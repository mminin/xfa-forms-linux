From e0d0f2205891e9590d015d535ed0ec9086322a24 Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Tue, 20 Oct 2026 10:20:45 -0700
Subject: [PATCH] Allow separately packaged viewers to select their application
 ID

AI-Assistant: OpenAI Codex
AI-Model: gpt-6.1-sol
AI-Reasoning-Effort: high
Co-authored-by: Codex <noreply@openai.com>
---
 data/icons/meson.build | 6 ++++--
 meson.build            | 4 ++++
 meson_options.txt      | 1 +
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/data/icons/meson.build b/data/icons/meson.build
index 22fb2db..1b1633a 100644
--- a/data/icons/meson.build
+++ b/data/icons/meson.build
@@ -1,8 +1,10 @@
 install_data(
-  join_paths('scalable', 'apps', '@0@.svg'.format(application_id)),
+  join_paths('scalable', 'apps', '@0@.svg'.format(application_icon_id)),
+  rename: '@0@.svg'.format(application_id),
   install_dir: join_paths(ev_datadir, 'icons', 'hicolor', 'scalable', 'apps'),
 )
 install_data(
-  join_paths('symbolic', 'apps', '@0@-symbolic.svg'.format(application_id)),
+  join_paths('symbolic', 'apps', '@0@-symbolic.svg'.format(application_icon_id)),
+  rename: '@0@-symbolic.svg'.format(application_id),
   install_dir: join_paths(ev_datadir, 'icons', 'hicolor', 'symbolic', 'apps'),
 )
diff --git a/meson.build b/meson.build
index 44e0ff5..e3e6fc8 100644
--- a/meson.build
+++ b/meson.build
@@ -15,6 +15,10 @@ if get_option('profile') == 'devel'
 else
   application_id = 'org.gnome.Evince'
 endif
+application_icon_id = application_id
+if get_option('application_id') != ''
+  application_id = get_option('application_id')
+endif
 
 ev_namespace = 'org.gnome.Evince'
 
diff --git a/meson_options.txt b/meson_options.txt
index f437e13..cfff31e 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1,4 +1,5 @@
 option('profile', type: 'combo', choices: ['default', 'devel'], value: 'default', description: 'whether this is a development build')
+option('application_id', type: 'string', value: '', description: 'override the application ID for an independently packaged viewer')
 option('platform', type: 'combo', choices: ['gnome', 'win32'], value: 'gnome', description: 'for which platform to build')
 
 option('viewer', type: 'boolean', value: true, description: 'whether Viewer support is requested')
-- 
2.43.0

