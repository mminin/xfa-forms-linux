From 236710ecdc583c84eca1e53685eb96f4deeff3e3 Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Tue, 20 Oct 2026 10:20:45 -0700
Subject: [PATCH] Allow separately packaged viewers to select their application
 ID

AI-Assistant: OpenAI Codex
AI-Model: gpt-6.1-sol
AI-Reasoning-Effort: high
Co-authored-by: Codex <noreply@openai.com>
---
 meson.build       | 3 +++
 meson_options.txt | 1 +
 2 files changed, 4 insertions(+)

diff --git a/meson.build b/meson.build
index 44e0ff5..2534e32 100644
--- a/meson.build
+++ b/meson.build
@@ -15,6 +15,9 @@ if get_option('profile') == 'devel'
 else
   application_id = 'org.gnome.Evince'
 endif
+if get_option('application_id') != ''
+  application_id = get_option('application_id')
+endif
 
 ev_namespace = 'org.gnome.Evince'
 
diff --git a/meson_options.txt b/meson_options.txt
index f437e13..cfff31e 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1,4 +1,5 @@
 option('profile', type: 'combo', choices: ['default', 'devel'], value: 'default', description: 'whether this is a development build')
+option('application_id', type: 'string', value: '', description: 'override the application ID for an independently packaged viewer')
 option('platform', type: 'combo', choices: ['gnome', 'win32'], value: 'gnome', description: 'for which platform to build')
 
 option('viewer', type: 'boolean', value: true, description: 'whether Viewer support is requested')
