From db94dcd8eccd6f70d93b3050accd5137cda01e42 Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Tue, 20 Oct 2026 11:36:05 -0700
Subject: [PATCH] Keep daemon activation names and protocol interfaces
 consistent

The daemon must own the selected application ID plus .Daemon, as advertised by its service file. Its generated D-Bus interface remains based on ev_namespace; the client must call that interface even for development and separately packaged profiles.

Assisted-by: OpenAI Codex
AI-Assistant: OpenAI Codex
AI-Model: gpt-6.1-sol
AI-Reasoning-Effort: high
Co-authored-by: Codex <noreply@openai.com>
---
 meson.build | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index e3e6fc8..6c6ddf4 100644
--- a/meson.build
+++ b/meson.build
@@ -187,10 +187,10 @@ if ev_platform == 'gnome'
     config_h.set_quoted('APPLICATION_DBUS_INTERFACE', '@0@.Application'.format(ev_namespace))
     config_h.set_quoted('EVINCE_DAEMON_SERVICE', '@0@.Daemon'.format(application_id))
     config_h.set_quoted('EVINCE_DAEMON_OBJECT_PATH', '/@0@/Daemon'.format(application_id.replace('.', '/')))
-    config_h.set_quoted('EVINCE_DAEMON_INTERFACE', '@0@.Daemon'.format(application_id))
+    config_h.set_quoted('EVINCE_DAEMON_INTERFACE', '@0@.Daemon'.format(ev_namespace))
 
     # ev-daemon
-    config_h.set_quoted('EV_DBUS_DAEMON_NAME', '@0@.Daemon'.format(ev_namespace))
+    config_h.set_quoted('EV_DBUS_DAEMON_NAME', '@0@.Daemon'.format(application_id))
     config_h.set_quoted('EV_DBUS_DAEMON_INTERFACE_NAME', '@0@.Daemon'.format(ev_namespace))
     config_h.set_quoted('EV_DBUS_DAEMON_OBJECT_PATH', '/@0@/Daemon'.format(application_id.replace('.', '/')))
     config_h.set_quoted('EV_DBUS_WINDOW_INTERFACE_NAME', '@0@.Window'.format(ev_namespace))
-- 
