diff --git a/libview/ev-view.c b/libview/ev-view.c
index b4729c4..515d2e0 100644
--- a/libview/ev-view.c
+++ b/libview/ev-view.c
@@ -2532,6 +2532,81 @@ ev_view_form_field_destroy (GtkWidget *widget,
