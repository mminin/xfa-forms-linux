+{
+	EvDocumentPrivate *priv = GET_PRIVATE (document);
+	EvDocumentPrivate *source_priv = GET_PRIVATE (source);
+	EvBackendInfo     *info;
+	const gchar       *uri_uncompressed;
+
+	priv->info = _ev_document_get_info (document);
+	priv->n_pages = _ev_document_get_n_pages (document);
+	ev_document_setup_cache (document);
+	priv->uri = g_strdup (source_priv->uri);
+	priv->file_size = source_priv->file_size;
+
+	info = g_object_get_data (G_OBJECT (source), EV_BACKEND_INFO_DATA_KEY);
+	if (info)
+		g_object_set_data_full (G_OBJECT (document), EV_BACKEND_INFO_DATA_KEY,
+					_ev_backend_info_ref (info),
+					(GDestroyNotify) _ev_backend_info_unref);
+	/* The source still owns, and removes, the uncompressed file */
+	uri_uncompressed = g_object_get_data (G_OBJECT (source), "uri-uncompressed");
+	if (uri_uncompressed)
+		g_object_set_data_full (G_OBJECT (document), "uri-uncompressed",
+					g_strdup (uri_uncompressed), g_free);
+}
