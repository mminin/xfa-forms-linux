+/* Dynamic XFA forms only hold a "please use Adobe Reader" page: show the
+ * pages poppler lays out from the form instead. */
+static void
+pdf_document_render_xfa (PdfDocument *pdf_document)
+{
+#ifdef HAVE_POPPLER_XFA
+	PopplerDocument *rendered;
+	GError *error = NULL;
+
+	if (poppler_document_get_form_type (pdf_document->document) != POPPLER_FORM_TYPE_XFA ||
+	    !poppler_document_get_needs_rendering (pdf_document->document))
+		return;
+
+	rendered = poppler_document_render_xfa (pdf_document->document, &error);
+	if (!rendered) {
+		g_warning ("Could not render the XFA form: %s", error->message);
+		g_error_free (error);
+		return;
+	}
+
+	g_object_unref (pdf_document->document);
+	pdf_document->document = rendered;
+#endif
+}
+
 static gboolean
 pdf_document_load (EvDocument   *document,
 		   const char   *uri,
@@ -261,6 +286,8 @@ pdf_document_load (EvDocument   *document,
 		return FALSE;
 	}
 
+	pdf_document_render_xfa (pdf_document);
+
 	return TRUE;
 }
 
@@ -285,6 +312,8 @@ pdf_document_load_stream (EvDocument          *document,
                 return FALSE;
         }
 
+        pdf_document_render_xfa (pdf_document);
+
         return TRUE;
 }
 
@@ -309,6 +338,8 @@ pdf_document_load_gfile (EvDocument          *document,
                 return FALSE;
         }
 
+        pdf_document_render_xfa (pdf_document);
+
         return TRUE;
 }
 
@@ -333,6 +364,8 @@ pdf_document_load_fd (EvDocument          *document,
                 return FALSE;
         }
 
+        pdf_document_render_xfa (pdf_document);
+
         return TRUE;
 }
 
@@ -2538,6 +2571,70 @@ pdf_document_forms_form_field_choice_get_text (EvDocumentForms *document,
 	return text;
 }
 
+static EvDocument *
+pdf_document_forms_rerender (EvDocumentForms *document)
+{
+#ifdef HAVE_POPPLER_XFA
+	PdfDocument *pdf_document = PDF_DOCUMENT (document);
+	PdfDocument *rerendered;
+	PopplerDocument *poppler_document;
+	GError *error = NULL;
+
+	if (!poppler_document_xfa_needs_rerender (pdf_document->document))
+		return NULL;
+
+	poppler_document = poppler_document_render_xfa (pdf_document->document, &error);
+	if (!poppler_document) {
+		g_warning ("Could not render the XFA form: %s", error->message);
+		g_error_free (error);
+		return NULL;
+	}
+
+	rerendered = g_object_new (PDF_TYPE_DOCUMENT, NULL);
+	rerendered->document = poppler_document;
+	rerendered->password = g_strdup (pdf_document->password);
+	rerendered->forms_modified = TRUE;
+	ev_document_set_modified (EV_DOCUMENT (rerendered), TRUE);
+
+	return EV_DOCUMENT (rerendered);
+#else
+	return NULL;
+#endif
+}
+
+static gchar **
+pdf_document_forms_take_messages (EvDocumentForms *document)
+{
+#ifdef HAVE_POPPLER_XFA
+	return poppler_document_xfa_take_messages (PDF_DOCUMENT (document)->document);
+#else
+	return NULL;
+#endif
+}
+
+static gchar **
+pdf_document_forms_take_urls (EvDocumentForms *document)
+{
+#ifdef HAVE_POPPLER_XFA
+	return poppler_document_xfa_take_urls (PDF_DOCUMENT (document)->document);
+#else
+	return NULL;
+#endif
+}
+
+static gboolean
+pdf_document_forms_take_print_request (EvDocumentForms *document,
+				       gint            *first_page,
+				       gint            *last_page)
+{
+#ifdef HAVE_POPPLER_XFA
+	return poppler_document_xfa_take_print_request (PDF_DOCUMENT (document)->document,
+							 first_page, last_page);
+#else
+	return FALSE;
+#endif
+}
+
 static void
 pdf_document_document_forms_iface_init (EvDocumentFormsInterface *iface)
 {
@@ -2556,6 +2653,10 @@ pdf_document_document_forms_iface_init (EvDocumentFormsInterface *iface)
 	iface->form_field_choice_unselect_all = pdf_document_forms_form_field_choice_unselect_all;
 	iface->form_field_choice_set_text = pdf_document_forms_form_field_choice_set_text;
 	iface->form_field_choice_get_text = pdf_document_forms_form_field_choice_get_text;
+	iface->rerender = pdf_document_forms_rerender;
+	iface->take_messages = pdf_document_forms_take_messages;
+	iface->take_urls = pdf_document_forms_take_urls;
+	iface->take_print_request = pdf_document_forms_take_print_request;
 }
 
