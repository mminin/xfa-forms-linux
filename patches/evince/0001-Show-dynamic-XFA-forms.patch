 }
 
+/* Some forms run scripts when their fields change: they can ask to show
+ * messages, open URLs or print, and can change the pages of the document,
+ * which then has to be replaced. */
+static void
+ev_view_apply_form_changes (EvView *view)
+{
+	EvViewPrivate *priv = GET_PRIVATE (view);
+	EvDocumentForms *forms;
+	EvDocument *rerendered;
+	gchar **strv;
+	gint first_page, last_page;
+
+	priv->form_changes_idle_id = 0;
+
+	if (!priv->document || !EV_IS_DOCUMENT_FORMS (priv->document))
+		return;
+
+	forms = EV_DOCUMENT_FORMS (g_object_ref (priv->document));
+
+	strv = ev_document_forms_take_urls (forms);
+	for (gchar **url = strv; url && *url; url++) {
+		g_autofree gchar *uri = strstr (*url, "://") ? g_strdup (*url) : g_strconcat ("https://", *url, NULL);
+		EvLinkAction *action = ev_link_action_new_external_uri (uri);
+		EvLink *link = ev_link_new (NULL, action);
+
+		ev_view_handle_link (view, link);
+		g_object_unref (link);
+		g_object_unref (action);
+	}
+	g_strfreev (strv);
+
+	strv = ev_document_forms_take_messages (forms);
+	if (strv && *strv) {
+		g_autofree gchar *text = g_strjoinv ("\n\n", strv);
+#if GTK_CHECK_VERSION (4, 10, 0)
+		GtkAlertDialog *dialog = gtk_alert_dialog_new ("%s", text);
+		GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (view));
+
+		gtk_alert_dialog_show (dialog, GTK_IS_WINDOW (root) ? GTK_WINDOW (root) : NULL);
+		g_object_unref (dialog);
+#else
+		g_message ("%s", text);
+#endif
+	}
+	g_strfreev (strv);
+
+	/* The model keeps the current page, and the view its position on it. */
+	rerendered = ev_document_forms_rerender (forms);
+	if (rerendered) {
+		ev_document_model_set_document (priv->model, rerendered);
+		g_object_unref (rerendered);
+	}
+
+	if (ev_document_forms_take_print_request (forms, &first_page, &last_page)) {
+		if (first_page >= 0 && last_page >= first_page)
+			gtk_widget_activate_action (GTK_WIDGET (view), "win.print-range",
+						    "(ii)", first_page + 1, last_page + 1);
+		else
+			gtk_widget_activate_action (GTK_WIDGET (view), "win.print", NULL);
+	}
+
+	g_object_unref (forms);
+}
+
+static void
+ev_view_form_changed (EvView *view)
+{
+	EvViewPrivate *priv = GET_PRIVATE (view);
+
+	/* In an idle: replacing the document destroys the field widgets,
+	 * and we may be in a signal handler of one of them. */
+	if (!priv->form_changes_idle_id)
+		priv->form_changes_idle_id = g_idle_add_once ((GSourceOnceFunc) ev_view_apply_form_changes, view);
+}
