+
+/**
+ * ev_document_forms_rerender:
+ * @document_forms: an #EvDocumentForms
+ *
+ * Some documents lay out their pages from their forms, such as PDF files
+ * with dynamic XFA forms, so changing their fields can change their pages.
+ * When the latest changes did, this returns a new document showing the
+ * current state of the form, to be shown instead of @document_forms.
+ *
+ * Returns: (transfer full) (nullable): the new document, or %NULL when
+ *   the pages of @document_forms are up to date
+ *
+ * Since: 49.0
+ */
+EvDocument *
+ev_document_forms_rerender (EvDocumentForms *document_forms)
+{
+	EvDocumentFormsInterface *iface = EV_DOCUMENT_FORMS_GET_IFACE (document_forms);
+	EvDocument *rerendered;
+
+	if (!iface->rerender)
+		return NULL;
+
+	rerendered = iface->rerender (document_forms);
+	if (rerendered)
+		_ev_document_set_up_from (rerendered, EV_DOCUMENT (document_forms));
+
+	return rerendered;
+}
+
+/**
+ * ev_document_forms_take_messages:
+ * @document_forms: an #EvDocumentForms
+ *
+ * Returns the messages the scripts of the form showed since the last call.
+ *
+ * Returns: (transfer full) (array zero-terminated=1) (nullable): the
+ *   messages, or %NULL. Free with g_strfreev().
+ *
+ * Since: 49.0
+ */
+gchar **
+ev_document_forms_take_messages (EvDocumentForms *document_forms)
+{
+	EvDocumentFormsInterface *iface = EV_DOCUMENT_FORMS_GET_IFACE (document_forms);
+
+	return iface->take_messages ? iface->take_messages (document_forms) : NULL;
+}
+
+/**
+ * ev_document_forms_take_urls:
+ * @document_forms: an #EvDocumentForms
+ *
+ * Returns the URLs the scripts of the form asked to open since the last
+ * call.
+ *
+ * Returns: (transfer full) (array zero-terminated=1) (nullable): the URLs,
+ *   or %NULL. Free with g_strfreev().
+ *
+ * Since: 49.0
+ */
+gchar **
+ev_document_forms_take_urls (EvDocumentForms *document_forms)
+{
+	EvDocumentFormsInterface *iface = EV_DOCUMENT_FORMS_GET_IFACE (document_forms);
+
+	return iface->take_urls ? iface->take_urls (document_forms) : NULL;
+}
+
+/**
+ * ev_document_forms_take_print_request:
+ * @document_forms: an #EvDocumentForms
+ * @first_page: (out) (optional): return location for the first page to print,
+ *   0-based, or -1 for all pages
+ * @last_page: (out) (optional): return location for the last page to print,
+ *   0-based, or -1 for all pages
+ *
+ * Returns whether the scripts of the form asked to print the document
+ * since the last call.
+ *
+ * Returns: %TRUE if printing was requested
+ *
+ * Since: 49.0
+ */
+gboolean
+ev_document_forms_take_print_request (EvDocumentForms *document_forms,
+				      gint            *first_page,
+				      gint            *last_page)
+{
+	EvDocumentFormsInterface *iface = EV_DOCUMENT_FORMS_GET_IFACE (document_forms);
+	gint first = -1, last = -1;
+	gboolean requested;
+
+	requested = iface->take_print_request ?
+		iface->take_print_request (document_forms, &first, &last) : FALSE;
+	if (first_page)
+		*first_page = first;
+	if (last_page)
+		*last_page = last;
+
+	return requested;
+}
