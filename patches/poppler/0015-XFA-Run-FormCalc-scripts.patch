+        return "__fc.object(" + som + ")";
+    }
+
+    std::vector<Token> tokens;
+    size_t index = 0;
+    std::set<std::string> locals;
+    std::set<std::string> functions;
+    int counter = 0;
+    int depth = 0;
+    bool failed = false;
+    std::string *error = nullptr;
