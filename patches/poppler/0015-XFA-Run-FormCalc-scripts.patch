+
+} // namespace
+
+std::optional<std::string> XFAFormCalcToJS(const std::string &formCalc, std::string *error)
+{
+    std::vector<Token> tokens;
+    Lexer lexer(formCalc);
+    if (!lexer.run(tokens, error)) {
+        return std::nullopt;
+    }
+    Translator translator(std::move(tokens));
+    return translator.run(error);
+}
