 // Locale independent number parsing: "1.5" whatever LC_NUMERIC says.
diff --git a/poppler/XFAFormCalc.cc b/poppler/XFAFormCalc.cc
new file mode 100644
index 0000000..7157067
--- /dev/null
+++ b/poppler/XFAFormCalc.cc
@@ -0,0 +1,692 @@
+//========================================================================
+//
+// XFAFormCalc.cc
+//
+// A recursive descent parser for FormCalc that writes JavaScript as it
+// goes. The JavaScript keeps FormCalc's semantics through the runtime
+// object __fc (see the prelude in XFAScript.cc): references to form
+// objects resolve when used, null counts as 0 in arithmetic, comparisons
+// give 1 or 0, and a script's value is that of its last expression.
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#include <config.h>
+
+#include "XFAFormCalc.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <set>
+#include <vector>
+
+namespace {
+
+struct Token
+{
+    enum Kind
+    {
+        End,
+        Number,
+        String,
+        Name,
+        Punct
+    };
+    Kind kind = End;
+    std::string text; // for strings, the decoded value
+    size_t pos = 0;
+};
+
+std::string lower(std::string s)
+{
+    std::ranges::transform(s, s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return s;
+}
+
+void appendUTF8(std::string &s, unsigned int c)
+{
+    if (c < 0x80) {
+        s += static_cast<char>(c);
+    } else if (c < 0x800) {
+        s += static_cast<char>(0xC0 | (c >> 6));
+        s += static_cast<char>(0x80 | (c & 0x3F));
+    } else {
+        s += static_cast<char>(0xE0 | (c >> 12));
+        s += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
+        s += static_cast<char>(0x80 | (c & 0x3F));
+    }
+}
+
+class Lexer
+{
+public:
+    explicit Lexer(const std::string &srcA) : src(srcA) { }
+
+    // Splits the whole source; false with *error set on a bad token.
+    bool run(std::vector<Token> &out, std::string *error)
+    {
+        while (true) {
+            skipSpaceAndComments();
+            Token t;
+            t.pos = pos;
+            if (pos >= src.size()) {
+                out.push_back(t);
+                return true;
+            }
+            const char c = src[pos];
+            if (std::isdigit(static_cast<unsigned char>(c)) || (c == '.' && pos + 1 < src.size() && std::isdigit(static_cast<unsigned char>(src[pos + 1])) && !afterName(out))) {
+                t.kind = Token::Number;
+                const size_t start = pos;
+                while (pos < src.size() && std::isdigit(static_cast<unsigned char>(src[pos]))) {
+                    ++pos;
+                }
+                if (pos < src.size() && src[pos] == '.') {
+                    ++pos;
+                    while (pos < src.size() && std::isdigit(static_cast<unsigned char>(src[pos]))) {
+                        ++pos;
+                    }
+                }
+                if (pos < src.size() && (src[pos] == 'e' || src[pos] == 'E')) {
+                    size_t p = pos + 1;
+                    if (p < src.size() && (src[p] == '+' || src[p] == '-')) {
+                        ++p;
+                    }
+                    if (p < src.size() && std::isdigit(static_cast<unsigned char>(src[p]))) {
+                        pos = p;
+                        while (pos < src.size() && std::isdigit(static_cast<unsigned char>(src[pos]))) {
+                            ++pos;
+                        }
+                    }
+                }
+                t.text = src.substr(start, pos - start);
+            } else if (c == '"') {
+                t.kind = Token::String;
+                ++pos;
+                while (true) {
+                    if (pos >= src.size()) {
+                        *error = "unterminated string";
+                        return false;
+                    }
+                    if (src[pos] == '"') {
+                        if (pos + 1 < src.size() && src[pos + 1] == '"') {
+                            t.text += '"';
+                            pos += 2;
+                            continue;
+                        }
+                        ++pos;
+                        break;
+                    }
+                    if (src[pos] == '\\' && pos + 5 < src.size() && (src[pos + 1] == 'u' || src[pos + 1] == 'U')
+                        && std::all_of(src.begin() + pos + 2, src.begin() + pos + 6, [](char h) { return std::isxdigit(static_cast<unsigned char>(h)); })) {
+                        appendUTF8(t.text, static_cast<unsigned int>(std::stoul(src.substr(pos + 2, 4), nullptr, 16)));
+                        pos += 6;
+                        continue;
+                    }
+                    t.text += src[pos++];
+                }
+            } else if (std::isalpha(static_cast<unsigned char>(c)) || c == '_' || c == '$' || c == '!' || static_cast<unsigned char>(c) >= 0x80) {
+                t.kind = Token::Name;
+                const size_t start = pos++;
+                while (pos < src.size() && (std::isalnum(static_cast<unsigned char>(src[pos])) || src[pos] == '_' || src[pos] == '$' || static_cast<unsigned char>(src[pos]) >= 0x80)) {
+                    ++pos;
+                }
+                t.text = src.substr(start, pos - start);
+            } else {
+                t.kind = Token::Punct;
+                static const char *const two[] = { "==", "<>", "<=", ">=", ".." };
+                for (const char *op : two) {
+                    if (src.compare(pos, 2, op) == 0) {
+                        t.text = op;
+                    }
+                }
+                if (t.text.empty()) {
+                    if (!std::strchr("=<>+-*/&|()[],.#", c)) {
+                        *error = std::string("unexpected character '") + c + "'";
+                        return false;
+                    }
+                    t.text = std::string(1, c);
+                }
+                pos += t.text.size();
+            }
+            out.push_back(t);
+        }
+    }
+
+private:
+    // ".5" after a name is a property access, not a number.
+    static bool afterName(const std::vector<Token> &out) { return !out.empty() && (out.back().kind == Token::Name || out.back().text == "]" || out.back().text == ")"); }
+
+    void skipSpaceAndComments()
+    {
+        while (pos < src.size()) {
+            const char c = src[pos];
+            if (std::isspace(static_cast<unsigned char>(c))) {
+                ++pos;
+            } else if (c == ';' || (c == '/' && pos + 1 < src.size() && src[pos + 1] == '/')) {
+                while (pos < src.size() && src[pos] != '\n') {
+                    ++pos;
+                }
+            } else {
+                break;
+            }
+        }
+    }
+
+    const std::string &src;
+    size_t pos = 0;
+};
+
+std::string jsString(const std::string &s)
+{
+    std::string res = "\"";
+    for (unsigned char c : s) {
+        switch (c) {
+        case '"':
+            res += "\\\"";
+            break;
+        case '\\':
+            res += "\\\\";
+            break;
+        case '\n':
+            res += "\\n";
+            break;
+        case '\r':
+            res += "\\r";
+            break;
+        case '\t':
+            res += "\\t";
+            break;
+        default:
+            if (c < 0x20) {
+                static const char *digits = "0123456789abcdef";
+                res += "\\u00";
+                res += digits[c >> 4];
+                res += digits[c & 0xF];
+            } else {
+                res += static_cast<char>(c);
+            }
+        }
+    }
+    return res + "\"";
+}
+
+// An expression: a plain value, a local variable, or a reference to form
+// objects that resolves when used (a JavaScript expression making a SOM
+// string).
+struct Expr
+{
+    enum Kind
+    {
+        Value,
+        Variable,
+        Reference
+    };
+    Kind kind = Value;
+    std::string js;
+};
+
+const std::set<std::string> &keywords()
+{
+    static const std::set<std::string> k = { "if",  "then", "elseif", "else",     "endif",  "while", "do",  "endwhile", "for", "upto", "downto", "step", "endfor", "foreach", "in", "func", "endfunc",
+                                             "var", "end",  "break",  "continue", "return", "null",  "and", "or",       "not", "eq",   "ne",     "lt",   "gt",     "le",      "ge", "throw" };
+    return k;
+}
+
+// The built-in functions of the runtime.
+const std::set<std::string> &builtins()
+{
+    static const std::set<std::string> b = { "abs",         "avg",      "ceil",    "count",        "floor", "max",    "min",      "mod",    "round", "sum",    "concat", "left",   "right",
+                                             "len",         "lower",    "upper",   "ltrim",        "rtrim", "substr", "replace",  "space",  "str",   "stuff",  "at",     "date",   "date2num",
+                                             "isodate2num", "num2date", "datefmt", "localdatefmt", "time",  "choose", "hasvalue", "exists", "oneof", "within", "uuid",   "encode", "decode" };
+    return b;
+}
+
+class Translator
+{
+public:
+    explicit Translator(std::vector<Token> tokensA) : tokens(std::move(tokensA))
+    {
+        // Functions may be called before they are declared.
+        for (size_t i = 0; i + 1 < tokens.size(); ++i) {
+            if (isKeyword(tokens[i], "func") && tokens[i + 1].kind == Token::Name) {
+                functions.insert(lower(tokens[i + 1].text));
+            }
+        }
+    }
+
+    std::optional<std::string> run(std::string *errorA)
+    {
+        error = errorA;
+        std::string body = statements({});
+        if (!failed && peek().kind != Token::End) {
+            fail("unexpected '" + peek().text + "'");
+        }
+        if (failed) {
+            return std::nullopt;
+        }
+        return "(function (__fc) {\nvar __res = null;\n" + body + "return __res;\n})(__fcRuntime(this))";
+    }
+
+private:
+    const Token &peek(size_t ahead = 0) const { return tokens[std::min(index + ahead, tokens.size() - 1)]; }
+    Token next() { return tokens[std::min(index++, tokens.size() - 1)]; }
+    bool isKeyword(const Token &t, const char *kw) const { return t.kind == Token::Name && lower(t.text) == kw; }
+    bool isPunct(const Token &t, const char *p) const { return t.kind == Token::Punct && t.text == p; }
+    bool acceptKeyword(const char *kw)
+    {
+        if (isKeyword(peek(), kw)) {
+            ++index;
+            return true;
+        }
+        return false;
+    }
+    bool acceptPunct(const char *p)
+    {
+        if (isPunct(peek(), p)) {
+            ++index;
+            return true;
+        }
+        return false;
+    }
+    void expectKeyword(const char *kw)
+    {
+        if (!acceptKeyword(kw)) {
+            fail(std::string("expected '") + kw + "'");
+        }
+    }
+    void expectPunct(const char *p)
+    {
+        if (!acceptPunct(p)) {
+            fail(std::string("expected '") + p + "'");
+        }
+    }
+    void fail(const std::string &msg)
+    {
+        if (!failed) {
+            *error = msg + " at offset " + std::to_string(peek().pos);
+        }
+        failed = true;
+    }
+    std::string fresh() { return "__t" + std::to_string(++counter); }
+
+    static std::string value(const Expr &e) { return e.kind == Expr::Reference ? "__fc.get(" + e.js + ")" : e.js; }
+    // Arguments of built-in functions keep references, so that functions
+    // such as Sum() see all the objects of "a[*]".
+    static std::string argument(const Expr &e) { return e.kind == Expr::Reference ? "__fc.ref(" + e.js + ")" : e.js; }
+
+    // Statements up to one of the given keywords (not consumed).
+    std::string statements(std::initializer_list<const char *> enders)
+    {
+        std::string js;
+        while (!failed && peek().kind != Token::End) {
+            if (std::ranges::any_of(enders, [this](const char *kw) { return isKeyword(peek(), kw); })) {
+                break;
+            }
+            js += statement();
+        }
+        return js;
+    }
+
+    // Deeply nested scripts are refused rather than overflowing the stack.
+    struct Nesting
+    {
+        explicit Nesting(Translator *tA) : t(tA)
+        {
+            if (++t->depth > 200) {
+                t->fail("nested too deeply");
+            }
+        }
+        ~Nesting() { --t->depth; }
+        Translator *t;
+    };
+
+    std::string statement()
+    {
+        const Nesting nesting(this);
+        if (failed) {
+            return {};
+        }
+        if (acceptKeyword("var")) {
+            const Token name = next();
+            if (name.kind != Token::Name) {
+                fail("expected a variable name");
+                return {};
+            }
+            locals.insert(name.text);
+            std::string init = "null";
+            if (acceptPunct("=")) {
+                init = value(simple());
+            }
+            return "var fc_" + name.text + " = " + init + ";\n__res = fc_" + name.text + ";\n";
+        }
+        if (acceptKeyword("if")) {
+            std::string js = "if (__fc.bool(" + condition() + ")) {\n";
+            expectKeyword("then");
+            js += statements({ "elseif", "else", "endif" }) + "}";
+            while (acceptKeyword("elseif")) {
+                js += " else if (__fc.bool(" + condition() + ")) {\n";
+                expectKeyword("then");
+                js += statements({ "elseif", "else", "endif" }) + "}";
+            }
+            if (acceptKeyword("else")) {
+                js += " else {\n" + statements({ "endif" }) + "}";
+            }
+            expectKeyword("endif");
+            return js + "\n";
+        }
+        if (acceptKeyword("while")) {
+            std::string js = "while (__fc.bool(" + condition() + ")) {\n";
+            expectKeyword("do");
+            js += statements({ "endwhile" }) + "}\n";
+            expectKeyword("endwhile");
+            return js;
+        }
+        if (acceptKeyword("for")) {
+            const Token name = next();
+            if (name.kind != Token::Name) {
+                fail("expected a loop variable");
+                return {};
+            }
+            locals.insert(name.text);
+            expectPunct("=");
+            const std::string start = value(simple());
+            const bool up = acceptKeyword("upto");
+            if (!up) {
+                expectKeyword("downto");
+            }
+            const std::string end = value(simple());
+            std::string step = "1";
+            if (acceptKeyword("step")) {
+                step = value(simple());
+            }
+            expectKeyword("do");
+            const std::string e = fresh(), s = fresh(), v = "fc_" + name.text;
+            std::string js = "for (var " + v + " = __fc.num(" + start + "), " + e + " = __fc.num(" + end + "), " + s + " = __fc.num(" + step + "); " + v + (up ? " <= " : " >= ") + e + "; " + v + (up ? " += " : " -= ") + s + ") {\n";
