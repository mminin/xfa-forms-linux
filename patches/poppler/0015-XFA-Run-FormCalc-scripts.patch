+    *runnable = false;
+    if (s->getAttr("runAt", "client") == "server") {
+        return {};
+    }
+    const std::string type = s->getAttr("contentType", "application/x-formcalc");
+    const std::string source = s->textContent();
+    if (type.find("javascript") != std::string::npos || type.find("ecmascript") != std::string::npos) {
+        *runnable = true;
+        return source;
+    }
+    if (type != "application/x-formcalc") {
+        return {};
+    }
+    auto it = formCalcCache.find(source);
+    if (it == formCalcCache.end()) {
+        std::string error;
+        std::optional<std::string> js = XFAFormCalcToJS(source, &error);
+        if (!js) {
+            logMessage("FormCalc: " + error);
+        }
+        it = formCalcCache.emplace(source, std::move(js)).first;
+    }
+    *runnable = it->second.has_value();
+    return it->second.value_or(std::string());
 }
 
