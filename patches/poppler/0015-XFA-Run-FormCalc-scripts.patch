+/* FormCalc calculations, the default script language. */
+#define FORMCALC_FIELD(name, script) "<field name=\"" name "\" w=\"6in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui><calculate><script>" script "</script></calculate></field>"
+static const char *formcalc_xdp =
+        "<?xml version=\"1.0\"?>\n"
+        "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+        "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+        "<subform name=\"form1\" layout=\"tb\">"
+        "<pageSet><pageArea name=\"Page1\">"
+        "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+        "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/>"
+        "</pageArea></pageSet>"
+        "<subform name=\"Row\" layout=\"tb\"><occur min=\"3\" max=\"3\"/>"
+        "<field name=\"v\" w=\"1in\" h=\"0.3in\"><ui><numericEdit/></ui><value><integer>2</integer></value></field></subform>"
+        "<field name=\"empty\" w=\"1in\" h=\"0.3in\"><ui><textEdit/></ui></field>" FORMCALC_FIELD("sum", "Concat(\"sum=\", Sum(Row[*].v))") FORMCALC_FIELD("loop",
+                                                                                                                                                           "var x = 0 ; comment\n for i = 1 upto 4 do x = x + i endfor\n"
+                                                                                                                                                           " if (x &gt; 5 and not (x == 3)) then Concat(\"loop=\", x) else \"small\" endif")
+                FORMCALC_FIELD("date", "Concat(\"date=\", Num2Date(Date2Num(\"2024-03-01\", \"YYYY-MM-DD\") - 1, \"YYYY-MM-DD\"))")
+                        FORMCALC_FIELD("func", "func twice(n) do n * 2 endfunc // comment\n Concat(\"func=\", twice(21), \"|\", empty + 1, \"|\", Upper(Left(\"hello\", 2)))") "</subform>"
+                                                                                                                                                                               "</template>"
+                                                                                                                                                                               "</xdp:xdp>";
+
+static void test_formcalc(void)
+{
+    GBytes *bytes = build_pdf_from(formcalc_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    char *text = page_text(rendered);
+    if (!strstr(text, "sum=")) {
+        g_test_skip("poppler was built without XFA scripting");
+    } else {
+        g_assert_nonnull(strstr(text, "sum=6"));
+        g_assert_nonnull(strstr(text, "loop=10"));
+        g_assert_nonnull(strstr(text, "date=2024-02-29"));
+        g_assert_nonnull(strstr(text, "func=42|1|HE"));
+    }
+    g_free(text);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -652,5 +696,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/static-values", test_static_values);
     g_test_add_func("/xfa/scripting", test_scripting);
     g_test_add_func("/xfa/data", test_data);
+    g_test_add_func("/xfa/formcalc", test_formcalc);
     return g_test_run();
 }
