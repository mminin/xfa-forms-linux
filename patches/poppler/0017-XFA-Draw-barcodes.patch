     g_bytes_unref(bytes);
 }
 
+/* A PDF417 barcode, drawn when poppler is built with Zint. */
+static const char *barcode_xdp = "<?xml version=\"1.0\"?>\n"
+                                 "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                                 "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                                 "<subform name=\"form1\" layout=\"position\" w=\"8.5in\" h=\"11in\">"
+                                 "<pageSet><pageArea name=\"Page1\">"
+                                 "<contentArea x=\"0in\" y=\"0in\" w=\"8.5in\" h=\"11in\"/>"
+                                 "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/>"
+                                 "</pageArea></pageSet>"
+                                 "<field name=\"code\" x=\"1in\" y=\"1in\" w=\"4in\" h=\"1in\" access=\"readOnly\">"
+                                 "<ui><barcode type=\"pdf417\" errorCorrectionLevel=\"5\" moduleHeight=\"0.676mm\" moduleWidth=\"0.338mm\"/></ui>"
+                                 "<value><text>XFA barcode test 0123456789 0123456789 0123456789</text></value></field>"
+                                 "</subform>"
+                                 "</template>"
+                                 "</xdp:xdp>";
+
+static void test_barcode(void)
+{
+    GBytes *bytes = build_pdf_from(barcode_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    PopplerPage *page = poppler_document_get_page(rendered, 0);
+    double width, height;
+    poppler_page_get_size(page, &width, &height);
+    cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_RGB24, width * 2, height * 2);
+    cairo_t *cr = cairo_create(surface);
+    cairo_set_source_rgb(cr, 1, 1, 1);
+    cairo_paint(cr);
+    cairo_scale(cr, 2, 2);
+    poppler_page_render(page, cr);
+    cairo_surface_flush(surface);
+    const unsigned char *data = cairo_image_surface_get_data(surface);
+    const int stride = cairo_image_surface_get_stride(surface);
+    /* The field spans 1 to 5 inches across, 1 to 2 down, at 144 dpi: the
+     * symbol is as wide as the field allows, and about half dark. */
+    int x1 = 720, x2 = 0, y1 = 288, y2 = 0;
+    for (int y = 144; y < 288; ++y) {
+        for (int x = 144; x < 720; ++x) {
+            if (data[y * stride + x * 4 + 1] < 128) {
+                x1 = MIN(x1, x);
+                x2 = MAX(x2, x);
+                y1 = MIN(y1, y);
+                y2 = MAX(y2, y);
+            }
+        }
+    }
+    if (x2 < x1) {
+        g_test_skip("poppler was built without Zint");
+    } else {
+        int dark = 0, total = 0;
+        for (int y = y1; y <= y2; ++y) {
+            for (int x = x1; x <= x2; ++x) {
+                dark += data[y * stride + x * 4 + 1] < 128;
+                ++total;
+            }
+        }
+        g_assert_cmpint(x2 - x1, >, 576 * 3 / 4);
+        g_assert_cmpint(dark, >, total * 3 / 10);
+        g_assert_cmpint(dark, <, total * 7 / 10);
+    }
+    cairo_destroy(cr);
+    cairo_surface_destroy(surface);
+    g_object_unref(page);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -697,5 +768,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/scripting", test_scripting);
     g_test_add_func("/xfa/data", test_data);
     g_test_add_func("/xfa/formcalc", test_formcalc);
+    g_test_add_func("/xfa/barcode", test_barcode);
     return g_test_run();
 }
