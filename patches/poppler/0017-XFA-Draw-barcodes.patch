+// Barcodes, encoded by Zint. Modules are moduleWidth wide, and the rows of
+// PDF417 symbols moduleHeight high; the symbol shrinks if it does not fit
+// the field.
+void Writer::drawBarcode(XFANode *field, double x, double y, double w, double h)
+{
+#if HAVE_XFA_BARCODES
+    const std::optional<std::string> value = form->getRawValue(field);
+    const XFANode *barcode = field->firstChild("ui")->firstChild("barcode");
+    if (!value || !barcode || ZBarcode_Version() < 21000) {
+        return;
+    }
+    static const struct
+    {
+        const char *xfa;
+        int zint;
+        bool linear;
+    } types[] = { { "pdf417", BARCODE_PDF417, false },
+                  { "QRCode", BARCODE_QRCODE, false },
+                  { "dataMatrix", BARCODE_DATAMATRIX, false },
+                  { "aztec", BARCODE_AZTEC, false },
+                  { "code128", BARCODE_CODE128, true },
+                  { "code128A", BARCODE_CODE128, true },
+                  { "code128B", BARCODE_CODE128, true },
+                  { "code128C", BARCODE_CODE128, true },
+                  { "code3Of9", BARCODE_CODE39, true },
+                  { "code3Of9extended", BARCODE_EXCODE39, true },
+                  { "code11", BARCODE_CODE11, true },
+                  { "code93", BARCODE_CODE93, true },
+                  { "codabar", BARCODE_CODABAR, true },
+                  { "code2Of5Interleaved", BARCODE_C25INTER, true },
+                  { "code2Of5Industrial", BARCODE_C25IND, true },
+                  { "code2Of5Standard", BARCODE_C25STANDARD, true },
+                  { "ean8", BARCODE_EANX, true },
+                  { "ean13", BARCODE_EANX, true },
+                  { "upcA", BARCODE_UPCA, true },
+                  { "upcE", BARCODE_UPCE, true },
+                  { "logmars", BARCODE_LOGMARS, true },
+                  { "msi", BARCODE_MSI_PLESSEY, true } };
+    const std::string type = barcode->getAttr("type", "");
+    const auto *t = std::ranges::find_if(types, [&type](const auto &e) { return type == e.xfa; });
+    if (t == std::end(types)) {
+        form->logMessage("unsupported barcode " + type);
+        return;
+    }
+    const double moduleW = XFAMeasureAttr(barcode, "moduleWidth", 0.25 * 72 / 25.4);
+    const double moduleH = XFAMeasureAttr(barcode, "moduleHeight", moduleW);
+    std::unique_ptr<zint_symbol, decltype(&ZBarcode_Delete)> symbol(ZBarcode_Create(), ZBarcode_Delete);
+    symbol->symbology = t->zint;
+    symbol->input_mode = DATA_MODE;
+    if (const std::string *level = barcode->getAttr("errorCorrectionLevel")) {
+        // PDF417 levels are 0 to 8; QR Code's L, M, Q, H are 1 to 4 in Zint.
+        symbol->option_1 = std::atoi(level->c_str()) + (t->zint == BARCODE_QRCODE ? 1 : 0);
+    }
+    if (t->zint == BARCODE_PDF417) {
+        // As many data columns as fit the field, unless given.
+        const int fit = static_cast<int>((w / moduleW - 69) / 17);
+        symbol->option_2 = barcode->getAttr("dataColumnCount") ? std::atoi(barcode->getAttr("dataColumnCount", "0").c_str()) : std::clamp(fit, 1, 30);
+        symbol->option_3 = std::atoi(barcode->getAttr("dataRowCount", "0").c_str());
+    }
+    const int error = ZBarcode_Encode(symbol.get(), reinterpret_cast<const unsigned char *>(value->data()), static_cast<int>(value->size()));
+    if (error >= ZINT_ERROR) {
+        form->logMessage("barcode " + type + ": " + symbol->errtxt);
+        return;
+    }
+    // Linear barcodes show their text below the bars, unless told otherwise.
+    if (t->linear && barcode->getAttr("textLocation", "below") != "none") {
+        const XFAFont font = XFAFontOf(field);
+        XFAPara para;
+        para.hAlign = "center";
+        h = std::max(0.0, h - font.lineHeight());
+        drawText(XFAParagraphsOfText(*value, font, para), para, x, y + h, w, font.lineHeight(), nullptr);
+    }
+    const int rows = t->linear ? 1 : symbol->rows;
+    double mw = moduleW;
+    double rowH = t->linear ? h : t->zint == BARCODE_PDF417 ? moduleH : moduleW;
+    const double scale = std::min({ 1.0, w / (symbol->width * mw), t->linear ? 1.0 : h / (rows * rowH) });
+    mw *= scale;
+    if (!t->linear) {
+        rowH *= scale;
+    }
+    const double ox = x + (w - symbol->width * mw) / 2;
+    const double oy = y + (h - rows * rowH) / 2;
+    std::string &ops = page->ops;
+    ops += "q\n0 g\n";
+    for (int r = 0; r < rows; ++r) {
+        for (int c = 0; c < symbol->width;) {
+            auto set = [&symbol, r](int col) { return (symbol->encoded_data[r][col >> 3] >> (col & 7)) & 1; };
+            if (!set(c)) {
+                ++c;
+                continue;
+            }
+            const int start = c;
+            while (c < symbol->width && set(c)) {
+                ++c;
+            }
+            ops += rect(ox + start * mw, oy + r * rowH, (c - start) * mw, rowH);
+        }
+    }
+    ops += "f\nQ\n";
+#else
+    (void)field;
+    (void)x;
+    (void)y;
+    (void)w;
+    (void)h;
+#endif
+}
+
 // Fields without a widget show their value as page content.
 void Writer::drawFieldValue(XFANode *field, const XFAFieldGeometry &g, double x, double y)
 {
@@ -765,7 +879,11 @@ void Writer::drawFieldValue(XFANode *field, const XFAFieldGeometry &g, double x,
         }
         return;
     }
-    if (ui == "signature" || ui == "barcode") {
+    if (ui == "barcode") {
+        drawBarcode(field, ux, uy, g.uiW, g.uiH);
+        return;
+    }
+    if (ui == "signature") {
         return;
     }
     const std::optional<std::string> raw = form->getRawValue(field);
