+// Type0 fonts with Identity-H encoding, glyph ids as codes, whole font
+// programs as poppler embeds them for AcroForm fields, and ToUnicode maps
+// so that the text can be copied.
+void Writer::writeFallbackFonts()
+{
+    for (const auto &[face, ff] : fallbackFonts) {
+        std::set<unsigned int> used;
+        for (const auto &[glyph, cp] : ff.glyphs) {
+            used.insert(glyph);
+        }
+        const XFAFallbackProgram p = XFAFallbackProgramOf(face, used);
+        // The program could not be read after all: viewers substitute a font.
+        const std::string program = p.data.empty()
+                ? std::string()
+                : std::string(p.trueType ? " /FontFile2 " : " /FontFile3 ") + ref(pdf.addStream((p.trueType ? "/Length1 " + std::to_string(p.data.size()) : std::string("/Subtype /OpenType")) + " /Filter /FlateDecode", XFADeflate(p.data)));
+        const std::string name = pdfName(p.name.empty() ? std::string("XFAFallback") : p.name);
+        const int descriptor = pdf.add("<< /Type /FontDescriptor /FontName " + name + " /Flags " + std::to_string((p.serif ? 2 : 0) | 32 | (p.italic ? 64 : 0)) + " /FontBBox [" + std::to_string(p.bbox[0]) + " " + std::to_string(p.bbox[1])
+                                       + " " + std::to_string(p.bbox[2]) + " " + std::to_string(p.bbox[3]) + "] /ItalicAngle " + (p.italic ? "-12" : "0") + " /Ascent " + std::to_string(p.ascent) + " /Descent " + std::to_string(p.descent)
+                                       + " /CapHeight " + std::to_string(p.ascent) + " /StemV 80" + program + " >>");
+        std::string widths;
+        std::string cmap = "/CIDInit /ProcSet findresource begin\n12 dict begin\nbegincmap\n/CIDSystemInfo << /Registry (Adobe) /Ordering (UCS) /Supplement 0 >> def\n/CMapName /Adobe-Identity-UCS def\n/CMapType 2 def\n"
+                           "1 begincodespacerange\n<0000> <FFFF>\nendcodespacerange\n";
+        std::vector<std::pair<unsigned int, unsigned int>> glyphs(ff.glyphs.begin(), ff.glyphs.end());
+        for (size_t start = 0; start < glyphs.size(); start += 100) {
+            const size_t end = std::min(glyphs.size(), start + 100);
+            cmap += std::to_string(end - start) + " beginbfchar\n";
+            for (size_t k = start; k < end; ++k) {
+                char code[8];
+                snprintf(code, sizeof(code), "%04X", glyphs[k].first & 0xFFFF);
+                std::string utf16;
+                unsigned int cp = glyphs[k].second;
+                char unit[8];
+                if (cp >= 0x10000) {
+                    cp -= 0x10000;
+                    snprintf(unit, sizeof(unit), "%04X", 0xD800 + (cp >> 10));
+                    utf16 += unit;
+                    snprintf(unit, sizeof(unit), "%04X", 0xDC00 + (cp & 0x3FF));
+                    utf16 += unit;
+                } else {
+                    snprintf(unit, sizeof(unit), "%04X", cp);
+                    utf16 += unit;
+                }
+                cmap += std::string("<") + code + "> <" + utf16 + ">\n";
+            }
+            cmap += "endbfchar\n";
+        }
+        cmap += "endcmap\nCMapName currentdict /CMap defineresource pop\nend\nend\n";
+        for (const auto &[glyph, cp] : glyphs) {
+            widths += std::to_string(glyph) + " [" + num(XFAFallbackWidth(face, cp)) + "] ";
+        }
+        const int toUnicode = pdf.addStream("/Filter /FlateDecode", XFADeflate(cmap));
+        const int cidFont =
+                pdf.add("<< /Type /Font /Subtype " + std::string(p.trueType ? "/CIDFontType2" : "/CIDFontType0") + " /BaseFont " + name + " /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> /FontDescriptor "
