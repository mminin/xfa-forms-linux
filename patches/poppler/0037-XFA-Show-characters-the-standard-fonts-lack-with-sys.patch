+struct XFAFallbackFace
+{
+    std::string path;
+    int index = 0;
+    std::string family, style;
+    FT_Face face = nullptr;
+    std::string sfnt; // the face's font file, read when first embedded
+};
+
+namespace {
+
+// Faces are kept for the life of the process: what fontconfig found for a
+// character does not change while poppler runs.
+struct Cache
+{
+    std::mutex mutex;
+    FT_Library library = nullptr;
+    bool libraryFailed = false;
+    std::map<std::pair<std::string, int>, std::unique_ptr<XFAFallbackFace>> faces;
+    std::map<std::pair<unsigned int, int>, const XFAFallbackFace *> byChar;
+    std::map<int, std::unique_ptr<GfxFont>> emulated;
+};
+
+Cache &cache()
+{
+    static Cache c;
+    return c;
+}
+
+// A standard font, for GlobalParams to find a system font similar to it.
+const GfxFont *emulatedFont(Cache &c, int standardFont)
+{
+    auto it = c.emulated.find(standardFont);
+    if (it == c.emulated.end()) {
+        Dict dict(static_cast<XRef *>(nullptr));
+        dict.add("Type", Object::name("Font"));
+        dict.add("Subtype", Object::name("Type1"));
+        dict.add("BaseFont", Object::name(XFAStandardFontName(standardFont)));
+        it = c.emulated.emplace(standardFont, GfxFont::makeFont(nullptr, "F", Ref::INVALID(), dict)).first;
+    }
+    return it->second.get();
+}
+
+unsigned int u16(const std::string &d, size_t at)
+{
+    return at + 2 <= d.size() ? (static_cast<unsigned char>(d[at]) << 8) | static_cast<unsigned char>(d[at + 1]) : 0;
+}
+
+unsigned int u32(const std::string &d, size_t at)
+{
+    return (u16(d, at) << 16) | u16(d, at + 2);
+}
+
+void put16(std::string &d, unsigned int v)
+{
+    d += static_cast<char>((v >> 8) & 0xFF);
+    d += static_cast<char>(v & 0xFF);
+}
+
+void put32(std::string &d, unsigned int v)
+{
+    put16(d, v >> 16);
+    put16(d, v & 0xFFFF);
+}
+
+// One face of a font file: the file itself, or the face out of a TrueType
+// or OpenType collection, as PDF cannot embed collections.
+std::string sfntOf(const std::string &file, int index)
+{
+    if (file.compare(0, 4, "ttcf") != 0) {
+        return file;
+    }
+    const unsigned int count = u32(file, 8);
+    if (index < 0 || static_cast<unsigned int>(index) >= count) {
+        return {};
+    }
+    const size_t header = u32(file, 12 + 4 * static_cast<size_t>(index));
+    const unsigned int numTables = u16(file, header + 4);
+    if (header + 12 + 16 * static_cast<size_t>(numTables) > file.size()) {
+        return {};
+    }
+    std::string out = file.substr(header, 12);
+    size_t offset = 12 + 16 * static_cast<size_t>(numTables);
+    std::string data;
+    for (unsigned int t = 0; t < numTables; ++t) {
+        const size_t rec = header + 12 + 16 * static_cast<size_t>(t);
+        const size_t from = u32(file, rec + 8), length = u32(file, rec + 12);
+        if (from > file.size() || length > file.size() - from) {
+            return {};
+        }
+        out += file.substr(rec, 8); // tag and checksum
+        put32(out, static_cast<unsigned int>(offset + data.size()));
+        put32(out, static_cast<unsigned int>(length));
+        data += file.substr(from, length);
+        data.resize((data.size() + 3) & ~static_cast<size_t>(3), '\0');
+    }
+    return out + data;
+}
+
+// The offset and length of a table of an sfnt, or nothing.
+std::optional<std::pair<size_t, size_t>> findTable(const std::string &sfnt, const char *tag)
+{
+    const unsigned int numTables = u16(sfnt, 4);
+    for (unsigned int t = 0; t < numTables; ++t) {
+        const size_t rec = 12 + 16 * static_cast<size_t>(t);
+        if (rec + 16 <= sfnt.size() && sfnt.compare(rec, 4, tag, 4) == 0) {
+            const size_t from = u32(sfnt, rec + 8), length = u32(sfnt, rec + 12);
+            if (from <= sfnt.size() && length <= sfnt.size() - from) {
+                return std::make_pair(from, length);
+            }
+        }
+    }
+    return std::nullopt;
+}
+
+bool hasTable(const std::string &sfnt, const char *tag)
+{
+    return findTable(sfnt, tag).has_value();
+}
+
+// Empties the TrueType glyphs not in keep, and those composite glyphs do
+// not use: a glyph of no contours.
+void emptyTrueTypeGlyphs(std::string &sfnt, std::set<unsigned int> keep)
+{
+    const auto head = findTable(sfnt, "head"), maxp = findTable(sfnt, "maxp"), loca = findTable(sfnt, "loca"), glyf = findTable(sfnt, "glyf");
+    if (!head || !maxp || !loca || !glyf || head->second < 54 || maxp->second < 6) {
+        return;
+    }
+    const bool longOffsets = u16(sfnt, head->first + 50) == 1;
+    const unsigned int numGlyphs = u16(sfnt, maxp->first + 4);
+    const auto offset = [&](unsigned int g) -> size_t { return longOffsets ? u32(sfnt, loca->first + 4 * static_cast<size_t>(g)) : 2 * static_cast<size_t>(u16(sfnt, loca->first + 2 * static_cast<size_t>(g))); };
+    if (loca->second < (longOffsets ? 4 : 2) * (static_cast<size_t>(numGlyphs) + 1)) {
+        return;
+    }
+    keep.insert(0);
+    // Components of composite glyphs, recursively.
+    std::vector<unsigned int> todo(keep.begin(), keep.end());
+    while (!todo.empty()) {
+        const unsigned int g = todo.back();
+        todo.pop_back();
+        if (g >= numGlyphs) {
+            continue;
+        }
+        const size_t start = offset(g), end = offset(g + 1);
+        if (end <= start || end > glyf->second || static_cast<short>(u16(sfnt, glyf->first + start)) >= 0) {
+            continue;
+        }
+        for (size_t at = glyf->first + start + 10; at + 4 <= glyf->first + end;) {
+            const unsigned int flags = u16(sfnt, at), component = u16(sfnt, at + 2);
+            if (keep.insert(component).second) {
+                todo.push_back(component);
+            }
+            at += 4 + ((flags & 1) ? 4 : 2); // ARG_1_AND_2_ARE_WORDS
+            at += (flags & 8) ? 2 : (flags & 0x40) ? 4 : (flags & 0x80) ? 8 : 0; // scales
+            if (!(flags & 0x20)) { // MORE_COMPONENTS
+                break;
+            }
+        }
+    }
+    for (unsigned int g = 0; g < numGlyphs; ++g) {
+        const size_t start = offset(g), end = std::min(offset(g + 1), glyf->second);
+        if (!keep.contains(g) && end > start) {
+            std::fill(sfnt.begin() + glyf->first + start, sfnt.begin() + glyf->first + end, '\0');
+        }
+    }
+}
+
+// An INDEX of a CFF table at at: the offsets of its items, relative to the
+// table, and where the INDEX ends.
+std::optional<std::pair<std::vector<size_t>, size_t>> cffIndex(const std::string &cff, size_t at)
+{
+    if (at + 2 > cff.size()) {
+        return std::nullopt;
+    }
+    const unsigned int count = u16(cff, at);
+    if (count == 0) {
+        return std::make_pair(std::vector<size_t> {}, at + 2);
+    }
+    const unsigned int offSize = static_cast<unsigned char>(cff[at + 2]);
+    if (offSize < 1 || offSize > 4 || at + 3 + (static_cast<size_t>(count) + 1) * offSize > cff.size()) {
+        return std::nullopt;
+    }
+    const size_t base = at + 2 + (static_cast<size_t>(count) + 1) * offSize; // offsets count from base + 1
+    std::vector<size_t> offsets;
+    for (unsigned int i = 0; i <= count; ++i) {
+        size_t v = 0;
+        for (unsigned int k = 0; k < offSize; ++k) {
+            v = (v << 8) | static_cast<unsigned char>(cff[at + 3 + static_cast<size_t>(i) * offSize + k]);
+        }
+        if (v < 1 || base + v > cff.size()) {
+            return std::nullopt;
+        }
+        offsets.push_back(base + v);
+    }
+    return std::make_pair(offsets, offsets.back());
+}
+
+// Empties the CFF charstrings of the glyphs not in keep: an endchar, then
+// bytes that are never read.
+void emptyCffGlyphs(std::string &sfnt, std::set<unsigned int> keep)
+{
+    const auto table = findTable(sfnt, "CFF ");
+    if (!table || table->second < 4) {
+        return;
+    }
+    std::string cff = sfnt.substr(table->first, table->second);
+    const auto names = cffIndex(cff, static_cast<unsigned char>(cff[2]));
+    const auto tops = names ? cffIndex(cff, names->second) : std::nullopt;
+    if (!tops || tops->first.size() < 2) {
+        return;
+    }
+    // The CharStrings operand of the first Top DICT.
+    std::vector<long> operands;
+    std::optional<size_t> charStrings;
+    for (size_t at = tops->first[0]; at < tops->first[1];) {
+        const unsigned int b = static_cast<unsigned char>(cff[at]);
+        if (b <= 21) {
+            if (b == 17 && !operands.empty()) {
+                charStrings = static_cast<size_t>(operands.back());
+            }
+            operands.clear();
+            at += b == 12 ? 2 : 1;
+        } else if (b == 28 && at + 2 < cff.size()) {
+            operands.push_back(static_cast<short>(u16(cff, at + 1)));
+            at += 3;
+        } else if (b == 29 && at + 4 < cff.size()) {
+            operands.push_back(static_cast<int>(u32(cff, at + 1)));
+            at += 5;
+        } else if (b == 30) {
+            for (++at; at < cff.size() && (static_cast<unsigned char>(cff[at]) & 0x0F) != 0x0F && (static_cast<unsigned char>(cff[at]) & 0xF0) != 0xF0; ++at) { }
+            ++at;
+            operands.push_back(0);
+        } else if (b >= 32 && b <= 246) {
+            operands.push_back(static_cast<long>(b) - 139);
+            ++at;
+        } else if (b >= 247 && b <= 254 && at + 1 < cff.size()) {
+            const long w = static_cast<unsigned char>(cff[at + 1]);
+            operands.push_back(b <= 250 ? (static_cast<long>(b) - 247) * 256 + w + 108 : -(static_cast<long>(b) - 251) * 256 - w - 108);
+            at += 2;
+        } else {
+            return;
+        }
+    }
+    const auto glyphs = charStrings ? cffIndex(cff, *charStrings) : std::nullopt;
+    if (!glyphs) {
+        return;
+    }
+    keep.insert(0);
+    for (size_t g = 0; g + 1 < glyphs->first.size(); ++g) {
+        const size_t start = glyphs->first[g], end = glyphs->first[g + 1];
+        if (!keep.contains(static_cast<unsigned int>(g)) && end > start) {
+            cff[start] = 14; // endchar
+            std::fill(cff.begin() + start + 1, cff.begin() + end, '\0');
+        }
+    }
+    sfnt.replace(table->first, table->second, cff);
+}
+
+// The sfnt without the tables PDF viewers do not use: layout, colour,
+// bitmaps, vertical metrics and signatures.
+std::string withoutUnusedTables(const std::string &sfnt)
+{
+    // Glyphs are chosen by id, so cmap goes too, and text is horizontal.
+    static const char *const kept[] = { "CFF ", "OS/2", "cvt ", "fpgm", "glyf", "head", "hhea", "hmtx", "loca", "maxp", "name", "post", "prep" };
+    const unsigned int numTables = u16(sfnt, 4);
+    std::vector<size_t> records;
+    for (unsigned int t = 0; t < numTables; ++t) {
+        const size_t rec = 12 + 16 * static_cast<size_t>(t);
+        if (rec + 16 <= sfnt.size() && std::ranges::any_of(kept, [&](const char *tag) { return sfnt.compare(rec, 4, tag, 4) == 0; })) {
+            records.push_back(rec);
+        }
+    }
+    std::string out = sfnt.substr(0, 4);
+    put16(out, static_cast<unsigned int>(records.size()));
+    out += sfnt.substr(6, 6); // searchRange and the rest, which readers recompute
+    std::string data;
+    const size_t dataStart = 12 + 16 * records.size();
+    for (size_t rec : records) {
+        const size_t from = u32(sfnt, rec + 8), length = u32(sfnt, rec + 12);
+        if (from > sfnt.size() || length > sfnt.size() - from) {
+            return sfnt;
+        }
+        out += sfnt.substr(rec, 8);
+        put32(out, static_cast<unsigned int>(dataStart + data.size()));
+        put32(out, static_cast<unsigned int>(length));
+        data += sfnt.substr(from, length);
+        data.resize((data.size() + 3) & ~static_cast<size_t>(3), '\0');
+    }
+    return out + data;
+}
+
+} // namespace
+
+const XFAFallbackFace *XFAFallbackFaceFor(unsigned int cp, int standardFont)
+{
+    Cache &c = cache();
+    const std::lock_guard<std::mutex> lock(c.mutex);
+    const auto key = std::make_pair(cp, standardFont);
+    if (const auto it = c.byChar.find(key); it != c.byChar.end()) {
+        return it->second;
+    }
+    const XFAFallbackFace *found = nullptr;
+    if (globalParams && !c.libraryFailed) {
+        if (!c.library && FT_Init_FreeType(&c.library)) {
+            c.library = nullptr;
+            c.libraryFailed = true;
+        }
+        const GfxFont *emulated = c.library ? emulatedFont(c, standardFont) : nullptr;
+        const UCharFontSearchResult res = emulated ? globalParams->findSystemFontFileForUChar(cp, *emulated) : UCharFontSearchResult();
+        if (!res.filepath.empty()) {
+            auto &slot = c.faces[{ res.filepath, res.faceIndex }];
+            if (!slot) {
+                slot = std::make_unique<XFAFallbackFace>();
+                slot->path = res.filepath;
+                slot->index = res.faceIndex;
+                slot->family = res.family;
+                slot->style = res.style;
+                if (ft_new_face_from_file(c.library, res.filepath.c_str(), res.faceIndex, &slot->face)) {
+                    slot->face = nullptr;
+                }
+                // Only TrueType and OpenType fonts can be embedded.
+                FT_ULong glyf = 0, cff = 0;
+                if (slot->face
+                    && (!FT_IS_SFNT(slot->face) || (FT_Load_Sfnt_Table(slot->face, FT_MAKE_TAG('g', 'l', 'y', 'f'), 0, nullptr, &glyf) != 0 && FT_Load_Sfnt_Table(slot->face, FT_MAKE_TAG('C', 'F', 'F', ' '), 0, nullptr, &cff) != 0))) {
+                    FT_Done_Face(slot->face);
+                    slot->face = nullptr;
+                }
+            }
+            if (slot->face && FT_Get_Char_Index(slot->face, cp) != 0) {
+                found = slot.get();
+            }
+        }
+    }
+    c.byChar[key] = found;
+    return found;
+}
+
+unsigned int XFAFallbackGlyph(const XFAFallbackFace *face, unsigned int cp)
+{
+    const std::lock_guard<std::mutex> lock(cache().mutex);
+    return face && face->face ? FT_Get_Char_Index(face->face, cp) : 0;
+}
+
+double XFAFallbackWidth(const XFAFallbackFace *face, unsigned int cp)
+{
+    const std::lock_guard<std::mutex> lock(cache().mutex);
+    if (!face || !face->face || face->face->units_per_EM == 0) {
+        return 0;
+    }
+    const FT_UInt glyph = FT_Get_Char_Index(face->face, cp);
+    if (FT_Load_Glyph(face->face, glyph, FT_LOAD_NO_SCALE | FT_LOAD_NO_HINTING)) {
+        return 0;
+    }
+    return face->face->glyph->advance.x * 1000.0 / face->face->units_per_EM;
+}
+
+XFAFallbackProgram XFAFallbackProgramOf(const XFAFallbackFace *face, const std::set<unsigned int> &glyphs)
+{
+    XFAFallbackProgram p;
+    if (!face || !face->face) {
+        return p;
+    }
+    {
+        const std::lock_guard<std::mutex> lock(cache().mutex);
+        const FT_Face f = face->face;
+        const double scale = f->units_per_EM ? 1000.0 / f->units_per_EM : 1;
+        p.bbox[0] = static_cast<int>(f->bbox.xMin * scale);
+        p.bbox[1] = static_cast<int>(f->bbox.yMin * scale);
+        p.bbox[2] = static_cast<int>(f->bbox.xMax * scale);
+        p.bbox[3] = static_cast<int>(f->bbox.yMax * scale);
+        p.ascent = static_cast<int>(f->ascender * scale);
+        p.descent = static_cast<int>(f->descender * scale);
+        p.italic = (f->style_flags & FT_STYLE_FLAG_ITALIC) != 0;
+        const char *psName = FT_Get_Postscript_Name(f);
+        p.name = psName ? psName : face->family + "-" + face->style;
+    }
+    std::erase_if(p.name, [](char ch) { return ch == ' ' || static_cast<unsigned char>(ch) < 0x21 || static_cast<unsigned char>(ch) > 0x7E; });
+    std::string lower = face->family;
+    for (char &ch : lower) {
+        ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+    }
+    p.serif = lower.find("serif") != std::string::npos && lower.find("sans") == std::string::npos;
+    std::string sfnt;
+    {
+        const std::lock_guard<std::mutex> lock(cache().mutex);
+        auto *mutableFace = const_cast<XFAFallbackFace *>(face);
+        if (mutableFace->sfnt.empty()) {
+            std::ifstream in(face->path, std::ios::binary);
+            const std::string file((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+            mutableFace->sfnt = withoutUnusedTables(sfntOf(file, face->index));
+        }
+        sfnt = face->sfnt;
+    }
+    if (sfnt.size() < 12 || (!hasTable(sfnt, "glyf") && !hasTable(sfnt, "CFF "))) {
+        return p;
+    }
+    p.trueType = hasTable(sfnt, "glyf");
+    if (p.trueType) {
+        emptyTrueTypeGlyphs(sfnt, glyphs);
+    } else {
+        emptyCffGlyphs(sfnt, glyphs);
+    }
+    p.data = std::move(sfnt);
+    return p;
+}
