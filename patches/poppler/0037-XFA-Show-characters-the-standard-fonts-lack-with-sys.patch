+//========================================================================
+//
+// XFAFonts.h
+//
+// Fonts for the text of XFA forms that the standard 14 fonts cannot show,
+// such as Cyrillic, Greek, Chinese or most of Latin Extended: system fonts
+// found the way poppler finds fonts for AcroForm fields, embedded as Type0
+// fonts with the Identity-H encoding.
