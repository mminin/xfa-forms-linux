     g_bytes_unref(bytes);
 }
 
+/* Characters the standard fonts lack come from an embedded system font
+ * instead of turning into question marks. */
+static void test_unicode_text(void)
+{
+    const char *xml = "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                      "<subform name=\"form1\" layout=\"tb\"><pageSet><pageArea name=\"Page1\">"
+                      "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                      "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/></pageArea></pageSet>"
+                      "<draw w=\"6in\" h=\"0.4in\"><font typeface=\"Myriad Pro\"/><value><text>Names: \xc5\x81ukasz \xd0\x98\xd0\xb2\xd0\xb0\xd0\xbd Zo\xc3\xab</text></value></draw>"
+                      "</subform></template>";
+    GBytes *bytes = build_pdf_from(xml);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    char *text = page_text(rendered);
+    if (strstr(text, "????")) {
+        g_test_skip("no system font has Cyrillic");
+    } else {
+        g_assert_nonnull(strstr(text, "Names: \xc5\x81ukasz \xd0\x98\xd0\xb2\xd0\xb0\xd0\xbd Zo\xc3\xab"));
+    }
+    g_free(text);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 /* Merging data adds the occurrences of repeatable subforms that the data
  * has groups for; field values reach their data nodes, which manifests
  * reference; functions a script calls plainly see its object as this. This
@@ -1400,5 +1428,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/som-predicates", test_som_predicates);
     g_test_add_func("/xfa/event-target", test_event_target);
     g_test_add_func("/xfa/data-binding", test_data_binding);
+    g_test_add_func("/xfa/unicode-text", test_unicode_text);
     return g_test_run();
 }
