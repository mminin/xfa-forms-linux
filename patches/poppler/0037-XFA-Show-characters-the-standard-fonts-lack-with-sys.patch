+
+#ifndef XFAFONTS_H
+#define XFAFONTS_H
+
+#include <set>
+#include <string>
+#include <vector>
+
+// A face of a system font, loaded once per process.
+struct XFAFallbackFace;
+
+// Whether the standard fonts show code point cp, in WinAnsiEncoding.
+bool XFAWinAnsiShows(unsigned int cp);
+
+// The face to show cp with instead of standard font standardFont (see
+// XFAStandardFontName()), or nullptr when no system font has it.
+const XFAFallbackFace *XFAFallbackFaceFor(unsigned int cp, int standardFont);
+
+// The glyph of cp in face, and its advance in thousandths of an em.
+unsigned int XFAFallbackGlyph(const XFAFallbackFace *face, unsigned int cp);
+double XFAFallbackWidth(const XFAFallbackFace *face, unsigned int cp);
+
+// What embedding a face takes.
+struct XFAFallbackProgram
+{
+    std::string name; // PostScript-like name, without spaces
+    bool trueType = true; // glyf outlines (FontFile2), else CFF (FontFile3 OpenType)
+    int bbox[4] = { 0, 0, 0, 0 }; // in thousandths of an em
+    int ascent = 0, descent = 0;
+    bool serif = false, italic = false;
+    std::string data; // one face, out of a collection if need be; empty on failure
+};
+// The face's program with only the given glyphs drawn: the others are left
+// empty, so that glyph ids do not change, and tables PDF does not use are
+// dropped.
+XFAFallbackProgram XFAFallbackProgramOf(const XFAFallbackFace *face, const std::set<unsigned int> &glyphs);
+
+#endif
