+static void test_saved_scripts(void)
+{
+    GBytes *bytes = build_pdf();
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *doc = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    PopplerFormField *field = first_text_field(doc);
+    if (!field) {
+        g_test_skip("poppler was built without XFA scripting");
+    } else {
+        poppler_form_field_text_set_text(field, "World & family");
+        g_object_unref(field);
+        GFileIOStream *io;
+        GFile *file = g_file_new_tmp("poppler-xfa-state-XXXXXX.pdf", &io, &err);
+        g_assert_no_error(err);
+        g_assert_true(g_io_stream_close(G_IO_STREAM(io), NULL, &err));
+        g_assert_no_error(err);
+        g_object_unref(io);
+        char *uri = g_file_get_uri(file);
+        for (int round = 0; round < 3; ++round) {
+#ifndef G_OS_WIN32
+            if (round == 1) {
+                char *fd_path;
+                int fd = g_file_open_tmp("poppler-xfa-fd-XXXXXX.pdf", &fd_path, &err);
+                g_assert_no_error(err);
+                g_assert_true(poppler_document_save_to_fd(doc, fd, TRUE, &err));
+                g_assert_no_error(err);
+                GFile *fd_file = g_file_new_for_path(fd_path);
+                g_assert_true(g_file_move(fd_file, file, G_FILE_COPY_OVERWRITE, NULL, NULL, NULL, &err));
+                g_assert_no_error(err);
+                g_object_unref(fd_file);
+                g_free(fd_path);
+            } else
+#endif
+            {
+                g_assert_true(poppler_document_save(doc, uri, &err));
+            }
+            g_assert_no_error(err);
+            g_object_unref(doc);
+            PopplerDocument *saved = poppler_document_new_from_file(uri, NULL, &err);
+            g_assert_no_error(err);
+            g_assert_true(poppler_document_get_needs_rendering(saved));
+            g_assert_cmpint(poppler_document_get_form_type(saved), ==, POPPLER_FORM_TYPE_XFA);
+            doc = poppler_document_render_xfa(saved, &err);
+            g_assert_no_error(err);
+            g_object_unref(saved);
+            field = first_text_field(doc);
+            char *value = poppler_form_field_text_get_text(field);
+            g_assert_cmpstr(value, ==, "World & family");
+            g_free(value);
+            g_object_unref(field);
+            PopplerPage *page = poppler_document_get_page(doc, 0);
+            GList *mapping = poppler_page_get_form_field_mapping(page);
+            int text_fields = 0;
+            PopplerFormField *generate = NULL;
+            for (GList *l = mapping; l; l = l->next) {
+                PopplerFormFieldMapping *m = l->data;
+                if (poppler_form_field_get_field_type(m->field) == POPPLER_FORM_FIELD_TEXT) {
+                    ++text_fields;
+                } else if (poppler_form_field_get_field_type(m->field) == POPPLER_FORM_FIELD_BUTTON && poppler_form_field_button_get_button_type(m->field) == POPPLER_FORM_BUTTON_PUSH) {
+                    generate = m->field;
+                }
+            }
+            g_assert_cmpint(text_fields, ==, round + 1);
+            g_assert_nonnull(generate);
+            poppler_form_field_button_set_state(generate, TRUE);
+            poppler_page_free_form_field_mapping(mapping);
+            g_object_unref(page);
+            PopplerDocument *updated = poppler_document_render_xfa(doc, &err);
+            g_assert_no_error(err);
+            g_object_unref(doc);
+            doc = updated;
+            char *text = page_text(doc);
+            g_assert_nonnull(strstr(text, "Generated World & family"));
+            g_free(text);
+        }
+        g_assert_true(g_file_delete(file, NULL, &err));
+        g_assert_no_error(err);
+        g_object_unref(file);
+        g_free(uri);
+    }
+    g_object_unref(doc);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
     g_test_add_func("/xfa/render", test_render_xfa);
     g_test_add_func("/xfa/saved-radio", test_saved_radio);
+    g_test_add_func("/xfa/saved-scripts", test_saved_scripts);
     return g_test_run();
 }
