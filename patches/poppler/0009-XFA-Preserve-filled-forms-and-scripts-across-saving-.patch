+                const auto result = std::from_chars(id->data(), id->data() + id->size(), serial);
+                XFANode *proto = templateDom.lookup(serial);
+                if (result.ec != std::errc() || result.ptr != id->data() + id->size() || !proto || proto->getClassName() != node->getClassName()) {
+                    valid = false;
+                } else {
+                    node->setProto(proto);
+                }
+                node->removeAttr("poppler:proto");
+            }
+            const std::string ns = node->getAttr("poppler:ns", "0");
+            node->setNamespace(ns == "1" ? XFANode::Namespace::XHTML : ns == "2" ? XFANode::Namespace::Other : XFANode::Namespace::XFA);
+            node->removeAttr("poppler:ns");
+            if (!pageSetInstance && node->getClassName() == "pageSet") {
+                pageSetInstance = node;
+            }
+            for (const auto &child : node->getChildren()) {
+                restore(child.get());
+            }
+        };
+        restore(formModel.get());
+        formRoot = formModel->firstChild("subform");
+        if (!valid || !formRoot || formRoot->getProto() != rootSubform) {
+            *error = "saved XFA state does not match its template";
+            return false;
+        }
