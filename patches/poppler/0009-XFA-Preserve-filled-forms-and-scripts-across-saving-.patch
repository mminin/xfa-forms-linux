+std::string XFAForm::saveState() const
+{
+    // The original template remains unchanged. This engine-specific snapshot
+    // retains repeated instances, presence, rich text and field values, along
+    // with template references needed by instance managers after reopening.
+    std::function<std::string(const XFANode *)> serialize = [&](const XFANode *node) -> std::string {
+        if (node->isText()) {
+            return XFAEscapeXML(node->getText());
+        }
+        std::string xml = "<" + node->getClassName();
+        for (const auto &attr : node->getAttrs()) {
+            xml += " " + attr.first + "=\"" + XFAEscapeXML(attr.second) + "\"";
+        }
+        if (const XFANode *proto = node->getProto(); proto && proto->getDom() == &templateDom) {
+            xml += " poppler:proto=\"" + std::to_string(proto->getSerial()) + "\"";
+        }
+        xml += " poppler:ns=\"" + std::to_string(static_cast<int>(node->getNamespace())) + "\">";
+        for (const auto &child : node->getChildren()) {
+            xml += serialize(child.get());
+        }
+        return xml + "</" + node->getClassName() + ">";
+    };
+    return "<state version=\"1\" language=\"" + XFAEscapeXML(language) + "\" xmlns:poppler=\"https://poppler.freedesktop.org/xfa-state/1\" xmlns:xfa=\"http://www.xfa.org/schema/xfa-data/1.0/\">" + serialize(formModel.get()) + "</state>";
+}
+
+std::string XFAForm::generateSavedPDF()
+{
+    return XFAWritePDF(this, getLayout(), false, false, true);
+}
+
 XFANode *XFAForm::fieldByName(const std::string &fieldName) const
 {
     if (!fieldName.starts_with("xfa")) {
@@ -1651,3 +1729,21 @@ bool XFAForm::clickBySOM(const std::string &som)
     }
     return clickButton("xfa" + std::to_string(node->getSerial()));
 }
+
+bool XFAForm::setValueByFieldName(const std::string &name, const std::string &value)
+{
+    XFANode *node = fieldByName(name);
+    if (!node || (node->getClassName() != "field" && node->getClassName() != "exclGroup")) {
+        logMessage("no exported field " + name);
+        return false;
+    }
+    if (node->getClassName() == "exclGroup") {
+        XFANode *button = node->firstChild("field");
+        if (!button) {
+            logMessage("no button in " + name);
+            return false;
+        }
+        return setButtonState(name, value == "Off" ? "f" + std::to_string(button->getSerial()) : value, value != "Off");
+    }
+    return setValueBySOM(somExpression(node), value);
+}
