+            g_set_error(error, G_FILE_ERROR, g_file_error_from_errno(errsv), "Failed to write XFA form: %s", g_strerror(errsv));
+            return FALSE;
+        }
+        return TRUE;
+    }
     stream = new FileOutStream(file, 0);
     if (include_changes) {
         rv = document->doc->saveAs(stream);
