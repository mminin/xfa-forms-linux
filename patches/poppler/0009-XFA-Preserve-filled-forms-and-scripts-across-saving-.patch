 poppler/XFAForm.cc       | 112 ++++++++++++++++++++++++++++++++++++---
 poppler/XFAForm.h        |   6 +++
 poppler/XFAWriter.cc     |  17 ++++--
 poppler/XFAWriter.h      |   2 +-
 utils/pdfxfa.cc          |  19 ++++---
 7 files changed, 255 insertions(+), 21 deletions(-)

