From 232567232a3cc5bdf7c07523b6a1a13d7c5e1613 Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Mon, 19 Oct 2026 18:20:49 -0700
Subject: [PATCH] XFA: Count all class siblings in anonymous SOM expressions

An unnamed container uses a class selector such as #subform[n], whose index includes named siblings of the same class. Its instance index only counted anonymous siblings, so the generated expression could point elsewhere and fail to resolve back to its own node.

AI-Assistant: OpenAI Codex
AI-Model: gpt-6.1-sol
AI-Reasoning-Effort: high
Co-authored-by: Codex <noreply@openai.com>
---
 poppler/XFAForm.cc | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/poppler/XFAForm.cc b/poppler/XFAForm.cc
index 2dd6fca..4c7c5c4 100644
--- a/poppler/XFAForm.cc
+++ b/poppler/XFAForm.cc
@@ -738,7 +738,22 @@ std::string XFAForm::somExpression(XFANode *node) const
     std::vector<std::string> parts;
     for (XFANode *n = node; n && n != formModel.get(); n = n->getParent()) {
         const std::string name = n->getName();
-        const int index = name.empty() ? instanceIndex(n) : nameIndex(n);
+        int index = nameIndex(n);
+        if (name.empty()) {
+            // A class selector counts named siblings of that class too;
+            // the instance index of an anonymous subform does not.
+            index = 0;
+            if (const XFANode *parent = n->getParent()) {
+                for (const auto &sibling : parent->getChildren()) {
+                    if (sibling.get() == n) {
+                        break;
+                    }
+                    if (sibling->getClassName() == n->getClassName()) {
+                        ++index;
+                    }
+                }
+            }
+        }
         parts.push_back((name.empty() ? "#" + n->getClassName() : name) + "[" + std::to_string(index) + "]");
     }
     std::string som = "xfa[0].form[0]";
