+/* A table of two columns, 1 and 2 inches wide, after a 1 inch margin: the
+ * second row's cell spans both. */
+static const char *table_xdp = "<?xml version=\"1.0\"?>\n"
+                               "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                               "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                               "<subform name=\"form1\" layout=\"tb\">"
+                               "<pageSet><pageArea name=\"Page1\">"
+                               "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                               "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/>"
+                               "</pageArea></pageSet>"
+                               "<subform name=\"Table\" layout=\"table\" columnWidths=\"1in 2in\">"
+                               "<subform name=\"Row1\" layout=\"row\">"
+                               "<field name=\"a\" h=\"0.3in\"><ui><textEdit/></ui><assist><toolTip>a</toolTip></assist></field>"
+                               "<field name=\"b\" h=\"0.5in\"><ui><textEdit/></ui><assist><toolTip>b</toolTip></assist></field>"
+                               "</subform>"
+                               "<subform name=\"Row2\" layout=\"row\">"
+                               "<field name=\"c\" colSpan=\"2\" h=\"0.3in\"><ui><textEdit/></ui><assist><toolTip>c</toolTip></assist></field>"
+                               "</subform>"
+                               "</subform>"
+                               "</subform>"
+                               "</template>"
+                               "</xdp:xdp>";
+
+static void test_table(void)
+{
+    /* x1, x2 and the top, in points from the top left corner */
+    static const struct
+    {
+        const char *name;
+        double x1, x2, top;
+    } expected[] = { { "a", 72, 144, 72 }, { "b", 144, 288, 72 }, { "c", 72, 288, 108 } };
+    GBytes *bytes = build_pdf_from(table_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    PopplerPage *page = poppler_document_get_page(rendered, 0);
+    double width, height;
+    poppler_page_get_size(page, &width, &height);
+    GList *mapping = poppler_page_get_form_field_mapping(page);
+    int found = 0;
+    for (GList *l = mapping; l; l = l->next) {
+        PopplerFormFieldMapping *m = l->data;
+        char *name = poppler_form_field_get_alternate_ui_name(m->field);
+        for (gsize i = 0; i < G_N_ELEMENTS(expected); ++i) {
+            if (g_strcmp0(name, expected[i].name) == 0) {
+                /* The first row is as high as its highest cell. */
+                g_assert_cmpfloat(fabs(m->area.x1 - expected[i].x1), <, 0.5);
+                g_assert_cmpfloat(fabs(m->area.x2 - expected[i].x2), <, 0.5);
+                g_assert_cmpfloat(fabs(height - m->area.y2 - expected[i].top), <, 0.5);
+                ++found;
+            }
+        }
+        g_free(name);
+    }
+    g_assert_cmpint(found, ==, G_N_ELEMENTS(expected));
+    poppler_page_free_form_field_mapping(mapping);
+    g_object_unref(page);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -444,5 +509,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/saved-radio", test_saved_radio);
     g_test_add_func("/xfa/saved-scripts", test_saved_scripts);
     g_test_add_func("/xfa/images", test_images);
+    g_test_add_func("/xfa/table", test_table);
     return g_test_run();
 }
