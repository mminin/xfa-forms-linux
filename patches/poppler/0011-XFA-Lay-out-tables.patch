-void Layouter::measureDraw(Box &b, double availW)
+// Rows place their cells in the columns of columnWidths, other children
+// stack as in "tb". Columns of width -1, and those beyond columnWidths,
+// are as wide as their widest cell.
+void Layouter::measureTable(Box &b, double innerW)
+{
+    std::vector<double> columns;
+    const std::string spec = b.node->getAttr("columnWidths", "");
+    for (size_t i = 0; i < spec.size();) {
+        const size_t end = std::min(spec.find(' ', i), spec.size());
+        if (end > i) {
+            const double w = XFAMeasure(spec.substr(i, end - i), -1);
+            columns.push_back(w < 0 ? -1 : w);
+        }
+        i = end + 1;
+    }
+    for (const auto &c : b.node->getChildren()) {
+        if (isLayoutChild(form, c.get())) {
+            b.children.push_back(measure(c.get(), innerW));
+        }
+    }
+    auto isRow = [](const Box &c) { return c.node->getClassName() == "subform" && (c.layout == "row" || c.layout == "rl-row"); };
+    std::vector<double> natural(columns.size(), 0);
+    for (const Box &row : b.children) {
+        if (!isRow(row)) {
+            continue;
+        }
+        size_t col = 0;
+        for (const Box &cell : row.children) {
+            const int span = std::atoi(cell.node->getAttr("colSpan", "1").c_str());
+            if (col >= columns.size()) {
+                columns.push_back(-1);
+                natural.push_back(0);
+            }
+            if (span == 1) {
+                natural[col] = std::max(natural[col], cell.w);
+            }
+            col = span < 0 ? columns.size() : col + std::max(span, 1);
+        }
+    }
+    for (size_t i = 0; i < columns.size(); ++i) {
+        if (columns[i] < 0) {
+            columns[i] = natural[i];
+        }
+    }
+    for (Box &c : b.children) {
+        if (isRow(c)) {
+            tableColumns = &columns;
+            c = measure(c.node, innerW);
+        }
+    }
+}
+
+// Cells side by side, in the columns of the table if any, all as high as
+// the highest.
+void Layouter::measureRow(Box &b, double innerW, const std::vector<double> *columns, double &contentW, double &contentH)
+{
+    double x = 0;
+    size_t col = 0;
+    for (const auto &c : b.node->getChildren()) {
+        if (!isLayoutChild(form, c.get())) {
+            continue;
+        }
+        std::optional<double> cellW;
+        if (columns && col < columns->size()) {
+            const int span = std::atoi(c->getAttr("colSpan", "1").c_str());
+            const size_t end = span < 0 ? columns->size() : std::min(columns->size(), col + std::max(span, 1));
+            cellW = std::accumulate(columns->begin() + col, columns->begin() + end, 0.0);
+            col = end;
+        }
+        Box cell = measure(c.get(), innerW, cellW);
+        cell.x = x;
+        x += cell.w;
+        contentH = std::max(contentH, cell.h);
+        b.children.push_back(std::move(cell));
+    }
+    contentW = x;
+    for (Box &c : b.children) {
+        c.h = contentH;
+        c.x = b.margin.left + (b.layout == "rl-row" ? contentW - c.x - c.w : c.x);
+        c.y = b.margin.top;
+    }
+}
