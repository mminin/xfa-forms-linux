diff --git a/glib/poppler-document.cc b/glib/poppler-document.cc
index 6c04a6e..54ae812 100644
--- a/glib/poppler-document.cc
+++ b/glib/poppler-document.cc
@@ -2498,6 +2498,62 @@ gchar *poppler_document_xfa_take_focus_request(PopplerDocument *document)
     return requests.empty() ? nullptr : g_strdup(requests.back().text.c_str());
 }
 
+/**
+ * poppler_document_xfa_set_dialog_funcs:
+ * @document: A #PopplerDocument made by poppler_document_render_xfa()
+ * @question_func: (scope notified) (nullable): asks questions, such as
+ *   whether to clear the form
+ * @prompt_func: (scope notified) (nullable): asks for text
+ * @user_data: data to pass to @question_func and @prompt_func
+ * @destroy_notify: (nullable): called on @user_data when the functions
+ *   are replaced or the form goes away
+ *
+ * Sets functions that let the user answer the questions of the scripts of
+ * the XFA form while they run. They must not use @document or the
+ * documents rendered from it. Without them, questions are answered as if
+ * confirmed and reported as messages, and prompts get their default
+ * answer.
+ *
+ * The functions apply to the documents rendered from @document too.
+ *
+ * Since: 26.11
+ **/
+void poppler_document_xfa_set_dialog_funcs(PopplerDocument *document, PopplerXfaQuestionFunc question_func, PopplerXfaPromptFunc prompt_func, gpointer user_data, GDestroyNotify destroy_notify)
+{
+    g_return_if_fail(POPPLER_IS_DOCUMENT(document));
+
+    if (!document->xfa) {
+        if (destroy_notify) {
+            destroy_notify(user_data);
+        }
+        return;
+    }
+    // Owns user_data for as long as either function is in use.
+    auto data = std::shared_ptr<void>(user_data, [destroy_notify](void *p) {
+        if (destroy_notify) {
+            destroy_notify(p);
+        }
+    });
+    XFAForm::HostDialogs dialogs;
+    if (question_func) {
+        dialogs.question = [question_func, data](const std::string &title, const std::string &message, int buttons) {
+            return static_cast<int>(question_func(title.c_str(), message.c_str(), static_cast<PopplerXfaButtons>(buttons), data.get()));
+        };
+    }
+    if (prompt_func) {
+        dialogs.prompt = [prompt_func, data](const std::string &title, const std::string &question, const std::string &defaultAnswer) -> std::optional<std::string> {
+            gchar *answer = prompt_func(title.c_str(), question.c_str(), defaultAnswer.c_str(), data.get());
+            if (!answer) {
+                return std::nullopt;
+            }
+            std::string res(answer);
+            g_free(answer);
+            return res;
+        };
+    }
+    document->xfa->setHostDialogs(std::move(dialogs));
+}
