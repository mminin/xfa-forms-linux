 /**
  * poppler_document_has_javascript:
  * @document: A #PopplerDocument
diff --git a/glib/poppler-document.h b/glib/poppler-document.h
index 175e296..2e67756 100644
--- a/glib/poppler-document.h
+++ b/glib/poppler-document.h
@@ -459,6 +459,77 @@ POPPLER_PUBLIC
 gboolean poppler_document_xfa_take_print_request(PopplerDocument *document, gint *first_page, gint *last_page);
 POPPLER_PUBLIC
 gchar *poppler_document_xfa_take_focus_request(PopplerDocument *document);
+
+/**
+ * PopplerXfaButtons:
+ * @POPPLER_XFA_BUTTONS_OK_CANCEL: OK and Cancel
+ * @POPPLER_XFA_BUTTONS_YES_NO: Yes and No
+ * @POPPLER_XFA_BUTTONS_YES_NO_CANCEL: Yes, No and Cancel
+ *
+ * The buttons of a question asked by the scripts of an XFA form.
+ *
+ * Since: 26.11
+ */
+typedef enum
+{
+    POPPLER_XFA_BUTTONS_OK_CANCEL = 1,
+    POPPLER_XFA_BUTTONS_YES_NO = 2,
+    POPPLER_XFA_BUTTONS_YES_NO_CANCEL = 3
+} PopplerXfaButtons;
+
+/**
+ * PopplerXfaAnswer:
+ * @POPPLER_XFA_ANSWER_OK: OK
+ * @POPPLER_XFA_ANSWER_CANCEL: Cancel, or the question was dismissed
+ * @POPPLER_XFA_ANSWER_NO: No
+ * @POPPLER_XFA_ANSWER_YES: Yes
+ *
+ * The answer to a question asked by the scripts of an XFA form.
+ *
+ * Since: 26.11
+ */
+typedef enum
+{
+    POPPLER_XFA_ANSWER_OK = 1,
+    POPPLER_XFA_ANSWER_CANCEL = 2,
+    POPPLER_XFA_ANSWER_NO = 3,
+    POPPLER_XFA_ANSWER_YES = 4
+} PopplerXfaAnswer;
+
+/**
+ * PopplerXfaQuestionFunc:
+ * @title: the title of the question, may be empty
+ * @message: the question
+ * @buttons: the buttons to answer with
+ * @user_data: the data passed to poppler_document_xfa_set_dialog_funcs()
+ *
+ * Asks the user a question of the scripts of an XFA form, while they wait.
+ *
+ * Returns: the answer
+ *
+ * Since: 26.11
+ */
+typedef PopplerXfaAnswer (*PopplerXfaQuestionFunc)(const gchar *title, const gchar *message, PopplerXfaButtons buttons, gpointer user_data);
+
+/**
+ * PopplerXfaPromptFunc:
+ * @title: the title of the prompt, may be empty
+ * @question: the question
+ * @default_answer: the answer to propose
+ * @user_data: the data passed to poppler_document_xfa_set_dialog_funcs()
+ *
+ * Asks the user to type an answer for the scripts of an XFA form, while
+ * they wait.
+ *
+ * Returns: (transfer full) (nullable): the answer, or %NULL if the user
+ *   cancelled
+ *
+ * Since: 26.11
+ */
+typedef gchar *(*PopplerXfaPromptFunc)(const gchar *title, const gchar *question, const gchar *default_answer, gpointer user_data);
+
+POPPLER_PUBLIC
+void poppler_document_xfa_set_dialog_funcs(PopplerDocument *document, PopplerXfaQuestionFunc question_func, PopplerXfaPromptFunc prompt_func, gpointer user_data, GDestroyNotify destroy_notify);
 /* Javascript */
 POPPLER_PUBLIC
 gboolean poppler_document_has_javascript(PopplerDocument *document);
