diff --git a/glib/tests/check_xfa.c b/glib/tests/check_xfa.c
index 42c8fe5..c0ad4c7 100644
--- a/glib/tests/check_xfa.c
+++ b/glib/tests/check_xfa.c
@@ -969,6 +969,86 @@ static void test_focus(void)
     g_bytes_unref(bytes);
 }
 
+/* Questions and prompts of scripts, answered by the viewer. */
+static const char *dialogs_xdp = "<?xml version=\"1.0\"?>\n"
+                                 "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                                 "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                                 "<subform name=\"form1\" layout=\"tb\">"
+                                 "<pageSet><pageArea name=\"Page1\">"
+                                 "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                                 "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/>"
+                                 "</pageArea></pageSet>"
+                                 "<field name=\"ask\" w=\"2in\" h=\"0.4in\"><ui><button/></ui><assist><toolTip>Ask</toolTip></assist>"
+                                 "<event activity=\"click\"><script contentType=\"application/x-javascript\">"
+                                 "var a = xfa.host.messageBox(\"Clear the form?\", \"Clear\", 2, 2);"
+                                 "out.rawValue = (a == 4 ? \"cleared\" : \"kept\") + \" \" + xfa.host.response(\"Which year?\", \"Year\", \"2024\");"
+                                 "</script></event></field>"
+                                 "<field name=\"out\" w=\"3in\" h=\"0.4in\" access=\"nonInteractive\"><ui><textEdit/></ui></field>"
+                                 "</subform>"
+                                 "</template>"
+                                 "</xdp:xdp>";
+
+static int dialogs_destroyed;
+
+static PopplerXfaAnswer answer_no(const gchar *title, const gchar *message, PopplerXfaButtons buttons, gpointer user_data)
+{
+    g_assert_cmpstr(title, ==, "Clear");
+    g_assert_cmpstr(message, ==, "Clear the form?");
+    g_assert_cmpint(buttons, ==, POPPLER_XFA_BUTTONS_YES_NO);
+    ++*(int *)user_data;
+    return POPPLER_XFA_ANSWER_NO;
+}
+
+static gchar *answer_year(const gchar *title, const gchar *question, const gchar *default_answer, gpointer user_data)
+{
+    g_assert_cmpstr(question, ==, "Which year?");
+    g_assert_cmpstr(default_answer, ==, "2024");
+    ++*(int *)user_data;
+    return g_strdup("2025");
+}
+
+static void count_destroy(gpointer user_data)
+{
+    ++dialogs_destroyed;
+}
+
+static void test_dialogs(void)
+{
+    GBytes *bytes = build_pdf_from(dialogs_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    int asked = 0;
+    dialogs_destroyed = 0;
+    poppler_document_xfa_set_dialog_funcs(rendered, answer_no, answer_year, &asked, count_destroy);
+    PopplerFormField *ask = field_named(rendered, "Ask");
+    g_assert_nonnull(ask);
+    poppler_form_field_button_set_state(ask, TRUE);
+    g_object_unref(ask);
+    if (asked == 0) {
+        g_test_skip("poppler was built without XFA scripting");
+    } else {
+        g_assert_cmpint(asked, ==, 2);
+        PopplerDocument *rerendered = poppler_document_render_xfa(rendered, &err);
+        g_assert_no_error(err);
+        char *text = page_text(rerendered);
+        g_assert_nonnull(strstr(text, "kept 2025"));
+        g_free(text);
+        g_object_unref(rerendered);
+    }
+    /* The question was answered: nothing to report. */
+    gchar **messages = poppler_document_xfa_take_messages(rendered);
+    g_assert_true(messages == NULL || messages[0] == NULL);
+    g_strfreev(messages);
+    poppler_document_xfa_set_dialog_funcs(rendered, NULL, NULL, NULL, NULL);
+    g_assert_cmpint(dialogs_destroyed, ==, 1);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -985,5 +1065,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/pictures", test_pictures);
     g_test_add_func("/xfa/pagination", test_pagination);
     g_test_add_func("/xfa/focus", test_focus);
+    g_test_add_func("/xfa/dialogs", test_dialogs);
     return g_test_run();
 }
diff --git a/poppler/XFAForm.cc b/poppler/XFAForm.cc
index 6021c38..d248d0c 100644
--- a/poppler/XFAForm.cc
+++ b/poppler/XFAForm.cc
@@ -1605,6 +1605,23 @@ void XFAForm::hostMessage(const std::string &title, const std::string &text)
     requests.push_back({ XFAHostRequest::Type::Message, title, text });
 }
 
+int XFAForm::hostQuestion(const std::string &title, const std::string &text, int buttons)
+{
+    if (buttons >= 1 && buttons <= 3 && dialogs.question) {
+        const int answer = dialogs.question(title, text, buttons);
+        if (answer >= 1 && answer <= 4) {
+            return answer;
+        }
+    }
+    hostMessage(title, text);
+    return buttons == 2 || buttons == 3 ? 4 : 1;
+}
+
+std::optional<std::string> XFAForm::hostPrompt(const std::string &title, const std::string &question, const std::string &defaultAnswer)
+{
+    return dialogs.prompt ? dialogs.prompt(title, question, defaultAnswer) : std::optional<std::string>(defaultAnswer);
+}
+
 void XFAForm::hostLaunchURL(const std::string &url)
 {
     requests.push_back({ XFAHostRequest::Type::LaunchURL, {}, url });
diff --git a/poppler/XFAForm.h b/poppler/XFAForm.h
index 1e66508..8b18c0e 100644
--- a/poppler/XFAForm.h
+++ b/poppler/XFAForm.h
@@ -205,8 +205,24 @@ public:
     int pageCount();
     std::vector<XFANode *> pageContent(int pageIndex, const std::string &cls, bool pageAreaOnly);
 
+    // Dialogs the viewer answers while scripts run, when it provides them:
+    // message boxes asking a question, with buttons as in Acrobat (1 OK and
+    // Cancel, 2 Yes and No, 3 Yes, No and Cancel), answered 1 OK, 2 Cancel,
+    // 3 No or 4 Yes; and prompts, answered with text or nothing for Cancel.
+    // The viewer must not use the form while answering.
+    struct HostDialogs
+    {
+        std::function<int(const std::string &title, const std::string &message, int buttons)> question;
+        std::function<std::optional<std::string>(const std::string &title, const std::string &question, const std::string &defaultAnswer)> prompt;
+    };
+    void setHostDialogs(HostDialogs d) { dialogs = std::move(d); }
+
     // Host interface for scripts.
     void hostMessage(const std::string &title, const std::string &text);
+    // A message box: with buttons 0, a message; else a question, answered
+    // as if confirmed when the viewer cannot ask.
+    int hostQuestion(const std::string &title, const std::string &text, int buttons);
+    std::optional<std::string> hostPrompt(const std::string &title, const std::string &question, const std::string &defaultAnswer);
     void hostLaunchURL(const std::string &url);
     void hostPrint(int firstPage, int lastPage);
     void hostFocus(XFANode *field);
@@ -262,6 +278,7 @@ private:
     bool remergePending = false;
     bool settingGlobal = false;
     std::map<std::string, std::optional<std::string>> formCalcCache; // FormCalc source -> JavaScript
+    HostDialogs dialogs;
 };
 
