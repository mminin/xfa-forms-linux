 } PopplerPDFConformance;
 
+/**
+ * PopplerFormType:
+ * @POPPLER_FORM_TYPE_NONE: the document has no interactive form
+ * @POPPLER_FORM_TYPE_ACROFORM: the document has an AcroForm
+ * @POPPLER_FORM_TYPE_XFA: the document has an XFA form. Only its AcroForm
+ *   fallback, if any, is rendered; see poppler_document_get_needs_rendering()
+ *
+ * Interactive form technology used by a document
+ *
+ * Since: 26.11
+ */
+typedef enum
+{
+    POPPLER_FORM_TYPE_NONE,
+    POPPLER_FORM_TYPE_ACROFORM,
+    POPPLER_FORM_TYPE_XFA
+} PopplerFormType;
+
