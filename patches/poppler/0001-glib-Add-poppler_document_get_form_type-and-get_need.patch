+bool Catalog::getNeedsRendering()
+{
+    Object catDict = xref->getCatalog();
+    if (!catDict.isDict()) {
+        return false;
+    }
+
+    Object obj = catDict.dictLookup("NeedsRendering");
+    return obj.isBool() && obj.getBool();
+}
+
 Form *Catalog::getCreateForm()
 {
     catalogLocker();
