From 567281834ea050349b82d957bdf07f6dbf6d142b Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Tue, 13 Oct 2026 13:53:39 -0700
Subject: [PATCH 1/9] glib: Add poppler_document_get_form_type() and
 get_needs_rendering()

Expose Catalog::getFormType() to glib users, as the Qt6 frontend already
does with Document::formType(), and add Catalog::getNeedsRendering() for
the catalog's NeedsRendering entry.

Together they let viewers recognise dynamic XFA forms. Poppler can't
render those, so their pages only show a "requires Adobe Reader" stub,
and viewers can now tell the user why instead of showing it silently.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 glib/poppler-document.cc            | 60 +++++++++++++++++++++++++++++
 glib/poppler-document.h             | 22 +++++++++++
 glib/reference/poppler-sections.txt |  5 +++
 glib/reference/poppler.types        |  1 +
 poppler/Catalog.cc                  | 11 ++++++
 poppler/Catalog.h                   |  3 ++
 6 files changed, 102 insertions(+)

diff --git a/glib/poppler-document.cc b/glib/poppler-document.cc
index e4184b1..d2635db 100644
--- a/glib/poppler-document.cc
+++ b/glib/poppler-document.cc
@@ -2213,6 +2213,66 @@ void poppler_document_reset_form(PopplerDocument *document, GList *fields, gbool
     }
 }
 
+/**
+ * poppler_document_get_form_type:
+ * @document: A #PopplerDocument
+ *
+ * Returns which interactive form technology @document uses.
+ *
+ * Return value: a #PopplerFormType
+ *
+ * Since: 26.11
+ **/
+PopplerFormType poppler_document_get_form_type(PopplerDocument *document)
+{
+    Catalog *catalog;
+
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), POPPLER_FORM_TYPE_NONE);
+
+    catalog = document->doc->getCatalog();
+    if (!catalog || !catalog->isOk()) {
+        return POPPLER_FORM_TYPE_NONE;
+    }
+
+    switch (catalog->getFormType()) {
+    case Catalog::NoForm:
+        return POPPLER_FORM_TYPE_NONE;
+    case Catalog::AcroForm:
+        return POPPLER_FORM_TYPE_ACROFORM;
+    case Catalog::XfaForm:
+        return POPPLER_FORM_TYPE_XFA;
+    }
+
+    return POPPLER_FORM_TYPE_NONE;
+}
+
+/**
+ * poppler_document_get_needs_rendering:
+ * @document: A #PopplerDocument
+ *
+ * Returns the value of the NeedsRendering entry of the document catalog.
+ * It is %TRUE for dynamic XFA forms, whose pages are generated from the XFA
+ * template by the viewer. Poppler does not do that, so the pages it renders
+ * for such documents usually only hold a "please use Adobe Reader" message.
+ *
+ * Return value: %TRUE if the document needs its pages generated from XFA
+ *
+ * Since: 26.11
+ **/
+gboolean poppler_document_get_needs_rendering(PopplerDocument *document)
+{
+    Catalog *catalog;
+
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), FALSE);
+
+    catalog = document->doc->getCatalog();
+    if (!catalog || !catalog->isOk()) {
+        return FALSE;
+    }
+
+    return catalog->getNeedsRendering();
+}
+
 /**
  * poppler_document_has_javascript:
  * @document: A #PopplerDocument
diff --git a/glib/poppler-document.h b/glib/poppler-document.h
