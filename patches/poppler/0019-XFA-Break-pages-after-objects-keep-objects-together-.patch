+/* Pagination: a page break after A, a title kept with the section after
+ * it, and a table repeating its header row on each page. The first page
+ * area holds 4 inches, the second, for the table's overflow, 9. */
+#define TEXT_DRAW(h, text) "<draw w=\"6in\" h=\"" h "\"><value><text>" text "</text></value></draw>"
+static const char *pagination_xdp =
+        "<?xml version=\"1.0\"?>\n"
+        "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+        "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+        "<subform name=\"form1\" layout=\"tb\">"
+        "<pageSet><pageArea name=\"P1\"><contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"4in\"/>"
+        "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/></pageArea>"
+        "<pageArea name=\"P2\"><contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+        "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/></pageArea></pageSet>"
+        "<subform name=\"A\" layout=\"tb\">" TEXT_DRAW(
+                "1in", "Section A") "<breakAfter targetType=\"pageArea\"/></subform>"
+                                    "<subform name=\"B\" layout=\"tb\">" TEXT_DRAW(
+                                            "1in",
+                                            "Section B") "</subform>"
+                                                         "<subform name=\"Title\" layout=\"tb\"><keep next=\"contentArea\"/>" TEXT_DRAW(
+                                                                 "0.5in",
+                                                                 "Title of C") "</subform>"
+                                                                               "<subform name=\"C\" layout=\"tb\"><keep intact=\"contentArea\"/>" TEXT_DRAW(
+                                                                                       "2.6in",
+                                                                                       "Section C") "</subform>"
+                                                                                                    "<subform name=\"T\" layout=\"table\" columnWidths=\"2in 2in\"><overflow leader=\"HeaderRow\" target=\"P2\"/>"
+                                                                                                    "<subform name=\"HeaderRow\" layout=\"row\"><draw h=\"0.3in\"><value><text>Head</text></value></draw></subform>"
+                                                                                                    "<subform name=\"Row\" layout=\"row\"><occur min=\"30\" max=\"30\"/><draw h=\"0.3in\"><value><text>cell</text></value></draw></subform>"
+                                                                                                    "</subform>"
+                                                                                                    "</subform>"
+                                                                                                    "</template>"
+                                                                                                    "</xdp:xdp>";
+
+static int count_of(const char *text, const char *word)
+{
+    int n = 0;
+    for (const char *p = strstr(text, word); p; p = strstr(p + 1, word)) {
+        ++n;
+    }
+    return n;
+}
+
+static void test_pagination(void)
+{
+    GBytes *bytes = build_pdf_from(pagination_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    g_assert_cmpint(poppler_document_get_n_pages(rendered), ==, 4);
+    char *texts[4];
+    for (int i = 0; i < 4; ++i) {
+        PopplerPage *page = poppler_document_get_page(rendered, i);
+        texts[i] = poppler_page_get_text(page);
+        g_object_unref(page);
+    }
+    g_assert_nonnull(strstr(texts[0], "Section A"));
+    g_assert_null(strstr(texts[0], "Section B"));
+    g_assert_null(strstr(texts[1], "Title of C"));
+    g_assert_nonnull(strstr(texts[2], "Title of C"));
+    g_assert_nonnull(strstr(texts[2], "Section C"));
+    g_assert_cmpint(count_of(texts[2], "Head"), ==, 1);
+    g_assert_cmpint(count_of(texts[3], "Head"), ==, 1);
+    g_assert_cmpint(count_of(texts[2], "cell") + count_of(texts[3], "cell"), ==, 30);
+    /* The table continues on the larger page area. */
+    g_assert_cmpint(count_of(texts[3], "cell"), >, 12);
+    for (int i = 0; i < 4; ++i) {
+        g_free(texts[i]);
+    }
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -860,5 +934,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/formcalc", test_formcalc);
     g_test_add_func("/xfa/barcode", test_barcode);
     g_test_add_func("/xfa/pictures", test_pictures);
+    g_test_add_func("/xfa/pagination", test_pagination);
     return g_test_run();
 }
