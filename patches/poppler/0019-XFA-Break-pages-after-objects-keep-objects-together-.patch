+            if (!brk.set && c.hasBreakAfter()) {
+                brk.set = true;
+                brk.target = c.breakAfterTarget;
+                brk.startNew = c.breakAfterStartNew;
+            }
             if (brk.set) {
                 ++i;
                 stopped = true;
@@ -723,6 +817,17 @@ Fit Layouter::splitFlow(Box &box, double avail, bool pageHasContent, Box &head,
             placed.push_back(std::move(p));
             continue;
         }
+        // Objects kept with this one move along to the next page, unless
+        // that would leave this page empty for nothing.
+        size_t kept = 0;
+        while (kept < placed.size() && (placed[placed.size() - 1 - kept].keepNext || box.children[i - kept].keepPrevious)) {
+            ++kept;
+        }
+        if (kept && (pageHasContent || kept < placed.size())) {
+            placed.resize(placed.size() - kept);
+            i -= kept;
+            used = placed.empty() ? (box.hasStart ? box.margin.top : 0) : placed.back().y + placed.back().h;
+        }
         stopped = true;
         break;
     }
@@ -761,11 +866,20 @@ const XFANode *Layouter::findPageArea(const std::string &target) const
     if (target.empty() || target == "#next") {
         return nullptr;
     }
-    const std::string t = target.starts_with("#") ? target.substr(1) : target;
-    for (const XFANode *a : pageAreas) {
-        if (a->getName() == t || a->getAttr("id", "") == t) {
-            return a;
+    // A name or id, or a SOM expression such as "Page2.#contentArea".
+    size_t start = 0;
+    while (start <= target.size()) {
+        const size_t dot = std::min(target.find('.', start), target.size());
+        std::string t = target.substr(start, dot - start);
+        if (t.starts_with("#")) {
+            t.erase(0, 1);
+        }
+        for (const XFANode *a : pageAreas) {
+            if (a->getName() == t || a->getAttr("id", "") == t) {
+                return a;
+            }
         }
+        start = dot + 1;
     }
     return nullptr;
 }
