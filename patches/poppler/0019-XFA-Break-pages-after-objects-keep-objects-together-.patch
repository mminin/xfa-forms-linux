@@ -297,9 +308,35 @@ Box Layouter::measure(XFANode *node, double availW, std::optional<double> forced
             b.breakStartNew = br->getAttr("startNew", "0") == "1";
         }
     }
+    if (const XFANode *ba = node->firstChild("breakAfter")) {
+        const std::string type = ba->getAttr("targetType", "auto");
+        if (type == "pageArea" || type == "contentArea") {
+            b.breakAfterTarget = ba->getAttr("target", "");
+            if (b.breakAfterTarget.empty()) {
+                b.breakAfterTarget = "#next";
+            }
+            b.breakAfterStartNew = ba->getAttr("startNew", "0") == "1";
+        }
+    } else if (const XFANode *br = node->firstChild("break")) {
+        const std::string after = br->getAttr("after", "auto");
+        if (after == "pageArea" || after == "contentArea" || after == "pageEven" || after == "pageOdd") {
+            b.breakAfterTarget = br->getAttr("afterTarget", "");
+            if (b.breakAfterTarget.empty()) {
+                b.breakAfterTarget = "#next";
+            }
+            b.breakAfterStartNew = br->getAttr("startNew", "0") == "1";
+        }
+    }
     if (const XFANode *keep = node->firstChild("keep")) {
         const std::string intact = keep->getAttr("intact", "none");
         b.keepIntact = intact == "contentArea" || intact == "pageArea";
+        const std::string next = keep->getAttr("next", "none"), previous = keep->getAttr("previous", "none");
+        b.keepNext = next == "contentArea" || next == "pageArea";
+        b.keepPrevious = previous == "contentArea" || previous == "pageArea";
+    }
+    if (const XFANode *overflow = node->firstChild("overflow")) {
+        b.overflowLeader = overflow->getAttr("leader", "");
+        b.overflowTarget = overflow->getAttr("target", "");
     }
     return b;
 }
@@ -590,7 +627,54 @@ Fit Layouter::split(Box &box, double avail, bool pageHasContent, Box &head, Box
     if (box.h <= avail + eps && !box.containsBreak()) {
         return Fit::All;
     }
-    return splitFlow(box, avail, pageHasContent, head, tail, brk);
+    const Fit f = splitFlow(box, avail, pageHasContent, head, tail, brk);
+    if (f == Fit::Some) {
+        // A header row alone at the bottom of a page moves with the rest.
+        if (pageHasContent && !head.children.empty() && std::ranges::all_of(head.children, [&](const Box &c) { return isOverflowLeader(box, c); })) {
+            return Fit::None;
+        }
+        addOverflowLeader(box, tail);
+        if (!box.overflowTarget.empty() && !brk.set) {
+            brk.set = true;
+            brk.target = box.overflowTarget;
+            brk.startNew = false;
+        }
+    }
+    return f;
+}
+
+// Whether child is the overflow leader of box, named by its overflow
+// element as "HeaderRow", "#id" or a SOM expression ending with the name.
+bool Layouter::isOverflowLeader(const Box &box, const Box &child)
+{
+    std::string name = box.overflowLeader;
+    if (const size_t dot = name.rfind('.'); dot != std::string::npos) {
+        name.erase(0, dot + 1);
+    }
+    if (const size_t bracket = name.find('['); bracket != std::string::npos) {
+        name.resize(bracket);
+    }
+    if (name.starts_with("#")) {
+        return child.node->getAttr("id", "") == name.substr(1);
+    }
+    return !name.empty() && child.node->getName() == name;
+}
+
+// The overflow leader of a split box, such as the header row of a table,
+// goes again at the top of the rest.
+void Layouter::addOverflowLeader(const Box &box, Box &tail)
+{
+    const auto leader = std::ranges::find_if(box.children, [&box](const Box &c) { return isOverflowLeader(box, c); });
+    if (leader == box.children.end() || (!tail.children.empty() && tail.children.front().node == leader->node)) {
+        return;
+    }
+    Box copy = *leader;
+    copy.y = 0;
+    for (Box &c : tail.children) {
+        c.y += copy.h;
+    }
+    tail.h += copy.h;
+    tail.children.insert(tail.children.begin(), std::move(copy));
 }
 
 Fit Layouter::splitText(Box &box, double avail, Box &head, Box &tail)
