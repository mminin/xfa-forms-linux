From 159ac2156abe12eb21551aeb91a7f06b3ed731e1 Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Mon, 19 Oct 2026 12:16:48 -0700
Subject: [PATCH] XFA: Compute image sizes in floating point

The natural size of an image was computed as width * 72 in int before
dividing by the resolution. Decoded images may be up to 2^26 pixels wide,
so that product could overflow. Multiply by 72.0 instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 poppler/XFAWriter.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/poppler/XFAWriter.cc b/poppler/XFAWriter.cc
index 40c098d..6f7c797 100644
--- a/poppler/XFAWriter.cc
+++ b/poppler/XFAWriter.cc
@@ -471,7 +471,7 @@ void Writer::drawImage(const XFANode *imageNode, double x, double y, double w, d
                                             img->smask));
             }
             // Without a resolution, pixels are taken to be screen pixels at 96 per inch.
-            io = ImageObject { pdf.addStream(dict, img->data), "Im" + std::to_string(imageCache.size()), img->width * 72 / (img->dpiX > 0 ? img->dpiX : 96), img->height * 72 / (img->dpiY > 0 ? img->dpiY : 96) };
+            io = ImageObject { pdf.addStream(dict, img->data), "Im" + std::to_string(imageCache.size()), img->width * 72.0 / (img->dpiX > 0 ? img->dpiX : 96), img->height * 72.0 / (img->dpiY > 0 ? img->dpiY : 96) };
         } else {
             form->logMessage("unsupported image " + imageNode->getAttr("contentType", "?"));
         }
