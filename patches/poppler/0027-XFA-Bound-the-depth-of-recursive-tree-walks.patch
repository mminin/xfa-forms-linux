diff --git a/poppler/XFALayout.cc b/poppler/XFALayout.cc
index 0302127..2671f46 100644
--- a/poppler/XFALayout.cc
+++ b/poppler/XFALayout.cc
@@ -260,10 +260,13 @@ private:
     const XFANode *nextPageArea() const;
     void newPage(const XFANode *area);
     void dropEmptyPage();
-    void place(const Box &b, double px, double py, XFALayoutPage &page, int pageIndex);
+    void place(const Box &b, double px, double py, XFALayoutPage &page, int pageIndex, int depth = 0);
 
     XFAForm *form;
     XFALayoutResult result;
+    // Measuring recurses with the node tree; a script can build that tree
+    // arbitrarily deep, so the recursion is bounded rather than the input.
+    int measureDepth = 0;
     std::vector<const XFANode *> pageAreas;
     std::map<const XFANode *, int> areaUses;
     std::optional<PageState> page;
@@ -279,6 +282,17 @@ Box Layouter::measure(XFANode *node, double availW, std::optional<double> forced
 {
     Box b;
     b.node = node;
+    // Stop descending past the depth limit, leaving an empty box. Only a tree
+    // a script has nested abnormally deep ever reaches this.
+    if (measureDepth >= XFANodeMaxDepth) {
+        return b;
+    }
+    struct DepthGuard
+    {
+        int &d;
+        explicit DepthGuard(int &x) : d(x) { ++d; }
+        ~DepthGuard() { --d; }
+    } guard(measureDepth);
     b.margin = XFAMarginOf(node);
     const std::string &cls = node->getClassName();
     if (cls == "draw") {
@@ -990,11 +1004,14 @@ void Layouter::dropEmptyPage()
     }
 }
 
-void Layouter::place(const Box &b, double px, double py, XFALayoutPage &lp, int pageIndex)
+void Layouter::place(const Box &b, double px, double py, XFALayoutPage &lp, int pageIndex, int depth)
 {
+    if (depth >= XFANodeMaxDepth) {
+        return;
+    }
     if (b.fragmentRow) {
         for (const Box &c : b.children) {
-            place(c, px + c.x, py + c.y, lp, pageIndex);
+            place(c, px + c.x, py + c.y, lp, pageIndex, depth + 1);
         }
         return;
     }
@@ -1011,7 +1028,7 @@ void Layouter::place(const Box &b, double px, double py, XFALayoutPage &lp, int
     lp.items.push_back(item);
     result.pageOfNode.emplace(b.node->getSerial(), pageIndex);
     for (const Box &c : b.children) {
-        place(c, px + c.x, py + c.y, lp, pageIndex);
+        place(c, px + c.x, py + c.y, lp, pageIndex, depth + 1);
     }
 }
 
diff --git a/poppler/XFANode.cc b/poppler/XFANode.cc
index fe13349..2ecebb2 100644
--- a/poppler/XFANode.cc
+++ b/poppler/XFANode.cc
@@ -193,15 +193,17 @@ bool XFANode::isContainer() const
     return ns == Namespace::XFA && std::ranges::any_of(containers, [this](const char *c) { return className == c; });
 }
 
-std::unique_ptr<XFANode> XFANode::clone(XFADom *targetDom) const
+std::unique_ptr<XFANode> XFANode::clone(XFADom *targetDom, int depth) const
 {
     auto copy = std::make_unique<XFANode>(targetDom, className);
     copy->ns = ns;
     copy->text = text;
     copy->attributes = attributes;
     copy->proto = proto ? proto : this;
-    for (const auto &c : children) {
-        copy->appendChild(c->clone(targetDom));
+    if (depth < XFANodeMaxDepth) {
+        for (const auto &c : children) {
+            copy->appendChild(c->clone(targetDom, depth + 1));
+        }
     }
     return copy;
 }
@@ -231,7 +233,7 @@ std::string XFAEscapeXML(const std::string &s)
     return res;
 }
 
-std::string XFANode::toXML() const
+std::string XFANode::toXML(int depth) const
 {
     if (isText()) {
         return XFAEscapeXML(text);
@@ -240,12 +242,15 @@ std::string XFANode::toXML() const
     for (const auto &a : attributes) {
         res += " " + a.first + "=\"" + XFAEscapeXML(a.second) + "\"";
     }
-    if (children.empty()) {
+    // Past the depth limit the node is serialized without its descendants.
+    // The result stays well-formed, only truncated, which only affects trees
+    // a script has nested abnormally deep.
+    if (children.empty() || depth >= XFANodeMaxDepth) {
         return res + "/>";
     }
     res += ">";
     for (const auto &c : children) {
-        res += c->toXML();
+        res += c->toXML(depth + 1);
     }
     return res + "</" + className + ">";
 }
diff --git a/poppler/XFANode.h b/poppler/XFANode.h
index 1de3a7d..8fd5bd8 100644
--- a/poppler/XFANode.h
+++ b/poppler/XFANode.h
@@ -40,6 +40,14 @@ private:
     int nextSerial = 1;
 };
 
+// Recursive walks over a node tree (serialization, cloning, layout, data
+// merging) are bounded to this depth. The XML parser refuses input nested
+// deeper than 256, but scripts build nodes one at a time and can bypass that,
+// so the walks guard themselves rather than trust the tree's shape. The limit
+// is far above any real form and far below the call depth that overflows the
+// stack.
+inline constexpr int XFANodeMaxDepth = 500;
+
 // A node of an XFA template, form or rich text DOM. Elements and character
 // data share this class; character data nodes have the class name "#text".
 class XFANode
@@ -106,10 +114,10 @@ public:
 
     // Deep copy into dom. Form nodes made from template nodes remember the
     // template node as their proto.
-    std::unique_ptr<XFANode> clone(XFADom *targetDom) const;
+    std::unique_ptr<XFANode> clone(XFADom *targetDom, int depth = 0) const;
 
     // Serializes this node and its descendants as XML.
-    std::string toXML() const;
+    std::string toXML(int depth = 0) const;
 
 private:
     XFADom *dom;
