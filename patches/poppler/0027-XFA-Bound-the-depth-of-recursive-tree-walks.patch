--- a/poppler/XFAForm.cc
+++ b/poppler/XFAForm.cc
@@ -244,8 +244,11 @@ bool isTransparent(const XFANode *n)
     return n->getNamespace() == XFANode::Namespace::XFA && (c == "area" || ((c == "subform" || c == "subformSet") && n->getName().empty()));
 }
 
-void collectNamed(const XFANode *node, const std::string &name, std::vector<XFANode *> &out)
+void collectNamed(const XFANode *node, const std::string &name, std::vector<XFANode *> &out, int depth = 0)
 {
+    if (depth >= XFANodeMaxDepth) {
+        return;
+    }
     for (const auto &c : node->getChildren()) {
         if (c->isText()) {
             continue;
@@ -254,7 +257,7 @@ void collectNamed(const XFANode *node, const std::string &name, std::vector<XFAN
         if (n && *n == name) {
             out.push_back(c.get());
         } else if (isTransparent(c.get())) {
-            collectNamed(c.get(), name, out);
+            collectNamed(c.get(), name, out, depth + 1);
         }
     }
 }
@@ -391,8 +394,8 @@ std::string XFAForm::scriptSource(const XFANode *s, bool *runnable)
 // Loading
 //------------------------------------------------------------------------
 
-static void mergeData(XFAForm *form, XFANode *node, const XFANode *data, bool skipEmpty);
-static void markData(XFANode *node);
+static void mergeData(XFAForm *form, XFANode *node, const XFANode *data, bool skipEmpty, int depth = 0);
+static void markData(XFANode *node, int depth = 0);
 
 XFAForm::XFAForm() = default;
 
@@ -1711,8 +1714,11 @@ static bool bindsData(const XFANode *n)
     return !bind || bind->getAttr("match", "once") != "none";
 }
 
-static void saveDataInto(const XFAForm *form, XFANode *node, std::string &out)
+static void saveDataInto(const XFAForm *form, XFANode *node, std::string &out, int depth = 0)
 {
+    if (depth >= XFANodeMaxDepth) {
+        return;
+    }
     for (const auto &c : node->getChildren()) {
         if (c->isText() || !c->isContainer()) {
             continue;
@@ -1729,10 +1735,10 @@ static void saveDataInto(const XFAForm *form, XFANode *node, std::string &out)
             const std::optional<std::string> v = form->getRawValue(c.get());
             out += "<" + name + ">" + XFAEscapeXML(v.value_or("")) + "</" + name + ">";
         } else if (name.empty()) {
-            saveDataInto(form, c.get(), out);
+            saveDataInto(form, c.get(), out, depth + 1);
         } else {
             out += "<" + name + ">";
-            saveDataInto(form, c.get(), out);
+            saveDataInto(form, c.get(), out, depth + 1);
             out += "</" + name + ">";
         }
     }
@@ -1765,8 +1771,11 @@ void XFAForm::loadData(const std::string &xml, bool ignoreRoot, bool /*overwrite
 
 // Values of matching names in data go into the fields of node. With
 // skipEmpty, empty data values leave the fields' default values.
-static void mergeData(XFAForm *form, XFANode *node, const XFANode *data, bool skipEmpty)
+static void mergeData(XFAForm *form, XFANode *node, const XFANode *data, bool skipEmpty, int depth)
 {
+    if (depth >= XFANodeMaxDepth) {
+        return;
+    }
     std::map<std::string, int> seen;
     for (const auto &c : node->getChildren()) {
         if (c->isText() || !c->isContainer() || c->getClassName() == "draw" || !bindsData(c.get())) {
@@ -1774,7 +1783,7 @@ static void mergeData(XFAForm *form, XFANode *node, const XFANode *data, bool sk
         }
         const std::string name = c->getName();
         if (name.empty()) {
-            mergeData(form, c.get(), data, skipEmpty);
+            mergeData(form, c.get(), data, skipEmpty, depth + 1);
             continue;
         }
         const int index = seen[name]++;
@@ -1795,7 +1804,7 @@ static void mergeData(XFAForm *form, XFANode *node, const XFANode *data, bool sk
                 form->setRawValue(c.get(), v.empty() ? std::nullopt : std::optional<std::string>(v));
             }
         } else {
-            mergeData(form, c.get(), match, skipEmpty);
+            mergeData(form, c.get(), match, skipEmpty, depth + 1);
         }
     }
 }
@@ -1819,11 +1828,14 @@ void XFAForm::applyPendingData(XFANode *node)
     mergeData(this, node, match ? match : data.get(), false);
 }
 
-static void markData(XFANode *node)
+static void markData(XFANode *node, int depth)
 {
     node->setNamespace(XFANode::Namespace::Data);
+    if (depth >= XFANodeMaxDepth) {
+        return;
+    }
     for (const auto &c : node->getChildren()) {
-        markData(c.get());
+        markData(c.get(), depth + 1);
     }
 }
 
@@ -1881,8 +1893,11 @@ void XFAForm::doRemerge()
 // Viewer interface
 //------------------------------------------------------------------------
 
-void XFAForm::collectFieldValues(XFANode *node, std::vector<std::pair<int, std::string>> &values) const
+void XFAForm::collectFieldValues(XFANode *node, std::vector<std::pair<int, std::string>> &values, int depth) const
 {
+    if (depth >= XFANodeMaxDepth) {
+        return;
+    }
     for (const auto &c : node->getChildren()) {
         if (c->isText() || !c->isContainer()) {
             continue;
@@ -1892,7 +1907,7 @@ void XFAForm::collectFieldValues(XFANode *node, std::vector<std::pair<int, std::
             values.emplace_back(c->getSerial(), v ? "=" + *v : std::string("null"));
         }
         if (c->getClassName() != "field") {
-            collectFieldValues(c.get(), values);
+            collectFieldValues(c.get(), values, depth + 1);
         }
     }
 }
