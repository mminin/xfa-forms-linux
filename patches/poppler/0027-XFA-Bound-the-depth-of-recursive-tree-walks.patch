From 4bff8669f01384d3ecf823a92fa1d0386632de2f Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Mon, 19 Oct 2026 10:55:30 -0700
Subject: [PATCH] XFA: Bound the depth of recursive tree walks

The XML parser refuses input nested deeper than 256, but scripts build
nodes one at a time and can assemble a tree far deeper than that. The
recursive walks over a node tree -- serialization, cloning, data merging,
SOM name resolution, state capture and layout -- then overflow the stack.
A docReady script that builds a chain some tens of thousands deep and
calls saveXML() or relayout() crashes the viewer when the form opens, with
no user interaction.

Bound each walk to XFANodeMaxDepth (500) rather than trusting the tree's
shape: past the limit serialization truncates (staying well-formed) and
layout stops descending. The limit is far above any real form and far
below the call depth that overflows the stack. A glib test checks that a
2000-deep script tree serializes to the bounded size, and the qa suite
checks that building and saving a deep tree under a small stack does not
crash.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 glib/tests/check_xfa.c | 39 ++++++++++++++++++++++++++++++++++++++
 poppler/XFAForm.cc     | 43 ++++++++++++++++++++++++++++--------------
 poppler/XFAForm.h      |  2 +-
 poppler/XFALayout.cc   | 25 ++++++++++++++++++++----
 poppler/XFANode.cc     | 17 +++++++++++------
 poppler/XFANode.h      | 12 ++++++++++--
 6 files changed, 111 insertions(+), 27 deletions(-)

diff --git a/glib/tests/check_xfa.c b/glib/tests/check_xfa.c
index fd5ffc5..e4700fd 100644
--- a/glib/tests/check_xfa.c
+++ b/glib/tests/check_xfa.c
@@ -1175,6 +1175,44 @@ static void test_default_ui(void)
     g_bytes_unref(bytes);
 }
 
+/* A script builds a data tree far deeper than the parser's limit and then
+ * serializes it. The recursive walkers cap their own depth, so the save is
+ * truncated rather than overflowing the stack: a 2000-deep chain serializes
+ * to the same bounded size as the ~500-node cap, well under what the whole
+ * chain would produce. */
+static void test_deep_script_tree(void)
+{
+    const char *xml = "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                      "<subform name=\"form1\" layout=\"tb\"><pageSet><pageArea name=\"Page1\">"
+                      "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                      "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/></pageArea></pageSet>"
+                      "<field name=\"out\" w=\"6in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui>"
+                      "<event activity=\"initialize\"><script contentType=\"application/x-javascript\">"
+                      "var root = xfa.datasets.createNode(\"dataGroup\", \"deep\"); var cur = root;"
+                      "for (var i = 0; i != 2000; i = i + 1) {"
+                      "  var c = xfa.datasets.createNode(\"dataGroup\", \"n\"); cur.nodes.append(c); cur = c; }"
+                      "var len = root.saveXML().length;"
+                      "this.rawValue = (len > 30000) ? (\"DEEPBAD\" + len) : \"DEEPOK\";"
+                      "</script></event></field></subform></template>";
+    GBytes *bytes = build_pdf_from(xml);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    g_assert_nonnull(rendered);
+    char *text = page_text(rendered);
+    if (!strstr(text, "DEEP")) {
+        g_test_skip("poppler was built without XFA scripting");
+    } else {
+        g_assert_nonnull(strstr(text, "DEEPOK"));
+    }
+    g_free(text);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -1195,5 +1233,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/xml-depth", test_xml_depth);
     g_test_add_func("/xfa/invalid-state-type", test_invalid_state_type);
     g_test_add_func("/xfa/default-ui", test_default_ui);
+    g_test_add_func("/xfa/deep-script-tree", test_deep_script_tree);
     return g_test_run();
 }
