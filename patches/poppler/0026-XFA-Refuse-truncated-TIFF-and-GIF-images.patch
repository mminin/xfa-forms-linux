From b8e7778e28622ade971a52fa9778faea9f6d6b67 Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Sun, 18 Oct 2026 19:13:33 -0700
Subject: [PATCH] XFA: Refuse truncated TIFF and GIF images

Missing image data was padded, so a file of a few dozen bytes could
claim up to 64 megapixels and take seconds and hundreds of megabytes
to decode. Refuse such images, as PNG already does. Also look up TIFF
palettes once rather than for every pixel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 poppler/XFAImage.cc | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/poppler/XFAImage.cc b/poppler/XFAImage.cc
index 8a4e72d..cf98aab 100644
--- a/poppler/XFAImage.cc
+++ b/poppler/XFAImage.cc
@@ -447,7 +447,11 @@ bool decodeGIF(const std::string &d, XFAImage &img)
                 prev = code;
             }
         }
-        indices.resize(static_cast<size_t>(w) * h, static_cast<unsigned char>(transparent >= 0 ? transparent : 0));
+        // Truncated images are refused, as by PNG and TIFF.
+        if (indices.size() < static_cast<size_t>(w) * h) {
+            return false;
+        }
+        indices.resize(static_cast<size_t>(w) * h);
         if (interlaced) {
             std::vector<unsigned char> rows(indices.size());
             int src = 0;
@@ -739,7 +743,12 @@ bool decodeTIFF(const std::string &d, XFAImage &img)
         }
         const std::string in = d.substr(offset, length);
         std::string strip = compression == 1 ? in : compression == 5 ? tiffLZW(in, stripBytes) : compression == 32773 ? packBits(in, stripBytes) : inflateData(in, stripBytes);
-        strip.resize(stripBytes, '\0');
+        // Truncated strips are refused, as by PNG, so that a small file
+        // cannot claim a large image.
+        if (strip.size() < stripBytes) {
+            return false;
+        }
+        strip.resize(stripBytes);
         if (predictor == 2 && depth == 8) {
             for (size_t r = 0; r < stripBytes; r += rowBytes) {
                 for (size_t i = spp; i < rowBytes; ++i) {
@@ -749,7 +758,9 @@ bool decodeTIFF(const std::string &d, XFAImage &img)
         }
         raw += strip;
     }
-    raw.resize(rowBytes * h, '\0');
+    if (raw.size() < rowBytes * h) {
+        return false;
+    }
 
     const bool rgbIn = photometric == 2;
     const int colors = rgbIn ? 3 : 1;
@@ -757,6 +768,13 @@ bool decodeTIFF(const std::string &d, XFAImage &img)
     const bool hasAlpha = spp > colors && (value(338, 0, 0) == 1 || value(338, 0, 0) == 2);
     const bool premultiplied = value(338, 0, 0) == 1;
     const unsigned int maxValue = (1u << depth) - 1;
+    std::vector<unsigned char> colormap;
+    if (photometric == 3) {
+        colormap.resize(3u << depth);
+        for (unsigned int i = 0; i < colormap.size(); ++i) {
+            colormap[i] = static_cast<unsigned char>(value(320, i, 0) >> 8);
+        }
+    }
     std::string samples(static_cast<size_t>(w * h) * comps, '\0');
     std::string alpha(static_cast<size_t>(w * h), '\xFF');
     for (long long y = 0; y < h; ++y) {
@@ -772,7 +790,7 @@ bool decodeTIFF(const std::string &d, XFAImage &img)
             if (photometric == 3) {
                 const uint32_t idx = packedSample(row, base, depth);
                 for (int c = 0; c < 3; ++c) {
-                    samples[o * 3 + c] = static_cast<char>(value(320, c * (1u << depth) + idx, 0) >> 8);
+                    samples[o * 3 + c] = static_cast<char>(colormap[c * (1u << depth) + idx]);
                 }
                 continue;
             }
