+
+class XFAScript
+{
+public:
+    explicit XFAScript(XFAForm *form);
+    ~XFAScript();
+
+    // False when poppler was built without a JavaScript engine.
+    static bool isAvailable();
+
+    // Defines the script objects declared in the <variables> of container.
+    void defineScriptObjects(XFANode *container);
