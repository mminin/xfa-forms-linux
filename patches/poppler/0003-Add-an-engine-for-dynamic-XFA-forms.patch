+//------------------------------------------------------------------------
+// Native functions
+//------------------------------------------------------------------------
+
+struct XFAScript::Private
+{
+    XFAForm *form = nullptr;
+    JSRuntime *rt = nullptr;
+    JSContext *ctx = nullptr;
+    std::unique_ptr<XFANode> limbo; // nodes made by createNode, not yet attached
