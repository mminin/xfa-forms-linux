+//========================================================================
+//
+// XFALayout.cc
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#include <config.h>
+
+#include "XFALayout.h"
+
+#include "XFAText.h"
+
+#include <algorithm>
+#include <deque>
+#include <memory>
+
+static const double eps = 0.01;
+
+XFAInsets XFAMarginOf(const XFANode *node)
+{
+    XFAInsets m;
+    const XFANode *margin = node ? node->firstChild("margin") : nullptr;
+    if (margin) {
+        m.left = XFAMeasureAttr(margin, "leftInset", 0);
+        m.top = XFAMeasureAttr(margin, "topInset", 0);
+        m.right = XFAMeasureAttr(margin, "rightInset", 0);
+        m.bottom = XFAMeasureAttr(margin, "bottomInset", 0);
+    }
+    return m;
+}
+
+static double checkButtonSize(const XFANode *field)
+{
+    const XFANode *ui = field->firstChild("ui");
+    const XFANode *cb = ui ? ui->firstChild("checkButton") : nullptr;
+    return cb ? XFAMeasureAttr(cb, "size", 10) : 10;
+}
+
+static const XFANode *visibleCaption(const XFANode *field)
+{
+    const XFANode *caption = field->firstChild("caption");
+    if (!caption) {
+        return nullptr;
+    }
+    const std::string p = caption->getAttr("presence", "visible");
+    if (p == "hidden" || p == "inactive") {
+        return nullptr;
+    }
+    return caption;
+}
+
+XFAFieldGeometry XFAFieldGeometryOf(XFAForm *form, XFANode *field, double w, double h)
+{
+    XFAFieldGeometry g;
+    const XFAInsets m = XFAMarginOf(field);
+    const double cx = m.left, cy = m.top;
+    const double cw = std::max(0.0, w - m.left - m.right);
+    const double ch = std::max(0.0, h - m.top - m.bottom);
+    g.uiX = cx;
+    g.uiY = cy;
+    g.uiW = cw;
+    g.uiH = ch;
+
+    const std::string ui = form->uiClass(field);
+    const XFANode *caption = visibleCaption(field);
+    if (ui == "button") {
+        // The caption is the face of the button.
+        if (caption) {
+            g.hasCaption = true;
+            g.captionX = cx;
+            g.captionY = cy;
+            g.captionW = cw;
+            g.captionH = ch;
+        }
+        return g;
+    }
+    if (!caption) {
+        return g;
+    }
+    const std::string placement = caption->getAttr("placement", "left");
+    double reserve = XFAMeasureAttr(caption, "reserve", -1);
+    const bool horizontal = placement == "left" || placement == "right";
+    if (reserve <= 0) {
+        if (ui == "checkButton" && horizontal) {
+            reserve = std::max(0.0, cw - checkButtonSize(field) - 2);
+        } else {
+            const XFAFont font = XFAFontOf(caption);
+            const XFAPara para = XFAParaOf(caption);
+            const XFAInsets cm = XFAMarginOf(caption);
+            const XFATextBlock tb = XFALayoutText(XFAParagraphsOf(form, field, caption->firstChild("value"), font, para), horizontal ? 0 : cw - cm.left - cm.right);
+            reserve = horizontal ? tb.width + cm.left + cm.right + 2 : tb.height + cm.top + cm.bottom;
+        }
+    }
+    g.hasCaption = true;
+    if (placement == "right") {
+        reserve = std::min(reserve, cw);
+        g.uiW = cw - reserve;
+        g.captionX = cx + cw - reserve;
+        g.captionY = cy;
+        g.captionW = reserve;
+        g.captionH = ch;
+    } else if (placement == "top") {
+        reserve = std::min(reserve, ch);
+        g.captionX = cx;
+        g.captionY = cy;
+        g.captionW = cw;
+        g.captionH = reserve;
+        g.uiY = cy + reserve;
+        g.uiH = ch - reserve;
+    } else if (placement == "bottom") {
+        reserve = std::min(reserve, ch);
+        g.uiH = ch - reserve;
+        g.captionX = cx;
+        g.captionY = cy + ch - reserve;
+        g.captionW = cw;
+        g.captionH = reserve;
+    } else {
+        reserve = std::min(reserve, cw);
+        g.captionX = cx;
+        g.captionY = cy;
+        g.captionW = reserve;
+        g.captionH = ch;
+        g.uiX = cx + reserve;
+        g.uiW = cw - reserve;
+    }
+    return g;
+}
+
+namespace {
+
+struct Box
+{
+    XFANode *node = nullptr;
+    double x = 0, y = 0, w = 0, h = 0;
+    std::vector<Box> children;
+    std::string layout = "position";
+    XFAInsets margin;
+
+    // Text that may be split across pages.
+    bool splittableText = false;
+    std::shared_ptr<XFATextBlock> text;
+    double textTop = 0;
+    size_t firstLine = 0;
+    size_t lastLine = std::numeric_limits<size_t>::max();
+    bool hasStart = true;
+    bool hasEnd = true;
+
+    // Pagination.
+    std::string breakTarget;
+    bool breakStartNew = false;
+    bool breakConsumed = false;
+    bool keepIntact = false;
+
+    bool hasOwnBreak() const { return !breakTarget.empty() && !breakConsumed; }
+    bool isFlow() const { return layout == "tb" && !keepIntact && !children.empty(); }
+    bool containsBreak() const
+    {
+        if (hasOwnBreak()) {
+            return true;
+        }
+        if (layout != "tb") {
+            return false;
+        }
+        return std::ranges::any_of(children, [](const Box &c) { return c.containsBreak(); });
+    }
+};
+
+struct PendingBreak
+{
+    bool set = false;
+    std::string target;
+    bool startNew = false;
+};
+
+enum class Fit
+{
+    All,
+    Some,
+    None
+};
+
+bool isLayoutChild(const XFAForm *form, const XFANode *n)
+{
+    if (n->isText() || !n->isContainer()) {
+        return false;
+    }
+    const std::string &c = n->getClassName();
+    if (c != "subform" && c != "subformSet" && c != "exclGroup" && c != "field" && c != "draw" && c != "area") {
+        return false;
+    }
+    const std::string p = form->getPresence(n);
+    return p != "hidden" && p != "inactive";
+}
+
+void anchorOffset(const XFANode *n, double w, double h, double *dx, double *dy)
+{
+    const std::string a = n->getAttr("anchorType", "topLeft");
+    *dx = 0;
+    *dy = 0;
+    if (a.ends_with("Center")) {
+        *dx = w / 2;
+    } else if (a.ends_with("Right")) {
+        *dx = w;
+    }
+    if (a.starts_with("middle")) {
+        *dy = h / 2;
+    } else if (a.starts_with("bottom")) {
+        *dy = h;
+    }
+}
+
+class Layouter
+{
+public:
+    explicit Layouter(XFAForm *formA) : form(formA) { }
+
+    XFALayoutResult run();
+
+private:
+    struct PageState
+    {
+        int index;
+        const XFANode *area;
+        double contentX, contentY, contentW, contentH;
+        double used = 0;
+    };
+
+    Box measure(XFANode *node, double availW);
+    void measureContainer(Box &b, double availW);
+    void measureDraw(Box &b, double availW);
+    void measureField(Box &b, double availW);
+
+    Fit split(Box &box, double avail, bool pageHasContent, Box &head, Box &tail, PendingBreak &brk);
+    Fit splitFlow(Box &box, double avail, bool pageHasContent, Box &head, Box &tail, PendingBreak &brk);
+    Fit splitText(Box &box, double avail, Box &head, Box &tail);
+
+    const XFANode *findPageArea(const std::string &target) const;
+    const XFANode *nextPageArea() const;
+    void newPage(const XFANode *area);
+    void dropEmptyPage();
+    void place(const Box &b, double px, double py, XFALayoutPage &page, int pageIndex);
+
+    XFAForm *form;
+    XFALayoutResult result;
+    std::vector<const XFANode *> pageAreas;
+    std::map<const XFANode *, int> areaUses;
+    std::optional<PageState> page;
+};
+
+//------------------------------------------------------------------------
+// Measuring
+//------------------------------------------------------------------------
+
+Box Layouter::measure(XFANode *node, double availW)
+{
+    Box b;
+    b.node = node;
+    b.margin = XFAMarginOf(node);
+    const std::string &cls = node->getClassName();
+    if (cls == "draw") {
+        measureDraw(b, availW);
+    } else if (cls == "field") {
+        measureField(b, availW);
+    } else {
+        measureContainer(b, availW);
+    }
+
+    if (const XFANode *bb = node->firstChild("breakBefore")) {
+        const std::string type = bb->getAttr("targetType", "auto");
+        if (type == "pageArea" || type == "contentArea") {
+            b.breakTarget = bb->getAttr("target", "");
+            if (b.breakTarget.empty()) {
+                b.breakTarget = "#next";
+            }
+            b.breakStartNew = bb->getAttr("startNew", "0") == "1";
+        }
+    } else if (const XFANode *br = node->firstChild("break")) {
+        const std::string before = br->getAttr("before", "auto");
+        if (before == "pageArea" || before == "contentArea" || before == "pageEven" || before == "pageOdd") {
+            b.breakTarget = br->getAttr("beforeTarget", "");
+            if (b.breakTarget.empty()) {
+                b.breakTarget = "#next";
+            }
+            b.breakStartNew = br->getAttr("startNew", "0") == "1";
+        }
+    }
+    if (const XFANode *keep = node->firstChild("keep")) {
+        const std::string intact = keep->getAttr("intact", "none");
+        b.keepIntact = intact == "contentArea" || intact == "pageArea";
+    }
+    return b;
+}
+
+void Layouter::measureContainer(Box &b, double availW)
+{
+    XFANode *node = b.node;
+    const std::string &cls = node->getClassName();
+    b.layout = node->getAttr("layout", cls == "subformSet" ? "tb" : "position");
+    if (b.layout == "rl-tb") {
+        b.layout = "lr-tb";
+    } else if (b.layout == "row" || b.layout == "table" || b.layout == "rl-row") {
+        b.layout = "tb";
+    }
+    const XFAInsets &m = b.margin;
+    const bool fixedW = node->getAttr("w") != nullptr;
+    const double outerW = fixedW ? XFAMeasureAttr(node, "w") : availW;
+    const double innerW = std::max(0.0, outerW - m.left - m.right);
+
+    for (const auto &c : node->getChildren()) {
+        if (isLayoutChild(form, c.get())) {
+            b.children.push_back(measure(c.get(), innerW));
+        }
+    }
+
+    double contentW = 0, contentH = 0;
+    if (b.layout == "tb") {
+        double y = m.top;
+        for (Box &c : b.children) {
+            c.x = m.left;
+            c.y = y;
+            y += c.h;
+            contentW = std::max(contentW, c.w);
+        }
+        contentH = y - m.top;
+    } else if (b.layout == "lr-tb") {
+        double x = m.left, y = m.top, rowH = 0;
+        const double right = m.left + innerW;
+        for (Box &c : b.children) {
+            if (x > m.left + eps && x + c.w > right + eps) {
+                y += rowH;
+                x = m.left;
+                rowH = 0;
+            }
+            c.x = x;
+            c.y = y;
+            x += c.w;
+            rowH = std::max(rowH, c.h);
+            contentW = std::max(contentW, x - m.left);
+        }
+        contentH = y + rowH - m.top;
+    } else {
+        for (Box &c : b.children) {
+            double dx, dy;
+            anchorOffset(c.node, c.w, c.h, &dx, &dy);
+            c.x = m.left + XFAMeasureAttr(c.node, "x") - dx;
+            c.y = m.top + XFAMeasureAttr(c.node, "y") - dy;
+            contentW = std::max(contentW, c.x + c.w - m.left);
+            contentH = std::max(contentH, c.y + c.h - m.top);
+        }
+    }
+
+    if (fixedW) {
+        b.w = outerW;
+    } else if (b.layout == "lr-tb") {
+        b.w = availW;
+    } else {
+        b.w = contentW + m.left + m.right;
+        b.w = std::max(b.w, XFAMeasureAttr(node, "minW", 0));
+        if (node->getAttr("maxW")) {
+            b.w = std::min(b.w, XFAMeasureAttr(node, "maxW"));
+        }
+    }
+    if (node->getAttr("h")) {
+        b.h = XFAMeasureAttr(node, "h");
+    } else {
+        b.h = contentH + m.top + m.bottom;
+        b.h = std::max(b.h, XFAMeasureAttr(node, "minH", 0));
+        if (node->getAttr("maxH")) {
+            b.h = std::min(b.h, XFAMeasureAttr(node, "maxH"));
+        }
+    }
+}
+
+void Layouter::measureDraw(Box &b, double availW)
+{
+    XFANode *node = b.node;
+    const XFAInsets &m = b.margin;
+    const XFANode *value = node->firstChild("value");
+    const XFANode *content = nullptr;
+    if (value) {
+        for (XFANode *c : value->elementChildren()) {
+            content = c;
+            break;
+        }
+    }
+    const bool isText = content && (content->getClassName() == "text" || content->getClassName() == "exData");
+
+    const bool fixedW = node->getAttr("w") != nullptr;
+    const bool fixedH = node->getAttr("h") != nullptr;
+    double w = fixedW ? XFAMeasureAttr(node, "w") : 0;
+    std::shared_ptr<XFATextBlock> text;
+    if (isText) {
+        const XFAFont font = XFAFontOf(node);
+        const XFAPara para = XFAParaOf(node);
+        const auto paras = XFAParagraphsOf(form, node, value, font, para);
+        if (!fixedW) {
+            // Growable width: as wide as the text, within minW and maxW.
+            const XFATextBlock natural = XFALayoutText(paras, 0);
+            w = natural.width + m.left + m.right;
+            w = std::max(w, XFAMeasureAttr(node, "minW", 0));
+            if (node->getAttr("maxW")) {
+                w = std::min(w, XFAMeasureAttr(node, "maxW"));
+            }
+        }
+        text = std::make_shared<XFATextBlock>(XFALayoutText(paras, std::max(1.0, w - m.left - m.right)));
+    } else if (!fixedW) {
+        w = std::max(XFAMeasureAttr(node, "minW", 0), 0.0);
+    }
+    (void)availW;
+    b.w = w;
+    if (fixedH) {
+        b.h = XFAMeasureAttr(node, "h");
+    } else {
+        b.h = (text ? text->height : 0) + m.top + m.bottom;
+        b.h = std::max(b.h, XFAMeasureAttr(node, "minH", 0));
+        if (node->getAttr("maxH")) {
+            b.h = std::min(b.h, XFAMeasureAttr(node, "maxH"));
+        }
+        const XFANode *keep = node->firstChild("keep");
+        if (text && keep && keep->getAttr("intact", "") == "none") {
+            b.splittableText = true;
+        }
+    }
+    b.text = text;
+    b.textTop = m.top;
+}
+
+void Layouter::measureField(Box &b, double availW)
+{
+    XFANode *node = b.node;
+    const XFAInsets &m = b.margin;
+    const XFAFont font = XFAFontOf(node);
+    (void)availW;
+    if (node->getAttr("h")) {
+        b.h = XFAMeasureAttr(node, "h");
+    } else {
+        double h = font.lineHeight() + m.top + m.bottom + 4;
+        if (const XFANode *caption = visibleCaption(node)) {
+            const std::string placement = caption->getAttr("placement", "left");
+            if (placement == "top" || placement == "bottom") {
+                h += std::max(XFAMeasureAttr(caption, "reserve", 0), XFAFontOf(caption).lineHeight());
+            }
+        }
+        b.h = std::max(h, XFAMeasureAttr(node, "minH", 0));
+        if (node->getAttr("maxH")) {
+            b.h = std::min(b.h, XFAMeasureAttr(node, "maxH"));
+        }
+    }
+    if (node->getAttr("w")) {
+        b.w = XFAMeasureAttr(node, "w");
+    } else {
+        double natural = m.left + m.right + 4;
+        if (const XFANode *caption = visibleCaption(node)) {
+            const double reserve = XFAMeasureAttr(caption, "reserve", 0);
+            if (reserve > 0) {
+                natural += reserve;
+            } else {
+                const XFAInsets cm = XFAMarginOf(caption);
+                const XFATextBlock tb = XFALayoutText(XFAParagraphsOf(form, node, caption->firstChild("value"), XFAFontOf(caption), XFAParaOf(caption)), 0);
+                natural += tb.width + cm.left + cm.right;
+            }
+        }
+        const std::string ui = form->uiClass(node);
+        if (ui == "checkButton") {
+            natural += checkButtonSize(node);
+        } else if (ui != "button") {
+            natural += font.width(form->getFormattedValue(node));
+        }
+        b.w = std::max(natural, XFAMeasureAttr(node, "minW", 0));
+        if (node->getAttr("maxW")) {
+            b.w = std::min(b.w, XFAMeasureAttr(node, "maxW"));
+        }
+    }
+}
+
+//------------------------------------------------------------------------
+// Pagination
+//------------------------------------------------------------------------
+
+Fit Layouter::split(Box &box, double avail, bool pageHasContent, Box &head, Box &tail, PendingBreak &brk)
+{
+    if (box.splittableText) {
+        return splitText(box, avail, head, tail);
+    }
+    if (!box.isFlow()) {
+        return box.h <= avail + eps ? Fit::All : Fit::None;
+    }
+    if (box.h <= avail + eps && !box.containsBreak()) {
+        return Fit::All;
+    }
+    return splitFlow(box, avail, pageHasContent, head, tail, brk);
+}
+
+Fit Layouter::splitText(Box &box, double avail, Box &head, Box &tail)
+{
+    if (box.h <= avail + eps) {
+        return Fit::All;
+    }
+    const XFATextBlock &tb = *box.text;
+    const size_t first = box.firstLine;
+    const size_t last = std::min(box.lastLine, tb.lines.size());
+    const double top = box.hasStart ? box.textTop : 0;
+    size_t k = first;
+    while (k < last && top + tb.heightOf(first, k + 1) <= avail + eps) {
+        ++k;
+    }
+    if (k == first || k == last) {
+        return k == last ? Fit::All : Fit::None;
+    }
+    head = box;
+    head.lastLine = k;
+    head.h = top + tb.heightOf(first, k);
+    head.hasEnd = false;
+    tail = box;
+    tail.firstLine = k;
+    tail.hasStart = false;
+    tail.h = tb.heightOf(k, last) + (box.hasEnd ? box.margin.bottom : 0);
+    return Fit::Some;
+}
+
+Fit Layouter::splitFlow(Box &box, double avail, bool pageHasContent, Box &head, Box &tail, PendingBreak &brk)
+{
+    double used = box.hasStart ? box.margin.top : 0;
+    std::vector<Box> placed;
+    std::vector<Box> rest;
+    size_t i = 0;
+    bool stopped = false;
+    for (; i < box.children.size(); ++i) {
+        Box &c = box.children[i];
+        const bool contentBefore = pageHasContent || !placed.empty();
+        if (c.hasOwnBreak()) {
+            c.breakConsumed = true;
+            brk.set = true;
+            brk.target = c.breakTarget;
+            brk.startNew = c.breakStartNew;
+            if (contentBefore || brk.startNew || brk.target != "#next") {
+                stopped = true;
+                break;
+            }
+            brk.set = false;
+        }
+        const double remaining = avail - used;
+        if (c.h <= remaining + eps && !c.containsBreak()) {
+            Box p = c;
+            p.y = used;
+            used += c.h;
+            placed.push_back(std::move(p));
+            continue;
+        }
+        Box ch, ct;
+        const Fit f = split(c, remaining, contentBefore, ch, ct, brk);
+        if (f == Fit::All) {
+            Box p = c;
+            p.y = used;
+            used += c.h;
+            placed.push_back(std::move(p));
+            if (brk.set) {
+                ++i;
+                stopped = true;
+                break;
+            }
+            continue;
+        }
+        if (f == Fit::Some) {
+            ch.y = used;
+            used += ch.h;
+            placed.push_back(std::move(ch));
+            rest.push_back(std::move(ct));
+            ++i;
+            stopped = true;
+            break;
+        }
+        if (!contentBefore && !brk.set) {
+            // Does not fit even on an empty page: let it overflow.
+            Box p = c;
+            p.y = used;
+            used += c.h;
+            placed.push_back(std::move(p));
+            continue;
+        }
+        stopped = true;
+        break;
+    }
+    if (!stopped) {
+        return Fit::All;
+    }
+    for (; i < box.children.size(); ++i) {
+        rest.push_back(box.children[i]);
+    }
+    if (rest.empty()) {
+        return Fit::All;
+    }
+    if (placed.empty()) {
+        return Fit::None;
+    }
+
+    head = box;
+    head.children = std::move(placed);
+    head.h = used;
+    head.hasEnd = false;
+
+    tail = box;
+    tail.hasStart = false;
+    double y = 0;
+    for (Box &r : rest) {
+        r.y = y;
+        y += r.h;
+    }
+    tail.children = std::move(rest);
+    tail.h = y + (box.hasEnd ? box.margin.bottom : 0);
+    return Fit::Some;
+}
+
+const XFANode *Layouter::findPageArea(const std::string &target) const
+{
+    if (target.empty() || target == "#next") {
+        return nullptr;
+    }
+    const std::string t = target.starts_with("#") ? target.substr(1) : target;
+    for (const XFANode *a : pageAreas) {
+        if (a->getName() == t || a->getAttr("id", "") == t) {
+            return a;
+        }
+    }
+    return nullptr;
+}
+
+const XFANode *Layouter::nextPageArea() const
+{
+    if (pageAreas.empty()) {
+        return nullptr;
+    }
+    if (!page) {
+        return pageAreas.front();
+    }
+    const XFANode *cur = page->area;
+    const XFANode *occur = cur->firstChild("occur");
+    const int max = occur ? std::atoi(occur->getAttr("max", "-1").c_str()) : -1;
+    auto it = areaUses.find(cur);
+    const int uses = it == areaUses.end() ? 0 : it->second;
+    if (max < 0 || uses < max) {
+        return cur;
+    }
+    auto pos = std::ranges::find(pageAreas, cur);
+    if (pos != pageAreas.end() && pos + 1 != pageAreas.end()) {
+        return *(pos + 1);
+    }
+    return cur;
+}
+
+void Layouter::newPage(const XFANode *area)
+{
+    if (!area) {
+        area = nextPageArea();
+    }
+    if (!area) {
+        return;
+    }
+    areaUses[area]++;
+
+    XFALayoutPage lp;
+    lp.pageArea = area;
+    lp.pageAreaInstance = form->pageInstance(area, result.pages.size());
+    lp.width = 612;
+    lp.height = 792;
+    if (const XFANode *medium = area->firstChild("medium")) {
+        const double s = XFAMeasureAttr(medium, "short", 612);
+        const double l = XFAMeasureAttr(medium, "long", 792);
+        if (medium->getAttr("orientation", "portrait") == "landscape") {
+            lp.width = l;
+            lp.height = s;
+        } else {
+            lp.width = s;
+            lp.height = l;
+        }
+    }
+    PageState ps;
+    ps.index = static_cast<int>(result.pages.size());
+    ps.area = area;
+    ps.contentX = 0;
+    ps.contentY = 0;
+    ps.contentW = lp.width;
+    ps.contentH = lp.height;
+    if (const XFANode *ca = area->firstChild("contentArea")) {
+        ps.contentX = XFAMeasureAttr(ca, "x");
+        ps.contentY = XFAMeasureAttr(ca, "y");
+        ps.contentW = XFAMeasureAttr(ca, "w", lp.width);
+        ps.contentH = XFAMeasureAttr(ca, "h", lp.height);
+    }
+    result.pages.push_back(std::move(lp));
+    page = ps;
+
+    // Master page objects, positioned relative to the page.
+    XFALayoutPage &cur = result.pages.back();
+    if (cur.pageAreaInstance) {
+        result.pageOfNode[cur.pageAreaInstance->getSerial()] = ps.index;
+        for (const auto &c : cur.pageAreaInstance->getChildren()) {
+            if (!isLayoutChild(form, c.get())) {
+                continue;
+            }
+            Box b = measure(c.get(), cur.width);
+            double dx, dy;
+            anchorOffset(c.get(), b.w, b.h, &dx, &dy);
+            place(b, XFAMeasureAttr(c.get(), "x") - dx, XFAMeasureAttr(c.get(), "y") - dy, cur, ps.index);
+        }
+    }
+}
+
+void Layouter::dropEmptyPage()
+{
+    if (!page || result.pages.empty()) {
+        return;
+    }
+    XFALayoutPage &last = result.pages.back();
+    areaUses[last.pageArea]--;
+    if (last.pageAreaInstance && last.pageAreaInstance->getParent()) {
+        last.pageAreaInstance->getParent()->removeChild(last.pageAreaInstance);
+    }
+    const int index = static_cast<int>(result.pages.size()) - 1;
+    std::erase_if(result.pageOfNode, [index](const auto &p) { return p.second == index; });
+    result.pages.pop_back();
+    page.reset();
+    if (!result.pages.empty()) {
+        // Continue counting from the previous page.
+        const XFALayoutPage &prev = result.pages.back();
+        PageState ps;
+        ps.index = static_cast<int>(result.pages.size()) - 1;
+        ps.area = prev.pageArea;
+        ps.used = 1; // not empty
+        page = ps;
+    }
+}
+
+void Layouter::place(const Box &b, double px, double py, XFALayoutPage &lp, int pageIndex)
+{
+    XFALayoutItem item;
+    item.node = b.node;
+    item.x = px;
+    item.y = py;
+    item.w = b.w;
+    item.h = b.h;
+    item.firstLine = b.firstLine;
+    item.lastLine = b.lastLine;
+    item.hasStart = b.hasStart;
+    item.hasEnd = b.hasEnd;
+    lp.items.push_back(item);
+    result.pageOfNode.emplace(b.node->getSerial(), pageIndex);
+    for (const Box &c : b.children) {
+        place(c, px + c.x, py + c.y, lp, pageIndex);
+    }
+}
+
+XFALayoutResult Layouter::run()
+{
+    XFANode *root = form->getFormRoot();
+    const XFANode *rootProto = root->getProto();
+    if (const XFANode *ps = rootProto ? rootProto->firstChild("pageSet") : nullptr) {
+        for (const XFANode *a : ps->childrenOfClass("pageArea")) {
+            pageAreas.push_back(a);
+        }
+    }
+    if (pageAreas.empty()) {
+        return result;
+    }
+
+    double contentW = 612;
+    if (const XFANode *ca = pageAreas.front()->firstChild("contentArea")) {
+        contentW = XFAMeasureAttr(ca, "w", contentW);
+    }
+    Box rootBox = measure(root, contentW);
+
+    std::deque<Box> queue;
+    if (rootBox.layout == "tb") {
+        for (Box &c : rootBox.children) {
+            queue.push_back(std::move(c));
+        }
+    } else {
+        rootBox.x = 0;
+        rootBox.y = 0;
+        queue.push_back(std::move(rootBox));
+    }
+
+    int guard = 0;
+    while (!queue.empty() && ++guard < 10000) {
+        Box &item = queue.front();
+        if (item.hasOwnBreak()) {
+            item.breakConsumed = true;
+            const XFANode *target = findPageArea(item.breakTarget);
+            const bool empty = page && page->used <= eps;
+            if (!page) {
+                newPage(target);
+            } else if (empty && (!target || target == page->area)) {
+                // Already at the top of a suitable page.
+            } else if (empty) {
+                dropEmptyPage();
+                newPage(target);
+            } else {
+                newPage(target);
+            }
+        }
+        if (!page) {
+            newPage(nullptr);
+            if (!page) {
+                break;
+            }
+        }
+        XFALayoutPage &lp = result.pages.back();
+        const double avail = page->contentH - page->used;
+        Box head, tail;
+        PendingBreak brk;
+        const Fit f = split(item, avail, page->used > eps, head, tail, brk);
+        if (f == Fit::All) {
+            place(item, page->contentX + item.x, page->contentY + page->used, lp, page->index);
+            page->used += item.h;
+            queue.pop_front();
+            continue;
+        }
+        if (f == Fit::Some) {
+            place(head, page->contentX + head.x, page->contentY + page->used, lp, page->index);
+            page->used += head.h;
+            queue.front() = std::move(tail);
+            newPage(brk.set ? findPageArea(brk.target) : nullptr);
+            continue;
+        }
+        // Nothing fits.
+        if (brk.set) {
+            const XFANode *target = findPageArea(brk.target);
+            if (page->used <= eps) {
+                dropEmptyPage();
+            }
+            newPage(target);
+            continue;
+        }
+        if (page->used <= eps) {
+            place(item, page->contentX + item.x, page->contentY + page->used, lp, page->index);
+            page->used += item.h;
+            queue.pop_front();
+            continue;
+        }
+        newPage(nullptr);
+    }
+    form->trimPageInstances(result.pages.size());
+    return result;
+}
+
+} // namespace
+
+XFALayoutResult XFALayoutForm(XFAForm *form)
+{
+    Layouter layouter(form);
+    return layouter.run();
+}
