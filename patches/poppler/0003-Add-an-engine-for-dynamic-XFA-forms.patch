+}
+
+NATIVE(text)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    return n ? strValue(ctx, n->textContent()) : JS_NULL;
+}
+
+NATIVE(setText)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    if (n && n->getDom() == formOf(ctx)->getFormDom()) {
+        const std::string value = strArg(ctx, ARG(1));
