+    bool ok = false;
+};
+
+namespace {
+
+XFAScript::Private *priv(JSContext *ctx)
+{
+    return static_cast<XFAScript::Private *>(JS_GetContextOpaque(ctx));
+}
+
+XFAForm *formOf(JSContext *ctx)
+{
+    return priv(ctx)->form;
+}
+
+int idOfNode(XFAForm *form, const XFANode *n)
+{
+    if (!n) {
+        return 0;
+    }
+    return n->getDom() == form->getFormDom() ? n->getSerial() : -n->getSerial();
+}
+
+XFANode *nodeArg(JSContext *ctx, JSValueConst v)
+{
+    if (JS_IsNull(v) || JS_IsUndefined(v)) {
+        return nullptr;
+    }
+    int32_t id = 0;
+    if (JS_ToInt32(ctx, &id, v) != 0 || id == 0) {
+        return nullptr;
+    }
+    XFAForm *form = formOf(ctx);
+    return id > 0 ? form->lookupNode(id) : form->lookupTemplateNode(-id);
+}
+
+std::string strArg(JSContext *ctx, JSValueConst v)
+{
+    size_t len = 0;
+    const char *s = JS_ToCStringLen(ctx, &len, v);
+    if (!s) {
+        return {};
+    }
+    std::string res(s, len);
+    JS_FreeCString(ctx, s);
+    return res;
+}
+
+JSValue idValue(JSContext *ctx, const XFANode *n)
+{
+    return n ? JS_NewInt32(ctx, idOfNode(formOf(ctx), n)) : JS_NULL;
+}
+
+JSValue strValue(JSContext *ctx, const std::string &s)
+{
+    return JS_NewStringLen(ctx, s.data(), s.size());
+}
+
+JSValue optValue(JSContext *ctx, const std::optional<std::string> &s)
+{
+    return s ? strValue(ctx, *s) : JS_NULL;
+}
+
+JSValue idArray(JSContext *ctx, const std::vector<XFANode *> &nodes)
+{
+    JSValue arr = JS_NewArray(ctx);
+    uint32_t i = 0;
+    for (const XFANode *n : nodes) {
+        JS_SetPropertyUint32(ctx, arr, i++, idValue(ctx, n));
+    }
+    return arr;
+}
+
+JSValue strArray(JSContext *ctx, const std::vector<std::string> &v)
+{
+    JSValue arr = JS_NewArray(ctx);
+    uint32_t i = 0;
+    for (const std::string &s : v) {
+        JS_SetPropertyUint32(ctx, arr, i++, strValue(ctx, s));
+    }
+    return arr;
+}
+
+JSValue imValue(JSContext *ctx, const std::optional<XFAForm::InstanceManager> &im)
+{
+    if (!im) {
+        return JS_NULL;
+    }
+    JSValue arr = JS_NewArray(ctx);
+    JS_SetPropertyUint32(ctx, arr, 0, idValue(ctx, im->parent));
+    JS_SetPropertyUint32(ctx, arr, 1, idValue(ctx, im->proto));
+    return arr;
+}
+
+std::optional<XFAForm::InstanceManager> imArgs(JSContext *ctx, JSValueConst *argv)
+{
+    XFANode *parent = nodeArg(ctx, argv[0]);
+    XFANode *proto = nodeArg(ctx, argv[1]);
+    if (!parent || !proto) {
+        return std::nullopt;
+    }
+    return XFAForm::InstanceManager { parent, proto };
+}
+
+#    define NATIVE(name) JSValue native_##name(JSContext *ctx, JSValueConst, [[maybe_unused]] int argc, [[maybe_unused]] JSValueConst *argv)
+#    define ARG(i) (i < argc ? argv[i] : JS_UNDEFINED)
+
+NATIVE(alive)
+{
+    return JS_NewBool(ctx, nodeArg(ctx, ARG(0)) != nullptr);
+}
+
+NATIVE(cls)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    return n ? strValue(ctx, n->getClassName()) : JS_NULL;
+}
+
+NATIVE(name)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    return n ? strValue(ctx, n->getName()) : JS_NULL;
+}
+
+NATIVE(attr)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
