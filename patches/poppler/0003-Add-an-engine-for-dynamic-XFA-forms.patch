+int interruptHandler(JSContext *, void *opaque)
+{
+    auto *p = static_cast<XFAScript::Private *>(opaque);
+    return std::chrono::steady_clock::now() > p->deadline ? 1 : 0;
+}
+
+std::string exceptionText(JSContext *ctx)
+{
+    JSValue exc = JS_GetException(ctx);
+    std::string text = strArg(ctx, exc);
+    if (JS_IsError(exc)) {
+        JSValue stack = JS_GetPropertyStr(ctx, exc, "stack");
+        if (!JS_IsUndefined(stack)) {
+            text += "\n" + strArg(ctx, stack);
+        }
+        JS_FreeValue(ctx, stack);
+    }
+    JS_FreeValue(ctx, exc);
+    return text;
+}
