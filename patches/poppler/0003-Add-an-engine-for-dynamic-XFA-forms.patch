+#ifndef XFANODE_H
+#define XFANODE_H
+
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+class XFANode;
+
+// Owner of a tree of XFANodes. Hands out serial numbers that stay unique
+// for the lifetime of the DOM, so scripts can refer to nodes by number and
+// find out when a node they refer to has been removed.
+class XFADom
+{
+public:
+    XFADom() = default;
+    XFADom(const XFADom &) = delete;
+    XFADom &operator=(const XFADom &) = delete;
+
+    XFANode *lookup(int serial) const;
+
+private:
+    friend class XFANode;
+    int registerNode(XFANode *node);
+    void unregisterNode(int serial);
+
+    std::unordered_map<int, XFANode *> nodes;
+    int nextSerial = 1;
+};
+
+// A node of an XFA template, form or rich text DOM. Elements and character
+// data share this class; character data nodes have the class name "#text".
+class XFANode
+{
+public:
+    enum class Namespace
+    {
+        XFA,
+        XHTML,
+        Other
+    };
+
+    XFANode(XFADom *dom, std::string className);
+    ~XFANode();
+    XFANode(const XFANode &) = delete;
+    XFANode &operator=(const XFANode &) = delete;
+
+    const std::string &getClassName() const { return className; }
+    Namespace getNamespace() const { return ns; }
+    void setNamespace(Namespace n) { ns = n; }
+    int getSerial() const { return serial; }
+    XFADom *getDom() const { return dom; }
+    XFANode *getParent() const { return parent; }
+    // The template node this form node was created from, or nullptr.
+    const XFANode *getProto() const { return proto; }
+    void setProto(const XFANode *p) { proto = p; }
+
+    bool isText() const { return className == "#text"; }
+    const std::string &getText() const { return text; }
+    void setText(std::string t) { text = std::move(t); }
+
+    // Attributes. Attributes in the xfa-data namespace are stored with an
+    // "xfa:" prefix, e.g. "xfa:embed".
+    const std::string *getAttr(const std::string &name) const;
+    std::string getAttr(const std::string &name, const std::string &def) const;
+    void setAttr(const std::string &name, const std::string &value);
+    void removeAttr(const std::string &name);
+    const std::vector<std::pair<std::string, std::string>> &getAttrs() const { return attributes; }
+
+    // Value of the name attribute, or "" for unnamed nodes.
+    std::string getName() const;
+
+    const std::vector<std::unique_ptr<XFANode>> &getChildren() const { return children; }
+    XFANode *appendChild(std::unique_ptr<XFANode> child);
+    XFANode *insertChild(size_t pos, std::unique_ptr<XFANode> child);
+    std::unique_ptr<XFANode> removeChild(XFANode *child);
+    size_t indexInParent() const;
+
+    // First element child of the given class, or nullptr.
+    XFANode *firstChild(const std::string &cls) const;
+    std::vector<XFANode *> childrenOfClass(const std::string &cls) const;
+    // Element children only, in document order.
+    std::vector<XFANode *> elementChildren() const;
+
+    // Concatenated character data of all descendants.
+    std::string textContent() const;
+    // Replaces all children by a single character data node.
+    void setTextContent(const std::string &value);
+
+    // True for the objects that take part in layout and SOM name lookup.
+    bool isContainer() const;
+
+    // Deep copy into dom. Form nodes made from template nodes remember the
+    // template node as their proto.
+    std::unique_ptr<XFANode> clone(XFADom *targetDom) const;
+
+    // Serializes this node and its descendants as XML.
+    std::string toXML() const;
+
+private:
+    XFADom *dom;
+    std::string className;
+    Namespace ns = Namespace::XFA;
+    int serial;
+    XFANode *parent = nullptr;
+    const XFANode *proto = nullptr;
+    std::string text;
+    std::vector<std::pair<std::string, std::string>> attributes;
+    std::vector<std::unique_ptr<XFANode>> children;
+};
+
+// Parses an XML document into an XFANode tree owned by dom. Returns the root
+// element, or nullptr with *error set when the data is not well-formed.
+std::unique_ptr<XFANode> XFAParseXML(const std::string &data, XFADom *dom, std::string *error);
+
+// Escapes text for use in XML character data or attribute values.
+std::string XFAEscapeXML(const std::string &s);
+
+#endif
