+//========================================================================
+//
+// XFAForm.h
+//
+// Dynamic XFA forms: builds the form from the XFA template, runs its
+// scripts, lays it out into pages and writes those pages as a regular PDF
+// with AcroForm fields, which the rest of poppler can render and edit.
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#ifndef XFAFORM_H
+#define XFAFORM_H
+
+#include "XFANode.h"
+#include "poppler_private_export.h"
+
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+class PDFDoc;
+class XFAScript;
+struct XFALayoutResult;
+
+// Something the form wants the viewer to do: show a message, open a URL,
+// print. Message boxes are answered with "Yes" so scripts can continue.
+struct XFAHostRequest
+{
+    enum class Type
+    {
+        Message,
+        LaunchURL,
+        Print
+    };
+    Type type;
+    std::string title;
+    std::string text; // message text, or URL
+    int firstPage = -1; // for Print, 0-based, -1 for all pages
+    int lastPage = -1;
+};
+
+class POPPLER_PRIVATE_EXPORT XFAForm
+{
+public:
+    // Builds the form of doc and runs its initialization scripts.
+    // Returns nullptr with *error set if doc has no usable XFA form.
+    static std::unique_ptr<XFAForm> load(PDFDoc *doc, std::string *error);
+
+    ~XFAForm();
+    XFAForm(const XFAForm &) = delete;
+    XFAForm &operator=(const XFAForm &) = delete;
+
+    // A PDF file holding the current state of the form laid out as pages.
+    // The print variant leaves out the objects that are relevant only on
+    // screen, such as the buttons, but keeps the same page layout.
+    std::string generatePDF(bool forPrint);
+
+    // Changes coming from the viewer. Fields are named as in the /T entries
+    // of the generated PDF. These return true when the generated PDF would
+    // now differ from the one the viewer shows, beyond the edited value.
+    bool setFieldText(const std::string &fieldName, const std::string &value);
+    bool setFieldChoice(const std::string &fieldName, int index);
+    bool setButtonState(const std::string &fieldName, const std::string &onState, bool state);
+    bool clickButton(const std::string &fieldName);
+
+    // The same, addressing fields by SOM expression relative to the root
+    // subform, e.g. "MainForm.PersonGivingConsent.Names.givingName".
+    // Meant for testing and command line tools.
+    bool setValueBySOM(const std::string &som, const std::string &value);
+    bool clickBySOM(const std::string &som);
+
+    std::vector<XFAHostRequest> takeHostRequests();
+
+    // Number of times the visible form changed so far.
+    unsigned int getChangeCount() const { return changeCount; }
+
+    // Messages from the scripts and the engine, for debugging.
+    const std::vector<std::string> &getLog() const { return log; }
+
+    //------------------------------------------------------------------
+    // Internal API shared by the layout engine, the PDF writer and the
+    // scripting engine.
+    //------------------------------------------------------------------
+
+    XFANode *getFormRoot() const { return formRoot; }
+    XFANode *getFormModel() const { return formModel.get(); }
+    XFANode *getTemplate() const { return templateNode; }
+    XFANode *lookupNode(int serial) const { return formDom.lookup(serial); }
+    XFADom *getFormDom() { return &formDom; }
+    const std::string &getLanguage() const { return language; }
+
+    // SOM resolution. When implicit is true, the first name of the
+    // expression is searched in the scope of context and its ancestors, as
+    // for names used in scripts.
+    std::vector<XFANode *> resolve(XFANode *context, const std::string &som, bool implicit) const;
+    XFANode *resolveFirst(XFANode *context, const std::string &som, bool implicit) const;
+    // Children of node matching one SOM name: named children (looking
+    // through unnamed subforms), else properties of that class.
+    std::vector<XFANode *> childrenByName(XFANode *node, const std::string &name) const;
+    XFANode *lookupTemplateNode(int serial) const { return templateDom.lookup(serial); }
+    XFADom *getTemplateDom() { return &templateDom; }
+    // SOM expression of node, such as "xfa[0].form[0].root[0].field[0]".
+    std::string somExpression(XFANode *node) const;
+
+    // Instance managers. parent is the form node holding the instances of
+    // the template subform proto.
+    struct InstanceManager
+    {
+        XFANode *parent = nullptr;
+        const XFANode *proto = nullptr;
+    };
+    std::optional<InstanceManager> findInstanceManager(XFANode *context, const std::string &name, bool implicit) const;
+    std::vector<XFANode *> instances(const InstanceManager &im) const;
+    XFANode *addInstance(const InstanceManager &im);
+    void removeInstance(const InstanceManager &im, int index);
+    void setInstances(const InstanceManager &im, int count);
+    int instanceIndex(XFANode *node) const;
+    // Index among the siblings with the same name, as used by SOM.
+    int nameIndex(XFANode *node) const;
+
+    // Values.
+    std::optional<std::string> getRawValue(XFANode *node) const;
+    void setRawValue(XFANode *node, const std::optional<std::string> &value);
+    std::string getFormattedValue(XFANode *node) const;
+    // Items of a choice list or check button: display texts and values.
+    std::vector<std::string> getItems(XFANode *field, bool saveValues) const;
+    std::string uiClass(const XFANode *field) const;
+    // Node presence, taking "hidden" ancestors into account when deep.
+    std::string getPresence(const XFANode *node) const;
+    bool isLaidOut(const XFANode *node) const;
+    // The node with the given id attribute that is closest to context:
+    // master pages and repeated subforms hold copies with the same ids.
+    XFANode *findById(const std::string &id, XFANode *context) const;
+    // Whether a change of node's content can change the layout.
+    bool affectsLayout(const XFANode *node) const;
+    // Call after changing node's attributes or content from scripts.
+    void nodeChanged(XFANode *node);
+
+    // Events and scripts.
+    struct EventContext
+    {
+        std::string activity;
+        XFANode *target = nullptr;
+        std::string newText;
+        std::string prevText;
+        std::string change;
+    };
+    void fireEvent(XFANode *node, const std::string &activity, EventContext *ctx = nullptr);
+    void fireEventRecursive(XFANode *node, const std::string &activity);
+    void runCalculations();
+    bool runValidations(XFANode *node);
+    void initializeSubtree(XFANode *node);
+
+    // Layout, available to scripts through xfa.layout.
+    const XFALayoutResult &getLayout();
+    void invalidateLayout();
+    // Master page objects of page index, created by the layout engine.
+    // Instances are kept across layouts, with the values scripts gave them.
+    XFANode *pageInstance(const XFANode *pageArea, size_t index);
+    void trimPageInstances(size_t count);
+    int pageOf(XFANode *node);
+    int pageCount();
+    std::vector<XFANode *> pageContent(int pageIndex, const std::string &cls, bool pageAreaOnly);
+
+    // Host interface for scripts.
+    void hostMessage(const std::string &title, const std::string &text);
+    void hostLaunchURL(const std::string &url);
+    void hostPrint(int firstPage, int lastPage);
+    void resetData(XFANode *subtree);
+    void logMessage(const std::string &msg);
+
+    // Data transfer used when scripts rebuild parts of the form, see
+    // xfa.record.loadXML and dataNode.saveXML.
+    std::string saveData(XFANode *node) const;
+    void loadData(const std::string &xml, bool ignoreRoot, bool overwrite);
+
+private:
+    XFAForm();
+    bool build(PDFDoc *doc, std::string *error);
+    std::unique_ptr<XFANode> instantiate(const XFANode *templ);
+    void applyPendingData(XFANode *node);
+    struct VisibleState
+    {
+        std::string layout;
+        std::vector<std::pair<int, std::string>> values;
+        bool operator==(const VisibleState &) const = default;
+    };
+    VisibleState visibleState();
+    bool afterChange(XFANode *editedField, const std::optional<std::string> &shownValue);
+    void collectFieldValues(XFANode *node, std::vector<std::pair<int, std::string>> &values) const;
+    XFANode *fieldByName(const std::string &fieldName) const;
+    void fireEnterEvents(XFANode *node);
+
+    XFADom templateDom;
+    XFADom formDom;
+    std::unique_ptr<XFANode> xdpRoot; // the whole XDP document
+    XFANode *templateNode = nullptr; // <template>
+    std::unique_ptr<XFANode> formModel; // <form>, holding the root subform
+    XFANode *formRoot = nullptr; // root subform instance
+    XFANode *pageSetInstance = nullptr; // holds the master page objects
+    std::unique_ptr<XFAScript> script;
+    std::unique_ptr<XFALayoutResult> layout;
+    std::unique_ptr<XFANode> pendingData; // from xfa.record.loadXML
+    std::vector<XFAHostRequest> requests;
+    std::vector<std::string> log;
+    std::string language;
+    VisibleState shownState; // of the PDF the viewer shows
+    unsigned int changeCount = 0;
+    int calcDepth = 0;
+    bool inLayout = false;
+    bool layoutDirty = false;
+};
+
+// Locale independent number parsing: "1.5" whatever LC_NUMERIC says.
+// Returns def and leaves *end at s when s does not start with a number.
+double XFAParseNumber(const char *s, const char **end, double def = 0);
+
+// Lengths in XFA measurement syntax ("12.7mm", "0.5in", "10pt") to points.
+double XFAMeasure(const std::string &value, double def = 0);
+double XFAMeasureAttr(const XFANode *node, const char *attr, double def = 0);
+
+struct XFAColor
+{
+    double r = 0, g = 0, b = 0;
+};
+XFAColor XFAParseColor(const std::string &value, XFAColor def = {});
+
+#endif
