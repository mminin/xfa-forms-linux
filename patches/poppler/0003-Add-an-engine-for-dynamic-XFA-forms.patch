+//------------------------------------------------------------------------
+// Document assembly
+//------------------------------------------------------------------------
+
+class PDFBuilder
+{
+public:
+    int reserve()
+    {
+        objects.emplace_back();
+        return static_cast<int>(objects.size());
+    }
+    void set(int num, std::string body) { objects[num - 1] = std::move(body); }
+    int add(std::string body)
+    {
+        objects.push_back(std::move(body));
+        return static_cast<int>(objects.size());
+    }
+    int addStream(const std::string &dict, const std::string &data) { return add("<< " + dict + " /Length " + std::to_string(data.size()) + " >>\nstream\n" + data + "\nendstream"); }
+    std::string finish(int root)
+    {
+        std::string out = "%PDF-1.7\n%\xE2\xE3\xCF\xD3\n";
+        std::vector<size_t> offsets;
+        for (size_t i = 0; i < objects.size(); ++i) {
+            offsets.push_back(out.size());
+            out += std::to_string(i + 1) + " 0 obj\n" + objects[i] + "\nendobj\n";
+        }
+        const size_t xref = out.size();
+        out += "xref\n0 " + std::to_string(objects.size() + 1) + "\n0000000000 65535 f \n";
+        for (size_t off : offsets) {
+            std::string o = std::to_string(off);
+            out += std::string(10 - o.size(), '0') + o + " 00000 n \n";
+        }
+        out += "trailer\n<< /Size " + std::to_string(objects.size() + 1) + " /Root " + std::to_string(root) + " 0 R >>\nstartxref\n" + std::to_string(xref) + "\n%%EOF\n";
+        return out;
+    }
+
+private:
+    std::vector<std::string> objects;
+};
+
+std::string ref(int num)
+{
+    return std::to_string(num) + " 0 R";
+}
+
+//------------------------------------------------------------------------
+// Borders
+//------------------------------------------------------------------------
+
+struct Edge
+{
+    bool visible = true;
+    double thickness = 0.5;
+    XFAColor color;
+    std::string stroke = "solid";
+};
+
+Edge edgeOf(const XFANode *e)
+{
+    Edge edge;
+    if (!e) {
+        return edge;
+    }
+    const std::string p = e->getAttr("presence", "visible");
+    edge.visible = p == "visible";
+    edge.thickness = XFAMeasureAttr(e, "thickness", 0.5);
+    edge.stroke = e->getAttr("stroke", "solid");
+    if (const XFANode *c = e->firstChild("color")) {
+        edge.color = XFAParseColor(c->getAttr("value", "0,0,0"));
+    }
+    if (edge.stroke == "lowered" || edge.stroke == "raised" || edge.stroke == "etched" || edge.stroke == "embossed") {
+        // 3D strokes: approximate with a grey line.
+        edge.color = { 0.5, 0.5, 0.5 };
+        edge.thickness = std::max(edge.thickness, 0.5);
+    }
+    return edge;
+}
