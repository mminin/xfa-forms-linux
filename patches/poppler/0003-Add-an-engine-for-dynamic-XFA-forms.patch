+
+#ifndef XFALAYOUT_H
+#define XFALAYOUT_H
+
+#include "XFAForm.h"
+
+#include <cstddef>
+#include <limits>
+#include <map>
+#include <vector>
+
+// One object placed on a page. Coordinates are in points with the origin
+// at the top left corner of the page.
+struct XFALayoutItem
+{
+    XFANode *node;
+    double x, y, w, h;
+    // Text split across pages: the lines of the node's text shown here.
+    size_t firstLine = 0;
+    size_t lastLine = std::numeric_limits<size_t>::max();
+    // Fragments of split objects: whether this one has the start and the end.
+    bool hasStart = true;
+    bool hasEnd = true;
+};
+
+struct XFALayoutPage
+{
+    const XFANode *pageArea; // template
+    XFANode *pageAreaInstance; // form node of the master page objects
+    double width, height;
+    std::vector<XFALayoutItem> items; // master page objects first
+};
+
+struct XFALayoutResult
+{
+    std::vector<XFALayoutPage> pages;
+    std::map<int, int> pageOfNode; // node serial -> first page index
+};
+
+XFALayoutResult XFALayoutForm(XFAForm *form);
+
+// Geometry shared by the layout engine and the PDF writer.
+struct XFAInsets
+{
+    double left = 0, top = 0, right = 0, bottom = 0;
+};
+XFAInsets XFAMarginOf(const XFANode *node);
+
+struct XFAFieldGeometry
+{
+    // Rectangles relative to the field's top left corner: x, y, w, h.
+    double captionX = 0, captionY = 0, captionW = 0, captionH = 0;
+    double uiX = 0, uiY = 0, uiW = 0, uiH = 0;
+    bool hasCaption = false;
+};
+XFAFieldGeometry XFAFieldGeometryOf(XFAForm *form, XFANode *field, double w, double h);
+
+#endif
diff --git a/poppler/XFANode.cc b/poppler/XFANode.cc
new file mode 100644
index 0000000..fd86c24
--- /dev/null
+++ b/poppler/XFANode.cc
@@ -0,0 +1,592 @@
+//========================================================================
+//
+// XFANode.cc
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#include <config.h>
+
+#include "XFANode.h"
+
+#include <algorithm>
+#include <cstring>
+#include <map>
+
+//------------------------------------------------------------------------
+// XFADom
+//------------------------------------------------------------------------
+
+XFANode *XFADom::lookup(int serial) const
+{
+    auto it = nodes.find(serial);
+    return it == nodes.end() ? nullptr : it->second;
+}
+
+int XFADom::registerNode(XFANode *node)
+{
+    const int serial = nextSerial++;
+    nodes[serial] = node;
+    return serial;
+}
+
+void XFADom::unregisterNode(int serial)
+{
+    nodes.erase(serial);
+}
+
+//------------------------------------------------------------------------
+// XFANode
+//------------------------------------------------------------------------
+
+XFANode::XFANode(XFADom *domA, std::string classNameA) : dom(domA), className(std::move(classNameA))
+{
+    serial = dom->registerNode(this);
+}
+
+XFANode::~XFANode()
+{
+    // Children first, so lookups never return a node that is half destroyed.
+    children.clear();
+    dom->unregisterNode(serial);
+}
+
+const std::string *XFANode::getAttr(const std::string &name) const
+{
+    for (const auto &a : attributes) {
+        if (a.first == name) {
+            return &a.second;
+        }
+    }
+    return nullptr;
+}
+
+std::string XFANode::getAttr(const std::string &name, const std::string &def) const
+{
+    const std::string *v = getAttr(name);
+    return v ? *v : def;
+}
+
+void XFANode::setAttr(const std::string &name, const std::string &value)
+{
+    for (auto &a : attributes) {
+        if (a.first == name) {
+            a.second = value;
+            return;
+        }
+    }
+    attributes.emplace_back(name, value);
+}
+
+void XFANode::removeAttr(const std::string &name)
+{
+    std::erase_if(attributes, [&name](const auto &a) { return a.first == name; });
+}
+
+std::string XFANode::getName() const
+{
+    return getAttr("name", "");
+}
+
+XFANode *XFANode::appendChild(std::unique_ptr<XFANode> child)
+{
+    child->parent = this;
+    children.push_back(std::move(child));
+    return children.back().get();
+}
+
+XFANode *XFANode::insertChild(size_t pos, std::unique_ptr<XFANode> child)
+{
+    pos = std::min(pos, children.size());
+    child->parent = this;
+    XFANode *raw = child.get();
+    children.insert(children.begin() + pos, std::move(child));
+    return raw;
+}
+
+std::unique_ptr<XFANode> XFANode::removeChild(XFANode *child)
+{
+    for (auto it = children.begin(); it != children.end(); ++it) {
+        if (it->get() == child) {
+            std::unique_ptr<XFANode> removed = std::move(*it);
+            children.erase(it);
+            removed->parent = nullptr;
+            return removed;
+        }
+    }
+    return nullptr;
+}
+
+size_t XFANode::indexInParent() const
+{
+    if (!parent) {
+        return 0;
+    }
+    for (size_t i = 0; i < parent->children.size(); ++i) {
+        if (parent->children[i].get() == this) {
+            return i;
+        }
+    }
+    return 0;
+}
+
+XFANode *XFANode::firstChild(const std::string &cls) const
+{
+    for (const auto &c : children) {
+        if (c->className == cls) {
+            return c.get();
+        }
+    }
+    return nullptr;
+}
+
+std::vector<XFANode *> XFANode::childrenOfClass(const std::string &cls) const
+{
+    std::vector<XFANode *> res;
+    for (const auto &c : children) {
+        if (c->className == cls) {
+            res.push_back(c.get());
+        }
+    }
+    return res;
+}
+
+std::vector<XFANode *> XFANode::elementChildren() const
+{
+    std::vector<XFANode *> res;
+    for (const auto &c : children) {
+        if (!c->isText()) {
+            res.push_back(c.get());
+        }
+    }
+    return res;
+}
+
+std::string XFANode::textContent() const
+{
+    if (isText()) {
+        return text;
+    }
+    std::string res;
+    for (const auto &c : children) {
+        res += c->textContent();
+    }
+    return res;
+}
+
+void XFANode::setTextContent(const std::string &value)
+{
+    children.clear();
+    if (!value.empty()) {
+        auto t = std::make_unique<XFANode>(dom, "#text");
+        t->text = value;
+        appendChild(std::move(t));
+    }
+}
+
+bool XFANode::isContainer() const
+{
+    static const char *const containers[] = { "subform", "field", "draw", "exclGroup", "subformSet", "area", "pageSet", "pageArea", "contentArea" };
+    return ns == Namespace::XFA && std::ranges::any_of(containers, [this](const char *c) { return className == c; });
+}
+
+std::unique_ptr<XFANode> XFANode::clone(XFADom *targetDom) const
+{
+    auto copy = std::make_unique<XFANode>(targetDom, className);
+    copy->ns = ns;
+    copy->text = text;
+    copy->attributes = attributes;
+    copy->proto = proto ? proto : this;
+    for (const auto &c : children) {
+        copy->appendChild(c->clone(targetDom));
+    }
+    return copy;
+}
+
+std::string XFAEscapeXML(const std::string &s)
+{
+    std::string res;
+    res.reserve(s.size());
+    for (char c : s) {
+        switch (c) {
+        case '<':
+            res += "&lt;";
+            break;
+        case '>':
+            res += "&gt;";
+            break;
+        case '&':
+            res += "&amp;";
+            break;
+        case '"':
+            res += "&quot;";
+            break;
+        default:
+            res += c;
+        }
+    }
+    return res;
+}
+
+std::string XFANode::toXML() const
+{
+    if (isText()) {
+        return XFAEscapeXML(text);
+    }
+    std::string res = "<" + className;
+    for (const auto &a : attributes) {
+        res += " " + a.first + "=\"" + XFAEscapeXML(a.second) + "\"";
+    }
+    if (children.empty()) {
+        return res + "/>";
+    }
+    res += ">";
+    for (const auto &c : children) {
+        res += c->toXML();
+    }
+    return res + "</" + className + ">";
+}
+
+//------------------------------------------------------------------------
+// XML parser
+//------------------------------------------------------------------------
+
+namespace {
+
+const char *const xhtmlNamespace = "http://www.w3.org/1999/xhtml";
+const char *const xfaDataNamespace = "http://www.xfa.org/schema/xfa-data/1.0/";
+
+void appendUTF8(std::string &s, unsigned int c)
+{
+    if (c < 0x80) {
+        s += static_cast<char>(c);
+    } else if (c < 0x800) {
+        s += static_cast<char>(0xC0 | (c >> 6));
+        s += static_cast<char>(0x80 | (c & 0x3F));
+    } else if (c < 0x10000) {
+        s += static_cast<char>(0xE0 | (c >> 12));
+        s += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
+        s += static_cast<char>(0x80 | (c & 0x3F));
+    } else {
+        s += static_cast<char>(0xF0 | (c >> 18));
+        s += static_cast<char>(0x80 | ((c >> 12) & 0x3F));
+        s += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
+        s += static_cast<char>(0x80 | (c & 0x3F));
+    }
+}
+
+class XMLParser
+{
+public:
+    XMLParser(const std::string &dataA, XFADom *domA) : data(dataA), dom(domA) { }
+
+    std::unique_ptr<XFANode> parse(std::string *error);
+
+private:
+    struct Scope
+    {
+        std::map<std::string, std::string> prefixes; // prefix -> URI, "" is the default namespace
+    };
+
+    bool atEnd() const { return pos >= data.size(); }
+    bool lookingAt(const char *s) const { return data.compare(pos, strlen(s), s) == 0; }
+    void skipSpace()
+    {
+        while (!atEnd() && (data[pos] == ' ' || data[pos] == '\t' || data[pos] == '\r' || data[pos] == '\n')) {
+            ++pos;
+        }
+    }
+    bool skipPast(const char *s)
+    {
+        size_t p = data.find(s, pos);
+        if (p == std::string::npos) {
+            return false;
+        }
+        pos = p + strlen(s);
+        return true;
+    }
+    std::string parseName()
+    {
+        size_t start = pos;
+        while (!atEnd()) {
+            char c = data[pos];
+            if (c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '=' || c == '>' || c == '/' || c == '"' || c == '\'' || c == '<') {
+                break;
+            }
+            ++pos;
+        }
+        return data.substr(start, pos - start);
+    }
+    std::string decode(size_t start, size_t end);
+    std::string resolve(const std::string &prefix) const;
+    std::unique_ptr<XFANode> parseElement();
+    bool fail(const std::string &msg)
+    {
+        if (errorMsg.empty()) {
+            errorMsg = msg + " at offset " + std::to_string(pos);
+        }
+        return false;
+    }
+
+    const std::string &data;
+    XFADom *dom;
+    size_t pos = 0;
+    std::vector<Scope> scopes;
+    std::string errorMsg;
+};
+
+std::string XMLParser::decode(size_t start, size_t end)
+{
+    std::string res;
+    res.reserve(end - start);
+    for (size_t i = start; i < end; ++i) {
+        if (data[i] != '&') {
+            res += data[i];
+            continue;
+        }
+        size_t semi = data.find(';', i);
+        if (semi == std::string::npos || semi > end) {
+            res += data[i];
+            continue;
+        }
+        const std::string ent = data.substr(i + 1, semi - i - 1);
+        if (ent == "lt") {
+            res += '<';
+        } else if (ent == "gt") {
+            res += '>';
+        } else if (ent == "amp") {
+            res += '&';
+        } else if (ent == "quot") {
+            res += '"';
+        } else if (ent == "apos") {
+            res += '\'';
+        } else if (!ent.empty() && ent[0] == '#') {
+            unsigned int c = 0;
+            if (ent.size() > 1 && (ent[1] == 'x' || ent[1] == 'X')) {
+                c = static_cast<unsigned int>(strtoul(ent.c_str() + 2, nullptr, 16));
+            } else {
+                c = static_cast<unsigned int>(strtoul(ent.c_str() + 1, nullptr, 10));
+            }
+            appendUTF8(res, c);
+        } else {
+            res += data.substr(i, semi - i + 1);
+        }
+        i = semi;
+    }
+    return res;
+}
+
+std::string XMLParser::resolve(const std::string &prefix) const
+{
+    for (auto it = scopes.rbegin(); it != scopes.rend(); ++it) {
+        auto p = it->prefixes.find(prefix);
+        if (p != it->prefixes.end()) {
+            return p->second;
+        }
+    }
+    return {};
+}
+
+std::unique_ptr<XFANode> XMLParser::parseElement()
+{
+    // pos is just after '<'
+    const std::string qname = parseName();
+    if (qname.empty()) {
+        fail("expected element name");
+        return nullptr;
+    }
+
+    std::vector<std::pair<std::string, std::string>> rawAttrs;
+    Scope scope;
+    bool selfClosing = false;
+    while (true) {
+        skipSpace();
+        if (atEnd()) {
+            fail("unterminated start tag");
+            return nullptr;
+        }
+        if (lookingAt("/>")) {
+            pos += 2;
+            selfClosing = true;
+            break;
+        }
+        if (data[pos] == '>') {
+            ++pos;
+            break;
+        }
+        const std::string aname = parseName();
+        skipSpace();
+        if (atEnd() || data[pos] != '=') {
+            fail("expected '='");
+            return nullptr;
+        }
+        ++pos;
+        skipSpace();
+        if (atEnd() || (data[pos] != '"' && data[pos] != '\'')) {
+            fail("expected quoted attribute value");
+            return nullptr;
+        }
+        const char quote = data[pos++];
+        const size_t vend = data.find(quote, pos);
+        if (vend == std::string::npos) {
+            fail("unterminated attribute value");
+            return nullptr;
+        }
+        std::string value = decode(pos, vend);
+        pos = vend + 1;
+        if (aname == "xmlns") {
+            scope.prefixes[""] = value;
+        } else if (aname.starts_with("xmlns:")) {
+            scope.prefixes[aname.substr(6)] = value;
+        } else {
+            rawAttrs.emplace_back(aname, std::move(value));
+        }
+    }
+    scopes.push_back(std::move(scope));
+
+    std::string prefix, local = qname;
+    if (size_t colon = qname.find(':'); colon != std::string::npos) {
+        prefix = qname.substr(0, colon);
+        local = qname.substr(colon + 1);
+    }
+    auto node = std::make_unique<XFANode>(dom, local);
+    const std::string uri = resolve(prefix);
+    if (uri == xhtmlNamespace) {
+        node->setNamespace(XFANode::Namespace::XHTML);
+    } else if (uri.starts_with("http://www.xfa.org/schema/xfa-template/") || uri.empty()) {
+        node->setNamespace(XFANode::Namespace::XFA);
+    } else {
+        node->setNamespace(XFANode::Namespace::Other);
+    }
+    for (auto &a : rawAttrs) {
+        std::string aname = a.first;
+        if (size_t colon = aname.find(':'); colon != std::string::npos) {
+            const std::string aprefix = aname.substr(0, colon);
+            if (resolve(aprefix) == xfaDataNamespace) {
+                aname = "xfa:" + aname.substr(colon + 1);
+            }
+        }
+        node->setAttr(aname, a.second);
+    }
+
+    if (!selfClosing) {
+        while (true) {
+            if (atEnd()) {
+                fail("unterminated element " + qname);
+                return nullptr;
+            }
+            if (lookingAt("</")) {
+                pos += 2;
+                const std::string endName = parseName();
+                skipSpace();
+                if (endName != qname || atEnd() || data[pos] != '>') {
+                    fail("mismatched end tag " + endName + " for " + qname);
+                    return nullptr;
+                }
+                ++pos;
+                break;
+            }
+            if (lookingAt("<!--")) {
+                if (!skipPast("-->")) {
+                    fail("unterminated comment");
+                    return nullptr;
+                }
+                continue;
+            }
+            if (lookingAt("<![CDATA[")) {
+                pos += 9;
+                const size_t end = data.find("]]>", pos);
+                if (end == std::string::npos) {
+                    fail("unterminated CDATA");
+                    return nullptr;
+                }
+                auto t = std::make_unique<XFANode>(dom, "#text");
+                t->setText(data.substr(pos, end - pos));
+                node->appendChild(std::move(t));
+                pos = end + 3;
+                continue;
+            }
+            if (lookingAt("<?")) {
+                if (!skipPast("?>")) {
+                    fail("unterminated processing instruction");
+                    return nullptr;
+                }
+                continue;
+            }
+            if (data[pos] == '<') {
+                ++pos;
+                auto child = parseElement();
+                if (!child) {
+                    return nullptr;
+                }
+                node->appendChild(std::move(child));
+                continue;
+            }
+            const size_t end = data.find('<', pos);
+            const size_t stop = end == std::string::npos ? data.size() : end;
+            auto t = std::make_unique<XFANode>(dom, "#text");
+            t->setText(decode(pos, stop));
+            node->appendChild(std::move(t));
+            pos = stop;
+        }
+    }
+    scopes.pop_back();
+    return node;
+}
+
+std::unique_ptr<XFANode> XMLParser::parse(std::string *error)
+{
+    // Skip a byte order mark, the XML declaration, comments, processing
+    // instructions and a doctype before the root element.
+    if (lookingAt("\xEF\xBB\xBF")) {
+        pos += 3;
+    }
+    while (true) {
+        skipSpace();
+        if (atEnd()) {
+            fail("no root element");
+            break;
+        }
+        if (lookingAt("<?")) {
+            if (!skipPast("?>")) {
+                fail("unterminated processing instruction");
+                break;
+            }
+        } else if (lookingAt("<!--")) {
+            if (!skipPast("-->")) {
+                fail("unterminated comment");
+                break;
+            }
+        } else if (lookingAt("<!")) {
+            if (!skipPast(">")) {
+                fail("unterminated declaration");
+                break;
+            }
+        } else if (data[pos] == '<') {
+            ++pos;
+            auto root = parseElement();
+            if (root) {
+                return root;
+            }
+            break;
+        } else {
+            fail("unexpected character data before root element");
+            break;
+        }
+    }
+    if (error) {
+        *error = errorMsg;
+    }
+    return nullptr;
+}
+
+} // namespace
+
+std::unique_ptr<XFANode> XFAParseXML(const std::string &data, XFADom *dom, std::string *error)
+{
+    XMLParser parser(data, dom);
+    return parser.parse(error);
+}
