+
+NATIVE(formattedValue)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    return n ? strValue(ctx, formOf(ctx)->getFormattedValue(n)) : JS_NULL;
+}
+
+NATIVE(items)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    return strArray(ctx, n ? formOf(ctx)->getItems(n, JS_ToBool(ctx, ARG(1)) == 1) : std::vector<std::string>());
