diff --git a/utils/pdfxfa.cc b/utils/pdfxfa.cc
new file mode 100644
index 0000000..594dfb9
--- /dev/null
+++ b/utils/pdfxfa.cc
@@ -0,0 +1,155 @@
+//========================================================================
+//
+// pdfxfa.cc
+//
+// Converts a dynamic XFA form to a regular PDF file. Fields can be filled
+// in and buttons clicked first, running the scripts of the form.
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#include "config.h"
+#include <poppler-config.h>
+
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "goo/GooString.h"
+#include "GlobalParams.h"
+#include "PDFDoc.h"
+#include "PDFDocFactory.h"
+#include "XFAForm.h"
+
+static void usage()
+{
+    fprintf(stderr,
+            "pdfxfa version %s\n"
+            "Converts a dynamic XFA form to a regular PDF file.\n\n"
+            "Usage: pdfxfa [options] <input.pdf> <output.pdf>\n"
+            "  -set <som>=<value>  set a field; radio groups take the value of a button,\n"
+            "                      lists the value or the text of an item\n"
+            "  -click <som>        click a button\n"
+            "  -print              write the print version, without on-screen objects\n"
+            "  -log                print the messages of the form and its scripts\n"
+            "  -opw <password>     owner password\n"
+            "  -upw <password>     user password\n\n"
+            "SOM expressions are relative to the root subform, for example\n"
+            "  -set 'English.MainForm.PersonGivingConsent.PersonGivingConsentInfo.Names.givingName=Jane Doe'\n"
+            "Actions run in the order given.\n",
+            PACKAGE_VERSION);
+}
+
+int main(int argc, char *argv[])
+{
+    struct Action
+    {
+        bool click;
+        std::string som;
+        std::string value;
+    };
+    std::vector<Action> actions;
+    std::vector<std::string> files;
+    bool forPrint = false, showLog = false;
+    std::optional<GooString> ownerPW, userPW;
+
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg = argv[i];
+        if ((arg == "-set" || arg == "-click" || arg == "-opw" || arg == "-upw") && i + 1 >= argc) {
+            usage();
+            return 99;
+        }
+        if (arg == "-set") {
+            const std::string a = argv[++i];
+            const size_t eq = a.find('=');
+            if (eq == std::string::npos) {
+                fprintf(stderr, "-set needs <som>=<value>\n");
+                return 99;
+            }
+            actions.push_back({ false, a.substr(0, eq), a.substr(eq + 1) });
+        } else if (arg == "-click") {
+            actions.push_back({ true, argv[++i], {} });
+        } else if (arg == "-print") {
+            forPrint = true;
+        } else if (arg == "-log") {
+            showLog = true;
+        } else if (arg == "-opw") {
+            ownerPW = GooString(argv[++i]);
+        } else if (arg == "-upw") {
+            userPW = GooString(argv[++i]);
+        } else if (arg == "-h" || arg == "-help" || arg == "--help" || arg == "-?") {
+            usage();
+            return 0;
+        } else {
+            files.push_back(arg);
+        }
+    }
+    if (files.size() != 2) {
+        usage();
+        return 99;
+    }
+
+    globalParams = std::make_unique<GlobalParams>();
+    std::unique_ptr<PDFDoc> doc = PDFDocFactory().createPDFDoc(GooString(files[0]), ownerPW, userPW);
+    if (!doc->isOk()) {
+        fprintf(stderr, "Error opening %s\n", files[0].c_str());
+        return 1;
+    }
+
+    std::string error;
+    std::unique_ptr<XFAForm> form = XFAForm::load(doc.get(), &error);
+    if (!form) {
+        fprintf(stderr, "%s: %s\n", files[0].c_str(), error.c_str());
+        return 2;
+    }
+
+    int status = 0;
+    for (const Action &a : actions) {
+        const size_t logBefore = form->getLog().size();
+        if (a.click) {
+            form->clickBySOM(a.som);
+        } else {
+            form->setValueBySOM(a.som, a.value);
+        }
+        for (size_t k = logBefore; k < form->getLog().size(); ++k) {
+            if (form->getLog()[k].starts_with("no ")) {
+                status = 3;
+            }
+        }
+    }
+
+    const std::string pdf = form->generatePDF(forPrint);
+
+    if (showLog) {
+        for (const std::string &line : form->getLog()) {
+            fprintf(stderr, "log: %s\n", line.c_str());
+        }
+    }
+    for (const XFAHostRequest &r : form->takeHostRequests()) {
+        switch (r.type) {
+        case XFAHostRequest::Type::Message:
+            fprintf(stderr, "message%s%s: %s\n", r.title.empty() ? "" : " ", r.title.c_str(), r.text.c_str());
+            break;
+        case XFAHostRequest::Type::LaunchURL:
+            fprintf(stderr, "open URL: %s\n", r.text.c_str());
+            break;
+        case XFAHostRequest::Type::Print:
+            fprintf(stderr, "print pages %d to %d\n", r.firstPage + 1, r.lastPage + 1);
+            break;
+        }
+    }
+
+    FILE *f = fopen(files[1].c_str(), "wb");
+    if (!f) {
+        fprintf(stderr, "Cannot write %s\n", files[1].c_str());
+        return 1;
+    }
+    const bool ok = fwrite(pdf.data(), 1, pdf.size(), f) == pdf.size();
+    fclose(f);
+    return ok ? status : 1;
+}
