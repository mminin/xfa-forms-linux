+
+void XFAForm::resetData(XFANode *subtree)
+{
+    std::vector<int> serials;
+    preorder(subtree ? subtree : formRoot, serials);
+    for (int serial : serials) {
+        XFANode *n = formDom.lookup(serial);
+        if (!n || n->getClassName() != "field" || !n->getProto()) {
+            continue;
+        }
+        const XFANode *proto = n->getProto();
+        const XFANode *v = proto->firstChild("value");
+        std::optional<std::string> def;
+        if (v) {
+            for (XFANode *c : v->elementChildren()) {
+                const std::string t = c->textContent();
+                if (!t.empty()) {
+                    def = t;
+                }
+                break;
+            }
+        }
+        setRawValue(n, def);
+    }
+    invalidateLayout();
+}
+
+//------------------------------------------------------------------------
+// Data
+//------------------------------------------------------------------------
+
+static bool bindsData(const XFANode *n)
+{
+    const XFANode *bind = n->firstChild("bind");
+    return !bind || bind->getAttr("match", "once") != "none";
+}
+
+static void saveDataInto(const XFAForm *form, XFANode *node, std::string &out)
+{
+    for (const auto &c : node->getChildren()) {
+        if (c->isText() || !c->isContainer()) {
+            continue;
+        }
+        const std::string &cls = c->getClassName();
+        if (cls == "draw" || !bindsData(c.get())) {
+            continue;
+        }
+        const std::string name = c->getName();
+        if (cls == "field" || cls == "exclGroup") {
+            if (name.empty()) {
+                continue;
+            }
+            const std::optional<std::string> v = form->getRawValue(c.get());
+            out += "<" + name + ">" + XFAEscapeXML(v.value_or("")) + "</" + name + ">";
+        } else if (name.empty()) {
+            saveDataInto(form, c.get(), out);
+        } else {
+            out += "<" + name + ">";
+            saveDataInto(form, c.get(), out);
+            out += "</" + name + ">";
+        }
+    }
+}
+
+std::string XFAForm::saveData(XFANode *node) const
+{
+    const std::string name = node->getName().empty() ? std::string("data") : node->getName();
+    std::string out = "<" + name + ">";
+    saveDataInto(this, node, out);
+    return out + "</" + name + ">";
+}
+
+void XFAForm::loadData(const std::string &xml, bool ignoreRoot, bool /*overwrite*/)
+{
+    std::string error;
+    std::unique_ptr<XFANode> root = XFAParseXML(xml, &formDom, &error);
+    if (!root) {
+        logMessage("loadXML: " + error);
+        return;
+    }
+    if (ignoreRoot) {
+        pendingData = std::move(root);
+        pendingData->setAttr("ignoredRoot", "1");
+    } else {
+        pendingData = std::make_unique<XFANode>(&formDom, "data");
+        pendingData->appendChild(std::move(root));
+    }
+}
+
+static void mergeData(XFAForm *form, XFANode *node, const XFANode *data)
+{
+    std::map<std::string, int> seen;
+    for (const auto &c : node->getChildren()) {
+        if (c->isText() || !c->isContainer() || c->getClassName() == "draw" || !bindsData(c.get())) {
+            continue;
+        }
+        const std::string name = c->getName();
+        if (name.empty()) {
+            mergeData(form, c.get(), data);
+            continue;
+        }
+        const int index = seen[name]++;
+        int k = 0;
+        const XFANode *match = nullptr;
+        for (const auto &d : data->getChildren()) {
+            if (!d->isText() && d->getClassName() == name && k++ == index) {
+                match = d.get();
+                break;
+            }
+        }
+        if (!match) {
+            continue;
+        }
+        if (c->getClassName() == "field" || c->getClassName() == "exclGroup") {
+            const std::string v = match->textContent();
+            form->setRawValue(c.get(), v.empty() ? std::nullopt : std::optional<std::string>(v));
+        } else {
+            mergeData(form, c.get(), match);
+        }
+    }
+}
+
+void XFAForm::applyPendingData(XFANode *node)
+{
+    if (!pendingData) {
+        return;
+    }
+    std::unique_ptr<XFANode> data = std::move(pendingData);
+    const std::string name = node->getName();
+    const XFANode *match = nullptr;
+    for (const auto &d : data->getChildren()) {
+        if (!d->isText() && d->getClassName() == name) {
+            match = d.get();
+            break;
+        }
+    }
+    // With the root ignored, the data holds the children of the subform
+    // it was saved from, which may have had another name.
+    mergeData(this, node, match ? match : data.get());
+}
+
+//------------------------------------------------------------------------
+// Viewer interface
+//------------------------------------------------------------------------
+
+void XFAForm::collectFieldValues(XFANode *node, std::vector<std::pair<int, std::string>> &values) const
+{
+    for (const auto &c : node->getChildren()) {
+        if (c->isText() || !c->isContainer()) {
+            continue;
+        }
+        if (c->getClassName() == "field" || c->getClassName() == "exclGroup") {
+            const std::optional<std::string> v = getRawValue(c.get());
+            values.emplace_back(c->getSerial(), v ? "=" + *v : std::string("null"));
+        }
+        if (c->getClassName() != "field") {
+            collectFieldValues(c.get(), values);
+        }
+    }
+}
+
+XFAForm::VisibleState XFAForm::visibleState()
+{
+    VisibleState state;
+    state.layout = XFAWritePDF(this, getLayout(), false, true);
+    collectFieldValues(formModel.get(), state.values);
+    return state;
+}
+
+bool XFAForm::afterChange(XFANode *editedField, const std::optional<std::string> &shownValue)
+{
+    if (editedField) {
+        for (auto &v : shownState.values) {
+            if (v.first == editedField->getSerial()) {
+                v.second = shownValue ? "=" + *shownValue : std::string("null");
+            }
+        }
+    }
+    const VisibleState now = visibleState();
+    if (now == shownState) {
+        return false;
+    }
+    ++changeCount;
+    return true;
+}
+
+std::string XFAForm::generatePDF(bool forPrint)
+{
+    const XFALayoutResult &lr = getLayout();
+    std::string pdf = XFAWritePDF(this, lr, forPrint, false);
+    if (!forPrint) {
+        shownState = visibleState();
+    }
+    return pdf;
+}
+
+XFANode *XFAForm::fieldByName(const std::string &fieldName) const
+{
+    if (!fieldName.starts_with("xfa")) {
+        return nullptr;
+    }
+    return formDom.lookup(std::atoi(fieldName.c_str() + 3));
+}
+
+bool XFAForm::setFieldText(const std::string &fieldName, const std::string &value)
+{
+    XFANode *field = fieldByName(fieldName);
+    if (!field) {
+        return false;
+    }
+    const int serial = field->getSerial();
+    fireEnterEvents(field);
+    if (!(field = formDom.lookup(serial))) {
+        return afterChange(nullptr, std::nullopt);
+    }
+    EventContext ctx;
+    ctx.activity = "change";
+    ctx.target = field;
+    ctx.prevText = getRawValue(field).value_or("");
+    ctx.newText = value;
+    ctx.change = value;
+    fireEvent(field, "change", &ctx);
+    const std::optional<std::string> v = value.empty() ? std::nullopt : std::optional<std::string>(value);
+    if ((field = formDom.lookup(serial))) {
+        setRawValue(field, v);
+        fireEvent(field, "exit");
+    }
+    if ((field = formDom.lookup(serial))) {
+        runValidations(field);
+    }
+    runCalculations();
+    return afterChange(formDom.lookup(serial), v);
+}
+
+bool XFAForm::setFieldChoice(const std::string &fieldName, int index)
+{
+    XFANode *field = fieldByName(fieldName);
+    if (!field) {
+        return false;
+    }
+    const std::vector<std::string> saves = getItems(field, true);
+    const std::vector<std::string> displays = getItems(field, false);
+    if (index < 0 || index >= static_cast<int>(saves.size())) {
+        return false;
+    }
+    const int serial = field->getSerial();
+    fireEnterEvents(field);
+    if (!(field = formDom.lookup(serial))) {
+        return afterChange(nullptr, std::nullopt);
+    }
+    EventContext ctx;
+    ctx.activity = "change";
+    ctx.target = field;
+    ctx.prevText = getFormattedValue(field);
+    ctx.newText = index < static_cast<int>(displays.size()) ? displays[index] : saves[index];
+    ctx.change = ctx.newText;
+    fireEvent(field, "change", &ctx);
+    if ((field = formDom.lookup(serial))) {
+        setRawValue(field, saves[index]);
+        fireEvent(field, "exit");
+    }
+    if ((field = formDom.lookup(serial))) {
+        runValidations(field);
+    }
+    runCalculations();
+    return afterChange(formDom.lookup(serial), saves[index]);
+}
+
+bool XFAForm::setButtonState(const std::string &fieldName, const std::string &onState, bool state)
+{
+    XFANode *target = fieldByName(fieldName);
+    // Radio buttons are addressed through their exclusion group, the
+    // button itself by its on state "f<serial>".
+    XFANode *button = target;
+    if (onState.starts_with("f")) {
+        if (XFANode *b = formDom.lookup(std::atoi(onState.c_str() + 1))) {
+            button = b;
+        }
+    }
+    if (!button || button->getClassName() != "field") {
+        return false;
+    }
+    if (uiClass(button) == "button") {
+        return state ? clickButton("xfa" + std::to_string(button->getSerial())) : false;
+    }
+    XFANode *group = button->getParent() && button->getParent()->getClassName() == "exclGroup" ? button->getParent() : nullptr;
+    const std::vector<std::string> items = getItems(button, true);
+    const std::string on = items.empty() ? "1" : items[0];
+    const std::string off = items.size() > 1 ? items[1] : std::string();
+    const int buttonSerial = button->getSerial();
+    const int groupSerial = group ? group->getSerial() : 0;
+    fireEnterEvents(button);
+
+    button = formDom.lookup(buttonSerial);
+    group = groupSerial ? formDom.lookup(groupSerial) : nullptr;
+    if (!button) {
+        return afterChange(nullptr, std::nullopt);
+    }
+    std::optional<std::string> newValue = state ? std::optional<std::string>(on) : (off.empty() ? std::nullopt : std::optional<std::string>(off));
+    if (group) {
+        setRawValue(group, newValue);
+    } else {
+        setRawValue(button, newValue);
+    }
+    EventContext ctx;
+    ctx.activity = "click";
+    ctx.target = button;
+    ctx.newText = newValue.value_or("");
+    fireEvent(button, "click", &ctx);
+    ctx.activity = "change";
+    if ((button = formDom.lookup(buttonSerial))) {
+        fireEvent(button, "change", &ctx);
+    }
+    if (groupSerial && (group = formDom.lookup(groupSerial))) {
+        ctx.target = group;
+        fireEvent(group, "change", &ctx);
+    }
+    if ((button = formDom.lookup(buttonSerial))) {
+        fireEvent(button, "exit");
+    }
+    if (groupSerial && (group = formDom.lookup(groupSerial))) {
+        fireEvent(group, "exit");
+        runValidations(group);
+    }
+    runCalculations();
+    XFANode *edited = groupSerial ? formDom.lookup(groupSerial) : formDom.lookup(buttonSerial);
+    return afterChange(edited, newValue);
+}
+
+bool XFAForm::clickButton(const std::string &fieldName)
+{
+    XFANode *field = fieldByName(fieldName);
+    if (!field) {
+        return false;
+    }
+    const int serial = field->getSerial();
+    fireEnterEvents(field);
+    if ((field = formDom.lookup(serial))) {
+        EventContext ctx;
+        ctx.activity = "click";
+        ctx.target = field;
+        fireEvent(field, "click", &ctx);
+    }
+    runCalculations();
+    return afterChange(nullptr, std::nullopt);
+}
+
+bool XFAForm::setValueBySOM(const std::string &som, const std::string &value)
+{
+    XFANode *node = resolveFirst(formRoot, som, false);
+    if (!node) {
+        logMessage("no node for " + som);
+        return false;
+    }
+    const std::string name = "xfa" + std::to_string(node->getSerial());
+    if (node->getClassName() == "exclGroup") {
+        for (XFANode *c : node->childrenOfClass("field")) {
+            const std::vector<std::string> items = getItems(c, true);
+            if (!items.empty() && items[0] == value) {
+                return setButtonState(name, "f" + std::to_string(c->getSerial()), true);
+            }
+        }
+        logMessage("no button with value " + value + " in " + som);
+        return false;
+    }
+    if (node->getClassName() == "field" && uiClass(node) == "choiceList") {
+        const std::vector<std::string> saves = getItems(node, true);
+        const std::vector<std::string> displays = getItems(node, false);
+        for (size_t i = 0; i < saves.size(); ++i) {
+            if (saves[i] == value || (i < displays.size() && displays[i] == value)) {
+                return setFieldChoice(name, static_cast<int>(i));
+            }
+        }
+    }
+    return setFieldText(name, value);
+}
+
+bool XFAForm::clickBySOM(const std::string &som)
+{
+    XFANode *node = resolveFirst(formRoot, som, false);
+    if (!node) {
+        logMessage("no node for " + som);
+        return false;
+    }
+    return clickButton("xfa" + std::to_string(node->getSerial()));
+}
