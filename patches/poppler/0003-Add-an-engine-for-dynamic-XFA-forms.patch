+                                ENTRY(scopeGet, 2),        ENTRY(imFind, 3),        ENTRY(imOf, 1),        ENTRY(imCount, 2),       ENTRY(imAdd, 2),       ENTRY(imRemove, 3),       ENTRY(imSet, 3),
+                                ENTRY(imOccur, 2),         ENTRY(instanceIndex, 1), ENTRY(nameIndex, 1),   ENTRY(rawValue, 1),      ENTRY(setRawValue, 2), ENTRY(formattedValue, 1), ENTRY(items, 2),
+                                ENTRY(pageOf, 1),          ENTRY(pageCount, 0),     ENTRY(pageContent, 3), ENTRY(relayout, 0),      ENTRY(message, 2),     ENTRY(launchURL, 1),      ENTRY(print, 2),
+                                ENTRY(language, 0),        ENTRY(resetData, 1),     ENTRY(saveXML, 1),     ENTRY(loadXML, 3),       ENTRY(removeNode, 1),  ENTRY(appendNode, 2),     ENTRY(createNode, 2),
+                                ENTRY(execValidate, 1),    ENTRY(fireEvent, 2),     ENTRY(runCalcs, 0),    ENTRY(log, 1),           ENTRY(som, 1),         ENTRY(formModel, 0),      ENTRY(templateRoot, 0) };
