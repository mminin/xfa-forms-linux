+
+#ifndef XFATEXT_H
+#define XFATEXT_H
+
+#include "XFAForm.h"
+
+#include <string>
+#include <vector>
+
+// The standard 14 fonts we render XFA text with, and how typefaces map to
+// them. Typefaces that are narrower or wider than the base font they map
+// to get a horizontal scale.
+struct XFAFont
+{
+    std::string typeface = "Courier";
+    double size = 10;
+    bool bold = false;
+    bool italic = false;
+    bool underline = false;
+    XFAColor color;
+    double letterSpacing = 0;
+
+    // Index into the standard fonts, see XFAStandardFontName().
+    int standardFont() const;
+    // Horizontal scale in percent, as used by the PDF Tz operator.
+    double hScale() const;
+    // Line metrics in points.
+    double ascent() const;
+    double descent() const;
+    double lineHeight() const { return ascent() + descent(); }
+    // Width of UTF-8 text in points.
+    double width(const std::string &utf8) const;
+};
+
+const char *XFAStandardFontName(int index);
+// Converts UTF-8 to WinAnsiEncoding, the encoding we use for all fonts.
+std::string XFAToWinAnsi(const std::string &utf8);
+
+struct XFAPara
+{
+    std::string hAlign = "left";
+    std::string vAlign = "top";
+    double marginLeft = 0;
+    double marginRight = 0;
+    double textIndent = 0;
+    double spaceAbove = 0;
+    double spaceBelow = 0;
+    double lineHeight = 0; // 0 for the font's natural line height
+    double tabDefault = 36;
+};
+
+// A run of text in one font. Text may contain '\n' (line break) and '\t'.
+struct XFARun
+{
+    std::string text;
+    XFAFont font;
+    bool preserveSpaces = false;
+};
+
+struct XFAParagraph
+{
+    XFAPara para;
+    XFAFont font; // for empty lines
+    std::vector<XFARun> runs;
+};
+
+struct XFAPlacedRun
+{
+    double x; // from the left of the text area
+    std::string text; // UTF-8
+    XFAFont font;
+};
+
+struct XFALine
+{
+    double top; // from the top of the text block
+    double baseline; // from the top of the text block
+    double height;
+    double width;
+    std::vector<XFAPlacedRun> runs;
+};
+
+struct XFATextBlock
+{
+    std::vector<XFALine> lines;
+    double height = 0;
+    double width = 0; // widest line
+
+    // Height of lines [first, last).
+    double heightOf(size_t first, size_t last) const;
+};
+
+// Font and paragraph properties of a node (field, draw, caption), with
+// XFA defaults and inheritance from the enclosing containers.
+XFAFont XFAFontOf(const XFANode *node);
+XFAPara XFAParaOf(const XFANode *node);
+
+// Builds paragraphs from a <value> node (or a content element such as
+// <text> or <exData>) using font and para as defaults. Values embedded in
+// rich text are looked up in form, SOM references relative to context.
+std::vector<XFAParagraph> XFAParagraphsOf(XFAForm *form, XFANode *context, const XFANode *valueOrContent, const XFAFont &font, const XFAPara &para);
+std::vector<XFAParagraph> XFAParagraphsOfText(const std::string &text, const XFAFont &font, const XFAPara &para);
+
+// Lays out paragraphs in a box availWidth wide. availWidth <= 0 means no
+// wrapping.
+XFATextBlock XFALayoutText(const std::vector<XFAParagraph> &paras, double availWidth);
+
+#endif
