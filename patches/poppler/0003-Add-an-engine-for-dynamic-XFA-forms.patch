+XFAScript::XFAScript(XFAForm *form) : d(std::make_unique<Private>())
+{
+    d->form = form;
+    d->limbo = std::make_unique<XFANode>(form->getFormDom(), "limbo");
+    d->rt = JS_NewRuntime();
+    if (!d->rt) {
+        return;
+    }
+    JS_SetMemoryLimit(d->rt, 256 * 1024 * 1024);
+    JS_SetMaxStackSize(d->rt, 4 * 1024 * 1024);
+    JS_SetInterruptHandler(d->rt, interruptHandler, d.get());
+    d->ctx = JS_NewContext(d->rt);
+    if (!d->ctx) {
+        return;
+    }
+    JS_SetContextOpaque(d->ctx, d.get());
+
+    JSValue global = JS_GetGlobalObject(d->ctx);
+    JSValue n = JS_NewObject(d->ctx);
+    for (const NativeEntry &e : natives) {
+        JS_SetPropertyStr(d->ctx, n, e.name, JS_NewCFunction(d->ctx, e.fn, e.name, e.length));
+    }
+    JS_SetPropertyStr(d->ctx, global, "__xfa", n);
+    JS_FreeValue(d->ctx, global);
+
+    d->deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    JSValue r = JS_Eval(d->ctx, prelude, strlen(prelude), "xfa-prelude.js", JS_EVAL_TYPE_GLOBAL);
+    if (JS_IsException(r)) {
+        form->logMessage("XFA prelude failed: " + exceptionText(d->ctx));
+    } else {
+        d->ok = true;
+    }
+    JS_FreeValue(d->ctx, r);
+}
+
+XFAScript::~XFAScript()
+{
+    if (d->ctx) {
+        JS_FreeContext(d->ctx);
+    }
+    if (d->rt) {
+        JS_FreeRuntime(d->rt);
+    }
+}
+
+bool XFAScript::isAvailable()
+{
+    return true;
+}
+
+void XFAScript::defineScriptObjects(XFANode *container)
+{
+    if (!d->ok) {
+        return;
+    }
+    for (XFANode *vars : container->childrenOfClass("variables")) {
+        for (XFANode *s : vars->childrenOfClass("script")) {
+            const std::string name = s->getName();
+            if (name.empty()) {
+                continue;
+            }
+            JS_UpdateStackTop(d->rt);
+            d->deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+            JSValue global = JS_GetGlobalObject(d->ctx);
+            JSValue fn = JS_GetPropertyStr(d->ctx, global, "__defineScriptObject");
+            JSValue args[3] = { JS_NewInt32(d->ctx, idOfNode(d->form, container)), strValue(d->ctx, name), strValue(d->ctx, s->textContent()) };
+            JSValue r = JS_Call(d->ctx, fn, global, 3, args);
+            if (JS_IsException(r)) {
+                d->form->logMessage("script object " + name + ": " + exceptionText(d->ctx));
+            }
+            for (JSValue &a : args) {
+                JS_FreeValue(d->ctx, a);
+            }
+            JS_FreeValue(d->ctx, r);
+            JS_FreeValue(d->ctx, fn);
+            JS_FreeValue(d->ctx, global);
+        }
+    }
+    for (XFANode *c : container->elementChildren()) {
+        if (c->isContainer() && c->getClassName() != "field" && c->getClassName() != "draw") {
+            defineScriptObjects(c);
+        }
+    }
+}
+
+XFAScript::Result XFAScript::run(XFANode *node, const std::string &source, const XFAForm::EventContext *event)
+{
+    Result res;
+    if (!d->ok) {
+        return res;
+    }
+    JSContext *ctx = d->ctx;
+    JS_UpdateStackTop(d->rt);
+    d->deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+
+    JSValue ev = JS_NULL;
+    if (event) {
+        ev = JS_NewObject(ctx);
+        JS_SetPropertyStr(ctx, ev, "activity", strValue(ctx, event->activity));
+        JS_SetPropertyStr(ctx, ev, "newText", strValue(ctx, event->newText));
+        JS_SetPropertyStr(ctx, ev, "prevText", strValue(ctx, event->prevText));
+        JS_SetPropertyStr(ctx, ev, "change", strValue(ctx, event->change));
+        JS_SetPropertyStr(ctx, ev, "target", idValue(ctx, event->target));
+    }
+    JSValue global = JS_GetGlobalObject(ctx);
+    JSValue fn = JS_GetPropertyStr(ctx, global, "__run");
+    JSValue args[3] = { JS_NewInt32(ctx, idOfNode(d->form, node)), strValue(ctx, source), ev };
+    JSValue r = JS_Call(ctx, fn, global, 3, args);
+    if (JS_IsException(r)) {
+        std::string where = node ? d->form->somExpression(node) : std::string("?");
+        d->form->logMessage("script error in " + where + " (" + (event ? event->activity : std::string("?")) + "): " + exceptionText(ctx));
+    } else {
+        res.ok = true;
+        res.undefined = JS_IsUndefined(r);
+        res.null = JS_IsNull(r);
+        if (!res.undefined && !res.null) {
+            if (JS_IsBool(r)) {
+                res.value = JS_ToBool(ctx, r) ? "1" : "0";
+            } else {
+                res.value = strArg(ctx, r);
+            }
+        }
+    }
+    for (JSValue &a : args) {
+        JS_FreeValue(ctx, a);
+    }
+    JS_FreeValue(ctx, r);
+    JS_FreeValue(ctx, fn);
+    JS_FreeValue(ctx, global);
+    return res;
+}
+
+#else // !HAVE_XFA_SCRIPTING
+
+struct XFAScript::Private
+{
+};
+
+XFAScript::XFAScript(XFAForm *) : d(std::make_unique<Private>()) { }
+
+XFAScript::~XFAScript() = default;
+
+bool XFAScript::isAvailable()
+{
+    return false;
+}
+
+void XFAScript::defineScriptObjects(XFANode *) { }
+
+XFAScript::Result XFAScript::run(XFANode *, const std::string &, const XFAForm::EventContext *)
+{
+    return {};
+}
+
+#endif
