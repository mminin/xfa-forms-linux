+//------------------------------------------------------------------------
+// Measurements and colors
+//------------------------------------------------------------------------
+
+double XFAParseNumber(const char *s, const char **end, double def)
+{
+    const char *p = s;
+    while (*p == ' ' || *p == '\t') {
+        ++p;
+    }
+    bool negative = false;
+    if (*p == '-' || *p == '+') {
+        negative = *p == '-';
+        ++p;
+    }
+    double v = 0;
+    bool digits = false;
+    while (*p >= '0' && *p <= '9') {
+        v = v * 10 + (*p - '0');
+        ++p;
+        digits = true;
+    }
+    if (*p == '.') {
+        ++p;
+        double scale = 0.1;
+        while (*p >= '0' && *p <= '9') {
+            v += (*p - '0') * scale;
+            scale /= 10;
+            ++p;
+            digits = true;
+        }
+    }
+    if (!digits) {
+        if (end) {
+            *end = s;
+        }
+        return def;
+    }
+    if ((*p == 'e' || *p == 'E') && ((p[1] >= '0' && p[1] <= '9') || ((p[1] == '-' || p[1] == '+') && p[2] >= '0' && p[2] <= '9'))) {
+        ++p;
+        bool negExp = false;
+        if (*p == '-' || *p == '+') {
+            negExp = *p == '-';
+            ++p;
+        }
+        int e = 0;
+        while (*p >= '0' && *p <= '9') {
+            e = std::min(e * 10 + (*p - '0'), 400);
+            ++p;
+        }
+        v *= std::pow(10.0, negExp ? -e : e);
+    }
+    if (end) {
+        *end = p;
+    }
+    return negative ? -v : v;
+}
+
+double XFAMeasure(const std::string &value, double def)
+{
+    const char *s = value.c_str();
+    const char *end = nullptr;
+    const double v = XFAParseNumber(s, &end);
+    if (end == s) {
+        return def;
+    }
+    std::string unit(end);
+    while (!unit.empty() && unit.back() == ' ') {
+        unit.pop_back();
+    }
+    if (unit.empty() || unit == "in") {
+        return v * 72.0;
+    }
+    if (unit == "pt") {
+        return v;
+    }
+    if (unit == "mm") {
+        return v * 72.0 / 25.4;
+    }
+    if (unit == "cm") {
+        return v * 72.0 / 2.54;
+    }
+    if (unit == "mp") {
+        return v / 1000.0;
+    }
+    if (unit == "px") {
+        return v * 0.75;
+    }
+    return v * 72.0;
+}
+
+double XFAMeasureAttr(const XFANode *node, const char *attr, double def)
+{
+    const std::string *v = node ? node->getAttr(attr) : nullptr;
+    return v ? XFAMeasure(*v, def) : def;
+}
+
+XFAColor XFAParseColor(const std::string &value, XFAColor def)
+{
+    double c[3];
+    int n = 0;
+    const char *s = value.c_str();
+    while (n < 3 && *s) {
+        const char *end = nullptr;
+        const double v = XFAParseNumber(s, &end);
+        if (end == s) {
+            break;
+        }
+        c[n++] = std::clamp(v, 0.0, 255.0) / 255.0;
+        s = end;
+        while (*s == ',' || *s == ' ') {
+            ++s;
+        }
+    }
+    if (n != 3) {
+        return def;
+    }
+    return { c[0], c[1], c[2] };
+}
+
+//------------------------------------------------------------------------
+// SOM expressions
+//------------------------------------------------------------------------
+
+namespace {
+
+struct SomStep
+{
+    enum Kind
+    {
+        Name,
+        Class,
+        Any
+    };
+    enum Index
+    {
+        Default,
+        Number,
+        All
+    };
+    Kind kind = Name;
+    std::string name;
+    Index index = Default;
+    int number = 0;
+};
+
+std::vector<SomStep> parseSom(const std::string &som)
+{
+    std::vector<SomStep> steps;
+    std::string token;
+    int depth = 0;
+    std::vector<std::string> tokens;
+    for (char c : som) {
+        if (c == '[') {
+            ++depth;
+        } else if (c == ']') {
+            --depth;
+        }
+        if (c == '.' && depth == 0) {
+            tokens.push_back(token);
+            token.clear();
+        } else {
+            token += c;
+        }
+    }
+    tokens.push_back(token);
+
+    for (std::string t : tokens) {
+        while (!t.empty() && t.front() == ' ') {
+            t.erase(t.begin());
+        }
+        while (!t.empty() && t.back() == ' ') {
+            t.pop_back();
+        }
+        if (t.empty()) {
+            continue; // ".." descendant searches are treated like "."
+        }
+        SomStep step;
+        std::string name = t;
+        if (size_t br = t.find('['); br != std::string::npos) {
+            name = t.substr(0, br);
+            std::string idx = t.substr(br + 1);
+            if (!idx.empty() && idx.back() == ']') {
+                idx.pop_back();
+            }
+            if (idx == "*") {
+                step.index = SomStep::All;
+            } else {
+                step.index = SomStep::Number;
+                step.number = std::atoi(idx.c_str()[0] == '+' ? idx.c_str() + 1 : idx.c_str());
+            }
+        }
+        if (name == "*") {
+            step.kind = SomStep::Any;
+        } else if (!name.empty() && name[0] == '#') {
+            step.kind = SomStep::Class;
+            step.name = name.substr(1);
+        } else {
+            step.name = name;
+        }
+        steps.push_back(step);
+    }
+    return steps;
+}
+
+bool isTransparent(const XFANode *n)
+{
+    const std::string &c = n->getClassName();
+    return n->getNamespace() == XFANode::Namespace::XFA && (c == "subform" || c == "subformSet" || c == "area") && n->getName().empty();
+}
+
+void collectNamed(const XFANode *node, const std::string &name, std::vector<XFANode *> &out)
+{
+    for (const auto &c : node->getChildren()) {
+        if (c->isText()) {
+            continue;
+        }
+        const std::string *n = c->getAttr("name");
+        if (n && *n == name) {
+            out.push_back(c.get());
+        } else if (isTransparent(c.get())) {
+            collectNamed(c.get(), name, out);
+        }
+    }
+}
+
+std::vector<XFANode *> findChildren(const XFANode *node, const SomStep &step)
+{
+    std::vector<XFANode *> res;
+    switch (step.kind) {
+    case SomStep::Class:
+        for (const auto &c : node->getChildren()) {
+            if (!c->isText() && c->getClassName() == step.name) {
+                res.push_back(c.get());
+            }
+        }
+        break;
+    case SomStep::Any:
+        res = node->elementChildren();
+        break;
+    case SomStep::Name:
+        collectNamed(node, step.name, res);
+        if (res.empty()) {
+            // Properties such as value, border or caption.
+            for (const auto &c : node->getChildren()) {
+                if (!c->isText() && c->getClassName() == step.name && !c->getAttr("name")) {
+                    res.push_back(c.get());
+                }
+            }
+        }
+        break;
+    }
+    return res;
+}
+
+void select(const std::vector<XFANode *> &matches, const SomStep &step, std::vector<XFANode *> &out)
+{
+    if (matches.empty()) {
+        return;
+    }
+    switch (step.index) {
+    case SomStep::Default:
+        out.push_back(matches.front());
+        break;
+    case SomStep::Number:
+        if (step.number >= 0 && step.number < static_cast<int>(matches.size())) {
+            out.push_back(matches[step.number]);
+        }
+        break;
+    case SomStep::All:
+        out.insert(out.end(), matches.begin(), matches.end());
+        break;
+    }
+}
+
+bool isRepeatable(const XFANode *n)
+{
+    const std::string &c = n->getClassName();
+    return c == "subform" || c == "subformSet";
+}
+
+int occurAttr(const XFANode *templ, const char *attr, int def)
+{
+    const XFANode *occur = templ->firstChild("occur");
+    if (!occur) {
+        return def;
+    }
+    const std::string *v = occur->getAttr(attr);
+    return v ? std::atoi(v->c_str()) : def;
+}
+
+int initialCount(const XFANode *templ)
+{
+    if (!isRepeatable(templ)) {
+        return 1;
+    }
+    const int min = occurAttr(templ, "min", 1);
+    return std::max(0, occurAttr(templ, "initial", min));
+}
+
+void preorder(XFANode *node, std::vector<int> &serials)
+{
+    serials.push_back(node->getSerial());
+    for (const auto &c : node->getChildren()) {
+        if (!c->isText() && (c->isContainer() || c->getClassName() == "pageSet")) {
+            preorder(c.get(), serials);
+        }
+    }
+}
+
+const XFANode *scriptOf(const XFANode *holder)
+{
+    // <event>, <calculate> and <validate> hold their script directly.
+    return holder ? holder->firstChild("script") : nullptr;
+}
+
+std::string scriptSource(const XFANode *script, bool *runnable)
+{
+    const std::string type = script->getAttr("contentType", "application/x-javascript");
+    *runnable = type.find("javascript") != std::string::npos || type.find("ecmascript") != std::string::npos;
+    return script->textContent();
+}
+
+} // namespace
+
+//------------------------------------------------------------------------
+// Loading
+//------------------------------------------------------------------------
+
+XFAForm::XFAForm() = default;
+
+XFAForm::~XFAForm()
+{
+    // Scripts hold references to nodes; drop them first.
+    script.reset();
+}
+
+std::unique_ptr<XFAForm> XFAForm::load(PDFDoc *doc, std::string *error)
+{
+    std::unique_ptr<XFAForm> form(new XFAForm());
+    if (!form->build(doc, error)) {
+        return nullptr;
+    }
+    return form;
+}
+
+static bool readXDP(PDFDoc *doc, std::string *xdp, std::string *error)
+{
+    Catalog *catalog = doc->getCatalog();
+    if (!catalog || !catalog->isOk() || !catalog->getAcroForm()->isDict()) {
+        *error = "document has no AcroForm";
+        return false;
+    }
+    Object xfa = catalog->getAcroForm()->dictLookup("XFA");
+    auto readStream = [](Object &obj) -> std::string {
+        if (!obj.isStream()) {
+            return {};
+        }
+        std::string s;
+        obj.getStream()->fillString(s);
+        return s;
+    };
+    if (xfa.isStream()) {
+        *xdp = readStream(xfa);
+    } else if (xfa.isArray()) {
+        for (int i = 1; i < xfa.arrayGetLength(); i += 2) {
+            Object packet = xfa.arrayGet(i);
+            *xdp += readStream(packet);
+        }
+    } else {
+        *error = "document has no XFA form";
+        return false;
+    }
+    if (xdp->empty()) {
+        *error = "XFA form is empty";
+        return false;
+    }
+    return true;
+}
+
+bool XFAForm::build(PDFDoc *doc, std::string *error)
+{
+    std::string xdp;
+    if (!readXDP(doc, &xdp, error)) {
+        return false;
+    }
+    std::string parseError;
+    xdpRoot = XFAParseXML(xdp, &templateDom, &parseError);
+    if (!xdpRoot) {
+        *error = "malformed XFA: " + parseError;
+        return false;
+    }
+    std::function<XFANode *(XFANode *)> findTemplate = [&](XFANode *n) -> XFANode * {
+        if (n->getClassName() == "template" && n->getNamespace() == XFANode::Namespace::XFA) {
+            return n;
+        }
+        for (const auto &c : n->getChildren()) {
+            if (XFANode *t = c->isText() ? nullptr : findTemplate(c.get())) {
+                return t;
+            }
+        }
+        return nullptr;
+    };
+    templateNode = findTemplate(xdpRoot.get());
+    XFANode *rootSubform = templateNode ? templateNode->firstChild("subform") : nullptr;
+    if (!rootSubform) {
+        *error = "XFA form has no template";
+        return false;
+    }
+
+    // The host language decides which language bilingual forms start in.
+    const char *envs[] = { "LC_ALL", "LC_MESSAGES", "LANG" };
+    language = "en_US";
+    for (const char *e : envs) {
+        const char *v = getenv(e);
+        if (v && *v && strcmp(v, "C") != 0 && strcmp(v, "POSIX") != 0) {
+            language = v;
+            if (size_t dot = language.find('.'); dot != std::string::npos) {
+                language.resize(dot);
+            }
+            break;
+        }
+    }
+
+    formModel = std::make_unique<XFANode>(&formDom, "form");
+    formRoot = formModel->appendChild(instantiate(rootSubform));
+
+    script = std::make_unique<XFAScript>(this);
+    if (!XFAScript::isAvailable()) {
+        logMessage("poppler was built without JavaScript; XFA scripts will not run");
+    }
+    script->defineScriptObjects(formRoot);
+
+    // Form initialization, as done by Adobe Reader: initialize events,
+    // calculations, then the document ready event.
+    initializeSubtree(formRoot);
+    std::vector<int> serials;
+    preorder(formRoot, serials);
+    for (int serial : serials) {
+        if (XFANode *n = formDom.lookup(serial)) {
+            fireEvent(n, "docReady");
+        }
+    }
+    runCalculations();
+    shownState = visibleState();
+    return true;
+}
+
+std::unique_ptr<XFANode> XFAForm::instantiate(const XFANode *templ)
+{
+    auto node = std::make_unique<XFANode>(&formDom, templ->getClassName());
+    node->setNamespace(templ->getNamespace());
+    node->setProto(templ);
+    for (const auto &a : templ->getAttrs()) {
+        node->setAttr(a.first, a.second);
+    }
+    for (const auto &c : templ->getChildren()) {
+        if (c->isText()) {
+            continue;
+        }
+        const std::string &cls = c->getClassName();
+        if (c->isContainer() && cls != "pageSet" && cls != "pageArea" && cls != "contentArea") {
+            const int n = initialCount(c.get());
+            for (int i = 0; i < n; ++i) {
+                node->appendChild(instantiate(c.get()));
+            }
+        } else if (cls == "pageSet") {
+            auto ps = std::make_unique<XFANode>(&formDom, "pageSet");
+            ps->setProto(c.get());
+            for (const auto &a : c->getAttrs()) {
+                ps->setAttr(a.first, a.second);
+            }
+            XFANode *added = node->appendChild(std::move(ps));
+            if (!pageSetInstance) {
+                pageSetInstance = added;
+            }
+        } else {
+            node->appendChild(c->clone(&formDom));
+        }
+    }
+    return node;
+}
+
+//------------------------------------------------------------------------
+// SOM
+//------------------------------------------------------------------------
+
+std::vector<XFANode *> XFAForm::resolve(XFANode *context, const std::string &som, bool implicit) const
+{
+    const std::vector<SomStep> steps = parseSom(som);
+    if (steps.empty()) {
+        return {};
+    }
+    std::vector<XFANode *> current;
+    size_t i = 0;
+    const SomStep &first = steps[0];
+    if (first.kind == SomStep::Name && first.name == "xfa") {
+        if (steps.size() < 2) {
+            return {};
+        }
+        const std::string &model = steps[1].name;
+        if (model == "form") {
+            current.push_back(formModel.get());
+        } else if (model == "template") {
+            current.push_back(templateNode);
+        } else {
+            return {};
+        }
+        i = 2;
+    } else if (first.kind == SomStep::Name && first.name == "$form") {
+        current.push_back(formModel.get());
+        i = 1;
+    } else if (first.kind == SomStep::Name && first.name == "$template") {
+        current.push_back(templateNode);
+        i = 1;
+    } else if (first.kind == SomStep::Name && first.name == "$") {
+        current.push_back(context);
+        i = 1;
+    } else if (first.kind == SomStep::Name && (first.name.starts_with("$") || first.name == "!")) {
+        return {};
+    } else {
+        // Relative: search the scope of context, then of its ancestors.
+        for (XFANode *n = context; n; n = n->getParent()) {
+            const std::vector<XFANode *> matches = findChildren(n, first);
+            if (!matches.empty()) {
+                select(matches, first, current);
+                break;
+            }
+            if (!implicit && n == context && first.kind == SomStep::Class) {
+                break;
+            }
+        }
+        if (current.empty() && context == formModel.get()) {
+            return {};
+        }
+        i = 1;
+    }
+    for (; i < steps.size() && !current.empty(); ++i) {
+        std::vector<XFANode *> next;
+        for (XFANode *n : current) {
+            select(findChildren(n, steps[i]), steps[i], next);
+        }
+        current = std::move(next);
+    }
+    return current;
+}
+
+XFANode *XFAForm::resolveFirst(XFANode *context, const std::string &som, bool implicit) const
+{
+    const std::vector<XFANode *> r = resolve(context, som, implicit);
+    return r.empty() ? nullptr : r.front();
+}
+
+std::vector<XFANode *> XFAForm::childrenByName(XFANode *node, const std::string &name) const
+{
+    SomStep step;
+    if (!name.empty() && name[0] == '#') {
+        step.kind = SomStep::Class;
+        step.name = name.substr(1);
+    } else {
+        step.name = name;
+    }
+    return findChildren(node, step);
+}
+
+std::string XFAForm::somExpression(XFANode *node) const
+{
+    std::vector<std::string> parts;
+    for (XFANode *n = node; n && n != formModel.get(); n = n->getParent()) {
+        const std::string name = n->getName();
+        const int index = name.empty() ? instanceIndex(n) : nameIndex(n);
+        parts.push_back((name.empty() ? "#" + n->getClassName() : name) + "[" + std::to_string(index) + "]");
+    }
+    std::string som = "xfa[0].form[0]";
+    for (auto it = parts.rbegin(); it != parts.rend(); ++it) {
+        som += "." + *it;
+    }
+    return som;
+}
+
+XFANode *XFAForm::findById(const std::string &id, XFANode *context) const
+{
+    std::function<XFANode *(XFANode *, const XFANode *)> search = [&](XFANode *n, const XFANode *skip) -> XFANode * {
+        if (n == skip) {
+            return nullptr;
+        }
+        const std::string *v = n->getAttr("id");
+        if (v && *v == id) {
+            return n;
+        }
+        for (const auto &c : n->getChildren()) {
+            if (XFANode *r = c->isText() ? nullptr : search(c.get(), skip)) {
+                return r;
+            }
+        }
+        return nullptr;
+    };
+    const XFANode *searched = nullptr;
+    for (XFANode *n = context ? context : formModel.get(); n; n = n->getParent()) {
+        if (XFANode *r = search(n, searched)) {
+            return r;
+        }
+        searched = n;
+    }
+    return nullptr;
+}
+
+//------------------------------------------------------------------------
+// Instance managers
+//------------------------------------------------------------------------
+
+static std::optional<XFAForm::InstanceManager> findTemplateChild(XFANode *formNode, const std::string &name)
+{
+    const XFANode *proto = formNode->getProto();
+    if (!proto) {
+        return std::nullopt;
+    }
+    for (const auto &t : proto->getChildren()) {
+        if (t->isText() || !isRepeatable(t.get())) {
+            continue;
+        }
+        if (t->getName() == name) {
+            return XFAForm::InstanceManager { formNode, t.get() };
+        }
+        if (isTransparent(t.get())) {
+            for (const auto &c : formNode->getChildren()) {
+                if (c->getProto() == t.get()) {
+                    if (auto r = findTemplateChild(c.get(), name)) {
+                        return r;
+                    }
+                }
+            }
+        }
+    }
+    return std::nullopt;
+}
+
+std::optional<XFAForm::InstanceManager> XFAForm::findInstanceManager(XFANode *context, const std::string &name, bool implicit) const
+{
+    for (XFANode *n = context; n; n = n->getParent()) {
+        if (auto r = findTemplateChild(n, name)) {
+            return r;
+        }
+        if (!implicit) {
+            break;
+        }
+    }
+    return std::nullopt;
+}
+
+std::vector<XFANode *> XFAForm::instances(const InstanceManager &im) const
+{
+    std::vector<XFANode *> res;
+    for (const auto &c : im.parent->getChildren()) {
+        if (c->getProto() == im.proto) {
+            res.push_back(c.get());
+        }
+    }
+    return res;
+}
+
+XFANode *XFAForm::addInstance(const InstanceManager &im)
+{
+    const std::vector<XFANode *> existing = instances(im);
+    size_t pos = im.parent->getChildren().size();
+    if (!existing.empty()) {
+        pos = existing.back()->indexInParent() + 1;
+    } else {
+        // Keep the template order: insert before the first node made from
+        // a template sibling that comes after im.proto.
+        const XFANode *templParent = im.proto->getParent();
+        const size_t templIndex = im.proto->indexInParent();
+        const auto &children = im.parent->getChildren();
+        for (size_t k = 0; k < children.size(); ++k) {
+            const XFANode *p = children[k]->getProto();
+            if (p && p->getParent() == templParent && p->indexInParent() > templIndex) {
+                pos = k;
+                break;
+            }
+        }
+    }
+    XFANode *node = im.parent->insertChild(pos, instantiate(im.proto));
+    applyPendingData(node);
+    invalidateLayout();
+    initializeSubtree(node);
+    runCalculations();
+    return node;
+}
+
+void XFAForm::removeInstance(const InstanceManager &im, int index)
+{
+    const std::vector<XFANode *> existing = instances(im);
+    if (index < 0 || index >= static_cast<int>(existing.size())) {
+        return;
+    }
+    im.parent->removeChild(existing[index]);
+    invalidateLayout();
+    runCalculations();
+}
+
+void XFAForm::setInstances(const InstanceManager &im, int count)
+{
+    count = std::max(count, 0);
+    while (static_cast<int>(instances(im).size()) < count) {
+        if (!addInstance(im)) {
+            break;
+        }
+    }
+    while (true) {
+        const int n = static_cast<int>(instances(im).size());
+        if (n <= count) {
+            break;
+        }
+        removeInstance(im, n - 1);
+    }
+}
+
+int XFAForm::instanceIndex(XFANode *node) const
+{
+    XFANode *parent = node->getParent();
+    if (!parent) {
+        return 0;
+    }
+    int i = 0;
+    for (const auto &c : parent->getChildren()) {
+        if (c.get() == node) {
+            return i;
+        }
+        if (c->getProto() && c->getProto() == node->getProto()) {
+            ++i;
+        }
+    }
+    return 0;
+}
+
+int XFAForm::nameIndex(XFANode *node) const
+{
+    XFANode *parent = node->getParent();
+    if (!parent) {
+        return 0;
+    }
+    // Siblings with the same name, looking through unnamed subforms.
+    XFANode *scope = parent;
+    while (scope->getParent() && isTransparent(scope)) {
+        scope = scope->getParent();
+    }
+    std::vector<XFANode *> same;
+    const std::string name = node->getName();
+    if (name.empty()) {
+        return instanceIndex(node);
+    }
+    collectNamed(scope, name, same);
+    for (size_t i = 0; i < same.size(); ++i) {
+        if (same[i] == node) {
+            return static_cast<int>(i);
+        }
+    }
+    return 0;
+}
+
+//------------------------------------------------------------------------
+// Values
+//------------------------------------------------------------------------
+
+std::string XFAForm::uiClass(const XFANode *field) const
+{
+    if (const XFANode *ui = field->firstChild("ui")) {
+        for (XFANode *c : ui->elementChildren()) {
+            if (c->getClassName() != "picture" && c->getClassName() != "extras") {
+                return c->getClassName();
+            }
+        }
+    }
+    return "textEdit";
+}
+
+std::vector<std::string> XFAForm::getItems(XFANode *field, bool saveValues) const
+{
+    const std::vector<XFANode *> lists = field->childrenOfClass("items");
+    const XFANode *display = nullptr, *save = nullptr;
+    for (const XFANode *l : lists) {
+        const bool isSave = l->getAttr("save", "0") == "1" || l->getAttr("presence", "visible") == "hidden";
+        if (isSave && !save) {
+            save = l;
+        } else if (!isSave && !display) {
+            display = l;
+        }
+    }
+    if (!display) {
+        display = save;
+    }
+    if (!save) {
+        save = display;
+    }
+    const XFANode *chosen = saveValues ? save : display;
+    std::vector<std::string> res;
+    if (chosen) {
+        for (XFANode *c : chosen->elementChildren()) {
+            res.push_back(c->textContent());
+        }
+    }
+    return res;
+}
+
+static XFANode *valueContent(XFANode *node, bool create)
+{
+    XFANode *value = node->firstChild("value");
+    if (!value) {
+        if (!create) {
+            return nullptr;
+        }
+        value = node->appendChild(std::make_unique<XFANode>(node->getDom(), "value"));
+    }
+    for (XFANode *c : value->elementChildren()) {
+        return c;
+    }
+    if (!create) {
+        return nullptr;
+    }
+    return value->appendChild(std::make_unique<XFANode>(node->getDom(), "text"));
+}
+
+std::optional<std::string> XFAForm::getRawValue(XFANode *node) const
+{
+    const std::string &cls = node->getClassName();
+    if (cls == "exclGroup") {
+        for (XFANode *c : node->childrenOfClass("field")) {
+            const std::optional<std::string> v = getRawValue(c);
+            const std::vector<std::string> items = getItems(c, true);
+            const std::string on = items.empty() ? "1" : items[0];
+            if (v && *v == on) {
+                return v;
+            }
+        }
+        return std::nullopt;
+    }
+    if (cls != "field" && cls != "draw") {
+        return std::nullopt;
+    }
+    XFANode *content = valueContent(node, false);
+    if (!content) {
+        return std::nullopt;
+    }
+    std::string text = content->textContent();
+    if (text.empty()) {
+        return std::nullopt;
+    }
+    return text;
+}
+
+void XFAForm::setRawValue(XFANode *node, const std::optional<std::string> &value)
+{
+    const std::string &cls = node->getClassName();
+    if (cls == "exclGroup") {
+        for (XFANode *c : node->childrenOfClass("field")) {
+            const std::vector<std::string> items = getItems(c, true);
+            const std::string on = items.empty() ? "1" : items[0];
+            const std::string off = items.size() > 1 ? items[1] : std::string();
+            if (value && *value == on) {
+                setRawValue(c, on);
+            } else {
+                setRawValue(c, off.empty() ? std::nullopt : std::optional<std::string>(off));
+            }
+        }
+        return;
+    }
+    if (cls != "field" && cls != "draw") {
+        return;
+    }
+    XFANode *content = valueContent(node, true);
+    if (content->getClassName() == "exData") {
+        // Plain values replace rich text.
+        XFANode *v = content->getParent();
+        v->removeChild(content);
+        content = v->appendChild(std::make_unique<XFANode>(node->getDom(), "text"));
+    }
+    const std::string newText = value.value_or("");
+    if (content->textContent() == newText) {
+        return;
+    }
+    content->setTextContent(newText);
+    nodeChanged(node);
+}
+
+std::string XFAForm::getFormattedValue(XFANode *node) const
+{
+    const std::optional<std::string> raw = getRawValue(node);
+    if (!raw) {
+        return {};
+    }
+    if (node->getClassName() == "field" && uiClass(node) == "choiceList") {
+        const std::vector<std::string> saves = getItems(node, true);
+        const std::vector<std::string> displays = getItems(node, false);
+        for (size_t i = 0; i < saves.size() && i < displays.size(); ++i) {
+            if (saves[i] == *raw) {
+                return displays[i];
+            }
+        }
+    }
+    return *raw;
+}
+
+std::string XFAForm::getPresence(const XFANode *node) const
+{
+    return node->getAttr("presence", "visible");
+}
+
+bool XFAForm::isLaidOut(const XFANode *node) const
+{
+    for (const XFANode *n = node; n; n = n->getParent()) {
+        const std::string p = getPresence(n);
+        if (p == "hidden" || p == "inactive") {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool XFAForm::affectsLayout(const XFANode *node) const
+{
+    // Find the container whose size may depend on this node.
+    const XFANode *c = node;
+    while (c && !c->isContainer()) {
+        c = c->getParent();
+    }
+    if (!c) {
+        return false;
+    }
+    if (c->getClassName() == "field" || c->getClassName() == "draw") {
+        // Fields with an id can be embedded in rich text, whose size then
+        // depends on their value.
+        return !c->getAttr("w") || !c->getAttr("h") || c->getAttr("id");
+    }
+    return true;
+}
+
+void XFAForm::nodeChanged(XFANode *node)
+{
+    if (affectsLayout(node)) {
+        invalidateLayout();
+    }
+}
+
+//------------------------------------------------------------------------
+// Events
+//------------------------------------------------------------------------
+
+void XFAForm::fireEvent(XFANode *node, const std::string &activity, EventContext *ctx)
+{
+    const int serial = node->getSerial();
+    // Collect first: scripts may change the node.
+    std::vector<std::string> sources;
+    for (XFANode *ev : node->childrenOfClass("event")) {
+        if (ev->getAttr("activity", "click") != activity) {
+            continue;
+        }
+        const XFANode *s = scriptOf(ev);
+        if (!s) {
+            continue;
+        }
+        bool runnable;
+        std::string src = scriptSource(s, &runnable);
+        if (!runnable) {
+            logMessage("skipping non-JavaScript " + activity + " script");
+            continue;
+        }
+        sources.push_back(std::move(src));
+    }
+    for (const std::string &src : sources) {
+        XFANode *n = formDom.lookup(serial);
+        if (!n) {
+            return;
+        }
+        EventContext local;
+        local.activity = activity;
+        local.target = n;
+        script->run(n, src, ctx ? ctx : &local);
+    }
+}
+
+void XFAForm::fireEventRecursive(XFANode *node, const std::string &activity)
+{
+    std::vector<int> serials;
+    preorder(node, serials);
+    for (int serial : serials) {
+        if (XFANode *n = formDom.lookup(serial)) {
+            fireEvent(n, activity);
+        }
+    }
+}
+
+void XFAForm::initializeSubtree(XFANode *node)
+{
+    fireEventRecursive(node, "initialize");
+}
+
+void XFAForm::runCalculations()
+{
+    if (calcDepth > 0) {
+        return;
+    }
+    ++calcDepth;
+    std::vector<int> serials;
+    preorder(formModel.get(), serials);
+    for (int serial : serials) {
+        XFANode *n = formDom.lookup(serial);
+        if (!n) {
+            continue;
+        }
+        const XFANode *s = scriptOf(n->firstChild("calculate"));
+        if (!s) {
+            continue;
+        }
+        bool runnable;
+        const std::string src = scriptSource(s, &runnable);
+        if (!runnable) {
+            continue;
+        }
+        EventContext ctx;
+        ctx.activity = "calculate";
+        ctx.target = n;
+        const XFAScript::Result r = script->run(n, src, &ctx);
+        n = formDom.lookup(serial);
+        if (n && r.ok && !r.undefined) {
+            setRawValue(n, r.null ? std::nullopt : std::optional<std::string>(r.value));
+        }
+    }
+    --calcDepth;
+}
+
+bool XFAForm::runValidations(XFANode *node)
+{
+    std::vector<int> serials;
+    preorder(node, serials);
+    for (int serial : serials) {
+        XFANode *n = formDom.lookup(serial);
+        if (!n) {
+            continue;
+        }
+        const XFANode *s = scriptOf(n->firstChild("validate"));
+        if (!s) {
+            continue;
+        }
+        bool runnable;
+        const std::string src = scriptSource(s, &runnable);
+        if (runnable) {
+            EventContext ctx;
+            ctx.activity = "validate";
+            ctx.target = n;
+            script->run(n, src, &ctx);
+        }
+    }
+    return true;
+}
+
+void XFAForm::fireEnterEvents(XFANode *node)
+{
+    std::vector<int> chain;
+    for (XFANode *n = node->getParent(); n; n = n->getParent()) {
+        if (n->getClassName() == "subform") {
+            chain.push_back(n->getSerial());
+        }
+    }
+    for (auto it = chain.rbegin(); it != chain.rend(); ++it) {
+        if (XFANode *n = formDom.lookup(*it)) {
+            fireEvent(n, "enter");
+        }
+    }
+    if (XFANode *n = formDom.lookup(node->getSerial())) {
+        fireEvent(n, "enter");
+    }
+}
+
+//------------------------------------------------------------------------
+// Layout
+//------------------------------------------------------------------------
+
+const XFALayoutResult &XFAForm::getLayout()
+{
+    if (layout) {
+        return *layout;
+    }
+    // Layout-dependent scripts, such as page numbers on master pages, may
+    // change the size of objects: lay out again until nothing changes.
+    for (int pass = 0; pass < 4; ++pass) {
+        inLayout = true;
+        layoutDirty = false;
+        layout = std::make_unique<XFALayoutResult>(XFALayoutForm(this));
+        std::vector<int> serials;
+        preorder(formModel.get(), serials);
+        for (int serial : serials) {
+            if (XFANode *n = formDom.lookup(serial)) {
+                fireEvent(n, "ready");
+            }
+        }
+        runCalculations();
+        inLayout = false;
+        if (!layoutDirty) {
+            break;
+        }
+    }
+    return *layout;
+}
+
+void XFAForm::invalidateLayout()
+{
+    if (inLayout) {
+        layoutDirty = true;
+    } else {
+        layout.reset();
+    }
+}
+
+XFANode *XFAForm::pageInstance(const XFANode *pageArea, size_t index)
+{
+    if (!pageSetInstance) {
+        return nullptr;
+    }
+    const auto &existing = pageSetInstance->getChildren();
+    if (index < existing.size() && existing[index]->getProto() == pageArea) {
+        return existing[index].get();
+    }
+    trimPageInstances(index);
+    auto inst = std::make_unique<XFANode>(&formDom, "pageArea");
+    inst->setProto(pageArea);
+    for (const auto &a : pageArea->getAttrs()) {
+        inst->setAttr(a.first, a.second);
+    }
+    for (const auto &c : pageArea->getChildren()) {
+        if (c->isText()) {
+            continue;
+        }
+        if (c->isContainer() && c->getClassName() != "contentArea") {
+            inst->appendChild(instantiate(c.get()));
+        } else {
+            inst->appendChild(c->clone(&formDom));
+        }
+    }
+    return pageSetInstance->appendChild(std::move(inst));
+}
+
+void XFAForm::trimPageInstances(size_t count)
+{
+    if (!pageSetInstance) {
+        return;
+    }
+    while (pageSetInstance->getChildren().size() > count) {
+        pageSetInstance->removeChild(pageSetInstance->getChildren().back().get());
+    }
+}
+
+int XFAForm::pageOf(XFANode *node)
+{
+    const XFALayoutResult &lr = getLayout();
+    for (XFANode *n = node; n; n = n->getParent()) {
+        auto it = lr.pageOfNode.find(n->getSerial());
+        if (it != lr.pageOfNode.end()) {
+            return it->second;
+        }
+    }
+    return -1;
+}
+
+int XFAForm::pageCount()
+{
+    return static_cast<int>(getLayout().pages.size());
+}
+
+std::vector<XFANode *> XFAForm::pageContent(int pageIndex, const std::string &cls, bool pageAreaOnly)
+{
+    std::vector<XFANode *> res;
+    const XFALayoutResult &lr = getLayout();
+    if (pageIndex < 0 || pageIndex >= static_cast<int>(lr.pages.size())) {
+        return res;
+    }
+    const XFALayoutPage &page = lr.pages[pageIndex];
+    for (const XFALayoutItem &item : page.items) {
+        if (pageAreaOnly) {
+            bool master = false;
+            for (XFANode *n = item.node; n; n = n->getParent()) {
+                if (n == page.pageAreaInstance) {
+                    master = true;
+                    break;
+                }
+            }
+            if (!master) {
+                continue;
+            }
+        }
+        if ((cls.empty() || item.node->getClassName() == cls) && std::ranges::find(res, item.node) == res.end()) {
+            res.push_back(item.node);
+        }
+    }
+    return res;
+}
