index 0000000..091521b
--- /dev/null
+++ b/poppler/XFAText.cc
@@ -0,0 +1,814 @@
+//========================================================================
+//
+// XFAText.cc
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#include <config.h>
+
+#include "XFAText.h"
+
+#include "BuiltinFont.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstring>
+
+// Only builtinFonts is needed here.
+[[maybe_unused]] static const BuiltinFont *const *const unusedSubst = builtinFontSubst;
+
+namespace {
+
+//------------------------------------------------------------------------
+// Typefaces
+//------------------------------------------------------------------------
+
+enum Family
+{
+    Courier,
+    Helvetica,
+    Times,
+    Symbol,
+    Dingbats
+};
+
+struct FaceInfo
+{
+    Family family;
+    double scale; // horizontal scale, percent
+    bool bold; // the face is bold by design
+    double ascent; // per unit of font size
+    double descent;
+};
+
+std::string lower(std::string s)
+{
+    std::ranges::transform(s, s.begin(), [](unsigned char c) { return std::tolower(c); });
+    return s;
+}
+
+FaceInfo faceInfo(const std::string &typeface)
+{
+    const std::string t = lower(typeface);
+    if (t.find("courier") != std::string::npos || t.find("mono") != std::string::npos) {
+        return { Courier, 100, false, 0.833, 0.300 };
+    }
+    if (t.find("times") != std::string::npos || t.find("serif") != std::string::npos || t.find("georgia") != std::string::npos || t.find("garamond") != std::string::npos) {
+        return { Times, 100, false, 0.891, 0.216 };
+    }
+    if (t.find("symbol") != std::string::npos) {
+        return { Symbol, 100, false, 1.010, 0.293 };
+    }
+    if (t.find("dingbat") != std::string::npos || t.find("wingding") != std::string::npos) {
+        return { Dingbats, 100, false, 0.820, 0.143 };
+    }
+    if (t.find("black") != std::string::npos) {
+        return { Helvetica, 108, true, 1.100, 0.310 };
+    }
+    if (t.find("narrow") != std::string::npos || t.find("condensed") != std::string::npos) {
+        return { Helvetica, 82, false, 0.936, 0.212 };
+    }
+    if (t.find("myriad") != std::string::npos) {
+        return { Helvetica, 90, false, 0.952, 0.268 };
+    }
+    return { Helvetica, 100, false, 0.905, 0.212 };
+}
+
+// Decodes one UTF-8 sequence starting at s[i], advancing i.
+unsigned int nextCodePoint(const std::string &s, size_t &i)
+{
+    const unsigned char c = s[i++];
+    if (c < 0x80) {
+        return c;
+    }
+    int extra;
+    unsigned int cp;
+    if ((c & 0xE0) == 0xC0) {
+        extra = 1;
+        cp = c & 0x1F;
+    } else if ((c & 0xF0) == 0xE0) {
+        extra = 2;
+        cp = c & 0x0F;
+    } else if ((c & 0xF8) == 0xF0) {
+        extra = 3;
+        cp = c & 0x07;
+    } else {
+        return 0xFFFD;
+    }
+    for (int k = 0; k < extra; ++k) {
+        if (i >= s.size() || (static_cast<unsigned char>(s[i]) & 0xC0) != 0x80) {
+            return 0xFFFD;
+        }
+        cp = (cp << 6) | (static_cast<unsigned char>(s[i++]) & 0x3F);
+    }
+    return cp;
+}
+
+int winAnsiCode(unsigned int cp)
+{
+    if (cp >= 0x20 && cp <= 0xFF && cp != 0x7F) {
+        return static_cast<int>(cp);
+    }
+    static const struct
+    {
+        unsigned int cp;
+        int code;
+    } specials[] = { { 0x20AC, 0x80 }, { 0x201A, 0x82 }, { 0x0192, 0x83 }, { 0x201E, 0x84 }, { 0x2026, 0x85 }, { 0x2020, 0x86 }, { 0x2021, 0x87 }, { 0x02C6, 0x88 }, { 0x2030, 0x89 }, { 0x0160, 0x8A }, { 0x2039, 0x8B }, { 0x0152, 0x8C },
+                     { 0x017D, 0x8E }, { 0x2018, 0x91 }, { 0x2019, 0x92 }, { 0x201C, 0x93 }, { 0x201D, 0x94 }, { 0x2022, 0x95 }, { 0x2013, 0x96 }, { 0x2014, 0x97 }, { 0x02DC, 0x98 }, { 0x2122, 0x99 }, { 0x0161, 0x9A }, { 0x203A, 0x9B },
+                     { 0x0153, 0x9C }, { 0x017E, 0x9E }, { 0x0178, 0x9F }, { 0x2010, '-' },  { 0x2011, '-' },  { 0x2012, '-' },  { 0x2212, '-' },  { 0x00A0, 0xA0 }, { 0x2002, ' ' },  { 0x2003, ' ' },  { 0x2009, ' ' } };
+    for (const auto &sp : specials) {
+        if (sp.cp == cp) {
+            return sp.code;
+        }
+    }
+    return '?';
+}
+
+std::string trim(const std::string &s)
+{
+    size_t a = 0, b = s.size();
+    while (a < b && std::isspace(static_cast<unsigned char>(s[a]))) {
+        ++a;
+    }
+    while (b > a && std::isspace(static_cast<unsigned char>(s[b - 1]))) {
+        --b;
+    }
+    return s.substr(a, b - a);
+}
+
+} // namespace
+
+//------------------------------------------------------------------------
+// XFAFont
+//------------------------------------------------------------------------
+
+int XFAFont::standardFont() const
+{
+    const FaceInfo fi = faceInfo(typeface);
+    const bool b = bold || fi.bold;
+    switch (fi.family) {
+    case Courier:
+        return b ? (italic ? 2 : 1) : (italic ? 3 : 0);
+    case Helvetica:
+        return b ? (italic ? 6 : 5) : (italic ? 7 : 4);
+    case Times:
+        return b ? (italic ? 10 : 9) : (italic ? 11 : 12);
+    case Symbol:
+        return 8;
+    case Dingbats:
+        return 13;
+    }
+    return 4;
+}
+
+double XFAFont::hScale() const
+{
+    return faceInfo(typeface).scale;
+}
+
+double XFAFont::ascent() const
+{
+    return faceInfo(typeface).ascent * size;
+}
+
+double XFAFont::descent() const
+{
+    return faceInfo(typeface).descent * size;
+}
+
+double XFAFont::width(const std::string &utf8) const
+{
+    const BuiltinFont &bf = builtinFonts[standardFont()];
+    double w = 0;
+    int n = 0;
+    for (size_t i = 0; i < utf8.size();) {
+        const int code = winAnsiCode(nextCodePoint(utf8, i));
+        const char *glyph = winAnsiEncoding[code];
+        unsigned short gw = 0;
+        if (!glyph || !bf.getWidth(glyph, &gw)) {
+            bf.getWidth("question", &gw);
+        }
+        w += gw;
+        ++n;
+    }
+    return w * size / 1000.0 * hScale() / 100.0 + letterSpacing * n;
+}
+
+const char *XFAStandardFontName(int index)
+{
+    return builtinFonts[index].name.c_str();
+}
+
+std::string XFAToWinAnsi(const std::string &utf8)
+{
+    std::string res;
+    res.reserve(utf8.size());
+    for (size_t i = 0; i < utf8.size();) {
+        res += static_cast<char>(winAnsiCode(nextCodePoint(utf8, i)));
+    }
+    return res;
+}
+
+double XFATextBlock::heightOf(size_t first, size_t last) const
+{
+    if (first >= last || first >= lines.size()) {
+        return 0;
+    }
+    last = std::min(last, lines.size());
+    return lines[last - 1].top + lines[last - 1].height - lines[first].top;
+}
+
+//------------------------------------------------------------------------
+// Font and paragraph properties
+//------------------------------------------------------------------------
+
+static void applyFontElement(XFAFont &font, const XFANode *fontNode)
+{
+    if (!fontNode) {
+        return;
+    }
+    if (const std::string *v = fontNode->getAttr("typeface")) {
+        font.typeface = *v;
+    }
+    if (fontNode->getAttr("size")) {
+        font.size = XFAMeasureAttr(fontNode, "size", font.size);
+    }
+    if (const std::string *v = fontNode->getAttr("weight")) {
+        font.bold = *v == "bold";
+    }
+    if (const std::string *v = fontNode->getAttr("posture")) {
+        font.italic = *v == "italic";
+    }
+    if (const std::string *v = fontNode->getAttr("underline")) {
+        font.underline = *v != "0";
+    }
+    if (fontNode->getAttr("letterSpacing")) {
+        font.letterSpacing = XFAMeasureAttr(fontNode, "letterSpacing", 0);
+    }
+    if (const XFANode *fill = fontNode->firstChild("fill")) {
+        if (const XFANode *color = fill->firstChild("color")) {
+            font.color = XFAParseColor(color->getAttr("value", "0,0,0"));
+        }
+    }
+}
+
+XFAFont XFAFontOf(const XFANode *node)
+{
+    XFAFont font;
+    if (!node) {
+        return font;
+    }
+    // Captions and items use the font of their field unless they have
+    // their own.
+    if (node->getClassName() == "caption" && node->getParent()) {
+        applyFontElement(font, node->getParent()->firstChild("font"));
+    }
+    applyFontElement(font, node->firstChild("font"));
+    return font;
+}
+
+XFAPara XFAParaOf(const XFANode *node)
+{
+    XFAPara para;
+    const XFANode *p = node ? node->firstChild("para") : nullptr;
+    if (!p) {
+        return para;
+    }
+    para.hAlign = p->getAttr("hAlign", para.hAlign);
+    para.vAlign = p->getAttr("vAlign", para.vAlign);
+    para.marginLeft = XFAMeasureAttr(p, "marginLeft", 0);
+    para.marginRight = XFAMeasureAttr(p, "marginRight", 0);
+    para.textIndent = XFAMeasureAttr(p, "textIndent", 0);
+    para.spaceAbove = XFAMeasureAttr(p, "spaceAbove", 0);
+    para.spaceBelow = XFAMeasureAttr(p, "spaceBelow", 0);
+    para.lineHeight = XFAMeasureAttr(p, "lineHeight", 0);
+    para.tabDefault = XFAMeasureAttr(p, "tabDefault", 36);
+    if (para.tabDefault <= 0) {
+        para.tabDefault = 36;
+    }
+    return para;
+}
+
+//------------------------------------------------------------------------
+// Rich text
+//------------------------------------------------------------------------
+
+// U+2028 LINE SEPARATOR and U+2029 PARAGRAPH SEPARATOR break lines in XFA.
+static std::string normalizeBreaks(std::string t)
+{
+    std::erase(t, '\r');
+    for (const char *sep : { "\xE2\x80\xA8", "\xE2\x80\xA9" }) {
+        for (size_t pos = t.find(sep); pos != std::string::npos; pos = t.find(sep, pos)) {
+            t.replace(pos, 3, "\n");
+        }
+    }
+    return t;
+}
+
+namespace {
+
+struct Style
+{
+    XFAFont font;
+    bool spaceRun = false;
+};
+
+std::vector<std::pair<std::string, std::string>> parseStyle(const std::string &style)
+{
+    std::vector<std::pair<std::string, std::string>> res;
+    size_t start = 0;
+    while (start < style.size()) {
+        size_t end = style.find(';', start);
+        if (end == std::string::npos) {
+            end = style.size();
+        }
+        const std::string decl = style.substr(start, end - start);
+        if (size_t colon = decl.find(':'); colon != std::string::npos) {
+            res.emplace_back(lower(trim(decl.substr(0, colon))), trim(decl.substr(colon + 1)));
+        }
+        start = end + 1;
+    }
+    return res;
+}
+
+double cssLength(const std::string &v, double def)
+{
+    if (v.empty()) {
+        return def;
+    }
+    if (v.ends_with("px")) {
+        return XFAParseNumber(v.c_str(), nullptr) * 0.75;
+    }
+    return XFAMeasure(v, def);
+}
+
+XFAColor cssColor(const std::string &v, XFAColor def)
+{
+    if (v.size() == 7 && v[0] == '#') {
+        const unsigned long c = std::strtoul(v.c_str() + 1, nullptr, 16);
+        return { ((c >> 16) & 0xFF) / 255.0, ((c >> 8) & 0xFF) / 255.0, (c & 0xFF) / 255.0 };
+    }
+    if (v.starts_with("rgb(")) {
+        return XFAParseColor(v.substr(4, v.size() - 5), def);
+    }
+    return def;
+}
+
+void applyFontStyle(XFAFont &font, const std::string &key, const std::string &value)
+{
+    if (key == "font-family") {
+        std::string f = value;
+        if (size_t comma = f.find(','); comma != std::string::npos) {
+            f = f.substr(0, comma);
+        }
+        f = trim(f);
+        if (f.size() >= 2 && (f.front() == '\'' || f.front() == '"')) {
+            f = f.substr(1, f.size() - 2);
+        }
+        if (!f.empty()) {
+            font.typeface = f;
+        }
+    } else if (key == "font-size") {
+        font.size = cssLength(value, font.size);
+    } else if (key == "font-weight") {
+        font.bold = value == "bold" || value == "bolder" || std::atoi(value.c_str()) >= 600;
+    } else if (key == "font-style") {
+        font.italic = value == "italic" || value == "oblique";
+    } else if (key == "text-decoration") {
+        font.underline = value.find("underline") != std::string::npos;
+    } else if (key == "color") {
+        font.color = cssColor(value, font.color);
+    } else if (key == "letter-spacing") {
+        font.letterSpacing = cssLength(value, 0);
+    }
+}
+
+class RichTextBuilder
+{
+public:
+    RichTextBuilder(XFAForm *formA, XFANode *contextA, const XFAFont &fontA, const XFAPara &paraA) : form(formA), context(contextA), baseFont(fontA), basePara(paraA) { }
+
+    std::vector<XFAParagraph> build(const XFANode *body)
+    {
+        Style style;
+        style.font = baseFont;
+        walk(body, style);
+        finishParagraph();
+        return paras;
+    }
+
+private:
+    void startParagraph(const XFAPara &para, const XFAFont &font)
+    {
+        finishParagraph();
+        current = XFAParagraph();
+        current.para = para;
+        current.font = font;
+        open = true;
+    }
+
+    void finishParagraph()
+    {
+        if (open) {
+            paras.push_back(std::move(current));
+            open = false;
+        }
+    }
+
+    void addText(const std::string &text, const Style &style, bool preserve)
+    {
+        if (!open) {
+            startParagraph(basePara, style.font);
+        }
+        if (!current.runs.empty()) {
+            XFARun &last = current.runs.back();
+            if (last.preserveSpaces == preserve && last.font.typeface == style.font.typeface && last.font.size == style.font.size && last.font.bold == style.font.bold && last.font.italic == style.font.italic
+                && last.font.underline == style.font.underline) {
+                last.text += text;
+                return;
+            }
+        }
+        current.runs.push_back({ text, style.font, preserve });
+    }
+
+    std::string embeddedValue(const XFANode *span)
+    {
+        const std::string ref = span->getAttr("xfa:embed", "");
+        const std::string type = span->getAttr("xfa:embedType", "som");
+        const std::string mode = span->getAttr("xfa:embedMode", "formatted");
+        XFANode *target = nullptr;
+        if (type == "uri") {
+            target = form->findById(ref.starts_with("#") ? ref.substr(1) : ref, context);
+        } else {
+            target = form->resolveFirst(context, ref, true);
+        }
+        if (!target) {
+            return {};
+        }
+        if (mode == "raw") {
+            return form->getRawValue(target).value_or("");
+        }
+        return form->getFormattedValue(target);
+    }
+
+    void walk(const XFANode *node, Style style)
+    {
+        for (const auto &child : node->getChildren()) {
+            if (child->isText()) {
+                addText(normalizeBreaks(child->getText()), style, style.spaceRun);
+                continue;
+            }
+            const std::string &cls = child->getClassName();
+            Style s = style;
+            XFAPara para = open ? current.para : basePara;
+            bool tabs = false;
+            int tabCount = 0;
+            for (const auto &[key, value] : parseStyle(child->getAttr("style", ""))) {
+                applyFontStyle(s.font, key, value);
+                if (key == "xfa-spacerun") {
+                    s.spaceRun = value == "yes";
+                } else if (key == "xfa-tab-count") {
+                    tabs = true;
+                    tabCount = std::atoi(value.c_str());
+                } else if (key == "text-align") {
+                    para.hAlign = value == "justify" ? "left" : value;
+                } else if (key == "margin-left") {
+                    para.marginLeft = cssLength(value, para.marginLeft);
+                } else if (key == "margin-right") {
+                    para.marginRight = cssLength(value, para.marginRight);
+                } else if (key == "text-indent") {
+                    para.textIndent = cssLength(value, para.textIndent);
+                } else if (key == "margin-top") {
+                    para.spaceAbove = cssLength(value, para.spaceAbove);
+                } else if (key == "margin-bottom") {
+                    para.spaceBelow = cssLength(value, para.spaceBelow);
+                } else if (key == "line-height") {
+                    para.lineHeight = cssLength(value, para.lineHeight);
+                }
+            }
+            if (cls == "b" || cls == "strong") {
+                s.font.bold = true;
+            } else if (cls == "i" || cls == "em") {
+                s.font.italic = true;
+            } else if (cls == "u") {
+                s.font.underline = true;
+            }
+
+            if (cls == "p" || cls == "div" || cls == "li") {
+                startParagraph(para, s.font);
+                walk(child.get(), s);
+                finishParagraph();
+            } else if (cls == "br") {
+                addText("\n", s, true);
+            } else if (child->getAttr("xfa:embed")) {
+                addText(embeddedValue(child.get()), s, true);
+            } else if (tabs) {
+                addText(std::string(std::max(tabCount, 0), '\t'), s, true);
+            } else {
+                walk(child.get(), s);
+            }
+        }
+    }
+
+    XFAForm *form;
+    XFANode *context;
+    XFAFont baseFont;
+    XFAPara basePara;
+    std::vector<XFAParagraph> paras;
+    XFAParagraph current;
+    bool open = false;
+};
+
+} // namespace
+
+std::vector<XFAParagraph> XFAParagraphsOfText(const std::string &text, const XFAFont &font, const XFAPara &para)
+{
+    XFAParagraph p;
+    p.para = para;
+    p.font = font;
+    const std::string t = normalizeBreaks(text);
+    p.runs.push_back({ t, font, true });
+    return { p };
+}
+
+std::vector<XFAParagraph> XFAParagraphsOf(XFAForm *form, XFANode *context, const XFANode *valueOrContent, const XFAFont &font, const XFAPara &para)
+{
+    if (!valueOrContent) {
+        return {};
+    }
+    const XFANode *content = valueOrContent;
+    if (content->getClassName() == "value") {
+        const auto elems = content->elementChildren();
+        if (elems.empty()) {
+            return {};
+        }
+        content = elems.front();
+    }
+    if (content->getClassName() == "exData") {
+        for (const auto &c : content->getChildren()) {
+            if (!c->isText() && c->getNamespace() == XFANode::Namespace::XHTML) {
+                RichTextBuilder builder(form, context, font, para);
+                return builder.build(c.get());
+            }
+        }
+    }
+    return XFAParagraphsOfText(content->textContent(), font, para);
+}
+
+//------------------------------------------------------------------------
+// Line breaking
+//------------------------------------------------------------------------
+
+namespace {
+
+struct Atom
+{
+    enum Kind
+    {
+        Word,
+        Space,
+        Tab,
+        Break
+    };
+    Kind kind;
+    std::string text;
+    const XFAFont *font;
+    double width;
+};
+
+std::vector<Atom> atomize(const XFAParagraph &p)
+{
+    std::vector<Atom> atoms;
+    bool lastWasSpace = true; // collapses leading spaces
+    for (const XFARun &run : p.runs) {
+        const std::string &t = run.text;
+        size_t i = 0;
+        while (i < t.size()) {
+            const char c = t[i];
+            if (c == '\n') {
+                atoms.push_back({ Atom::Break, {}, &run.font, 0 });
+                lastWasSpace = true;
+                ++i;
+            } else if (c == '\t' && run.preserveSpaces) {
+                atoms.push_back({ Atom::Tab, {}, &run.font, 0 });
+                lastWasSpace = true;
+                ++i;
+            } else if (c == ' ' || c == '\t' || c == '\r') {
+                size_t j = i;
+                while (j < t.size() && (t[j] == ' ' || ((t[j] == '\t' || t[j] == '\r') && !run.preserveSpaces))) {
+                    ++j;
+                }
+                if (run.preserveSpaces) {
+                    const std::string spaces(j - i, ' ');
+                    atoms.push_back({ Atom::Space, spaces, &run.font, run.font.width(spaces) });
+                } else if (!lastWasSpace) {
+                    atoms.push_back({ Atom::Space, " ", &run.font, run.font.width(" ") });
+                }
+                lastWasSpace = true;
+                i = j;
+            } else {
+                size_t j = i;
+                while (j < t.size() && t[j] != ' ' && t[j] != '\t' && t[j] != '\n' && t[j] != '\r') {
+                    ++j;
+                }
+                const std::string word = t.substr(i, j - i);
+                atoms.push_back({ Atom::Word, word, &run.font, run.font.width(word) });
+                lastWasSpace = false;
+                i = j;
+            }
+        }
+    }
+    return atoms;
+}
+
+class LineBuilder
+{
+public:
+    LineBuilder(XFATextBlock &blockA, const XFAParagraph &paraA, double availWidthA) : block(blockA), p(paraA), availWidth(availWidthA) { }
+
+    void run()
+    {
+        y = block.height + p.para.spaceAbove;
+        const std::vector<Atom> atoms = atomize(p);
+        startLine();
+        for (const Atom &a : atoms) {
+            switch (a.kind) {
+            case Atom::Break:
+                endLine(a.font);
+                startLine();
+                break;
+            case Atom::Space:
+                if (!line.runs.empty() || a.text.size() > 1 || preserveLeading(a)) {
+                    pendingSpace += a.width;
+                    pendingSpaceText += a.text;
+                    pendingFont = a.font;
+                }
+                break;
+            case Atom::Tab: {
+                const double tab = p.para.tabDefault;
+                double target = std::floor((x + pendingSpace - left()) / tab + 1) * tab + left();
+                if (limit() > 0 && target > limit() && !line.runs.empty()) {
+                    endLine(a.font);
+                    startLine();
+                    target = left() + tab;
+                }
+                x = target;
+                pendingSpace = 0;
+                pendingSpaceText.clear();
+                break;
+            }
+            case Atom::Word:
+                placeWord(a);
+                break;
+            }
+        }
+        endLine(nullptr);
+        block.height = y + p.para.spaceBelow;
+    }
+
+private:
+    bool preserveLeading(const Atom &a) const { return a.text.size() > 1; }
+    double left() const { return p.para.marginLeft + (firstLine ? p.para.textIndent : 0); }
+    double limit() const { return availWidth > 0 ? availWidth - p.para.marginRight : 0; }
+
+    void startLine()
+    {
+        line = XFALine();
+        x = left();
+        pendingSpace = 0;
+        pendingSpaceText.clear();
+    }
+
+    void placeText(const std::string &text, const XFAFont *font, double width)
+    {
+        if (!line.runs.empty()) {
+            XFAPlacedRun &last = line.runs.back();
+            if (std::abs(last.x + last.font.width(last.text) - x) < 0.01 && last.font.standardFont() == font->standardFont() && last.font.size == font->size && last.font.underline == font->underline
+                && last.font.hScale() == font->hScale()) {
+                last.text += text;
+                x += width;
+                return;
+            }
+        }
+        line.runs.push_back({ x, text, *font });
+        x += width;
+    }
+
+    void placeWord(const Atom &a)
+    {
+        const bool fits = limit() <= 0 || x + pendingSpace + a.width <= limit() + 0.01;
+        if (!fits && !line.runs.empty()) {
+            endLine(a.font);
+            startLine();
+        }
+        if (pendingSpace > 0 && !line.runs.empty()) {
+            placeText(pendingSpaceText, pendingFont, pendingSpace);
+        } else if (pendingSpace > 0 && pendingSpaceText.size() > 1) {
+            x += pendingSpace;
+        }
+        pendingSpace = 0;
+        pendingSpaceText.clear();
+
+        if (limit() > 0 && x + a.width > limit() + 0.01 && x <= left() + 0.01) {
+            // A word wider than the line: break it between characters.
+            std::string piece;
+            double pieceWidth = 0;
+            for (size_t i = 0; i < a.text.size();) {
+                size_t j = i + 1;
+                while (j < a.text.size() && (static_cast<unsigned char>(a.text[j]) & 0xC0) == 0x80) {
+                    ++j;
+                }
+                const std::string ch = a.text.substr(i, j - i);
+                const double cw = a.font->width(ch);
+                if (!piece.empty() && x + pieceWidth + cw > limit()) {
+                    placeText(piece, a.font, pieceWidth);
+                    endLine(a.font);
+                    startLine();
+                    piece.clear();
+                    pieceWidth = 0;
+                }
+                piece += ch;
+                pieceWidth += cw;
+                i = j;
+            }
+            if (!piece.empty()) {
+                placeText(piece, a.font, pieceWidth);
+            }
+            return;
+        }
+        placeText(a.text, a.font, a.width);
+    }
+
+    void endLine(const XFAFont *fallback)
+    {
+        double ascent = 0, descent = 0;
+        for (const auto &r : line.runs) {
+            ascent = std::max(ascent, r.font.ascent());
+            descent = std::max(descent, r.font.descent());
+        }
+        if (line.runs.empty()) {
+            const XFAFont &f = fallback ? *fallback : p.font;
+            ascent = f.ascent();
+            descent = f.descent();
+        }
+        double height = ascent + descent;
+        if (p.para.lineHeight > 0) {
+            height = p.para.lineHeight;
+        }
+        line.top = y;
+        line.baseline = y + ascent;
+        line.height = height;
+        line.width = 0;
+        for (const auto &r : line.runs) {
+            line.width = std::max(line.width, r.x + r.font.width(r.text));
+        }
+        if (availWidth > 0 && !line.runs.empty()) {
+            const double used = line.width - line.runs.front().x;
+            const double room = limit() - left();
+            double shift = 0;
+            if (p.para.hAlign == "center") {
+                shift = (room - used) / 2 + left() - line.runs.front().x;
+            } else if (p.para.hAlign == "right") {
+                shift = room - used + left() - line.runs.front().x;
+            }
+            if (shift != 0) {
+                for (auto &r : line.runs) {
+                    r.x += shift;
+                }
+                line.width += shift;
+            }
+        }
+        block.width = std::max(block.width, line.width + p.para.marginRight);
+        block.lines.push_back(std::move(line));
+        y += height;
+        firstLine = false;
+    }
+
+    XFATextBlock &block;
+    const XFAParagraph &p;
+    double availWidth;
+    XFALine line;
+    double x = 0;
+    double y = 0;
+    double pendingSpace = 0;
+    std::string pendingSpaceText;
+    const XFAFont *pendingFont = nullptr;
+    bool firstLine = true;
+};
+
+} // namespace
+
+XFATextBlock XFALayoutText(const std::vector<XFAParagraph> &paras, double availWidth)
+{
+    XFATextBlock block;
+    for (const XFAParagraph &p : paras) {
+        LineBuilder builder(block, p, availWidth);
+        builder.run();
+    }
+    return block;
+}
