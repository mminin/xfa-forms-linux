+}
+
+NATIVE(resolve)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    return idArray(ctx, n ? formOf(ctx)->resolve(n, strArg(ctx, ARG(1)), false) : std::vector<XFANode *>());
