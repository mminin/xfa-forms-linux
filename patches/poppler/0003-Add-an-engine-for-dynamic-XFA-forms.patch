+class Writer
+{
+public:
+    Writer(XFAForm *formA, bool forPrintA, bool blankValuesA) : form(formA), forPrint(forPrintA), blankValues(blankValuesA) { }
+
+    std::string write(const XFALayoutResult &layout);
+
+private:
+    struct PageOut
+    {
+        double height;
+        std::string ops;
+        std::set<std::string> images;
+        std::vector<int> annots;
+        int pageObj;
+    };
+
+    double py(double y) const { return page->height - y; }
+    bool drawable(const XFANode *node) const;
+    bool interactive(const XFANode *field) const;
+
+    void drawItem(const XFALayoutItem &item);
+    void drawBorder(const XFANode *border, double x, double y, double w, double h, bool hasStart = true, bool hasEnd = true);
+    void drawText(const std::vector<XFAParagraph> &paras, const XFAPara &para, double x, double y, double w, double h, const XFALayoutItem *fragment);
+    void drawRun(const XFAPlacedRun &run, double x, double baseline);
+    void drawImage(const XFANode *imageNode, double x, double y, double w, double h);
+    void drawDraw(const XFALayoutItem &item);
+    void drawField(const XFALayoutItem &item);
+    void drawCaption(XFANode *field, const XFAFieldGeometry &g, double x, double y);
+    void addWidget(XFANode *field, const XFAFieldGeometry &g, double x, double y, double w, double h);
+    std::string da(const XFAFont &font) const;
+    int circleAppearance(double size, bool filled);
+    std::string rect(double x, double y, double w, double h) const;
+
+    XFAForm *form;
+    bool forPrint;
+    bool blankValues;
+    PDFBuilder pdf;
+    PageOut *page = nullptr;
+    std::map<std::string, std::pair<int, std::string>> imageCache; // content -> object, name
+    std::vector<int> fields;
+    std::map<int, int> groupObjects; // exclGroup serial -> field object
+    std::map<int, std::vector<int>> groupKids;
+    int fontObjects[14];
+    int nextImage = 0;
+};
+
+bool Writer::drawable(const XFANode *node) const
+{
+    for (const XFANode *n = node; n; n = n->getParent()) {
+        const std::string p = form->getPresence(n);
+        if (p != "visible") {
+            return false;
+        }
+        const std::string *rel = n->getAttr("relevant");
+        if (rel) {
+            const bool minusPrint = rel->find("-print") != std::string::npos;
+            const bool plusPrint = rel->find("+print") != std::string::npos;
+            if ((forPrint && minusPrint) || (!forPrint && plusPrint)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+bool Writer::interactive(const XFANode *field) const
+{
+    const std::string ui = form->uiClass(field);
+    if (ui == "imageEdit" || ui == "signature" || ui == "barcode" || ui == "defaultUi") {
+        return false;
+    }
+    const std::string access = field->getAttr("access", "open");
+    return access != "nonInteractive";
+}
+
+std::string Writer::rect(double x, double y, double w, double h) const
+{
+    return num(x) + " " + num(py(y + h)) + " " + num(w) + " " + num(h) + " re\n";
+}
+
+void Writer::drawBorder(const XFANode *border, double x, double y, double w, double h, bool hasStart, bool hasEnd)
+{
+    if (!border || border->getAttr("presence", "visible") != "visible") {
+        return;
+    }
+    std::string &ops = page->ops;
+    if (const XFANode *fill = border->firstChild("fill")) {
+        if (fill->getAttr("presence", "visible") == "visible") {
+            XFAColor c { 1, 1, 1 };
+            if (const XFANode *col = fill->firstChild("color")) {
+                c = XFAParseColor(col->getAttr("value", "255,255,255"), c);
+            }
+            // Gradients and patterns: blend with their second color.
+            for (const char *kind : { "linear", "radial", "pattern", "stipple" }) {
+                if (const XFANode *g = fill->firstChild(kind)) {
+                    if (const XFANode *col2 = g->firstChild("color")) {
+                        const XFAColor c2 = XFAParseColor(col2->getAttr("value", "0,0,0"));
+                        c = { (c.r + c2.r) / 2, (c.g + c2.g) / 2, (c.b + c2.b) / 2 };
+                    }
+                }
+            }
+            ops += "q\n" + color(c, false) + rect(x, y, w, h) + "f\nQ\n";
+        }
+    }
+    const std::vector<XFANode *> edgeNodes = border->childrenOfClass("edge");
+    Edge edges[4];
+    for (int i = 0; i < 4; ++i) {
+        if (!edgeNodes.empty()) {
+            edges[i] = edgeOf(edgeNodes[std::min<size_t>(i, edgeNodes.size() - 1)]);
+        }
+    }
+    // top, right, bottom, left
+    const double x2 = x + w, y2 = y + h;
+    const double coords[4][4] = { { x, y, x2, y }, { x2, y, x2, y2 }, { x, y2, x2, y2 }, { x, y, x, y2 } };
+    for (int i = 0; i < 4; ++i) {
+        const Edge &e = edges[i];
+        if (!e.visible || e.thickness <= 0 || (i == 0 && !hasStart) || (i == 2 && !hasEnd)) {
+            continue;
+        }
+        ops += "q\n" + color(e.color, true) + num(e.thickness) + " w\n";
+        if (e.stroke == "dashed") {
+            ops += "[" + num(3 * e.thickness) + "] 0 d\n";
+        } else if (e.stroke == "dotted") {
+            ops += "[" + num(e.thickness) + "] 0 d\n";
+        }
+        ops += num(coords[i][0]) + " " + num(py(coords[i][1])) + " m " + num(coords[i][2]) + " " + num(py(coords[i][3])) + " l S\nQ\n";
+    }
+}
+
+void Writer::drawRun(const XFAPlacedRun &run, double x, double baseline)
+{
+    const std::string bytes = XFAToWinAnsi(run.text);
+    std::string trimmed = bytes;
+    while (!trimmed.empty() && trimmed.back() == ' ') {
+        trimmed.pop_back();
+    }
+    if (trimmed.empty()) {
+        return;
+    }
+    const XFAFont &f = run.font;
+    std::string &ops = page->ops;
+    // Tz and Tc are graphics state, not reset by ET: always set them.
+    ops += "BT\n/F" + std::to_string(f.standardFont()) + " " + num(f.size) + " Tf\n" + num(f.hScale()) + " Tz\n" + num(f.letterSpacing) + " Tc\n";
+    ops += color(f.color, false);
+    ops += "1 0 0 1 " + num(x) + " " + num(py(baseline)) + " Tm\n" + pdfString(trimmed) + " Tj\nET\n";
+    if (f.underline) {
+        const double w = f.width(run.text);
+        ops += "q\n" + color(f.color, true) + num(f.size * 0.05) + " w\n" + num(x) + " " + num(py(baseline + f.size * 0.12)) + " m " + num(x + w) + " " + num(py(baseline + f.size * 0.12)) + " l S\nQ\n";
+    }
+}
+
+void Writer::drawText(const std::vector<XFAParagraph> &paras, const XFAPara &para, double x, double y, double w, double h, const XFALayoutItem *fragment)
+{
+    const XFATextBlock tb = XFALayoutText(paras, std::max(1.0, w));
+    size_t first = 0, last = tb.lines.size();
+    bool split = false;
+    if (fragment) {
+        first = std::min(fragment->firstLine, tb.lines.size());
+        last = std::min(fragment->lastLine, tb.lines.size());
+        split = first > 0 || last < tb.lines.size();
+    }
+    if (first >= last) {
+        return;
+    }
+    double offset = -tb.lines[first].top;
+    if (!split) {
+        const double th = tb.heightOf(first, last);
+        if (para.vAlign == "middle") {
+            offset += (h - th) / 2;
+        } else if (para.vAlign == "bottom") {
+            offset += h - th;
+        }
+    }
+    for (size_t i = first; i < last; ++i) {
+        const XFALine &line = tb.lines[i];
+        for (const XFAPlacedRun &run : line.runs) {
+            drawRun(run, x + run.x, y + offset + line.baseline);
+        }
+    }
+}
+
+void Writer::drawImage(const XFANode *imageNode, double x, double y, double w, double h)
+{
+    const std::string key = imageNode->textContent();
+    auto it = imageCache.find(key);
+    if (it == imageCache.end()) {
+        Image img;
+        if (!decodeImage(imageNode, img)) {
+            form->logMessage("unsupported image " + imageNode->getAttr("contentType", "?"));
+            return;
+        }
+        const int obj = pdf.addStream(img.dict, img.data);
+        it = imageCache.emplace(key, std::make_pair(obj, "Im" + std::to_string(nextImage++))).first;
+        it->second.second += ":" + std::to_string(img.width) + "x" + std::to_string(img.height);
+    }
+    const std::string &tag = it->second.second;
+    const std::string name = tag.substr(0, tag.find(':'));
+    const std::string dims = tag.substr(tag.find(':') + 1);
+    const double iw = std::max(1, std::atoi(dims.c_str()));
+    const double ih = std::max(1, std::atoi(dims.c_str() + dims.find('x') + 1));
+    double dw = w, dh = h;
+    const std::string aspect = imageNode->getAttr("aspect", "fit");
+    if (aspect == "fit") {
+        const double s = std::min(w / iw, h / ih);
+        dw = iw * s;
+        dh = ih * s;
+    } else if (aspect == "actual") {
+        dw = iw * 0.75;
+        dh = ih * 0.75;
+    } else if (aspect == "width") {
+        dh = ih * w / iw;
+    } else if (aspect == "height") {
+        dw = iw * h / ih;
+    }
+    page->images.insert(name + ":" + std::to_string(it->second.first));
+    page->ops += "q\n" + rect(x, y, w, h) + "W n\n" + num(dw) + " 0 0 " + num(dh) + " " + num(x) + " " + num(py(y + dh)) + " cm\n/" + name + " Do\nQ\n";
+}
+
+void Writer::drawDraw(const XFALayoutItem &item)
+{
+    XFANode *node = item.node;
+    drawBorder(node->firstChild("border"), item.x, item.y, item.w, item.h, item.hasStart, item.hasEnd);
+    const XFANode *value = node->firstChild("value");
+    if (!value) {
+        return;
+    }
+    const XFANode *content = nullptr;
+    for (XFANode *c : value->elementChildren()) {
+        content = c;
+        break;
+    }
+    if (!content) {
+        return;
+    }
+    const XFAInsets m = XFAMarginOf(node);
+    const double cx = item.x + m.left;
+    const double cy = item.y + (item.hasStart ? m.top : 0);
+    const double cw = item.w - m.left - m.right;
+    const double ch = item.h - (item.hasStart ? m.top : 0) - (item.hasEnd ? m.bottom : 0);
+    if (content->getClassName() == "image") {
+        drawImage(content, cx, cy, cw, ch);
+    } else if (content->getClassName() == "text" || content->getClassName() == "exData") {
+        const XFAFont font = XFAFontOf(node);
+        const XFAPara para = XFAParaOf(node);
+        drawText(XFAParagraphsOf(form, node, value, font, para), para, cx, cy, cw, ch, &item);
+    } else if (content->getClassName() == "line" || content->getClassName() == "rectangle") {
+        const XFANode *edgeNode = content->firstChild("edge");
+        const Edge e = edgeOf(edgeNode);
+        if (content->getClassName() == "line") {
+            const bool slopeUp = content->getAttr("slope", "\\") == "/";
+            const bool vertical = cw < 0.5;
+            const bool horizontal = ch < 0.5;
+            double x1 = cx, y1 = cy, x2 = cx + cw, y2 = cy + ch;
+            if (vertical) {
+                x2 = x1;
+            } else if (horizontal) {
+                y2 = y1;
+            } else if (slopeUp) {
+                std::swap(y1, y2);
+            }
+            page->ops += "q\n" + color(e.color, true) + num(e.thickness) + " w\n" + num(x1) + " " + num(py(y1)) + " m " + num(x2) + " " + num(py(y2)) + " l S\nQ\n";
+        } else {
+            page->ops += "q\n" + color(e.color, true) + num(e.thickness) + " w\n" + rect(cx, cy, cw, ch) + "S\nQ\n";
+        }
+    }
+}
+
+void Writer::drawCaption(XFANode *field, const XFAFieldGeometry &g, double x, double y)
+{
+    const XFANode *caption = field->firstChild("caption");
+    if (!caption || !g.hasCaption) {
+        return;
+    }
+    const XFAInsets cm = XFAMarginOf(caption);
+    const XFAFont font = XFAFontOf(caption);
+    const XFAPara para = XFAParaOf(caption);
+    drawText(XFAParagraphsOf(form, field, caption->firstChild("value"), font, para), para, x + g.captionX + cm.left, y + g.captionY + cm.top, g.captionW - cm.left - cm.right, g.captionH - cm.top - cm.bottom, nullptr);
+}
+
+std::string Writer::da(const XFAFont &font) const
+{
+    return "/F" + std::to_string(font.standardFont()) + " " + num(font.size) + " Tf " + num(font.color.r) + " " + num(font.color.g) + " " + num(font.color.b) + " rg";
+}
+
+int Writer::circleAppearance(double size, bool filled)
+{
+    std::string ops;
+    if (filled) {
+        const double r = size * 0.28, c = size / 2, k = 0.5523 * r;
+        ops = "q 0 g\n" + num(c + r) + " " + num(c) + " m\n" + num(c + r) + " " + num(c + k) + " " + num(c + k) + " " + num(c + r) + " " + num(c) + " " + num(c + r) + " c\n" + num(c - k) + " " + num(c + r) + " " + num(c - r) + " "
+                + num(c + k) + " " + num(c - r) + " " + num(c) + " c\n" + num(c - r) + " " + num(c - k) + " " + num(c - k) + " " + num(c - r) + " " + num(c) + " " + num(c - r) + " c\n" + num(c + k) + " " + num(c - r) + " " + num(c + r)
+                + " " + num(c - k) + " " + num(c + r) + " " + num(c) + " c\nf Q";
+    }
+    return pdf.addStream("/Type /XObject /Subtype /Form /BBox [0 0 " + num(size) + " " + num(size) + "] /Resources << >>", ops);
+}
+
+void Writer::addWidget(XFANode *field, const XFAFieldGeometry &g, double x, double y, double w, double h)
+{
+    if (!interactive(field) || form->getPresence(field) != "visible") {
+        return;
+    }
+    const std::string ui = form->uiClass(field);
+    const std::string name = "xfa" + std::to_string(field->getSerial());
+    const std::string access = field->getAttr("access", "open");
+    const bool readOnly = access == "readOnly" || access == "protected";
+    const XFAFont font = XFAFontOf(field);
+    const XFAPara para = XFAParaOf(field);
+
+    double rx = x + g.uiX, ry = y + g.uiY, rw = g.uiW, rh = g.uiH;
+    if (ui == "button") {
+        rx = x;
+        ry = y;
+        rw = w;
+        rh = h;
+    } else if (ui == "checkButton") {
+        const double size = std::min({ rw, rh, XFAMeasureAttr(field->firstChild("ui")->firstChild("checkButton"), "size", 10) });
+        rx = rx + 1;
+        ry = ry + (rh - size) / 2;
+        rw = size;
+        rh = size;
+    }
+    std::string common = "/Type /Annot /Subtype /Widget /Rect [" + num(rx) + " " + num(py(ry + rh)) + " " + num(rx + rw) + " " + num(py(ry)) + "] /F 4 /P " + ref(page->pageObj);
+    if (const XFANode *assist = field->firstChild("assist")) {
+        const XFANode *tip = assist->firstChild("toolTip");
+        if (!tip) {
+            tip = assist->firstChild("speak");
+        }
+        if (tip && !tip->textContent().empty()) {
+            common += " /TU " + pdfTextString(tip->textContent());
+        }
+    }
+    const std::optional<std::string> raw = form->getRawValue(field);
+    int ff = readOnly ? 1 : 0;
+
+    if (ui == "checkButton") {
+        const std::string onState = "f" + std::to_string(field->getSerial());
+        const std::vector<std::string> items = form->getItems(field, true);
+        const std::string on = items.empty() ? "1" : items[0];
+        const bool selected = !blankValues && raw && *raw == on;
+        const bool round = field->firstChild("ui")->firstChild("checkButton")->getAttr("shape", "square") == "round";
+        const int onAP = circleAppearance(rw, true);
+        const int offAP = circleAppearance(rw, false);
+        std::string widget = common + " /AS " + (selected ? pdfName(onState) : std::string("/Off")) + " /AP << /N << " + pdfName(onState) + " " + ref(onAP) + " /Off " + ref(offAP) + " >> >> /MK << /CA "
+                + (round ? std::string("(l)") : std::string("(4)")) + " >> /DA (/F13 0 Tf 0 g)";
+        XFANode *group = field->getParent() && field->getParent()->getClassName() == "exclGroup" ? field->getParent() : nullptr;
+        if (group) {
+            int &parentObj = groupObjects[group->getSerial()];
+            if (!parentObj) {
+                parentObj = pdf.reserve();
+                fields.push_back(parentObj);
+            }
+            const int kid = pdf.add("<< " + widget + " /Parent " + ref(parentObj) + " >>");
+            groupKids[group->getSerial()].push_back(kid);
+            page->annots.push_back(kid);
+        } else {
+            const int obj = pdf.add("<< " + common.substr(0, 0) + widget + " /FT /Btn /T " + pdfString(name) + " /Ff " + std::to_string(ff) + " /V " + (selected ? pdfName(onState) : std::string("/Off")) + " >>");
+            fields.push_back(obj);
+            page->annots.push_back(obj);
+        }
+        return;
+    }
+
+    std::string dict = "<< " + common + " /T " + pdfString(name) + " /MK << >>";
+    if (ui == "button") {
+        ff |= 65536;
+        const int ap = pdf.addStream("/Type /XObject /Subtype /Form /BBox [0 0 " + num(rw) + " " + num(rh) + "] /Resources << >>", "");
+        dict += " /FT /Btn /Ff " + std::to_string(ff) + " /AP << /N " + ref(ap) + " >>";
+    } else if (ui == "choiceList") {
+        ff |= 131072; // combo box
+        const XFANode *cl = field->firstChild("ui")->firstChild("choiceList");
+        if (cl->getAttr("textEntry", "0") == "1") {
+            ff |= 262144;
+        }
+        const std::vector<std::string> saves = form->getItems(field, true);
+        const std::vector<std::string> displays = form->getItems(field, false);
+        std::string opt = "[";
+        for (size_t i = 0; i < displays.size(); ++i) {
+            const std::string &s = i < saves.size() ? saves[i] : displays[i];
+            if (s == displays[i]) {
+                opt += pdfTextString(s) + " ";
+            } else {
+                opt += "[" + pdfTextString(s) + " " + pdfTextString(displays[i]) + "] ";
+            }
+        }
+        opt += "]";
+        dict += " /FT /Ch /Ff " + std::to_string(ff) + " /Opt " + opt + " /DA " + pdfString(da(font));
+        if (raw && !blankValues) {
+            dict += " /V " + pdfTextString(*raw);
+        }
+    } else {
+        const XFANode *te = field->firstChild("ui")->firstChild(ui);
+        if (te && te->getAttr("multiLine", "0") == "1") {
+            ff |= 4096;
+        }
+        dict += " /FT /Tx /Ff " + std::to_string(ff) + " /DA " + pdfString(da(font));
+        dict += std::string(" /Q ") + (para.hAlign == "center" ? "1" : para.hAlign == "right" ? "2" : "0");
+        const XFANode *value = field->firstChild("value");
+        const XFANode *text = value ? value->firstChild("text") : nullptr;
+        if (text && text->getAttr("maxChars")) {
+            dict += " /MaxLen " + text->getAttr("maxChars", "0");
+        }
+        if (raw && !blankValues) {
+            dict += " /V " + pdfTextString(*raw);
+        }
+    }
+    dict += " >>";
+    const int obj = pdf.add(dict);
+    fields.push_back(obj);
+    page->annots.push_back(obj);
+}
+
+void Writer::drawField(const XFALayoutItem &item)
+{
+    XFANode *field = item.node;
+    const std::string ui = form->uiClass(field);
+    const XFAFieldGeometry g = XFAFieldGeometryOf(form, field, item.w, item.h);
+    drawBorder(field->firstChild("border"), item.x, item.y, item.w, item.h);
+    drawCaption(field, g, item.x, item.y);
+
+    const XFANode *uiNode = field->firstChild("ui");
+    const XFANode *widget = uiNode ? uiNode->firstChild(ui) : nullptr;
+    const double ux = item.x + g.uiX, uy = item.y + g.uiY;
+    if (ui == "checkButton") {
+        const double size = std::min({ g.uiW, g.uiH, widget ? XFAMeasureAttr(widget, "size", 10) : 10.0 });
+        const double bx = ux + 1, by = uy + (g.uiH - size) / 2;
+        std::string &ops = page->ops;
+        ops += "q\n0 0 0 RG 0.5 w\n";
+        if (widget && widget->getAttr("shape", "square") == "round") {
+            const double r = size / 2 - 0.25, cx = bx + size / 2, cy = py(by + size / 2), k = 0.5523 * r;
+            ops += num(cx + r) + " " + num(cy) + " m " + num(cx + r) + " " + num(cy + k) + " " + num(cx + k) + " " + num(cy + r) + " " + num(cx) + " " + num(cy + r) + " c " + num(cx - k) + " " + num(cy + r) + " " + num(cx - r) + " "
+                    + num(cy + k) + " " + num(cx - r) + " " + num(cy) + " c " + num(cx - r) + " " + num(cy - k) + " " + num(cx - k) + " " + num(cy - r) + " " + num(cx) + " " + num(cy - r) + " c " + num(cx + k) + " " + num(cy - r) + " "
+                    + num(cx + r) + " " + num(cy - k) + " " + num(cx + r) + " " + num(cy) + " c S\n";
+        } else {
+            ops += rect(bx, by, size, size) + "S\n";
+        }
+        ops += "Q\n";
+    } else if (ui != "button" && widget) {
+        drawBorder(widget->firstChild("border"), ux, uy, g.uiW, g.uiH);
+        if (ui == "choiceList") {
+            // A drop-down arrow, so the field reads as a list.
+            const double s = std::min(g.uiH * 0.4, 6.0);
+            const double ax = ux + g.uiW - s - 3, ay = uy + (g.uiH - s / 2) / 2;
+            page->ops += "q\n0.3 0.3 0.3 rg\n" + num(ax) + " " + num(py(ay)) + " m " + num(ax + s) + " " + num(py(ay)) + " l " + num(ax + s / 2) + " " + num(py(ay + s / 2)) + " l f\nQ\n";
+        }
+    }
+    if (ui == "button") {
+        drawCaption(field, g, item.x, item.y);
+    }
+    if (!forPrint || ui != "button") {
+        addWidget(field, g, item.x, item.y, item.w, item.h);
+    }
+}
+
+void Writer::drawItem(const XFALayoutItem &item)
+{
+    if (!drawable(item.node)) {
+        return;
+    }
+    const std::string &cls = item.node->getClassName();
+    if (cls == "draw") {
+        drawDraw(item);
+    } else if (cls == "field") {
+        drawField(item);
+    } else if (cls == "subform" || cls == "exclGroup" || cls == "area") {
+        drawBorder(item.node->firstChild("border"), item.x, item.y, item.w, item.h, item.hasStart, item.hasEnd);
+    }
+}
+
+std::string Writer::write(const XFALayoutResult &layout)
+{
+    const int catalog = pdf.reserve();
+    const int pagesObj = pdf.reserve();
+    const int acroForm = pdf.reserve();
+    std::string fontDict = "<<";
+    for (int i = 0; i < 14; ++i) {
+        const std::string base = XFAStandardFontName(i);
+        const bool symbolic = base == "Symbol" || base == "ZapfDingbats";
+        fontObjects[i] = pdf.add("<< /Type /Font /Subtype /Type1 /BaseFont /" + base + (symbolic ? std::string() : std::string(" /Encoding /WinAnsiEncoding")) + " >>");
+        fontDict += " /F" + std::to_string(i) + " " + ref(fontObjects[i]);
+    }
+    fontDict += " >>";
+
+    std::vector<int> pageObjs;
+    std::vector<PageOut> outs(layout.pages.size());
+    for (size_t i = 0; i < layout.pages.size(); ++i) {
+        outs[i].pageObj = pdf.reserve();
+        outs[i].height = layout.pages[i].height;
+        pageObjs.push_back(outs[i].pageObj);
+    }
+    for (size_t i = 0; i < layout.pages.size(); ++i) {
+        page = &outs[i];
+        for (const XFALayoutItem &item : layout.pages[i].items) {
+            drawItem(item);
+        }
+        std::string xobjects;
+        for (const std::string &img : page->images) {
+            const size_t colon = img.find(':');
+            xobjects += " /" + img.substr(0, colon) + " " + img.substr(colon + 1) + " 0 R";
+        }
+        const int contents = pdf.addStream("/Filter /FlateDecode", deflate(page->ops));
+        std::string annots;
+        for (int a : page->annots) {
+            annots += ref(a) + " ";
+        }
+        const XFALayoutPage &lp = layout.pages[i];
+        pdf.set(page->pageObj,
+                "<< /Type /Page /Parent " + ref(pagesObj) + " /MediaBox [0 0 " + num(lp.width) + " " + num(lp.height) + "] /Resources << /Font " + fontDict + (xobjects.empty() ? std::string() : " /XObject <<" + xobjects + " >>")
+                        + " >> /Contents " + ref(contents) + (annots.empty() ? std::string() : " /Annots [" + annots + "]") + " >>");
+    }
+    page = nullptr;
+
+    for (const auto &[serial, obj] : groupObjects) {
+        XFANode *group = form->lookupNode(serial);
+        std::string kids;
+        for (int k : groupKids[serial]) {
+            kids += ref(k) + " ";
+        }
+        std::string value = "/Off";
+        if (group && !blankValues) {
+            const std::optional<std::string> v = form->getRawValue(group);
+            for (XFANode *c : group->childrenOfClass("field")) {
+                const std::vector<std::string> items = form->getItems(c, true);
+                if (v && !items.empty() && items[0] == *v) {
+                    value = pdfName("f" + std::to_string(c->getSerial()));
+                }
+            }
+        }
+        const std::string access = group ? group->getAttr("access", "open") : std::string("open");
+        const int ff = 32768 | 16384 | ((access == "readOnly" || access == "protected") ? 1 : 0);
+        pdf.set(obj, "<< /FT /Btn /Ff " + std::to_string(ff) + " /T " + pdfString("xfa" + std::to_string(serial)) + " /V " + value + " /Kids [" + kids + "] >>");
+    }
+
+    std::string kids, fieldRefs;
+    for (int p : pageObjs) {
+        kids += ref(p) + " ";
+    }
+    for (int f : fields) {
+        fieldRefs += ref(f) + " ";
+    }
+    pdf.set(pagesObj, "<< /Type /Pages /Kids [" + kids + "] /Count " + std::to_string(pageObjs.size()) + " >>");
+    pdf.set(acroForm, "<< /Fields [" + fieldRefs + "] /NeedAppearances true /DR << /Font " + fontDict + " >> /DA (/F4 10 Tf 0 g) >>");
+    pdf.set(catalog, "<< /Type /Catalog /Pages " + ref(pagesObj) + " /AcroForm " + ref(acroForm) + " >>");
+    return pdf.finish(catalog);
+}
+
+} // namespace
+
+std::string XFAWritePDF(XFAForm *form, const XFALayoutResult &layout, bool forPrint, bool blankValues)
+{
+    Writer writer(form, forPrint, blankValues);
+    return writer.write(layout);
+}
