+
+NATIVE(pageOf)
+{
+    XFANode *n = nodeArg(ctx, ARG(0));
+    return JS_NewInt32(ctx, n ? formOf(ctx)->pageOf(n) : -1);
+}
+
+NATIVE(pageCount)
+{
+    return JS_NewInt32(ctx, formOf(ctx)->pageCount());
+}
+
+NATIVE(pageContent)
+{
+    int32_t page = 0;
+    JS_ToInt32(ctx, &page, ARG(0));
