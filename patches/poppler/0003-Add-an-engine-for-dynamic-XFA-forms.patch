+struct NativeEntry
+{
+    const char *name;
+    JSCFunction *fn;
+    int length;
+};
+
+#    define ENTRY(name, len) { #name, native_##name, len }
+const NativeEntry natives[] = { ENTRY(alive, 1),           ENTRY(cls, 1),           ENTRY(name, 1),        ENTRY(attr, 2),          ENTRY(setAttr, 3),     ENTRY(parent, 1),         ENTRY(children, 1),
