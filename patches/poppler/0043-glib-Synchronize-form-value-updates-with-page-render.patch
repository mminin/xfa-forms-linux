+++ b/glib/poppler-page.cc
@@ -318,6 +318,7 @@ void poppler_page_render_full(PopplerPage *page, cairo_t *cairo, gboolean printi
         }
     }
 
+    std::scoped_lock formLock(page->document->form_mutex);
     std::unique_lock lock(page->mutex);
 
     output_dev = page->document->output_dev;
diff --git a/glib/poppler-private.h b/glib/poppler-private.h
index 206e95b..7578957 100644
--- a/glib/poppler-private.h
+++ b/glib/poppler-private.h
@@ -35,6 +35,9 @@ struct _PopplerDocument
     GList *layers;
     GList *layers_rbgroups;
     CairoOutputDev *output_dev;
+    // Widget values are read while generating appearances on a render
+    // thread and replaced by the UI thread when an editor commits.
+    std::mutex form_mutex;
 
     // Set on documents made by poppler_document_render_xfa(): the form
