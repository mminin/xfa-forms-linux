From 8562423e96001875bc4b814d9654834c7f4f314c Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Mon, 19 Oct 2026 18:11:32 -0700
Subject: [PATCH] glib: Synchronize form value updates with page rendering

The UI can commit a text editor while a worker generates its widget appearance. Replacing FormFieldText's content then frees the string the render thread is reading; the multiline GUI regression reproduced a crash in drawMultiLineText under AddressSanitizer.

Protect widget mutations and rendering with a per-document mutex. Release it before executing XFA scripts, which may enter a nested main loop for a dialog. Add a synthetic concurrent rendering and editing regression.

AI-Assistant: OpenAI Codex
AI-Model: gpt-6.1-sol
AI-Reasoning-Effort: high
Co-authored-by: Codex <noreply@openai.com>
---
 glib/poppler-document.cc   |  6 +++-
 glib/poppler-form-field.cc | 27 ++++++++++++++----
 glib/poppler-page.cc       |  1 +
 glib/poppler-private.h     |  3 ++
 glib/tests/check_xfa.c     | 57 ++++++++++++++++++++++++++++++++++++++
 5 files changed, 88 insertions(+), 6 deletions(-)

diff --git a/glib/poppler-document.cc b/glib/poppler-document.cc
index 42930f9..b7f5c75 100644
--- a/glib/poppler-document.cc
+++ b/glib/poppler-document.cc
@@ -688,6 +688,7 @@ static void poppler_document_finalize(GObject *object)
     document->xfa.reset();
     document->doc.reset();
     document->initer.reset();
+    document->form_mutex.~mutex();
 
     G_OBJECT_CLASS(poppler_document_parent_class)->finalize(object);
 }
@@ -2914,7 +2915,10 @@ static void poppler_document_class_init(PopplerDocumentClass *klass)
     g_object_class_install_property(G_OBJECT_CLASS(klass), PROP_METADATA, g_param_spec_string("metadata", "XML Metadata", "Embedded XML metadata", nullptr, G_PARAM_READABLE));
 }
 
-static void poppler_document_init(PopplerDocument * /*document*/) { }
+static void poppler_document_init(PopplerDocument *document)
+{
+    new (&document->form_mutex) std::mutex();
+}
 
 /**
