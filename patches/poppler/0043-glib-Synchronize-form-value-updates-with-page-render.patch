@@ -1125,7 +1139,10 @@ void poppler_form_field_choice_set_text(PopplerFormField *field, const gchar *te
     tmp = text ? g_convert(text, -1, "UTF-16BE", "UTF-8", nullptr, &length, nullptr) : nullptr;
