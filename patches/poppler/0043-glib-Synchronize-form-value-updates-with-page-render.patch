diff --git a/glib/tests/check_xfa.c b/glib/tests/check_xfa.c
index c1b5982..53cd82b 100644
--- a/glib/tests/check_xfa.c
+++ b/glib/tests/check_xfa.c
@@ -1403,6 +1403,62 @@ static void test_deep_script_tree(void)
     g_bytes_unref(bytes);
 }
 
+typedef struct
+{
+    PopplerPage *page;
+    gint start;
+} RenderEditData;
+
+static gpointer render_while_editing(gpointer user_data)
+{
+    RenderEditData *data = user_data;
+    cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, 612, 792);
+    cairo_t *cr = cairo_create(surface);
+    while (!g_atomic_int_get(&data->start)) {
+        g_thread_yield();
+    }
+    for (int i = 0; i < 300; ++i) {
+        poppler_page_render(data->page, cr);
+    }
+    cairo_destroy(cr);
+    cairo_surface_destroy(surface);
+    return NULL;
+}
+
+/* A view renders on a worker while focus-out commits on the UI thread.
+ * The widget's appearance must not read a freed text buffer. */
+static void test_render_while_editing(void)
+{
+    const char *xml = "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                      "<subform name=\"form1\" layout=\"tb\"><pageSet><pageArea>"
+                      "<contentArea x=\"1in\" y=\"1in\" w=\"6in\" h=\"9in\"/>"
+                      "<medium short=\"8.5in\" long=\"11in\"/></pageArea></pageSet>"
+                      "<field name=\"who\" w=\"4in\" h=\"1in\"><ui><textEdit multiLine=\"1\"/></ui>"
+                      "<assist><toolTip>Name</toolTip></assist></field></subform></template>";
+    GBytes *bytes = build_pdf_from(xml);
+    GError *error = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &error);
+    g_assert_no_error(error);
+    PopplerDocument *doc = poppler_document_render_xfa(source, &error);
+    g_assert_no_error(error);
+    PopplerFormField *field = first_text_field(doc);
+    g_assert_nonnull(field);
+    RenderEditData data = { poppler_document_get_page(doc, 0), 0 };
+    GThread *thread = g_thread_new("render-edit", render_while_editing, &data);
+    g_atomic_int_set(&data.start, 1);
+    for (int i = 0; i < 300; ++i) {
+        char *value = g_strdup_printf("Answer %d\nAnother line with a different length %.*s", i, i % 30, "abcdefghijklmnopqrstuvwxyz012345");
+        poppler_form_field_text_set_text(field, value);
+        g_free(value);
+    }
+    g_thread_join(thread);
+    g_object_unref(data.page);
+    g_object_unref(field);
+    g_object_unref(doc);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -1429,5 +1485,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/event-target", test_event_target);
     g_test_add_func("/xfa/data-binding", test_data_binding);
     g_test_add_func("/xfa/unicode-text", test_unicode_text);
+    g_test_add_func("/xfa/render-while-editing", test_render_while_editing);
     return g_test_run();
 }
