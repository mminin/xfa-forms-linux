+// A label or value of an item bound with bindItems: "$" is the data
+// node's value, other names its child or attribute.
+static std::string boundItemPart(const XFANode *data, const std::string &ref)
+{
+    if (ref.empty() || ref == "$") {
+        return data->textContent();
+    }
+    for (XFANode *c : data->elementChildren()) {
+        if (c->getClassName() == ref) {
+            return c->textContent();
+        }
+    }
+    return data->getAttr(ref, "");
+}
