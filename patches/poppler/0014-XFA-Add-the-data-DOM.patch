+}
+
+static void markData(XFANode *node)
+{
+    node->setNamespace(XFANode::Namespace::Data);
+    for (const auto &c : node->getChildren()) {
+        markData(c.get());
+    }
+}
+
+const char *XFADataClass(const XFANode *node)
+{
+    const std::string kind = node->getAttr("xfa:dataNode", "");
+    if (kind == "dataGroup" || kind == "dataValue") {
+        return kind == "dataGroup" ? "dataGroup" : "dataValue";
+    }
+    return node->elementChildren().empty() ? "dataValue" : "dataGroup";
+}
+
+void XFAForm::loadDataXML(XFANode *dataNode, const std::string &xml, bool ignoreRoot, bool overwrite)
+{
+    std::string error;
+    std::unique_ptr<XFANode> root = XFAParseXML(xml, &dataDom, &error);
+    if (!root) {
+        logMessage("loadXML: " + error);
+        return;
+    }
+    markData(root.get());
+    if (overwrite) {
+        while (!dataNode->getChildren().empty()) {
+            dataNode->removeChild(dataNode->getChildren().back().get());
+        }
+    }
+    if (!ignoreRoot) {
+        dataNode->appendChild(std::move(root));
+        return;
+    }
+    while (!root->getChildren().empty()) {
+        dataNode->appendChild(root->removeChild(root->getChildren().front().get()));
+    }
+}
+
+void XFAForm::doRemerge()
+{
+    remergePending = false;
+    std::string error;
+    std::unique_ptr<XFANode> data = XFAParseXML(saveData(formRoot), &formDom, &error);
+    pageSetInstance = nullptr;
+    std::unique_ptr<XFANode> root = instantiate(formRoot->getProto());
+    retiredRoot = formModel->removeChild(formRoot);
+    formRoot = formModel->appendChild(std::move(root));
+    if (data) {
+        mergeData(this, formRoot, data.get(), false);
+    }
+    script->defineScriptObjects(formRoot);
+    invalidateLayout();
+    initializeSubtree(formRoot);
+    runCalculations();
 }
 
