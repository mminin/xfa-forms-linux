+/* The data DOM: initial data, items bound to data, globally bound fields
+ * and data nodes made by scripts. */
+static const char *data_xdp = "<?xml version=\"1.0\"?>\n"
+                              "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                              "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                              "<subform name=\"form1\" layout=\"tb\">"
+                              "<pageSet><pageArea name=\"Page1\">"
+                              "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                              "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/>"
+                              "</pageArea></pageSet>"
+                              "<field name=\"who\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui><value><text>nobody</text></value></field>"
+                              "<field name=\"color\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><choiceList/></ui>"
+                              "<bindItems ref=\"xfa.datasets.Lists.Color[*]\" labelRef=\"$\" valueRef=\"lic\"/><value><text>G</text></value></field>"
+                              "<subform name=\"A\" layout=\"tb\"><field name=\"sin\" w=\"3in\" h=\"0.3in\"><ui><textEdit/></ui><bind match=\"global\"/>"
+                              "<event activity=\"initialize\"><script contentType=\"application/x-javascript\">this.rawValue = \"123\";</script></event>"
+                              "</field></subform>"
+                              "<subform name=\"B\" layout=\"tb\"><field name=\"sin\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui><bind match=\"global\"/></field></subform>"
+                              "<field name=\"out\" w=\"6in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui>"
+                              "<event activity=\"initialize\"><script contentType=\"application/x-javascript\">"
+                              "var g = xfa.datasets.createNode(\"dataGroup\", \"vars\"); xfa.datasets.nodes.append(g);"
+                              "g.loadXML(\"&lt;v&gt;&lt;a&gt;1&lt;/a&gt;&lt;a&gt;2&lt;/a&gt;&lt;/v&gt;\", 1, 0);"
+                              "this.rawValue = [xfa.resolveNodes(\"xfa.datasets.vars.a[*]\").length, xfa.datasets.Lists.Color.lic.value, "
+                              "xfa.datasets.Lists.Color.className, xfa.data.saveXML().indexOf(\"&lt;who&gt;Ada\") &gt;= 0].join(\":\");"
+                              "</script></event></field>"
+                              "</subform>"
+                              "</template>"
+                              "<xfa:datasets xmlns:xfa=\"http://www.xfa.org/schema/xfa-data/1.0/\">"
+                              "<xfa:data><form1><who>Ada</who></form1></xfa:data>"
+                              "<Lists><Color lic=\"R\">Red</Color><Color lic=\"G\">Green</Color></Lists>"
+                              "</xfa:datasets>"
+                              "</xdp:xdp>";
+
+static void test_data(void)
+{
+    GBytes *bytes = build_pdf_from(data_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    char *text = page_text(rendered);
+    g_assert_nonnull(strstr(text, "Ada"));
+    g_assert_nonnull(strstr(text, "Green"));
+    if (!strstr(text, "123")) {
+        g_test_skip("poppler was built without XFA scripting");
+    } else {
+        g_assert_nonnull(strstr(text, "2:R:dataValue:true"));
+    }
+    g_free(text);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
