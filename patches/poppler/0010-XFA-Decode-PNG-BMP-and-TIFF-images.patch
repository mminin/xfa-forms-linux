-
-bool decodeJPEG(const std::string &d, Image &img)
-{
-    if (d.size() < 4 || static_cast<unsigned char>(d[0]) != 0xFF || static_cast<unsigned char>(d[1]) != 0xD8) {
-        return false;
-    }
-    bool adobe = false;
-    size_t p = 2;
-    while (p + 4 <= d.size()) {
-        if (static_cast<unsigned char>(d[p]) != 0xFF) {
-            ++p;
-            continue;
-        }
-        const unsigned char marker = d[p + 1];
-        if (marker == 0xD8 || marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7) || marker == 0xFF) {
-            p += marker == 0xFF ? 1 : 2;
-            continue;
-        }
-        const size_t len = (static_cast<unsigned char>(d[p + 2]) << 8) | static_cast<unsigned char>(d[p + 3]);
-        if (marker == 0xEE) {
-            adobe = true;
-        }
-        if ((marker >= 0xC0 && marker <= 0xC3) || (marker >= 0xC5 && marker <= 0xC7) || (marker >= 0xC9 && marker <= 0xCB) || (marker >= 0xCD && marker <= 0xCF)) {
-            if (p + 10 > d.size()) {
-                return false;
-            }
-            img.height = (static_cast<unsigned char>(d[p + 5]) << 8) | static_cast<unsigned char>(d[p + 6]);
-            img.width = (static_cast<unsigned char>(d[p + 7]) << 8) | static_cast<unsigned char>(d[p + 8]);
-            const int comps = static_cast<unsigned char>(d[p + 9]);
-            std::string cs = comps == 1 ? "/DeviceGray" : comps == 4 ? "/DeviceCMYK" : "/DeviceRGB";
-            img.dict = "/Type /XObject /Subtype /Image /Width " + std::to_string(img.width) + " /Height " + std::to_string(img.height) + " /ColorSpace " + cs + " /BitsPerComponent 8 /Filter /DCTDecode";
-            if (comps == 4 && adobe) {
-                img.dict += " /Decode [1 0 1 0 1 0 1 0]";
-            }
-            img.data = d;
-            return img.width > 0 && img.height > 0;
-        }
-        p += 2 + len;
-    }
-    return false;
-}
-
-bool decodeGIF(const std::string &d, Image &img)
-{
-    auto byte = [&d](size_t i) -> unsigned int { return i < d.size() ? static_cast<unsigned char>(d[i]) : 0; };
-    if (d.size() < 13 || d.compare(0, 3, "GIF") != 0) {
-        return false;
-    }
-    const int screenW = byte(6) | (byte(7) << 8);
-    const int screenH = byte(8) | (byte(9) << 8);
-    const unsigned int flags = byte(10);
-    const int bg = byte(11);
-    size_t p = 13;
-    std::vector<unsigned char> globalPalette;
-    if (flags & 0x80) {
-        const size_t n = 3u << ((flags & 7) + 1);
-        globalPalette.assign(d.begin() + p, d.begin() + std::min(d.size(), p + n));
-        p += n;
-    }
-    int transparent = -1;
-    while (p < d.size()) {
-        const unsigned int block = byte(p++);
-        if (block == 0x21) {
-            const unsigned int label = byte(p++);
-            if (label == 0xF9 && byte(p) >= 4 && (byte(p + 1) & 1)) {
-                transparent = static_cast<int>(byte(p + 4));
-            }
-            while (p < d.size()) {
-                const unsigned int len = byte(p++);
-                if (len == 0) {
-                    break;
-                }
-                p += len;
-            }
-        } else if (block == 0x2C) {
-            const int left = byte(p) | (byte(p + 1) << 8);
-            const int top = byte(p + 2) | (byte(p + 3) << 8);
-            const int w = byte(p + 4) | (byte(p + 5) << 8);
-            const int h = byte(p + 6) | (byte(p + 7) << 8);
-            const unsigned int iflags = byte(p + 8);
-            p += 9;
-            std::vector<unsigned char> palette = globalPalette;
-            if (iflags & 0x80) {
-                const size_t n = 3u << ((iflags & 7) + 1);
-                palette.assign(d.begin() + p, d.begin() + std::min(d.size(), p + n));
-                p += n;
-            }
-            const bool interlaced = iflags & 0x40;
-            const int minCode = static_cast<int>(byte(p++));
-            if (minCode < 2 || minCode > 11) {
-                return false;
-            }
-            std::string lzw;
-            while (p < d.size()) {
-                const unsigned int len = byte(p++);
-                if (len == 0) {
-                    break;
-                }
-                lzw.append(d, p, len);
-                p += len;
-            }
-
-            // LZW decoding.
-            std::vector<unsigned char> indices;
-            indices.reserve(static_cast<size_t>(w) * h);
-            const int clear = 1 << minCode;
-            const int eoi = clear + 1;
-            std::vector<int> prefix(4096, -1);
-            std::vector<unsigned char> suffix(4096), first(4096);
-            for (int i = 0; i < clear; ++i) {
-                suffix[i] = static_cast<unsigned char>(i);
-                first[i] = static_cast<unsigned char>(i);
-            }
-            int codeSize = minCode + 1;
-            int next = eoi + 1;
-            int prev = -1;
-            unsigned int bitBuf = 0;
-            int bitCount = 0;
-            std::vector<unsigned char> stack;
-            for (unsigned char c : lzw) {
-                bitBuf |= static_cast<unsigned int>(c) << bitCount;
-                bitCount += 8;
-                while (bitCount >= codeSize) {
-                    int code = static_cast<int>(bitBuf & ((1u << codeSize) - 1));
-                    bitBuf >>= codeSize;
-                    bitCount -= codeSize;
-                    if (code == clear) {
-                        codeSize = minCode + 1;
-                        next = eoi + 1;
-                        prev = -1;
-                        continue;
-                    }
-                    if (code == eoi) {
-                        goto done;
-                    }
-                    int cur = code;
-                    stack.clear();
-                    if (code >= next) {
-                        if (prev < 0) {
-                            goto done;
-                        }
-                        stack.push_back(first[prev]);
-                        cur = prev;
-                    }
-                    while (cur >= clear) {
-                        stack.push_back(suffix[cur]);
-                        cur = prefix[cur];
-                    }
-                    stack.push_back(static_cast<unsigned char>(cur));
-                    for (auto it = stack.rbegin(); it != stack.rend(); ++it) {
-                        indices.push_back(*it);
-                    }
-                    if (prev >= 0 && next < 4096) {
-                        prefix[next] = prev;
-                        suffix[next] = static_cast<unsigned char>(cur);
-                        first[next] = first[prev];
-                        ++next;
-                        if (next == (1 << codeSize) && codeSize < 12) {
-                            ++codeSize;
-                        }
-                    }
-                    first[code < next ? code : next - 1] = static_cast<unsigned char>(cur);
-                    prev = code;
-                }
-            }
-        done:
-            indices.resize(static_cast<size_t>(w) * h, static_cast<unsigned char>(transparent >= 0 ? transparent : 0));
-            if (interlaced) {
-                std::vector<unsigned char> rows(indices.size());
-                int src = 0;
-                const int starts[] = { 0, 4, 2, 1 }, steps[] = { 8, 8, 4, 2 };
-                for (int pass = 0; pass < 4; ++pass) {
-                    for (int y = starts[pass]; y < h; y += steps[pass], ++src) {
-                        std::copy_n(indices.begin() + static_cast<size_t>(src) * w, w, rows.begin() + static_cast<size_t>(y) * w);
-                    }
-                }
-                indices = std::move(rows);
-            }
-
-            // Composite on white, which is what transparent pixels sit on in forms.
-            const int outW = std::max(screenW, left + w);
-            const int outH = std::max(screenH, top + h);
-            std::string rgb(static_cast<size_t>(outW) * outH * 3, '\xFF');
-            (void)bg;
-            for (int y = 0; y < h; ++y) {
-                for (int x = 0; x < w; ++x) {
-                    const int idx = indices[static_cast<size_t>(y) * w + x];
-                    if (idx == transparent || static_cast<size_t>(idx) * 3 + 2 >= palette.size()) {
-                        continue;
-                    }
-                    const size_t o = (static_cast<size_t>(top + y) * outW + left + x) * 3;
-                    rgb[o] = static_cast<char>(palette[idx * 3]);
-                    rgb[o + 1] = static_cast<char>(palette[idx * 3 + 1]);
-                    rgb[o + 2] = static_cast<char>(palette[idx * 3 + 2]);
-                }
-            }
-            img.width = outW;
-            img.height = outH;
-            img.data = deflate(rgb);
-            img.dict = "/Type /XObject /Subtype /Image /Width " + std::to_string(outW) + " /Height " + std::to_string(outH) + " /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /FlateDecode";
-            return !img.data.empty();
-        } else {
-            break;
-        }
-    }
-    return false;
-}
