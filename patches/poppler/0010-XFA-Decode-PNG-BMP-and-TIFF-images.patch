new file mode 100644
index 0000000..49ef718
--- /dev/null
+++ b/poppler/XFAImage.cc
@@ -0,0 +1,812 @@
+//========================================================================
+//
+// XFAImage.cc
+//
+// JPEG data is passed through to DCTDecode. The other formats are decoded
+// to 8-bit samples, with transparency as a soft mask.
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#include <config.h>
+
+#include "XFAImage.h"
+
+#include <zlib.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <map>
+#include <vector>
+
+namespace {
+
+// Larger images are refused rather than decoded.
+constexpr long long maxPixels = 1LL << 26;
+
+bool sizeOk(long long w, long long h)
+{
+    return w > 0 && h > 0 && w <= maxPixels && h <= maxPixels / w;
+}
+
+// Bounds-checked reads; out of range bytes read as 0.
+class Bytes
+{
+public:
+    Bytes(const std::string &dataA, bool littleEndianA) : data(dataA), littleEndian(littleEndianA) { }
+    unsigned int u8(size_t i) const { return i < data.size() ? static_cast<unsigned char>(data[i]) : 0; }
+    uint32_t u16(size_t i) const { return littleEndian ? u8(i) | (u8(i + 1) << 8) : (u8(i) << 8) | u8(i + 1); }
+    uint32_t u32(size_t i) const { return littleEndian ? u16(i) | (u16(i + 2) << 16) : (u16(i) << 16) | u16(i + 2); }
+
+private:
+    const std::string &data;
+    bool littleEndian;
+};
+
+std::string inflateData(const std::string &in, size_t expected)
+{
+    std::string out(expected, '\0');
+    z_stream zs {};
+    if (expected == 0 || inflateInit(&zs) != Z_OK) {
+        return {};
+    }
+    zs.next_in = reinterpret_cast<Bytef *>(const_cast<char *>(in.data()));
+    zs.avail_in = static_cast<uInt>(in.size());
+    zs.next_out = reinterpret_cast<Bytef *>(out.data());
+    zs.avail_out = static_cast<uInt>(out.size());
+    inflate(&zs, Z_FINISH);
+    out.resize(out.size() - zs.avail_out);
+    inflateEnd(&zs);
+    return out;
+}
+
+// samples has comps (1: gray, 3: RGB) bytes per pixel, alpha one.
+bool finishRaster(XFAImage &img, int w, int h, int comps, const std::string &samples, const std::string &alpha)
+{
+    img.width = w;
+    img.height = h;
+    img.dict = "/Type /XObject /Subtype /Image /Width " + std::to_string(w) + " /Height " + std::to_string(h) + " /ColorSpace " + (comps == 1 ? "/DeviceGray" : "/DeviceRGB") + " /BitsPerComponent 8 /Filter /FlateDecode";
+    img.data = XFADeflate(samples);
+    img.smask.clear();
+    if (std::ranges::any_of(alpha, [](char a) { return a != '\xFF'; })) {
+        img.smask = XFADeflate(alpha);
+    }
+    return !img.data.empty();
+}
+
+// The index-th sample of a row of packed samples, most significant bits first.
+unsigned int packedSample(const unsigned char *row, size_t index, int depth)
+{
+    if (depth == 8) {
+        return row[index];
+    }
+    if (depth == 16) {
+        return (row[2 * index] << 8) | row[2 * index + 1];
+    }
+    const size_t bit = index * depth;
+    return (row[bit / 8] >> (8 - depth - bit % 8)) & ((1u << depth) - 1);
+}
+
+unsigned char scaleTo8(unsigned int v, int depth)
+{
+    if (depth == 16) {
+        return static_cast<unsigned char>(v >> 8);
+    }
+    return static_cast<unsigned char>(depth == 8 ? v : v * 255 / ((1u << depth) - 1));
+}
+
+//------------------------------------------------------------------------
+// JPEG
+//------------------------------------------------------------------------
+
+bool decodeJPEG(const std::string &d, XFAImage &img)
+{
+    const Bytes b(d, false);
+    if (d.size() < 4 || b.u8(0) != 0xFF || b.u8(1) != 0xD8) {
+        return false;
+    }
+    bool adobe = false;
+    size_t p = 2;
+    while (p + 4 <= d.size()) {
+        if (b.u8(p) != 0xFF) {
+            ++p;
+            continue;
+        }
+        const unsigned int marker = b.u8(p + 1);
+        if (marker == 0xD8 || marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7) || marker == 0xFF) {
+            p += marker == 0xFF ? 1 : 2;
+            continue;
+        }
+        const size_t len = b.u16(p + 2);
+        if (marker == 0xEE) {
+            adobe = true;
+        }
+        if (marker == 0xE0 && d.compare(p + 4, 5, std::string("JFIF\0", 5)) == 0) {
+            const unsigned int units = b.u8(p + 11);
+            const double scale = units == 1 ? 1 : units == 2 ? 2.54 : 0;
+            img.dpiX = b.u16(p + 12) * scale;
+            img.dpiY = b.u16(p + 14) * scale;
+        }
+        if ((marker >= 0xC0 && marker <= 0xC3) || (marker >= 0xC5 && marker <= 0xC7) || (marker >= 0xC9 && marker <= 0xCB) || (marker >= 0xCD && marker <= 0xCF)) {
+            if (p + 10 > d.size()) {
+                return false;
+            }
+            img.height = static_cast<int>(b.u16(p + 5));
+            img.width = static_cast<int>(b.u16(p + 7));
+            const unsigned int comps = b.u8(p + 9);
+            const std::string cs = comps == 1 ? "/DeviceGray" : comps == 4 ? "/DeviceCMYK" : "/DeviceRGB";
+            img.dict = "/Type /XObject /Subtype /Image /Width " + std::to_string(img.width) + " /Height " + std::to_string(img.height) + " /ColorSpace " + cs + " /BitsPerComponent 8 /Filter /DCTDecode";
+            if (comps == 4 && adobe) {
+                img.dict += " /Decode [1 0 1 0 1 0 1 0]";
+            }
+            img.data = d;
+            return img.width > 0 && img.height > 0;
+        }
+        p += 2 + len;
+    }
+    return false;
+}
+
+//------------------------------------------------------------------------
+// PNG
+//------------------------------------------------------------------------
+
+int paeth(int a, int b, int c)
+{
+    const int p = a + b - c;
+    const int pa = std::abs(p - a), pb = std::abs(p - b), pc = std::abs(p - c);
+    return pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
+}
+
+bool unfilter(unsigned char *row, const unsigned char *prev, size_t len, size_t bpp, unsigned int filter)
+{
+    for (size_t i = 0; i < len; ++i) {
+        const int a = i >= bpp ? row[i - bpp] : 0;
+        const int b = prev[i];
+        const int c = i >= bpp ? prev[i - bpp] : 0;
+        switch (filter) {
+        case 0:
+            break;
+        case 1:
+            row[i] += a;
+            break;
+        case 2:
+            row[i] += b;
+            break;
+        case 3:
+            row[i] += (a + b) / 2;
+            break;
+        case 4:
+            row[i] += paeth(a, b, c);
+            break;
+        default:
+            return false;
+        }
+    }
+    return true;
+}
+
+bool decodePNG(const std::string &d, XFAImage &img)
+{
+    if (d.size() < 8 || d.compare(0, 8, "\x89PNG\r\n\x1A\n") != 0) {
+        return false;
+    }
+    const Bytes b(d, false);
+    long long w = 0, h = 0;
+    int depth = 0, type = -1;
+    bool interlaced = false;
+    std::string idat, palette, trns;
+    for (size_t p = 8; p + 12 <= d.size();) {
+        const size_t len = b.u32(p);
+        if (len > d.size() - p - 12) {
+            break;
+        }
+        const std::string chunk = d.substr(p + 4, 4);
+        const size_t body = p + 8;
+        if (chunk == "IHDR" && len >= 13) {
+            w = b.u32(body);
+            h = b.u32(body + 4);
+            depth = static_cast<int>(b.u8(body + 8));
+            type = static_cast<int>(b.u8(body + 9));
+            interlaced = b.u8(body + 12) == 1;
+        } else if (chunk == "PLTE") {
+            palette = d.substr(body, len);
+        } else if (chunk == "tRNS") {
+            trns = d.substr(body, len);
+        } else if (chunk == "pHYs" && len >= 9 && b.u8(body + 8) == 1) {
+            img.dpiX = b.u32(body) * 0.0254;
+            img.dpiY = b.u32(body + 4) * 0.0254;
+        } else if (chunk == "IDAT") {
+            idat.append(d, body, len);
+        } else if (chunk == "IEND") {
+            break;
+        }
+        p = body + len + 4;
+    }
+    const int channels = type == 0 || type == 3 ? 1 : type == 2 ? 3 : type == 4 ? 2 : type == 6 ? 4 : 0;
+    const bool depthOk = depth == 8 || (depth == 16 && type != 3) || ((type == 0 || type == 3) && (depth == 1 || depth == 2 || depth == 4));
+    if (!channels || !depthOk || (type == 3 && palette.empty()) || !sizeOk(w, h)) {
+        return false;
+    }
+    const size_t bitsPerPixel = static_cast<size_t>(channels) * depth;
+    const size_t bpp = std::max<size_t>(1, bitsPerPixel / 8);
+
+    struct Pass
+    {
+        int x0, y0, dx, dy;
+    };
+    static const Pass adam7[] = { { 0, 0, 8, 8 }, { 4, 0, 8, 8 }, { 0, 4, 4, 8 }, { 2, 0, 4, 4 }, { 0, 2, 2, 4 }, { 1, 0, 2, 2 }, { 0, 1, 1, 2 } };
+    static const Pass whole[] = { { 0, 0, 1, 1 } };
+    const Pass *passes = interlaced ? adam7 : whole;
+    const int passCount = interlaced ? 7 : 1;
+    auto passSize = [w, h](const Pass &ps, long long &pw, long long &ph) {
+        pw = (w - ps.x0 + ps.dx - 1) / ps.dx;
+        ph = (h - ps.y0 + ps.dy - 1) / ps.dy;
+    };
+    size_t expected = 0;
+    for (int i = 0; i < passCount; ++i) {
+        long long pw, ph;
+        passSize(passes[i], pw, ph);
+        if (pw > 0 && ph > 0) {
+            expected += static_cast<size_t>(ph) * (1 + (pw * bitsPerPixel + 7) / 8);
+        }
+    }
+    const std::string raw = inflateData(idat, expected);
+    if (raw.size() < expected) {
+        return false;
+    }
+
+    const bool gray = type == 0 || type == 4;
+    const int comps = gray ? 1 : 3;
+    std::string samples(static_cast<size_t>(w * h) * comps, '\0');
+    std::string alpha(static_cast<size_t>(w * h), '\xFF');
+    auto be16 = [&trns](size_t i) -> unsigned int { return i + 1 < trns.size() ? (static_cast<unsigned char>(trns[i]) << 8) | static_cast<unsigned char>(trns[i + 1]) : 0x10000; };
+    size_t pos = 0;
+    for (int i = 0; i < passCount; ++i) {
+        const Pass &ps = passes[i];
+        long long pw, ph;
+        passSize(ps, pw, ph);
+        if (pw <= 0 || ph <= 0) {
+            continue;
+        }
+        const size_t rowBytes = (pw * bitsPerPixel + 7) / 8;
+        std::vector<unsigned char> prev(rowBytes, 0), cur(rowBytes);
+        for (long long r = 0; r < ph; ++r) {
+            const unsigned int filter = static_cast<unsigned char>(raw[pos++]);
+            std::copy_n(raw.begin() + pos, rowBytes, cur.begin());
+            pos += rowBytes;
+            if (!unfilter(cur.data(), prev.data(), rowBytes, bpp, filter)) {
+                return false;
+            }
+            for (long long k = 0; k < pw; ++k) {
+                const size_t o = static_cast<size_t>((ps.y0 + r * ps.dy) * w + ps.x0 + k * ps.dx);
+                unsigned int s[4];
+                for (int c = 0; c < channels; ++c) {
+                    s[c] = packedSample(cur.data(), k * channels + c, depth);
+                }
+                if (type == 3) {
+                    const size_t idx = s[0];
+                    for (int c = 0; c < 3; ++c) {
+                        samples[o * 3 + c] = idx * 3 + 2 < palette.size() ? palette[idx * 3 + c] : '\0';
+                    }
+                    if (idx < trns.size()) {
+                        alpha[o] = trns[idx];
+                    }
+                    continue;
+                }
+                for (int c = 0; c < comps; ++c) {
+                    samples[o * comps + c] = static_cast<char>(scaleTo8(s[c], depth));
+                }
+                if (channels == 2 || channels == 4) {
+                    alpha[o] = static_cast<char>(scaleTo8(s[channels - 1], depth));
+                } else if ((type == 0 && s[0] == be16(0)) || (type == 2 && s[0] == be16(0) && s[1] == be16(2) && s[2] == be16(4))) {
+                    alpha[o] = '\0';
+                }
+            }
+            std::swap(prev, cur);
+        }
+    }
+    return finishRaster(img, static_cast<int>(w), static_cast<int>(h), comps, samples, alpha);
+}
+
+//------------------------------------------------------------------------
+// GIF
+//------------------------------------------------------------------------
+
+// Decodes the first image of the file.
+bool decodeGIF(const std::string &d, XFAImage &img)
+{
+    const Bytes b(d, true);
+    if (d.size() < 13 || d.compare(0, 3, "GIF") != 0) {
+        return false;
+    }
+    const int screenW = static_cast<int>(b.u16(6));
+    const int screenH = static_cast<int>(b.u16(8));
+    const unsigned int flags = b.u8(10);
+    size_t p = 13;
+    std::vector<unsigned char> globalPalette;
+    if (flags & 0x80) {
+        const size_t n = 3u << ((flags & 7) + 1);
+        globalPalette.assign(d.begin() + p, d.begin() + std::min(d.size(), p + n));
+        p += n;
+    }
+    int transparent = -1;
+    while (p < d.size()) {
+        const unsigned int block = b.u8(p++);
+        if (block == 0x21) {
+            const unsigned int label = b.u8(p++);
+            if (label == 0xF9 && b.u8(p) >= 4 && (b.u8(p + 1) & 1)) {
+                transparent = static_cast<int>(b.u8(p + 4));
+            }
+            while (p < d.size()) {
+                const unsigned int len = b.u8(p++);
+                if (len == 0) {
+                    break;
+                }
+                p += len;
+            }
+            continue;
+        }
+        if (block != 0x2C) {
+            break;
+        }
+        const int left = static_cast<int>(b.u16(p));
+        const int top = static_cast<int>(b.u16(p + 2));
+        const int w = static_cast<int>(b.u16(p + 4));
+        const int h = static_cast<int>(b.u16(p + 6));
+        const unsigned int iflags = b.u8(p + 8);
+        p += 9;
+        const int outW = std::max(screenW, left + w);
+        const int outH = std::max(screenH, top + h);
+        if (!sizeOk(w, h) || !sizeOk(outW, outH)) {
+            return false;
+        }
+        std::vector<unsigned char> palette = globalPalette;
+        if (iflags & 0x80) {
+            const size_t n = 3u << ((iflags & 7) + 1);
+            palette.assign(d.begin() + p, d.begin() + std::min(d.size(), p + n));
+            p += n;
+        }
+        const bool interlaced = iflags & 0x40;
+        const int minCode = static_cast<int>(b.u8(p++));
+        if (minCode < 2 || minCode > 11) {
+            return false;
+        }
+        std::string lzw;
+        while (p < d.size()) {
+            const unsigned int len = b.u8(p++);
+            if (len == 0) {
+                break;
+            }
+            lzw.append(d, p, len);
+            p += len;
+        }
+
+        // LZW decoding, least significant bits first.
+        std::vector<unsigned char> indices;
+        indices.reserve(static_cast<size_t>(w) * h);
+        const int clear = 1 << minCode;
+        const int eoi = clear + 1;
+        std::vector<int> prefix(4096, -1);
+        std::vector<unsigned char> suffix(4096), first(4096);
+        for (int i = 0; i < clear; ++i) {
+            suffix[i] = static_cast<unsigned char>(i);
+            first[i] = static_cast<unsigned char>(i);
+        }
+        int codeSize = minCode + 1;
+        int next = eoi + 1;
+        int prev = -1;
+        unsigned int bitBuf = 0;
+        int bitCount = 0;
+        std::vector<unsigned char> stack;
+        bool ended = false;
+        for (size_t i = 0; i < lzw.size() && !ended; ++i) {
+            bitBuf |= static_cast<unsigned int>(static_cast<unsigned char>(lzw[i])) << bitCount;
+            bitCount += 8;
+            while (bitCount >= codeSize) {
+                const int code = static_cast<int>(bitBuf & ((1u << codeSize) - 1));
+                bitBuf >>= codeSize;
+                bitCount -= codeSize;
+                if (code == clear) {
+                    codeSize = minCode + 1;
+                    next = eoi + 1;
+                    prev = -1;
+                    continue;
+                }
+                // Codes past the next table entry are invalid.
+                if (code == eoi || code > next || (code == next && prev < 0) || indices.size() >= static_cast<size_t>(w) * h) {
+                    ended = true;
+                    break;
+                }
+                int cur = code;
+                stack.clear();
+                if (code >= next) {
+                    stack.push_back(first[prev]);
+                    cur = prev;
+                }
+                while (cur >= clear) {
+                    stack.push_back(suffix[cur]);
+                    cur = prefix[cur];
+                }
+                stack.push_back(static_cast<unsigned char>(cur));
+                indices.insert(indices.end(), stack.rbegin(), stack.rend());
+                if (prev >= 0 && next < 4096) {
+                    prefix[next] = prev;
+                    suffix[next] = static_cast<unsigned char>(cur);
+                    first[next] = first[prev];
+                    ++next;
+                    if (next == (1 << codeSize) && codeSize < 12) {
+                        ++codeSize;
+                    }
+                }
+                first[code < next ? code : next - 1] = static_cast<unsigned char>(cur);
+                prev = code;
+            }
+        }
+        indices.resize(static_cast<size_t>(w) * h, static_cast<unsigned char>(transparent >= 0 ? transparent : 0));
+        if (interlaced) {
+            std::vector<unsigned char> rows(indices.size());
+            int src = 0;
+            const int starts[] = { 0, 4, 2, 1 }, steps[] = { 8, 8, 4, 2 };
+            for (int pass = 0; pass < 4; ++pass) {
+                for (int y = starts[pass]; y < h; y += steps[pass], ++src) {
+                    std::copy_n(indices.begin() + static_cast<size_t>(src) * w, w, rows.begin() + static_cast<size_t>(y) * w);
+                }
+            }
+            indices = std::move(rows);
+        }
+
+        // Outside the image and its transparent pixels are transparent.
+        std::string rgb(static_cast<size_t>(outW) * outH * 3, '\xFF');
+        std::string alpha(static_cast<size_t>(outW) * outH, '\0');
+        for (int y = 0; y < h; ++y) {
+            for (int x = 0; x < w; ++x) {
+                const int idx = indices[static_cast<size_t>(y) * w + x];
+                if (idx == transparent || static_cast<size_t>(idx) * 3 + 2 >= palette.size()) {
+                    continue;
+                }
+                const size_t o = static_cast<size_t>(top + y) * outW + left + x;
+                std::copy_n(palette.begin() + idx * 3, 3, rgb.begin() + o * 3);
+                alpha[o] = '\xFF';
+            }
+        }
+        return finishRaster(img, outW, outH, 3, rgb, alpha);
+    }
+    return false;
+}
+
+//------------------------------------------------------------------------
+// BMP
+//------------------------------------------------------------------------
+
+// A channel of a 16 or 32-bit pixel, scaled to 8 bits.
+unsigned char maskedChannel(uint32_t pixel, uint32_t mask)
+{
+    if (!mask) {
+        return 0xFF;
+    }
+    int shift = 0;
+    while (!((mask >> shift) & 1)) {
+        ++shift;
+    }
+    const uint32_t max = mask >> shift;
+    return static_cast<unsigned char>(((pixel & mask) >> shift) * 255 / max);
+}
+
+bool decodeBMP(const std::string &d, XFAImage &img)
+{
+    const Bytes b(d, true);
+    if (d.size() < 26 || d.compare(0, 2, "BM") != 0) {
+        return false;
+    }
+    const size_t dataOffset = b.u32(10);
+    const size_t headerSize = b.u32(14);
+    long long w, h;
+    unsigned int bpp, compression = 0;
+    size_t paletteEntry = 4, paletteCount = 0;
+    if (headerSize == 12) {
+        w = b.u16(18);
+        h = static_cast<int16_t>(b.u16(20));
+        bpp = b.u16(24);
+        paletteEntry = 3;
+    } else if (headerSize >= 40) {
+        w = static_cast<int32_t>(b.u32(18));
+        h = static_cast<int32_t>(b.u32(22));
+        bpp = b.u16(28);
+        compression = b.u32(30);
+        img.dpiX = b.u32(38) * 0.0254;
+        img.dpiY = b.u32(42) * 0.0254;
+        paletteCount = b.u32(46);
+    } else {
+        return false;
+    }
+    const bool topDown = h < 0;
+    h = std::abs(h);
+    // Uncompressed, or bit fields; not RLE.
+    if (!sizeOk(w, h) || !(compression == 0 || (compression == 3 && (bpp == 16 || bpp == 32)))) {
+        return false;
+    }
+    if (bpp != 1 && bpp != 4 && bpp != 8 && bpp != 16 && bpp != 24 && bpp != 32) {
+        return false;
+    }
+    uint32_t masks[4] = { 0, 0, 0, 0 };
+    if (compression == 3) {
+        // After a 40-byte header, or inside a larger one.
+        for (int i = 0; i < (headerSize >= 56 ? 4 : 3); ++i) {
+            masks[i] = b.u32(54 + 4 * i);
+        }
+    } else if (bpp == 16) {
+        masks[0] = 0x7C00;
+        masks[1] = 0x3E0;
+        masks[2] = 0x1F;
+    } else if (bpp == 32) {
+        masks[0] = 0xFF0000;
+        masks[1] = 0xFF00;
+        masks[2] = 0xFF;
+    }
+    if (bpp <= 8 && (paletteCount == 0 || paletteCount > (1u << bpp))) {
+        paletteCount = 1u << bpp;
+    }
+    const size_t paletteAt = 14 + headerSize;
+    const size_t rowSize = static_cast<size_t>((w * bpp + 31) / 32) * 4;
+    if (dataOffset > d.size() || rowSize * h > d.size() - dataOffset) {
+        return false;
+    }
+    std::string rgb(static_cast<size_t>(w * h) * 3, '\0');
+    std::string alpha(static_cast<size_t>(w * h), '\xFF');
+    for (long long r = 0; r < h; ++r) {
+        const size_t row = dataOffset + static_cast<size_t>(r) * rowSize;
+        const long long y = topDown ? r : h - 1 - r;
+        const auto *bytes = reinterpret_cast<const unsigned char *>(d.data()) + row;
+        for (long long x = 0; x < w; ++x) {
+            const size_t o = static_cast<size_t>(y * w + x);
+            unsigned char px[3];
+            if (bpp <= 8) {
+                const size_t idx = std::min<size_t>(packedSample(bytes, x, static_cast<int>(bpp)), paletteCount - 1);
+                const size_t e = paletteAt + idx * paletteEntry;
+                px[0] = static_cast<unsigned char>(b.u8(e + 2));
+                px[1] = static_cast<unsigned char>(b.u8(e + 1));
+                px[2] = static_cast<unsigned char>(b.u8(e));
+            } else if (bpp == 24) {
+                px[0] = bytes[x * 3 + 2];
+                px[1] = bytes[x * 3 + 1];
+                px[2] = bytes[x * 3];
+            } else {
+                const size_t at = row + x * (bpp / 8);
+                const uint32_t pixel = bpp == 16 ? b.u16(at) : b.u32(at);
+                for (int c = 0; c < 3; ++c) {
+                    px[c] = maskedChannel(pixel, masks[c]);
+                }
+                if (masks[3]) {
+                    alpha[o] = static_cast<char>(maskedChannel(pixel, masks[3]));
+                }
+            }
+            std::copy_n(px, 3, rgb.begin() + o * 3);
+        }
+    }
+    return finishRaster(img, static_cast<int>(w), static_cast<int>(h), 3, rgb, alpha);
+}
+
+//------------------------------------------------------------------------
+// TIFF
+//------------------------------------------------------------------------
+
+std::string packBits(const std::string &in, size_t expected)
+{
+    std::string out;
+    for (size_t i = 0; i < in.size() && out.size() < expected;) {
+        const int n = static_cast<signed char>(in[i++]);
+        if (n >= 0) {
+            out.append(in, i, n + 1);
+            i += n + 1;
+        } else if (n != -128 && i < in.size()) {
+            out.append(1 - n, in[i++]);
+        }
+    }
+    return out;
+}
+
+// TIFF's LZW: most significant bits first, code width grows one code early.
+std::string tiffLZW(const std::string &in, size_t expected)
+{
+    std::string out;
+    std::vector<int> prefix(4096, -1);
+    std::vector<unsigned char> suffix(4096), first(4096);
+    for (int i = 0; i < 256; ++i) {
+        suffix[i] = first[i] = static_cast<unsigned char>(i);
+    }
+    int codeSize = 9, next = 258, prev = -1;
+    uint32_t acc = 0;
+    int bits = 0;
+    std::vector<unsigned char> stack;
+    for (unsigned char c : in) {
+        acc = (acc << 8) | c;
+        bits += 8;
+        while (bits >= codeSize) {
+            const int code = static_cast<int>((acc >> (bits - codeSize)) & ((1u << codeSize) - 1));
+            bits -= codeSize;
+            acc &= (1u << bits) - 1;
+            if (code == 256) {
+                codeSize = 9;
+                next = 258;
+                prev = -1;
+                continue;
+            }
+            if (code == 257 || code > next || (code == next && prev < 0) || out.size() >= expected) {
+                return out;
+            }
+            stack.clear();
+            int cur = code;
+            if (code == next) {
+                stack.push_back(first[prev]);
+                cur = prev;
+            }
+            while (cur >= 258) {
+                stack.push_back(suffix[cur]);
+                cur = prefix[cur];
+            }
+            stack.push_back(static_cast<unsigned char>(cur));
+            out.append(stack.rbegin(), stack.rend());
+            if (prev >= 0 && next < 4096) {
+                prefix[next] = prev;
+                suffix[next] = static_cast<unsigned char>(cur);
+                first[next] = first[prev];
+                ++next;
+            }
+            if (next >= (1 << codeSize) - 1 && codeSize < 12) {
+                ++codeSize;
+            }
+            prev = code;
+        }
+    }
+    return out;
+}
+
+// Baseline TIFF with LZW, Deflate or PackBits: bilevel, gray, palette and
+// RGB images, in strips. The first image of the file.
+bool decodeTIFF(const std::string &d, XFAImage &img)
+{
+    if (d.size() < 8 || !(d.compare(0, 4, "II*\0", 4) == 0 || d.compare(0, 4, "MM\0*", 4) == 0)) {
+        return false;
+    }
+    const Bytes b(d, d[0] == 'I');
+    struct Entry
+    {
+        unsigned int type;
+        uint32_t count;
+        size_t offset;
+    };
+    std::map<unsigned int, Entry> tags;
+    const size_t ifd = b.u32(4);
+    const unsigned int n = b.u16(ifd);
+    for (unsigned int k = 0; k < n; ++k) {
+        const size_t e = ifd + 2 + 12 * k;
+        const unsigned int type = b.u16(e + 2);
+        const uint32_t count = b.u32(e + 4);
+        const size_t size = (type == 3 ? 2 : type == 4 ? 4 : type == 5 ? 8 : 1) * static_cast<size_t>(count);
+        tags[b.u16(e)] = { type, count, size <= 4 ? e + 8 : b.u32(e + 8) };
+    }
+    auto value = [&](unsigned int tag, uint32_t i, uint32_t def) -> uint32_t {
+        const auto it = tags.find(tag);
+        if (it == tags.end() || i >= it->second.count) {
+            return def;
+        }
+        const Entry &e = it->second;
+        return e.type == 3 ? b.u16(e.offset + 2 * i) : e.type == 4 ? b.u32(e.offset + 4 * i) : b.u8(e.offset + i);
+    };
+    auto count = [&](unsigned int tag) -> uint32_t { return tags.contains(tag) ? tags[tag].count : 0; };
+    auto rational = [&](unsigned int tag) -> double {
+        const auto it = tags.find(tag);
+        if (it == tags.end() || it->second.type != 5) {
+            return 0;
+        }
+        const uint32_t den = b.u32(it->second.offset + 4);
+        return den ? static_cast<double>(b.u32(it->second.offset)) / den : 0;
+    };
+
+    const long long w = value(256, 0, 0), h = value(257, 0, 0);
+    const int depth = static_cast<int>(value(258, 0, 1));
+    const uint32_t compression = value(259, 0, 1);
+    const uint32_t photometric = value(262, 0, 1);
+    const int spp = static_cast<int>(value(277, 0, 1));
+    const long long rowsPerStrip = std::min<long long>(value(278, 0, static_cast<uint32_t>(h)), h);
+    const uint32_t predictor = value(317, 0, 1);
+    if (!sizeOk(w, h) || rowsPerStrip <= 0 || value(284, 0, 1) != 1 || count(273) == 0 || spp < 1 || spp > 4) {
+        return false;
+    }
+    if (!(depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16) || (photometric == 2 && (depth < 8 || spp < 3)) || photometric > 3 || (photometric == 3 && (depth > 8 || count(320) < 3u << depth))) {
+        return false;
+    }
+    if (compression != 1 && compression != 5 && compression != 8 && compression != 32946 && compression != 32773) {
+        return false;
+    }
+    const double resScale = value(296, 0, 2) == 3 ? 2.54 : value(296, 0, 2) == 2 ? 1 : 0;
+    img.dpiX = rational(282) * resScale;
+    img.dpiY = rational(283) * resScale;
+
+    const size_t rowBytes = (static_cast<size_t>(w) * spp * depth + 7) / 8;
+    std::string raw;
+    for (uint32_t s = 0; s < count(273) && raw.size() < rowBytes * h; ++s) {
+        const size_t offset = value(273, s, 0);
+        const size_t stripBytes = rowBytes * static_cast<size_t>(std::min<long long>(rowsPerStrip, h - static_cast<long long>(s) * rowsPerStrip));
+        const size_t length = count(279) ? value(279, s, 0) : stripBytes;
+        if (offset > d.size()) {
+            return false;
+        }
+        const std::string in = d.substr(offset, length);
+        std::string strip = compression == 1 ? in : compression == 5 ? tiffLZW(in, stripBytes) : compression == 32773 ? packBits(in, stripBytes) : inflateData(in, stripBytes);
+        strip.resize(stripBytes, '\0');
+        if (predictor == 2 && depth == 8) {
+            for (size_t r = 0; r < stripBytes; r += rowBytes) {
+                for (size_t i = spp; i < rowBytes; ++i) {
+                    strip[r + i] = static_cast<char>(strip[r + i] + strip[r + i - spp]);
+                }
+            }
+        }
+        raw += strip;
+    }
+    raw.resize(rowBytes * h, '\0');
+
+    const bool rgbIn = photometric == 2;
+    const int colors = rgbIn ? 3 : 1;
+    const int comps = photometric == 0 || photometric == 1 ? 1 : 3;
+    const bool hasAlpha = spp > colors && (value(338, 0, 0) == 1 || value(338, 0, 0) == 2);
+    const bool premultiplied = value(338, 0, 0) == 1;
+    const unsigned int maxValue = (1u << depth) - 1;
+    std::string samples(static_cast<size_t>(w * h) * comps, '\0');
+    std::string alpha(static_cast<size_t>(w * h), '\xFF');
+    for (long long y = 0; y < h; ++y) {
+        const auto *row = reinterpret_cast<const unsigned char *>(raw.data()) + y * rowBytes;
+        for (long long x = 0; x < w; ++x) {
+            const size_t o = static_cast<size_t>(y * w + x);
+            const size_t base = static_cast<size_t>(x) * spp;
+            unsigned char a = 0xFF;
+            if (hasAlpha) {
+                a = scaleTo8(packedSample(row, base + colors, depth), depth);
+                alpha[o] = static_cast<char>(a);
+            }
+            if (photometric == 3) {
+                const uint32_t idx = packedSample(row, base, depth);
+                for (int c = 0; c < 3; ++c) {
+                    samples[o * 3 + c] = static_cast<char>(value(320, c * (1u << depth) + idx, 0) >> 8);
+                }
+                continue;
+            }
+            for (int c = 0; c < colors; ++c) {
+                unsigned int v = packedSample(row, base + c, depth);
+                if (photometric == 0) {
+                    v = maxValue - v;
+                }
+                unsigned int v8 = scaleTo8(v, depth);
+                if (premultiplied && a) {
+                    v8 = std::min(255u, v8 * 255 / a);
+                }
+                samples[o * comps + c] = static_cast<char>(v8);
+            }
+        }
+    }
+    return finishRaster(img, static_cast<int>(w), static_cast<int>(h), comps, samples, alpha);
+}
+
+} // namespace
+
+std::string XFADeflate(const std::string &data)
+{
+    uLongf len = compressBound(data.size());
+    std::string out(len, '\0');
+    if (compress2(reinterpret_cast<Bytef *>(out.data()), &len, reinterpret_cast<const Bytef *>(data.data()), data.size(), 6) != Z_OK) {
+        return {};
+    }
+    out.resize(len);
+    return out;
+}
+
+bool XFADecodeImage(const std::string &data, XFAImage &img)
+{
+    img = XFAImage();
+    return decodeJPEG(data, img) || decodePNG(data, img) || decodeGIF(data, img) || decodeBMP(data, img) || decodeTIFF(data, img);
+}
