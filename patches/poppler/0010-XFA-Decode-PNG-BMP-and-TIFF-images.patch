+/* Images in a row of one inch squares, drawn over a blue background */
+static const char *const images[][2] = {
+    /* RGB, red */
+    { "png", "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAFklEQVR4nGP8z8DAwMDAxMDAwMDAAAANHQEDasKb6QAAAABJRU5ErkJggg==" },
+    /* palette, the only color transparent */
+    { "png", "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACAQMAAABIeJ9nAAAABlBMVEUA/wD/AADRm0quAAAAAXRSTlMAQObYZgAAAAxJREFUeJxjYGBgAAAABAAB9hc4VQAAAABJRU5ErkJggg==" },
+    /* RGBA, green and transparent halves */
+    { "png", "iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAYAAAD0In+KAAAAEUlEQVR4nGNg+M/w/z8DAwMAD/kC/nlhB4sAAAAASUVORK5CYII=" },
+    /* gray, interlaced, black and white halves */
+    { "png", "iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAAAAAGWY9HBAAAAGUlEQVR4nGNkYPzPyABHDP8Z8BEgigEfAwCT6Q4C5pw1AgAAAABJRU5ErkJggg==" },
+    /* 24 bits, yellow and blue halves */
+    { "bmp", "Qk1GAAAAAAAAADYAAAAoAAAAAgAAAAIAAAABABgAAAAAABAAAADEDgAAxA4AAAAAAAAAAAAA/wAA/wAAAAAA//8A//8AAA==" },
+    /* 1 bit, black */
+    { "bmp", "Qk1eAAAAAAAAAD4AAAAoAAAACAAAAAgAAAABAAEAAAAAACAAAADEDgAAxA4AAAIAAAACAAAAAAAAAP///wAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==" },
+    /* 1 bit, black */
+    { "tiff", "SUkqAAgAAAAIAAABBAABAAAACAAAAAEBBAABAAAACAAAAAMBAwABAAAAAQAAAAYBAwABAAAAAQAAABEBBAABAAAAbgAAABYBBAABAAAACAAAABcBBAABAAAACAAAABwBAwABAAAAAQAAAAAAAAAAAAAAAAAAAA==" },
+    /* RGB, LZW, magenta */
+    { "tiff", "SUkqABQAAACAP8AP+BQSBwWAgAAKAAABAwABAAAAAgAAAAEBAwABAAAAAgAAAAIBAwADAAAAkgAAAAMBAwABAAAABQAAAAYBAwABAAAAAgAAABEBBAABAAAACAAAABUBAwABAAAAAwAAABYBAwABAAAAAgAAABcBBAABAAAACwAAABwBAwABAAAAAQAAAAAAAAAIAAgACAA=" },
+    /* the only color transparent */
+    { "gif", "R0lGODlhAgACAIEAAAD/AAAAAAAAAAAAACH5BAEAAAAALAAAAAACAAIAAAgGAAEIBBAQADs=" },
+};
+
+static char *image_xdp(void)
+{
+    GString *s = g_string_new("<?xml version=\"1.0\"?>\n"
+                              "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                              "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                              "<subform name=\"form1\" layout=\"tb\">"
+                              "<pageSet><pageArea name=\"Page1\">"
+                              "<contentArea x=\"0in\" y=\"0in\" w=\"11in\" h=\"8.5in\"/>"
+                              "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\" orientation=\"landscape\"/>"
+                              "</pageArea></pageSet>"
+                              "<subform name=\"Images\" layout=\"position\" w=\"11in\" h=\"2in\">");
+    for (gsize i = 0; i < G_N_ELEMENTS(images); ++i) {
+        g_string_append_printf(s,
+                               "<draw x=\"%d.25in\" y=\"0.5in\" w=\"1in\" h=\"1in\">"
+                               "<border><edge presence=\"hidden\"/><fill><color value=\"0,0,255\"/></fill></border>"
+                               "<value><image aspect=\"none\" contentType=\"image/%s\">%s</image></value></draw>",
+                               (int)i, images[i][0], images[i][1]);
+    }
+    g_string_append(s, "</subform></subform></template></xdp:xdp>");
+    return g_string_free(s, FALSE);
+}
+
+static void test_images(void)
+{
+    /* The color expected at a point of an image, as a fraction of its square */
+    static const struct
+    {
+        int image;
+        double x, y;
+        unsigned char r, g, b;
+    } expected[] = {
+        { 0, 0.5, 0.5, 255, 0, 0 },    { 1, 0.5, 0.5, 0, 0, 255 },  { 2, 0.25, 0.5, 0, 255, 0 }, { 2, 0.75, 0.5, 0, 0, 255 }, { 3, 0.25, 0.5, 0, 0, 0 },    { 3, 0.75, 0.5, 255, 255, 255 },
+        { 4, 0.5, 0.25, 255, 255, 0 }, { 4, 0.5, 0.75, 0, 0, 255 }, { 5, 0.5, 0.5, 0, 0, 0 },    { 6, 0.5, 0.5, 0, 0, 0 },    { 7, 0.5, 0.5, 255, 0, 255 }, { 8, 0.5, 0.5, 0, 0, 255 },
+    };
+    char *xdp = image_xdp();
+    GBytes *bytes = build_pdf_from(xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    PopplerPage *page = poppler_document_get_page(rendered, 0);
+    double width, height;
+    poppler_page_get_size(page, &width, &height);
+    cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_RGB24, width, height);
+    cairo_t *cr = cairo_create(surface);
+    cairo_set_source_rgb(cr, 1, 1, 1);
+    cairo_paint(cr);
+    poppler_page_render(page, cr);
+    cairo_surface_flush(surface);
+    const unsigned char *data = cairo_image_surface_get_data(surface);
+    const int stride = cairo_image_surface_get_stride(surface);
+    for (gsize i = 0; i < G_N_ELEMENTS(expected); ++i) {
+        const int x = (int)((expected[i].image + 0.25 + expected[i].x) * 72);
+        const int y = (int)((0.5 + expected[i].y) * 72);
+        const unsigned char *pixel = data + y * stride + x * 4;
+        g_test_message("image %d at %d,%d: %d,%d,%d", expected[i].image, x, y, pixel[2], pixel[1], pixel[0]);
+        g_assert_cmpint(ABS(pixel[2] - expected[i].r), <, 8);
+        g_assert_cmpint(ABS(pixel[1] - expected[i].g), <, 8);
+        g_assert_cmpint(ABS(pixel[0] - expected[i].b), <, 8);
+    }
+    cairo_destroy(cr);
+    cairo_surface_destroy(surface);
+    g_object_unref(page);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+    g_free(xdp);
+}
+
