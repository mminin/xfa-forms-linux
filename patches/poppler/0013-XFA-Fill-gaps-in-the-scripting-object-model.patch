 }
 
+// The lists of display texts and of values of a choice field; either may
+// be missing.
+static void itemLists(XFANode *field, XFANode **display, XFANode **save)
+{
+    *display = nullptr;
+    *save = nullptr;
+    for (XFANode *l : field->childrenOfClass("items")) {
+        const bool isSave = l->getAttr("save", "0") == "1" || l->getAttr("presence", "visible") == "hidden";
+        if (isSave && !*save) {
+            *save = l;
+        } else if (!isSave && !*display) {
+            *display = l;
+        }
+    }
+}
+
+void XFAForm::clearItems(XFANode *field)
+{
+    XFANode *display, *save;
+    itemLists(field, &display, &save);
+    for (XFANode *l : { display, save }) {
+        while (l && !l->getChildren().empty()) {
+            l->removeChild(l->getChildren().back().get());
+        }
+    }
+    nodeChanged(field);
+}
+
+void XFAForm::addItem(XFANode *field, const std::string &displayText, const std::optional<std::string> &saveValue)
+{
+    XFANode *display, *save;
+    itemLists(field, &display, &save);
+    auto addText = [this](XFANode *list, const std::string &text) {
+        XFANode *t = list->appendChild(std::make_unique<XFANode>(&formDom, "text"));
+        t->setTextContent(text);
+    };
+    if (!display) {
+        display = field->appendChild(std::make_unique<XFANode>(&formDom, "items"));
+    }
+    if (saveValue && *saveValue != displayText && !save) {
+        // Values differing from the texts need a list of their own.
+        save = field->appendChild(std::make_unique<XFANode>(&formDom, "items"));
+        save->setAttr("save", "1");
+        save->setAttr("presence", "hidden");
+        for (XFANode *c : display->elementChildren()) {
+            addText(save, c->textContent());
+        }
+    }
+    addText(display, displayText);
+    if (save && save != display) {
+        addText(save, saveValue.value_or(displayText));
+    }
+    nodeChanged(field);
+}
+
+void XFAForm::deleteItem(XFANode *field, int index)
+{
+    XFANode *display, *save;
+    itemLists(field, &display, &save);
+    for (XFANode *l : { display, save }) {
+        const std::vector<XFANode *> items = l ? l->elementChildren() : std::vector<XFANode *>();
+        if (index >= 0 && index < static_cast<int>(items.size())) {
+            l->removeChild(items[index]);
+        }
+    }
+    nodeChanged(field);
+}
+
 std::vector<std::string> XFAForm::getItems(XFANode *field, bool saveValues) const
 {
     const std::vector<XFANode *> lists = field->childrenOfClass("items");
