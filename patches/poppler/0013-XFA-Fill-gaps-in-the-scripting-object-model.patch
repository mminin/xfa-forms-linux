+/* Script access to form variables, script object functions and variables,
+ * fields inside named areas, bare parent references, and item lists. */
+static const char *scripting_xdp = "<?xml version=\"1.0\"?>\n"
+                                   "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                                   "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                                   "<subform name=\"form1\" layout=\"tb\">"
+                                   "<pageSet><pageArea name=\"Page1\">"
+                                   "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                                   "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/>"
+                                   "</pageArea></pageSet>"
+                                   "<variables><text name=\"Version\">v7</text>"
+                                   "<script name=\"util\" contentType=\"application/x-javascript\">"
+                                   "var count = 2; /* function hidden() {} */ var re = /[{'\"]/;\n"
+                                   "function outer() { function inner() { return 1; } return inner() + count; }\n"
+                                   "function bump() { count++; }"
+                                   "</script></variables>"
+                                   "<subform name=\"Sub\" layout=\"position\" w=\"6in\" h=\"0.5in\">"
+                                   "<area name=\"Box\"><field name=\"inArea\" w=\"1in\" h=\"0.3in\"><ui><textEdit/></ui><value><text>boxed</text></value></field></area>"
+                                   "</subform>"
+                                   "<field name=\"list\" w=\"3in\" h=\"0.3in\"><ui><choiceList/></ui></field>"
+                                   "<field name=\"out\" w=\"6in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui>"
+                                   "<event activity=\"initialize\"><script contentType=\"application/x-javascript\">"
+                                   "util.bump(); list.clearItems(); list.addItem(\"Canada\", \"CA\"); list.addItem(\"France\", \"FR\"); list.rawValue = \"FR\";"
+                                   "this.rawValue = [Version.value, form1.Sub.inArea.rawValue, util.outer(), util.count, parent.name, list.formattedValue].join(\"|\");"
+                                   "</script></event></field>"
+                                   "</subform>"
+                                   "</template>"
+                                   "</xdp:xdp>";
+
+static void test_scripting(void)
+{
+    GBytes *bytes = build_pdf_from(scripting_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    char *text = page_text(rendered);
+    if (!strstr(text, "v7")) {
+        g_test_skip("poppler was built without XFA scripting");
+    } else {
+        g_assert_nonnull(strstr(text, "v7|boxed|4|3|form1|France"));
+    }
+    g_free(text);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -547,5 +596,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/images", test_images);
     g_test_add_func("/xfa/table", test_table);
     g_test_add_func("/xfa/static-values", test_static_values);
+    g_test_add_func("/xfa/scripting", test_scripting);
     return g_test_run();
 }
