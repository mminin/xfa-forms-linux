+void XFAForm::moveInstance(const InstanceManager &im, int from, int to)
+{
+    const std::vector<XFANode *> existing = instances(im);
+    const int n = static_cast<int>(existing.size());
+    if (from < 0 || from >= n || to < 0 || to >= n || from == to) {
+        return;
+    }
+    const size_t pos = existing[to]->indexInParent();
+    std::unique_ptr<XFANode> node = im.parent->removeChild(existing[from]);
+    im.parent->insertChild(pos, std::move(node));
+    invalidateLayout();
+    runCalculations();
+}
