-void anchorOffset(const XFANode *n, double w, double h, double *dx, double *dy)
+// Where the box b covers starts, left of and above the anchor point given
+// by the node's x and y. Turned objects turn about their anchor point.
+void anchorOffset(const Box &b, double *dx, double *dy)
 {
-    const std::string a = n->getAttr("anchorType", "topLeft");
-    *dx = 0;
-    *dy = 0;
+    const bool quarter = b.rotate == 90 || b.rotate == 270;
+    const double w = quarter ? b.h : b.w, h = quarter ? b.w : b.h;
+    const std::string a = b.node->getAttr("anchorType", "topLeft");
+    double ax = 0, ay = 0;
     if (a.ends_with("Center")) {
-        *dx = w / 2;
+        ax = w / 2;
     } else if (a.ends_with("Right")) {
-        *dx = w;
+        ax = w;
     }
     if (a.starts_with("middle")) {
-        *dy = h / 2;
+        ay = h / 2;
     } else if (a.starts_with("bottom")) {
-        *dy = h;
+        ay = h;
+    }
+    // The unturned box spans -ax..w-ax and -ay..h-ay around the anchor;
+    // counterclockwise on the page, y pointing down.
+    switch (b.rotate) {
+    case 90: // (x, y) -> (y, -x)
+        *dx = ay;
+        *dy = w - ax;
+        break;
+    case 180: // (x, y) -> (-x, -y)
+        *dx = w - ax;
+        *dy = h - ay;
+        break;
+    case 270: // (x, y) -> (-y, x)
+        *dx = h - ay;
+        *dy = ax;
+        break;
+    default:
+        *dx = ax;
+        *dy = ay;
     }
 }
 
