 }
 
+// The rectangle x, y, w, h of the turned item, drawn unturned with its top
+// left corner at the item's, as it lies on the page.
+void Writer::turnedRect(double &x, double &y, double &w, double &h) const
+{
+    if (!turned) {
+        return;
+    }
+    const XFALayoutItem &t = *turned;
+    const bool quarter = t.rotate == 90 || t.rotate == 270;
+    const double nw = quarter ? t.h : t.w, nh = quarter ? t.w : t.h;
+    auto map = [&](double px, double py, double &ox, double &oy) {
+        const double u = px - t.x, v = py - t.y;
+        switch (t.rotate) {
+        case 90:
+            ox = v;
+            oy = nw - u;
+            break;
+        case 180:
+            ox = nw - u;
+            oy = nh - v;
+            break;
+        default: // 270
+            ox = nh - v;
+            oy = u;
+        }
+        ox += t.x;
+        oy += t.y;
+    };
+    double x1, y1, x2, y2;
+    map(x, y, x1, y1);
+    map(x + w, y + h, x2, y2);
+    x = std::min(x1, x2);
+    y = std::min(y1, y2);
+    w = std::abs(x2 - x1);
+    h = std::abs(y2 - y1);
+}
