+int XFARotationOf(const XFANode *node)
+{
+    const std::string *attr = node ? node->getAttr("rotate") : nullptr;
+    if (!attr) {
+        return 0;
+    }
+    const double degrees = std::strtod(attr->c_str(), nullptr);
+    if (!std::isfinite(degrees) || std::abs(degrees) > 1e6) {
+        return 0;
+    }
+    // Other angles are not allowed; take the nearest quarter turn.
+    const long quarters = std::lround(degrees / 90);
+    return static_cast<int>(((quarters % 4) + 4) % 4) * 90;
+}
