+std::string XFALocalizePattern(const XFALocale &locale, const std::string &pattern, bool time)
+{
+    // The standard letter, in "GyMdkHmsSEDFwWahKzZ", for each picture symbol.
+    static const std::string standard = "GyMdkHmsSEDFwWahKzZ";
+    std::string out;
+    for (size_t i = 0; i < pattern.size(); ++i) {
+        const char c = pattern[i];
+        if (c == '\'') {
+            const size_t end = pattern.find('\'', i + 1);
+            out += pattern.substr(i, end == std::string::npos ? std::string::npos : end - i + 1);
+            i = end == std::string::npos ? pattern.size() : end;
+            continue;
+        }
+        char letter = 0;
+        if (time) {
+            switch (c) {
+            case 'H':
+                letter = 'H';
+                break;
+            case 'K':
+                letter = 'k';
+                break;
+            case 'h':
+                letter = 'h';
+                break;
+            case 'k':
+                letter = 'K';
+                break;
+            case 'M':
+                letter = 'm';
+                break;
+            case 'S':
+                letter = 's';
+                break;
+            case 'F':
+                letter = 'S';
+                break;
+            case 'A':
+                letter = 'a';
+                break;
+            case 'Z':
+                letter = 'z';
+                break;
+            case 'z':
+                letter = 'Z';
+                break;
+            }
+        } else {
+            switch (c) {
+            case 'G':
+                letter = 'G';
+                break;
+            case 'Y':
+                letter = 'y';
+                break;
+            case 'M':
+                letter = 'M';
+                break;
+            case 'D':
+                letter = 'd';
+                break;
+            case 'E':
+                letter = 'E';
+                break;
+            case 'J':
+                letter = 'D';
+                break;
+            case 'w':
+                letter = 'w';
+                break;
+            case 'W':
+                letter = 'W';
+                break;
+            }
+        }
+        const size_t at = letter ? standard.find(letter) : std::string::npos;
+        out += at != std::string::npos && at < locale.dateTimeSymbols.size() ? locale.dateTimeSymbols[at] : c;
+    }
+    return out;
+}
