+// The text of an element of a localeSet, without the line breaks and
+// indentation around it.
+static std::string localeText(const XFANode *node)
+{
+    std::string s = node->textContent();
+    const size_t start = s.find_first_not_of("\r\n\t");
+    const size_t end = s.find_last_not_of("\r\n\t");
+    return start == std::string::npos ? std::string() : s.substr(start, end - start + 1);
+}
+
+static std::vector<XFALocale> readLocales(const XFANode *localeSet)
+{
+    std::vector<XFALocale> res;
+    for (const XFANode *node : localeSet->childrenOfClass("locale")) {
+        // What the form leaves out keeps its built-in definition.
+        XFALocale l = XFABuiltinLocale(node->getAttr("name", ""));
+        const auto texts = [](const XFANode *list, const char *item) {
+            std::vector<std::string> v;
+            for (const XFANode *n : list->childrenOfClass(item)) {
+                v.push_back(localeText(n));
+            }
+            return v;
+        };
+        const auto named = [](const XFANode *list, const char *item, std::map<std::string, std::string> &into) {
+            for (const XFANode *n : list->childrenOfClass(item)) {
+                into[n->getAttr("name", "")] = localeText(n);
+            }
+        };
+        if (const XFANode *calendar = node->firstChild("calendarSymbols")) {
+            for (const XFANode *names : calendar->childrenOfClass("monthNames")) {
+                if (std::vector<std::string> v = texts(names, "month"); v.size() == 12) {
+                    (names->getAttr("abbr", "0") == "1" ? l.monthAbbrs : l.months) = std::move(v);
+                }
+            }
+            for (const XFANode *names : calendar->childrenOfClass("dayNames")) {
+                if (std::vector<std::string> v = texts(names, "day"); v.size() == 7) {
+                    (names->getAttr("abbr", "0") == "1" ? l.dayAbbrs : l.days) = std::move(v);
+                }
+            }
+            if (const XFANode *names = calendar->firstChild("meridiemNames")) {
+                if (std::vector<std::string> v = texts(names, "meridiem"); v.size() == 2) {
+                    l.meridiems = std::move(v);
+                }
+            }
+            if (const XFANode *names = calendar->firstChild("eraNames")) {
+                if (std::vector<std::string> v = texts(names, "era"); v.size() == 2) {
+                    l.eras = std::move(v);
+                }
+            }
+        }
+        if (const XFANode *list = node->firstChild("datePatterns")) {
+            named(list, "datePattern", l.datePatterns);
+        }
+        if (const XFANode *list = node->firstChild("timePatterns")) {
+            named(list, "timePattern", l.timePatterns);
+        }
+        if (const XFANode *list = node->firstChild("numberPatterns")) {
+            named(list, "numberPattern", l.numberPatterns);
+        }
+        if (const XFANode *symbols = node->firstChild("dateTimeSymbols"); symbols && !localeText(symbols).empty()) {
+            l.dateTimeSymbols = localeText(symbols);
+        }
+        // Number symbols are kept as they are: grouping may be a space.
+        if (const XFANode *list = node->firstChild("numberSymbols")) {
+            for (const XFANode *n : list->childrenOfClass("numberSymbol")) {
+                const std::string name = n->getAttr("name", "");
+                const std::string v = n->textContent();
+                if (v.empty()) {
+                    continue;
+                }
+                if (name == "decimal") {
+                    l.decimal = v;
+                } else if (name == "grouping") {
+                    l.grouping = v;
+                } else if (name == "percent") {
+                    l.percent = v;
+                } else if (name == "minus") {
+                    l.minus = v;
+                }
+            }
+        }
+        if (const XFANode *list = node->firstChild("currencySymbols")) {
+            for (const XFANode *n : list->childrenOfClass("currencySymbol")) {
+                const std::string name = n->getAttr("name", "");
+                if (name == "symbol" && !localeText(n).empty()) {
+                    l.currencySymbol = localeText(n);
+                } else if (name == "isoname" && !localeText(n).empty()) {
+                    l.currencyName = localeText(n);
+                }
+            }
+        }
+        res.push_back(std::move(l));
+    }
+    return res;
+}
