+/* Default patterns and names come from the form's locales, then from the
+ * built-in ones; null{} and zero{} apply only to null and zero values. */
+static void test_locales(void)
+{
+    const char *xml = "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                      "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                      "<subform name=\"form1\" layout=\"tb\" locale=\"en_CA\"><pageSet><pageArea name=\"Page1\">"
+                      "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                      "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/></pageArea></pageSet>"
+                      "<field name=\"amount\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><numericEdit/></ui>"
+                      "<format><picture>null{}|num{$z,zzz,zz9.zz}</picture></format><value><decimal>1234.5</decimal></value></field>"
+                      "<field name=\"nothing\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><numericEdit/></ui>"
+                      "<format><picture>null{}|zero{'nil'}|num.currency{}</picture></format><value><decimal>0</decimal></value></field>"
+                      "<field name=\"short\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><dateTimeEdit/></ui>"
+                      "<format><picture>date.short{}</picture></format><value><date>2024-03-05</date></value></field>"
+                      "<field name=\"long\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\" locale=\"fr_CA\"><ui><dateTimeEdit/></ui>"
+                      "<format><picture>date.long{}</picture></format><value><date>2024-03-05</date></value></field>"
+                      "<field name=\"time\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><dateTimeEdit/></ui>"
+                      "<format><picture>time{h:MM A}</picture></format><value><time>13:05:00</time></value></field>"
+                      "</subform></template>"
+                      "<localeSet xmlns=\"http://www.xfa.org/schema/xfa-locale-set/2.7/\"><locale name=\"en_CA\">"
+                      "<datePatterns><datePattern name=\"short\">YYYY/MM/DD</datePattern></datePatterns>"
+                      "</locale></localeSet></xdp:xdp>";
+    GBytes *bytes = build_pdf_from(xml);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    char *text = page_text(rendered);
+    g_assert_nonnull(strstr(text, "$1,234.5"));
+    g_assert_null(strstr(text, "1234.5"));
+    g_assert_nonnull(strstr(text, "nil"));
+    g_assert_nonnull(strstr(text, "2024/03/05"));
+    g_assert_nonnull(strstr(text, "5 mars 2024"));
+    g_assert_nonnull(strstr(text, "1:05 PM"));
+    g_free(text);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
