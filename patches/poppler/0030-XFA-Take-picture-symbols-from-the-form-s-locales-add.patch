+std::optional<XFALocale> XFAFindLocale(const std::vector<XFALocale> &locales, const std::string &name)
+{
+    std::string n = name;
+    std::ranges::replace(n, '-', '_');
+    for (const XFALocale &l : locales) {
+        if (l.name == n) {
+            return l;
+        }
