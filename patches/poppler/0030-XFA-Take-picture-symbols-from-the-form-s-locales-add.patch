+    std::string out = padded(t.h, 2) + ":" + padded(t.m, 2) + ":" + padded(t.s, 2);
+    if (t.ms) {
+        out += "." + padded(t.ms, 3);
+    }
+    if (t.zone == Time::Utc) {
+        out += "Z";
+    } else if (t.zone == Time::Offset) {
+        out += offsetText(t.offset, true);
+    }
+    return out;
+}
+
+std::optional<std::string> formatTimeOf(const std::string &pattern, const Time &t, const XFALocale &l)
+{
+    const auto [localOffset, localName] = localZone();
+    const int offset = t.zone == Time::Utc ? 0 : t.zone == Time::Offset ? t.offset : localOffset;
+    std::string out;
+    for (const std::string &k : symbolTokens(pattern, timeSymbols)) {
+        if (k[0] == '\'') {
+            out += k.substr(1);
+        } else if (k == "h" || k == "hh") {
+            out += padded(t.h % 12 ? t.h % 12 : 12, k.size());
+        } else if (k == "k" || k == "kk") {
+            out += padded(t.h % 12, k.size());
+        } else if (k == "H" || k == "HH") {
+            out += padded(t.h, k.size());
+        } else if (k == "K" || k == "KK") {
+            out += padded(t.h ? t.h : 24, k.size());
+        } else if (k == "M" || k == "MM") {
+            out += padded(t.m, k.size());
+        } else if (k == "S" || k == "SS") {
+            out += padded(t.s, k.size());
+        } else if (k == "FFF") {
+            out += padded(t.ms, 3);
+        } else if (k == "A") {
+            out += nameAt(l.meridiems, t.h < 12 ? 0 : 1);
+        } else if (k == "Z") {
+            // Local time has its usual abbreviation in English.
+            if (t.zone == Time::Local && l.name.starts_with("en") && !localName.empty() && localName.find(' ') == std::string::npos) {
+                out += localName;
+            } else {
+                out += offset ? "GMT" + offsetText(offset, true) : "GMT";
+            }
+        } else if (k == "z" || k == "zz") {
+            out += offset || t.zone == Time::Local ? offsetText(offset, k == "zz") : "Z";
+        } else {
+            return std::nullopt;
+        }
+    }
+    return out;
+}
+
+// Zone abbreviations that times may be written with, in minutes east of
+// GMT.
+std::optional<int> zoneOffset(const std::string &name)
+{
+    static const std::pair<const char *, int> zones[] = { { "GMT", 0 },    { "UTC", 0 },    { "UT", 0 },     { "WET", 0 },    { "WEST", 60 },   { "BST", 60 },    { "CET", 60 },   { "CEST", 120 }, { "EET", 120 },
+                                                          { "EEST", 180 }, { "NST", -210 }, { "NDT", -150 }, { "AST", -240 }, { "ADT", -180 },  { "EST", -300 },  { "EDT", -240 }, { "CST", -360 }, { "CDT", -300 },
+                                                          { "MST", -420 }, { "MDT", -360 }, { "PST", -480 }, { "PDT", -420 }, { "AKST", -540 }, { "AKDT", -480 }, { "HST", -600 } };
+    for (const auto &[n, o] : zones) {
+        if (name == n) {
+            return o;
+        }
+    }
+    return std::nullopt;
+}
+
+std::optional<Time> readTime(const std::string &pattern, Reader &r, const XFALocale &l)
+{
+    Time t;
+    int hour = -1;
+    bool twelve = false; // h or k
+    std::optional<int> meridiem;
+    for (const std::string &k : symbolTokens(pattern, timeSymbols)) {
+        std::optional<int> v;
+        if (k[0] == '\'') {
+            if (!r.literal(k.substr(1))) {
+                return std::nullopt;
+            }
+            continue;
+        }
+        const size_t width = k.size() == 2 ? 2 : 1;
+        if (k == "h" || k == "hh" || k == "k" || k == "kk" || k == "H" || k == "HH" || k == "K" || k == "KK") {
+            v = r.number(width, 2);
+            if (v) {
+                const char c = k[0];
+                twelve = c == 'h' || c == 'k';
+                if ((c == 'h' && (*v < 1 || *v > 12)) || (c == 'k' && *v > 11) || (c == 'H' && *v > 23) || (c == 'K' && (*v < 1 || *v > 24))) {
+                    return std::nullopt;
+                }
+                hour = c == 'K' ? *v % 24 : c == 'h' ? *v % 12 : *v;
+            }
+        } else if (k == "M" || k == "MM") {
+            v = r.number(width, 2);
+            if (v && *v > 59) {
+                return std::nullopt;
+            }
+            t.m = v.value_or(0);
+        } else if (k == "S" || k == "SS") {
+            v = r.number(width, 2);
+            if (v && *v > 59) {
+                return std::nullopt;
+            }
+            t.s = v.value_or(0);
+        } else if (k == "FFF") {
+            v = r.number(3, 3);
+            t.ms = v.value_or(0);
+        } else if (k == "A") {
+            v = meridiem = r.name(l.meridiems);
+        } else if (k == "Z") {
+            if (r.literal("GMT") || r.literal("UTC")) {
+                v = 0;
+                if (!readOffset(r, t)) {
+                    t.zone = Time::Utc;
+                }
+            } else {
+                size_t end = r.pos;
+                while (end < r.text.size() && std::isalpha(static_cast<unsigned char>(r.text[end]))) {
+                    ++end;
+                }
+                const std::string name = r.text.substr(r.pos, end - r.pos);
+                if (const std::optional<int> o = zoneOffset(name)) {
+                    v = 0;
+                    r.pos = end;
+                    t.zone = *o ? Time::Offset : Time::Utc;
+                    t.offset = *o;
+                } else if (!name.empty() && name == localZone().second) {
+                    v = 0;
+                    r.pos = end;
+                }
+            }
+        } else if (k == "z" || k == "zz") {
+            if (readOffset(r, t)) {
+                v = 0;
+            }
+        } else {
+            return std::nullopt;
+        }
+        if (!v) {
+            return std::nullopt;
+        }
+    }
+    if (hour < 0) {
+        return std::nullopt;
+    }
+    // A meridiem applies to hours of either clock: "1:13 PM" is 13:13.
+    if (meridiem && *meridiem == 1 && hour < 12) {
+        hour += 12;
+    } else if (meridiem && *meridiem == 0 && twelve) {
+        hour %= 12;
+    }
+    t.h = hour;
+    return t;
+}
