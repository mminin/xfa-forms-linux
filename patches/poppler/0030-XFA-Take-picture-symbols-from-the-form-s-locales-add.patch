+// A date-time pattern: the date and time patterns separated by "T".
+std::pair<std::string, std::string> dateTimeParts(const std::string &pattern)
+{
+    const std::vector<std::string> parts = splitPicture(pattern, 'T', false);
+    if (parts.size() < 2) {
+        return { pattern, {} };
+    }
+    std::string time = parts[1];
+    for (size_t i = 2; i < parts.size(); ++i) {
+        time += "T" + parts[i];
+    }
+    return { parts[0], time };
+}
+
+std::optional<std::string> formatClause(const Clause &c, const std::string &pattern, const std::string &value, const XFALocale &l)
+{
+    if (c.category == "num") {
+        return formatNumber(pattern, value, l);
+    }
+    if (c.category == "text") {
+        return formatText(pattern, value);
+    }
+    if (c.category == "date") {
+        const std::optional<Date> d = canonicalDate(value);
+        return d ? formatDateOf(pattern, *d, l) : std::nullopt;
+    }
+    if (c.category == "time") {
+        const std::optional<Time> t = canonicalTime(value);
+        return t ? formatTimeOf(pattern, *t, l) : std::nullopt;
+    }
+    if (c.category == "datetime") {
+        const auto [datePattern, timePattern] = dateTimeParts(pattern);
+        const std::optional<Date> d = canonicalDate(value);
+        const std::optional<Time> t = value.find('T') == std::string::npos ? std::nullopt : canonicalTime(value);
+        if (!d || !t) {
+            return std::nullopt;
+        }
+        const std::optional<std::string> date = formatDateOf(datePattern, *d, l);
+        const std::optional<std::string> time = formatTimeOf(timePattern, *t, l);
+        return date && time ? std::optional<std::string>(*date + *time) : std::nullopt;
+    }
+    if (c.category == "null") {
+        return value.empty() ? std::optional<std::string>(literalText(pattern)) : std::nullopt;
+    }
+    if (c.category == "zero") {
+        const std::optional<Decimal> d = parseDecimal(value);
+        return d && d->whole.empty() && d->fraction.empty() ? std::optional<std::string>(literalText(pattern)) : std::nullopt;
+    }
+    return std::nullopt;
+}
+
+std::optional<std::string> parseClauseText(const Clause &c, const std::string &pattern, const std::string &text, const XFALocale &l)
+{
+    if (c.category == "num") {
+        return parseNumber(pattern, text, l);
+    }
+    if (c.category == "text") {
+        return parseText(pattern, text);
+    }
+    Reader r(text);
+    if (c.category == "date") {
+        const std::optional<Date> d = readDate(pattern, r, l);
+        return d && r.pos == text.size() ? std::optional<std::string>(canonical(*d)) : std::nullopt;
+    }
+    if (c.category == "time") {
+        const std::optional<Time> t = readTime(pattern, r, l);
+        return t && r.pos == text.size() ? std::optional<std::string>(canonical(*t)) : std::nullopt;
+    }
+    if (c.category == "datetime") {
+        const auto [datePattern, timePattern] = dateTimeParts(pattern);
+        const std::optional<Date> d = readDate(datePattern, r, l);
+        const std::optional<Time> t = d ? readTime(timePattern, r, l) : std::nullopt;
+        return t && r.pos == text.size() ? std::optional<std::string>(canonical(*d) + "T" + canonical(*t)) : std::nullopt;
+    }
+    if (c.category == "null") {
+        return text == literalText(pattern) ? std::optional<std::string>(std::string()) : std::nullopt;
+    }
+    if (c.category == "zero") {
+        return text == literalText(pattern) ? std::optional<std::string>("0") : std::nullopt;
+    }
+    return std::nullopt;
+}
