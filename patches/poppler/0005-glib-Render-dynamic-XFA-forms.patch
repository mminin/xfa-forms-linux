+/**
+ * poppler_document_render_xfa:
+ * @document: A #PopplerDocument
+ * @error: (allow-none): Return location for an error, or %NULL
+ *
+ * Renders the dynamic XFA form of @document, see
+ * poppler_document_get_needs_rendering(). The scripts of the form are run
+ * and the form is laid out on pages, which the returned document holds,
+ * along with AcroForm fields for the fields of the form.
+ *
+ * Changes made through the form fields of the returned document are
+ * passed to the XFA form, whose scripts may then change the layout. Use
+ * poppler_document_xfa_needs_rerender() to find out when that happens, and
+ * call this function again with the returned document to render the
+ * new state of the form.
+ *
+ * Printing the pages of the returned document leaves out the objects that
+ * the form shows on screen only, such as buttons.
+ *
+ * Return value: (transfer full): a new #PopplerDocument, or %NULL with
+ *   @error set when @document has no XFA form that can be rendered
+ *
+ * Since: 26.11
+ **/
+PopplerDocument *poppler_document_render_xfa(PopplerDocument *document, GError **error)
+{
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), nullptr);
+
+    std::shared_ptr<XFAForm> form = document->xfa;
+    if (!form) {
+        std::string message;
+        std::unique_ptr<XFAForm> loaded = XFAForm::load(document->doc.get(), &message);
+        if (!loaded) {
+            g_set_error(error, POPPLER_ERROR, POPPLER_ERROR_INVALID, "%s", message.c_str());
+            return nullptr;
+        }
+        form = std::move(loaded);
+    }
+
+    const std::string pdf = form->generatePDF(false);
+    const std::string printPdf = form->generatePDF(true);
+
+    GBytes *bytes = g_bytes_new(pdf.data(), pdf.size());
+    PopplerDocument *rendered = poppler_document_new_from_bytes(bytes, nullptr, error);
+    g_bytes_unref(bytes);
+    if (!rendered) {
+        return nullptr;
+    }
+    bytes = g_bytes_new(printPdf.data(), printPdf.size());
+    rendered->xfa_print = poppler_document_new_from_bytes(bytes, nullptr, nullptr);
+    g_bytes_unref(bytes);
+
+    rendered->xfa = std::move(form);
+    rendered->xfa_change_count = rendered->xfa->getChangeCount();
+    return rendered;
+}
+
+/**
+ * poppler_document_is_xfa_rendered:
+ * @document: A #PopplerDocument
+ *
+ * Returns whether @document was made by poppler_document_render_xfa().
+ *
+ * Return value: %TRUE if @document holds a rendered XFA form
+ *
+ * Since: 26.11
+ **/
+gboolean poppler_document_is_xfa_rendered(PopplerDocument *document)
+{
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), FALSE);
+
+    return document->xfa != nullptr;
+}
+
+/**
+ * poppler_document_xfa_needs_rerender:
+ * @document: A #PopplerDocument made by poppler_document_render_xfa()
+ *
+ * Returns whether the scripts of the XFA form changed the form in ways
+ * the pages of @document do not show, after its form fields were changed.
+ * Values typed into fields by the user are not such changes.
+ *
+ * Return value: %TRUE if @document should be rendered again with
+ *   poppler_document_render_xfa()
+ *
+ * Since: 26.11
+ **/
+gboolean poppler_document_xfa_needs_rerender(PopplerDocument *document)
+{
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), FALSE);
+
+    return document->xfa && document->xfa->getChangeCount() != document->xfa_change_count;
+}
+
+static gchar **take_xfa_requests(PopplerDocument *document, XFAHostRequest::Type type)
+{
+    GPtrArray *res = g_ptr_array_new();
+    if (document->xfa) {
+        for (const XFAHostRequest &r : document->xfa->takeHostRequests(type)) {
+            std::string text = r.text;
+            if (type == XFAHostRequest::Type::Message && !r.title.empty()) {
+                text = r.title + "\n\n" + text;
+            }
+            g_ptr_array_add(res, g_strdup(text.c_str()));
+        }
+    }
+    g_ptr_array_add(res, nullptr);
+    return reinterpret_cast<gchar **>(g_ptr_array_free(res, FALSE));
+}
+
+/**
+ * poppler_document_xfa_take_messages:
+ * @document: A #PopplerDocument made by poppler_document_render_xfa()
+ *
+ * Returns the messages the scripts of the XFA form showed since the last
+ * call, and forgets them. Scripts asking for confirmation were answered
+ * with "Yes".
+ *
+ * Return value: (transfer full) (array zero-terminated=1): the messages,
+ *   with the title, if any, in front. Free with g_strfreev().
+ *
+ * Since: 26.11
+ **/
+gchar **poppler_document_xfa_take_messages(PopplerDocument *document)
+{
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), nullptr);
+
+    return take_xfa_requests(document, XFAHostRequest::Type::Message);
+}
+
+/**
+ * poppler_document_xfa_take_urls:
+ * @document: A #PopplerDocument made by poppler_document_render_xfa()
+ *
+ * Returns the URLs the scripts of the XFA form asked to open since the
+ * last call, and forgets them.
+ *
+ * Return value: (transfer full) (array zero-terminated=1): the URLs.
+ *   Free with g_strfreev().
+ *
+ * Since: 26.11
+ **/
+gchar **poppler_document_xfa_take_urls(PopplerDocument *document)
+{
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), nullptr);
+
+    return take_xfa_requests(document, XFAHostRequest::Type::LaunchURL);
+}
+
+/**
+ * poppler_document_xfa_take_print_request:
+ * @document: A #PopplerDocument made by poppler_document_render_xfa()
+ * @first_page: (out) (allow-none): return location for the first page to print, 0-based, or -1
+ * @last_page: (out) (allow-none): return location for the last page to print, 0-based, or -1
+ *
+ * Returns whether the scripts of the XFA form asked to print since the
+ * last call, and forgets the request. -1 page numbers mean all pages.
+ *
+ * Return value: %TRUE if printing was requested
+ *
+ * Since: 26.11
+ **/
+gboolean poppler_document_xfa_take_print_request(PopplerDocument *document, gint *first_page, gint *last_page)
+{
+    g_return_val_if_fail(POPPLER_IS_DOCUMENT(document), FALSE);
+
+    if (!document->xfa) {
+        return FALSE;
+    }
+    const std::vector<XFAHostRequest> requests = document->xfa->takeHostRequests(XFAHostRequest::Type::Print);
+    if (requests.empty()) {
+        return FALSE;
+    }
+    if (first_page) {
+        *first_page = requests.back().firstPage;
+    }
+    if (last_page) {
+        *last_page = requests.back().lastPage;
+    }
+    return TRUE;
+}
