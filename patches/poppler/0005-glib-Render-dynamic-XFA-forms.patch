  **/
+// Fields of documents rendered from XFA forms pass changes on to the form.
+static XFAForm *xfa_form_of(PopplerFormField *field, std::string *name)
+{
+    XFAForm *form = field->document ? field->document->xfa.get() : nullptr;
+    if (form) {
+        const GooString *fqn = field->widget->getFullyQualifiedName();
+        *name = fqn ? fqn->toStr() : std::string();
+    }
+    return form;
+}
+
 void poppler_form_field_button_set_state(PopplerFormField *field, gboolean state)
 {
     g_return_if_fail(field->widget->getType() == formButton);
 
-    static_cast<FormWidgetButton *>(field->widget)->setState(static_cast<bool>(state));
+    auto *button = static_cast<FormWidgetButton *>(field->widget);
+    std::string name;
+    if (XFAForm *xfa = xfa_form_of(field, &name)) {
+        // Push buttons have no state: setting it clicks them.
+        if (button->getButtonType() == formButtonPush) {
+            if (state) {
+                xfa->clickButton(name);
+            }
+            return;
+        }
+        button->setState(static_cast<bool>(state));
+        xfa->setButtonState(name, button->getOnStr() ? button->getOnStr() : "", state);
+        return;
+    }
+    button->setState(static_cast<bool>(state));
 }
 
