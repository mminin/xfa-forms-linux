     return std::exchange(requests, {});
 }
 
+std::vector<XFAHostRequest> XFAForm::takeHostRequests(XFAHostRequest::Type type)
+{
+    std::vector<XFAHostRequest> taken;
+    std::erase_if(requests, [&](const XFAHostRequest &r) {
+        if (r.type != type) {
+            return false;
+        }
+        taken.push_back(r);
+        return true;
+    });
+    return taken;
+}
