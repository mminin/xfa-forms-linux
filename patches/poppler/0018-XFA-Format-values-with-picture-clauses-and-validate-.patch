index 0000000..d4a21df
--- /dev/null
+++ b/poppler/XFAPicture.cc
@@ -0,0 +1,782 @@
+//========================================================================
+//
+// XFAPicture.cc
+//
+// Numeric, date and text picture clauses. Numbers are formatted from
+// their decimal digits, without going through floating point.
+//
+// This file is licensed under the GPLv2 or later
+//
+// Copyright (C) 2026 mminin <mminin2010@gmail.com>
+//
+//========================================================================
+
+#include <config.h>
+
+#include "XFAPicture.h"
+
+#include <algorithm>
+#include <cctype>
+#include <vector>
+
+namespace {
+
+struct Locale
+{
+    bool french = false;
+    std::string radix = ".";
+    std::string grouping = ",";
+    std::string currency = "$";
+};
+
+Locale localeOf(const std::string &name)
+{
+    Locale l;
+    if (name.starts_with("fr")) {
+        l.french = true;
+        l.radix = ",";
+        l.grouping = " ";
+    }
+    return l;
+}
+
+const char *const monthsEn[] = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
+const char *const monthsFr[] = { "janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre" };
+const char *const daysEn[] = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
+const char *const daysFr[] = { "dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi" };
+
+// One clause of a picture: category{pattern}, with an optional
+// subcategory (num.decimal) and locale (date(fr_CA)).
+struct Clause
+{
+    std::string category;
+    std::string subcategory;
+    std::string locale;
+    std::string pattern;
+};
+
+std::vector<std::string> alternatives(const std::string &picture)
+{
+    std::vector<std::string> res;
+    std::string cur;
+    bool quoted = false;
+    int depth = 0;
+    for (char c : picture) {
+        if (c == '\'') {
+            quoted = !quoted;
+        } else if (!quoted && c == '{') {
+            ++depth;
+        } else if (!quoted && c == '}') {
+            --depth;
+        }
+        if (c == '|' && !quoted && depth == 0) {
+            res.push_back(cur);
+            cur.clear();
+        } else {
+            cur += c;
+        }
+    }
+    res.push_back(cur);
+    return res;
+}
+
+std::optional<Clause> parseClause(const std::string &text, const std::string &defaultLocale)
+{
+    Clause c;
+    c.locale = defaultLocale;
+    const size_t open = text.find('{');
+    if (open == std::string::npos) {
+        // A bare pattern: numeric if it only has numeric symbols.
+        c.pattern = text;
+        c.category = text.find_first_not_of("9zZ8,.sS$% ()") == std::string::npos ? "num" : "text";
+        return c;
+    }
+    const size_t close = text.rfind('}');
+    if (close == std::string::npos || close < open) {
+        return std::nullopt;
+    }
+    c.pattern = text.substr(open + 1, close - open - 1);
+    std::string head = text.substr(0, open);
+    while (!head.empty() && std::isspace(static_cast<unsigned char>(head.front()))) {
+        head.erase(head.begin());
+    }
+    if (const size_t paren = head.find('('); paren != std::string::npos) {
+        const size_t end = head.find(')', paren);
+        c.locale = head.substr(paren + 1, end == std::string::npos ? std::string::npos : end - paren - 1);
+        head.resize(paren);
+    }
+    if (const size_t dot = head.find('.'); dot != std::string::npos) {
+        c.subcategory = head.substr(dot + 1);
+        head.resize(dot);
+    }
+    c.category = head;
+    return c;
+}
+
+// The locale's pattern for clauses such as num.decimal{} or date.short{}.
+std::string defaultPattern(const Clause &c, const Locale &l)
+{
+    if (c.category == "num") {
+        if (c.subcategory == "integer") {
+            return "z,zzz,zzz,zzz,zz9";
+        }
+        if (c.subcategory == "currency") {
+            return l.french ? "z,zzz,zzz,zz9.99' $'" : "$z,zzz,zzz,zz9.99";
+        }
+        if (c.subcategory == "percent") {
+            return "z,zzz,zz9%";
+        }
+        return "z,zzz,zzz,zzz,zz9.zzz";
+    }
+    if (c.category == "date") {
+        if (c.subcategory == "short") {
+            return l.french ? "YY-MM-DD" : "M/D/YY";
+        }
+        if (c.subcategory == "long") {
+            return l.french ? "D MMMM YYYY" : "MMMM D, YYYY";
+        }
+        if (c.subcategory == "full") {
+            return l.french ? "EEEE D MMMM YYYY" : "EEEE, MMMM D, YYYY";
+        }
+        return l.french ? "D MMM YYYY" : "MMM D, YYYY";
+    }
+    return {};
+}
+
+//------------------------------------------------------------------------
+// Numbers
+//------------------------------------------------------------------------
+
+struct NumToken
+{
+    enum Kind
+    {
+        Digit, // 9, z, Z or 8
+        Radix,
+        Grouping,
+        Sign, // s, S, (, ), CR, cr, DB, db
+        Currency,
+        Percent,
+        Literal
+    };
+    Kind kind;
+    std::string text;
+};
+
+std::optional<std::vector<NumToken>> numTokens(const std::string &p)
+{
+    std::vector<NumToken> res;
+    for (size_t i = 0; i < p.size();) {
+        const char c = p[i];
+        if (c == '\'') {
+            const size_t end = p.find('\'', i + 1);
+            res.push_back({ NumToken::Literal, p.substr(i + 1, end == std::string::npos ? std::string::npos : end - i - 1) });
+            i = end == std::string::npos ? p.size() : end + 1;
+        } else if (c == '9' || c == 'z' || c == 'Z' || c == '8') {
+            res.push_back({ NumToken::Digit, std::string(1, c) });
+            ++i;
+        } else if (c == '.' || c == 'v' || c == 'V') {
+            res.push_back({ NumToken::Radix, std::string(1, c) });
+            ++i;
+        } else if (c == ',') {
+            res.push_back({ NumToken::Grouping, "," });
+            ++i;
+        } else if (c == 's' || c == 'S' || c == '(' || c == ')') {
+            res.push_back({ NumToken::Sign, std::string(1, c) });
+            ++i;
+        } else if ((c == 'C' || c == 'c' || c == 'D' || c == 'd') && i + 1 < p.size() && std::tolower(static_cast<unsigned char>(p[i + 1])) == (std::tolower(static_cast<unsigned char>(c)) == 'c' ? 'r' : 'b')) {
+            res.push_back({ NumToken::Sign, p.substr(i, 2) });
+            i += 2;
+        } else if (c == '$') {
+            res.push_back({ NumToken::Currency, "$" });
+            ++i;
+        } else if (c == '%') {
+            res.push_back({ NumToken::Percent, "%" });
+            ++i;
+        } else if (c == 'E' || c == 'e') {
+            return std::nullopt; // exponents are not supported
+        } else {
+            res.push_back({ NumToken::Literal, std::string(1, c) });
+            ++i;
+        }
+    }
+    return res;
+}
+
+// A canonical number split into sign and digits.
+struct Decimal
+{
+    bool negative = false;
+    std::string whole; // without leading zeros, "" for zero
+    std::string fraction; // without trailing zeros
+};
+
+std::optional<Decimal> parseDecimal(const std::string &s)
+{
+    Decimal d;
+    size_t i = 0;
+    while (i < s.size() && s[i] == ' ') {
+        ++i;
+    }
+    if (i < s.size() && (s[i] == '-' || s[i] == '+')) {
+        d.negative = s[i] == '-';
+        ++i;
+    }
+    bool digits = false;
+    while (i < s.size() && std::isdigit(static_cast<unsigned char>(s[i]))) {
+        d.whole += s[i++];
+        digits = true;
+    }
+    if (i < s.size() && s[i] == '.') {
+        ++i;
+        while (i < s.size() && std::isdigit(static_cast<unsigned char>(s[i]))) {
+            d.fraction += s[i++];
+            digits = true;
+        }
+    }
+    while (i < s.size() && s[i] == ' ') {
+        ++i;
+    }
+    if (!digits || i != s.size()) {
+        return std::nullopt;
+    }
+    d.whole.erase(0, std::min(d.whole.find_first_not_of('0'), d.whole.size()));
+    while (!d.fraction.empty() && d.fraction.back() == '0') {
+        d.fraction.pop_back();
+    }
+    if (d.whole.empty() && d.fraction.empty()) {
+        d.negative = false;
+    }
+    return d;
+}
+
+// Rounds half away from zero to places fraction digits.
+void roundDecimal(Decimal &d, size_t places)
+{
+    if (d.fraction.size() <= places) {
+        return;
+    }
+    const bool up = d.fraction[places] >= '5';
+    d.fraction.resize(places);
+    if (up) {
+        std::string digits = d.whole + d.fraction;
+        int i = static_cast<int>(digits.size()) - 1;
+        for (; i >= 0; --i) {
+            if (digits[i] == '9') {
+                digits[i] = '0';
+            } else {
+                ++digits[i];
+                break;
+            }
+        }
+        if (i < 0) {
+            digits.insert(digits.begin(), '1');
+        }
+        d.whole = digits.substr(0, digits.size() - places);
+        d.fraction = digits.substr(digits.size() - places);
+    }
+    d.whole.erase(0, std::min(d.whole.find_first_not_of('0'), d.whole.size()));
+    while (!d.fraction.empty() && d.fraction.back() == '0') {
+        d.fraction.pop_back();
+    }
+    if (d.whole.empty() && d.fraction.empty()) {
+        d.negative = false;
+    }
+}
+
+std::optional<std::string> formatNumber(const std::string &pattern, const std::string &value, const Locale &l)
+{
+    const auto tokens = numTokens(pattern);
+    auto d = parseDecimal(value);
+    if (!tokens || !d) {
+        return std::nullopt;
+    }
+    const auto radix = std::ranges::find_if(*tokens, [](const NumToken &t) { return t.kind == NumToken::Radix; });
+    const size_t wholePlaces = std::count_if(tokens->begin(), radix, [](const NumToken &t) { return t.kind == NumToken::Digit; });
+    const size_t fractionPlaces = std::count_if(radix, tokens->end(), [](const NumToken &t) { return t.kind == NumToken::Digit; });
+    roundDecimal(*d, fractionPlaces);
+    if (d->whole.size() > wholePlaces) {
+        return std::nullopt;
+    }
+    const bool hasSign = std::ranges::any_of(*tokens, [](const NumToken &t) { return t.kind == NumToken::Sign; });
+
+    std::string out = d->negative && !hasSign ? "-" : "";
+    size_t position = wholePlaces; // of the next whole digit, counted from the radix
+    size_t fractionIndex = 0;
+    bool inFraction = false;
+    char shown = 0; // what the digits so far showed: 0 nothing, ' ' spaces, '1' digits
+    for (const NumToken &t : *tokens) {
+        switch (t.kind) {
+        case NumToken::Digit:
+            if (!inFraction) {
+                --position;
+                if (position < d->whole.size()) {
+                    out += d->whole[d->whole.size() - 1 - position];
+                    shown = '1';
+                } else if (t.text == "9") {
+                    out += '0';
+                    shown = '1';
+                } else if (t.text == "Z") {
+                    out += ' ';
+                    shown = shown ? shown : ' ';
+                }
+            } else {
+                // Trailing zeros show only for 9.
+                const bool more = fractionIndex < d->fraction.size();
+                if (more || t.text == "9") {
+                    out += more ? d->fraction[fractionIndex] : '0';
+                } else if (t.text == "Z") {
+                    out += ' ';
+                }
+                ++fractionIndex;
+            }
+            break;
+        case NumToken::Radix:
+            inFraction = true;
+            if (t.text == ".") {
+                // Shown when a fraction digit follows.
+                const bool shows = !d->fraction.empty() || std::any_of(radix, tokens->end(), [](const NumToken &k) { return k.kind == NumToken::Digit && k.text == "9"; });
+                if (shows) {
+                    out += l.radix;
+                }
+            }
+            break;
+        case NumToken::Grouping:
+            if (shown == '1') {
+                out += l.grouping;
+            } else if (shown == ' ') {
+                out += ' ';
+            }
+            break;
+        case NumToken::Sign:
+            if (t.text == "s") {
+                out += d->negative ? "-" : "";
+            } else if (t.text == "S") {
+                out += d->negative ? "-" : " ";
+            } else if (t.text == "(" || t.text == ")") {
+                out += d->negative ? t.text : " ";
+            } else {
+                out += d->negative ? t.text : std::string(t.text.size(), ' ');
+            }
+            break;
+        case NumToken::Currency:
+            out += l.currency;
+            break;
+        case NumToken::Percent:
+            out += '%';
+            break;
+        case NumToken::Literal:
+            out += t.text;
+            break;
+        }
+    }
+    return out;
+}
+
+std::optional<std::string> parseNumber(const std::string &pattern, const std::string &text, const Locale &l)
+{
+    const auto tokens = numTokens(pattern);
+    if (!tokens) {
+        return std::nullopt;
+    }
+    const auto radix = std::ranges::find_if(*tokens, [](const NumToken &t) { return t.kind == NumToken::Radix; });
+    const size_t wholePlaces = std::count_if(tokens->begin(), radix, [](const NumToken &t) { return t.kind == NumToken::Digit; });
+    const size_t fractionPlaces = std::count_if(radix, tokens->end(), [](const NumToken &t) { return t.kind == NumToken::Digit; });
+    // Drop what the picture adds around the digits, then read a number.
+    std::string s = text;
+    for (const NumToken &t : *tokens) {
+        if (t.kind == NumToken::Literal && !t.text.empty() && t.text.find_first_of("0123456789") == std::string::npos) {
+            for (size_t at; (at = s.find(t.text)) != std::string::npos;) {
+                s.erase(at, t.text.size());
+            }
+        }
+    }
+    bool negative = false;
+    std::string digits;
+    bool seenRadix = false;
+    for (size_t i = 0; i < s.size(); ++i) {
+        const char c = s[i];
+        if (std::isdigit(static_cast<unsigned char>(c))) {
+            digits += c;
+        } else if (s.compare(i, l.radix.size(), l.radix) == 0 || (c == '.' && l.radix != ".")) {
+            if (seenRadix) {
+                return std::nullopt;
+            }
+            seenRadix = true;
+            digits += '.';
+            i += l.radix.size() - 1;
+        } else if (c == '-' || c == '(' || c == ')') {
+            negative = true;
+        } else if ((c == 'C' || c == 'c' || c == 'D' || c == 'd') && i + 1 < s.size() && std::isalpha(static_cast<unsigned char>(s[i + 1]))) {
+            negative = true;
+            ++i;
+        } else if (c == ' ' || c == '+' || c == '$' || c == '%' || s.compare(i, l.grouping.size(), l.grouping) == 0 || (c == ',' && l.radix != ",")) {
+            continue;
+        } else if (static_cast<unsigned char>(c) >= 0x80) {
+            continue; // no-break spaces and other separators
+        } else {
+            return std::nullopt;
+        }
+    }
+    auto d = parseDecimal(digits);
+    if (!d || d->whole.size() > wholePlaces || d->fraction.size() > fractionPlaces) {
+        return std::nullopt;
+    }
+    std::string res = (negative && (!d->whole.empty() || !d->fraction.empty()) ? "-" : "") + (d->whole.empty() ? std::string("0") : d->whole);
+    if (!d->fraction.empty()) {
+        res += "." + d->fraction;
+    }
+    return res;
+}
+
+//------------------------------------------------------------------------
+// Text
+//------------------------------------------------------------------------
+
+// Literal runs and placeholders: 9 digit, A letter, X any, O or 0 letter
+// or digit.
+bool placeholderAccepts(char symbol, unsigned char c)
+{
+    switch (symbol) {
+    case '9':
+        return std::isdigit(c);
+    case 'A':
+        return std::isalpha(c) || c >= 0x80;
+    case 'O':
+    case '0':
+        return std::isalnum(c) || c >= 0x80;
+    default:
+        return true;
+    }
+}
+
+struct TextElement
+{
+    char symbol; // 0 for literals
+    std::string literal;
+};
+
+std::vector<TextElement> textElements(const std::string &p)
+{
+    std::vector<TextElement> res;
+    for (size_t i = 0; i < p.size();) {
+        const char c = p[i];
+        if (c == '\'') {
+            const size_t end = p.find('\'', i + 1);
+            res.push_back({ 0, p.substr(i + 1, end == std::string::npos ? std::string::npos : end - i - 1) });
+            i = end == std::string::npos ? p.size() : end + 1;
+        } else if (c == '9' || c == 'A' || c == 'X' || c == 'O' || c == '0') {
+            res.push_back({ c, {} });
+            ++i;
+        } else if (c == 't') {
+            res.push_back({ 0, "\t" });
+            ++i;
+        } else {
+            res.push_back({ 0, std::string(1, c) });
+            ++i;
+        }
+    }
+    return res;
+}
+
+// UTF-8 characters, so that placeholders take whole characters.
+std::vector<std::string> characters(const std::string &s)
+{
+    std::vector<std::string> res;
+    for (size_t i = 0; i < s.size();) {
+        size_t n = 1;
+        const unsigned char c = s[i];
+        if (c >= 0xF0) {
+            n = 4;
+        } else if (c >= 0xE0) {
+            n = 3;
+        } else if (c >= 0xC0) {
+            n = 2;
+        }
+        res.push_back(s.substr(i, n));
+        i += n;
+    }
+    return res;
+}
+
+std::optional<std::string> formatText(const std::string &pattern, const std::string &value)
+{
+    const std::vector<std::string> chars = characters(value);
+    std::string out;
+    size_t k = 0;
+    for (const TextElement &e : textElements(pattern)) {
+        if (!e.symbol) {
+            out += e.literal;
+            continue;
+        }
+        if (k >= chars.size() || !placeholderAccepts(e.symbol, chars[k][0])) {
+            return std::nullopt;
+        }
+        out += chars[k++];
+    }
+    if (k != chars.size()) {
+        return std::nullopt;
+    }
+    return out;
+}
+
+std::optional<std::string> parseText(const std::string &pattern, const std::string &text)
+{
+    const std::vector<std::string> chars = characters(text);
+    std::string out;
+    size_t k = 0;
+    for (const TextElement &e : textElements(pattern)) {
+        if (!e.symbol) {
+            for (const std::string &lc : characters(e.literal)) {
+                if (k >= chars.size() || chars[k] != lc) {
+                    return std::nullopt;
+                }
+                ++k;
+            }
+            continue;
+        }
+        if (k >= chars.size() || !placeholderAccepts(e.symbol, chars[k][0])) {
+            return std::nullopt;
+        }
+        out += chars[k++];
+    }
+    if (k != chars.size()) {
+        return std::nullopt;
+    }
+    return out;
+}
+
+//------------------------------------------------------------------------
+// Dates
+//------------------------------------------------------------------------
+
+struct Date
+{
+    int y = 0, m = 0, d = 0;
+};
+
+bool validDate(const Date &d)
+{
+    static const int days[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
+    if (d.m < 1 || d.m > 12 || d.d < 1 || d.y < 1) {
+        return false;
+    }
+    const bool leap = (d.y % 4 == 0 && d.y % 100 != 0) || d.y % 400 == 0;
+    return d.d <= days[d.m - 1] + (d.m == 2 && leap ? 1 : 0);
+}
+
+int weekday(const Date &d)
+{
+    // Zeller's congruence, 0 for Sunday.
+    int y = d.y, m = d.m;
+    if (m < 3) {
+        m += 12;
+        --y;
+    }
+    const int h = (d.d + 13 * (m + 1) / 5 + y + y / 4 - y / 100 + y / 400) % 7;
+    return (h + 6) % 7;
+}
+
+int dayOfYear(const Date &d)
+{
+    int n = d.d;
+    for (int m = 1; m < d.m; ++m) {
+        n += m == 2 ? 28 + (validDate({ d.y, 2, 29 }) ? 1 : 0) : (m == 4 || m == 6 || m == 9 || m == 11) ? 30 : 31;
+    }
+    return n;
+}
+
+// Runs of the same date symbol, quoted literals and other characters.
+std::vector<std::string> dateTokens(const std::string &p)
+{
+    std::vector<std::string> res;
+    for (size_t i = 0; i < p.size();) {
+        const char c = p[i];
+        if (c == '\'') {
+            const size_t end = p.find('\'', i + 1);
+            res.push_back("'" + p.substr(i + 1, end == std::string::npos ? std::string::npos : end - i - 1));
+            i = end == std::string::npos ? p.size() : end + 1;
+        } else if (c == 'Y' || c == 'M' || c == 'D' || c == 'E' || c == 'J') {
+            size_t k = i;
+            while (k < p.size() && p[k] == c) {
+                ++k;
+            }
+            res.push_back(p.substr(i, k - i));
+            i = k;
+        } else {
+            res.push_back("'" + std::string(1, c));
+            ++i;
+        }
+    }
+    return res;
+}
+
+std::string padded(int v, size_t width)
+{
+    std::string s = std::to_string(v);
+    return std::string(width > s.size() ? width - s.size() : 0, '0') + s;
+}
+
+std::optional<std::string> formatDate(const std::string &pattern, const std::string &value, const Locale &l)
+{
+    // The canonical form, YYYY-MM-DD, or YYYYMMDD.
+    Date d;
+    const std::string digits = value.size() == 10 && value[4] == '-' && value[7] == '-' ? value.substr(0, 4) + value.substr(5, 2) + value.substr(8, 2) : value;
+    if (digits.size() != 8 || !std::ranges::all_of(digits, [](char c) { return std::isdigit(static_cast<unsigned char>(c)); })) {
+        return std::nullopt;
+    }
+    d.y = std::stoi(digits.substr(0, 4));
+    d.m = std::stoi(digits.substr(4, 2));
+    d.d = std::stoi(digits.substr(6, 2));
+    if (!validDate(d)) {
+        return std::nullopt;
+    }
+    const char *const *months = l.french ? monthsFr : monthsEn;
+    const char *const *days = l.french ? daysFr : daysEn;
+    std::string out;
+    for (const std::string &t : dateTokens(pattern)) {
+        if (t[0] == '\'') {
+            out += t.substr(1);
+        } else if (t == "YYYY") {
+            out += padded(d.y, 4);
+        } else if (t == "YY") {
+            out += padded(d.y % 100, 2);
+        } else if (t == "MMMM") {
+            out += months[d.m - 1];
+        } else if (t == "MMM") {
+            const std::vector<std::string> name = characters(months[d.m - 1]);
+            for (size_t i = 0; i < std::min<size_t>(3, name.size()); ++i) {
+                out += name[i];
+            }
+        } else if (t == "MM") {
+            out += padded(d.m, 2);
+        } else if (t == "M") {
+            out += std::to_string(d.m);
+        } else if (t == "DD") {
+            out += padded(d.d, 2);
+        } else if (t == "D") {
+            out += std::to_string(d.d);
+        } else if (t == "EEEE") {
+            out += days[weekday(d)];
+        } else if (t == "EEE") {
+            out += std::string(days[weekday(d)]).substr(0, 3);
+        } else if (t == "JJJ") {
+            out += padded(dayOfYear(d), 3);
+        } else if (t == "J") {
+            out += std::to_string(dayOfYear(d));
+        } else {
+            return std::nullopt;
+        }
+    }
+    return out;
+}
+
+std::optional<std::string> parseDate(const std::string &pattern, const std::string &text, const Locale &l)
+{
+    Date d { 0, 0, 0 };
+    size_t pos = 0;
+    auto number = [&](size_t min, size_t max) -> std::optional<int> {
+        size_t k = pos;
+        while (k < text.size() && k - pos < max && std::isdigit(static_cast<unsigned char>(text[k]))) {
+            ++k;
+        }
+        if (k - pos < min) {
+            return std::nullopt;
+        }
+        const int v = std::stoi(text.substr(pos, k - pos));
+        pos = k;
+        return v;
+    };
+    auto name = [&](const char *const *names, int count, size_t len) -> std::optional<int> {
+        for (int i = 0; i < count; ++i) {
+            std::string n;
+            const std::vector<std::string> chars = characters(names[i]);
+            for (size_t k = 0; k < chars.size() && (!len || k < len); ++k) {
+                n += chars[k];
+            }
+            if (text.size() - pos >= n.size() && std::equal(n.begin(), n.end(), text.begin() + pos, [](char a, char b) { return std::tolower(static_cast<unsigned char>(a)) == std::tolower(static_cast<unsigned char>(b)); })) {
+                pos += n.size();
+                return i;
+            }
+        }
+        return std::nullopt;
+    };
+    const char *const *months = l.french ? monthsFr : monthsEn;
+    const char *const *days = l.french ? daysFr : daysEn;
+    for (const std::string &t : dateTokens(pattern)) {
+        std::optional<int> v;
+        if (t[0] == '\'') {
+            if (text.compare(pos, t.size() - 1, t, 1) != 0) {
+                return std::nullopt;
+            }
+            pos += t.size() - 1;
+            continue;
+        }
+        if (t == "YYYY") {
+            v = number(4, 4);
+            d.y = v.value_or(0);
+        } else if (t == "YY") {
+            v = number(2, 2);
+            d.y = v ? (*v < 50 ? 2000 : 1900) + *v : 0;
+        } else if (t == "MMMM" || t == "MMM") {
+            v = name(months, 12, t == "MMM" ? 3 : 0);
+            d.m = v ? *v + 1 : 0;
+        } else if (t == "MM" || t == "M") {
+            v = number(t.size(), 2);
+            d.m = v.value_or(0);
+        } else if (t == "DD" || t == "D") {
+            v = number(t.size(), 2);
+            d.d = v.value_or(0);
+        } else if (t == "EEEE" || t == "EEE") {
+            v = name(days, 7, t == "EEE" ? 3 : 0);
+        } else {
+            return std::nullopt;
+        }
+        if (!v) {
+            return std::nullopt;
+        }
+    }
+    if (pos != text.size() || !validDate(d)) {
+        return std::nullopt;
+    }
+    return padded(d.y, 4) + "-" + padded(d.m, 2) + "-" + padded(d.d, 2);
+}
+
+std::optional<std::string> apply(const std::string &picture, const std::string &input, const std::string &localeName, bool format)
+{
+    for (const std::string &alt : alternatives(picture)) {
+        const std::optional<Clause> c = parseClause(alt, localeName);
+        if (!c) {
+            continue;
+        }
+        const Locale l = localeOf(c->locale);
+        const std::string pattern = c->pattern.empty() ? defaultPattern(*c, l) : c->pattern;
+        if (pattern.empty()) {
+            return input;
+        }
+        std::optional<std::string> res;
+        if (c->category == "num") {
+            res = format ? formatNumber(pattern, input, l) : parseNumber(pattern, input, l);
+        } else if (c->category == "date") {
+            res = format ? formatDate(pattern, input, l) : parseDate(pattern, input, l);
+        } else if (c->category == "text") {
+            res = format ? formatText(pattern, input) : parseText(pattern, input);
+        }
+        if (res) {
+            return res;
+        }
+    }
+    return std::nullopt;
+}
+
+} // namespace
+
+std::optional<std::string> XFAPictureFormat(const std::string &picture, const std::string &value, const std::string &locale)
+{
+    return apply(picture, value, locale, true);
+}
+
+std::optional<std::string> XFAPictureParse(const std::string &picture, const std::string &text, const std::string &locale)
+{
+    return apply(picture, text, locale, false);
+}
