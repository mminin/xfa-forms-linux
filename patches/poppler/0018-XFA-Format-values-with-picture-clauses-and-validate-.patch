+/* Picture clauses: values shown formatted, typed text parsed back, and
+ * values checked against validation pictures. */
+static const char *picture_xdp = "<?xml version=\"1.0\"?>\n"
+                                 "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                                 "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                                 "<subform name=\"form1\" layout=\"tb\" locale=\"en_CA\">"
+                                 "<pageSet><pageArea name=\"Page1\">"
+                                 "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                                 "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/>"
+                                 "</pageArea></pageSet>"
+                                 "<field name=\"amount\" w=\"3in\" h=\"0.3in\" access=\"nonInteractive\"><ui><numericEdit/></ui>"
+                                 "<format><picture>num{$z,zzz,zz9.99}</picture></format><value><decimal>1234.5</decimal></value></field>"
+                                 "<field name=\"sin\" w=\"3in\" h=\"0.3in\"><ui><textEdit/><picture>text{999999999}|text{999 999 999}</picture></ui>"
+                                 "<assist><toolTip>SIN</toolTip></assist>"
+                                 "<format><picture>text{999 999 999}</picture></format><value><text>123456789</text></value></field>"
+                                 "<field name=\"date\" w=\"3in\" h=\"0.3in\"><ui><textEdit/></ui><assist><toolTip>Date</toolTip></assist>"
+                                 "<validate formatTest=\"error\"><picture>date{YYYY-MM-DD}</picture><message><text name=\"formatTest\">Bad date</text></message></validate></field>"
+                                 "</subform>"
+                                 "</template>"
+                                 "</xdp:xdp>";
+
+static PopplerFormField *field_named(PopplerDocument *doc, const char *tooltip)
+{
+    PopplerPage *page = poppler_document_get_page(doc, 0);
+    GList *mapping = poppler_page_get_form_field_mapping(page);
+    PopplerFormField *field = NULL;
+    for (GList *l = mapping; l && !field; l = l->next) {
+        PopplerFormFieldMapping *m = l->data;
+        char *name = poppler_form_field_get_alternate_ui_name(m->field);
+        if (g_strcmp0(name, tooltip) == 0) {
+            field = g_object_ref(m->field);
+        }
+        g_free(name);
+    }
+    poppler_page_free_form_field_mapping(mapping);
+    g_object_unref(page);
+    return field;
+}
+
+static void test_pictures(void)
+{
+    GBytes *bytes = build_pdf_from(picture_xdp);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    char *text = page_text(rendered);
+    g_assert_nonnull(strstr(text, "$1,234.50"));
+    g_free(text);
+
+    PopplerFormField *sin = field_named(rendered, "SIN");
+    g_assert_nonnull(sin);
+    text = poppler_form_field_text_get_text(sin);
+    g_assert_cmpstr(text, ==, "123 456 789");
+    g_free(text);
+    poppler_form_field_text_set_text(sin, "987654321");
+    g_object_unref(sin);
+    if (poppler_document_xfa_needs_rerender(rendered)) {
+        PopplerDocument *rerendered = poppler_document_render_xfa(rendered, &err);
+        g_assert_no_error(err);
+        sin = field_named(rerendered, "SIN");
+        text = poppler_form_field_text_get_text(sin);
+        g_assert_cmpstr(text, ==, "987 654 321");
+        g_free(text);
+        g_object_unref(sin);
+        g_object_unref(rendered);
+        rendered = rerendered;
+    } else {
+        g_test_fail_printf("the formatted value is not shown");
+    }
+
+    PopplerFormField *date = field_named(rendered, "Date");
+    g_assert_nonnull(date);
+    poppler_form_field_text_set_text(date, "2024-13-45");
+    g_object_unref(date);
+    gchar **messages = poppler_document_xfa_take_messages(rendered);
+    g_assert_nonnull(messages);
+    gboolean found = FALSE;
+    for (gchar **m = messages; *m; ++m) {
+        found = found || strstr(*m, "Bad date") != NULL;
+    }
+    g_assert_true(found);
+    g_strfreev(messages);
+
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 int main(int argc, char *argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -769,5 +859,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/data", test_data);
     g_test_add_func("/xfa/formcalc", test_formcalc);
     g_test_add_func("/xfa/barcode", test_barcode);
+    g_test_add_func("/xfa/pictures", test_pictures);
     return g_test_run();
 }
