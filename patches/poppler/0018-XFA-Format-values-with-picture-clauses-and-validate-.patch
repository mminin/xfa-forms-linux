+//========================================================================
+//
+// XFAPicture.h
+//
+// Picture clauses: the patterns that format the values of XFA fields for
+// display and editing, and parse what users type, such as
+// "num{$z,zzz,zz9.99}", "date{YYYY-MM-DD}" or "text{999 999 999}".
