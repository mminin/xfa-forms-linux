+//
+//========================================================================
+
+#ifndef XFAPICTURE_H
+#define XFAPICTURE_H
+
+#include <optional>
+#include <string>
+
+// Values are canonical: numbers as "-1234.5", dates as "YYYY-MM-DD", text
+// as it is. locale is a name such as "en_CA" or "fr_CA". A picture may
+// hold alternatives separated by "|": the first that fits is used.
+
+// The value formatted with picture, or nothing when it does not fit.
+std::optional<std::string> XFAPictureFormat(const std::string &picture, const std::string &value, const std::string &locale);
+
+// The canonical value of text formatted with picture, or nothing when the
+// text does not match.
+std::optional<std::string> XFAPictureParse(const std::string &picture, const std::string &text, const std::string &locale);
+
+#endif
