+// The picture clause of a field for display ("format"), editing ("ui"),
+// validation ("validate") or data ("bind").
+static std::string pictureOf(const XFANode *node, const char *where)
+{
+    const XFANode *holder = node->firstChild(where);
+    const XFANode *picture = holder ? holder->firstChild("picture") : nullptr;
+    return picture ? picture->textContent() : std::string();
+}
+
+std::string XFAForm::localeOf(const XFANode *node) const
+{
+    for (const XFANode *n = node; n; n = n->getParent()) {
+        if (const std::string *l = n->getAttr("locale"); l && !l->empty() && *l != "ambient") {
+            return *l;
+        }
+    }
+    return language;
+}
+
+std::string XFAForm::getEditValue(XFANode *node) const
+{
+    const std::optional<std::string> raw = getRawValue(node);
+    const std::string picture = node->getClassName() == "field" ? pictureOf(node, "ui") : std::string();
+    if (!raw || picture.empty()) {
+        return raw.value_or("");
+    }
+    return XFAPictureFormat(picture, *raw, localeOf(node)).value_or(*raw);
+}
+
+std::optional<std::string> XFAForm::getWidgetValue(XFANode *node) const
+{
+    const std::optional<std::string> raw = getRawValue(node);
+    const std::string ui = uiClass(node);
+    if (!raw || (ui != "textEdit" && ui != "numericEdit" && ui != "dateTimeEdit")) {
+        return raw;
+    }
+    const std::string formatted = getFormattedValue(node);
+    const XFANode *value = node->firstChild("value");
+    const XFANode *text = value ? value->firstChild("text") : nullptr;
+    const XFANode *comb = node->firstChild("ui")->firstChild(ui)->firstChild("comb");
+    const long maxChars = text ? std::atol(text->getAttr("maxChars", "0").c_str()) : 0;
+    if (comb || (maxChars > 0 && static_cast<long>(formatted.size()) > maxChars)) {
+        return raw;
+    }
+    return formatted;
+}
+
+void XFAForm::setFormattedValue(XFANode *node, const std::string &text)
+{
+    if (text.empty() || node->getClassName() != "field") {
+        setRawValue(node, text.empty() ? std::nullopt : std::optional<std::string>(text));
+        return;
+    }
+    const std::string locale = localeOf(node);
+    for (const char *where : { "ui", "format" }) {
+        const std::string picture = pictureOf(node, where);
+        if (!picture.empty()) {
+            if (const std::optional<std::string> v = XFAPictureParse(picture, text, locale)) {
+                setRawValue(node, v);
+                return;
+            }
+        }
+    }
+    setRawValue(node, text);
+}
