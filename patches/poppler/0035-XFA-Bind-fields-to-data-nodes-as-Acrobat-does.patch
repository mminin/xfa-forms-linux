+// dataNode(node): the data node the node binds to, made if need be and up
+// to date with the values of the fields it holds.
+NATIVE(dataNode)
+{
+    XFAForm *form = formOf(ctx);
+    XFANode *n = nodeArg(ctx, ARG(0));
+    if (!n) {
+        return JS_NULL;
+    }
+    XFANode *d = form->dataNodeOf(n, true);
+    if (d) {
+        form->syncData(n);
+    }
+    return idValue(ctx, d);
+}
