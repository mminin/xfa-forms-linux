+// In Acrobat a script runs with its object as the global scope, so in a
+// function the script calls plainly, `this` still has the object's
+// properties. The global object reads properties it lacks from the object
+// whose script is running, after those of Object.prototype.
+Object.setPrototypeOf(g, new Proxy(Object.prototype, {
+    get: function (t, p, r) {
+        if (p in t || typeof p !== "string" || !running.length) return Reflect.get(t, p, r);
+        var o = wrap(running[running.length - 1]);
+        return o ? o[p] : undefined;
+    }
+}));
