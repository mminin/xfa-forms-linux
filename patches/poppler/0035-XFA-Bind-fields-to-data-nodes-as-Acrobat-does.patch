         }
+        writeData(node, value);
         return;
     }
     if (cls != "field" && cls != "draw") {
@@ -1172,6 +1360,9 @@ void XFAForm::setRawValue(XFANode *node, const std::optional<std::string> &value
     }
     content->setTextContent(newText);
     nodeChanged(node);
+    if (cls == "field") {
+        writeData(node, value);
+    }
 
