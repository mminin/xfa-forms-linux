     if (cls == "field" && !settingGlobal && isGlobal(node) && formRoot) {
@@ -1882,6 +2073,7 @@ static void mergeData(XFAForm *form, XFANode *node, const XFANode *data, bool sk
     if (depth >= XFANodeMaxDepth) {
         return;
     }
