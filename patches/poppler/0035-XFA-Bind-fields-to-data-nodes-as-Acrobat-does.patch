+// The data node named name that is the index-th of its name in group,
+// added (with those before it) when create is set.
+static XFANode *dataChild(XFADom *dom, XFANode *group, const std::string &name, size_t index, bool create, bool isGroup)
+{
+    size_t k = 0;
+    for (XFANode *c : group->elementChildren()) {
+        if (c->getClassName() == name && k++ == index) {
+            return c;
+        }
+    }
+    if (!create) {
+        return nullptr;
+    }
+    XFANode *made = nullptr;
+    for (; k <= index; ++k) {
+        made = group->appendChild(std::make_unique<XFANode>(dom, name));
+        made->setNamespace(XFANode::Namespace::Data);
+        if (isGroup) {
+            made->setAttr("xfa:dataNode", "dataGroup");
+        }
+    }
+    return made;
+}
+
+static XFANode *findDataNamed(XFANode *group, const std::string &name, int depth = 0)
+{
+    if (depth >= XFANodeMaxDepth) {
+        return nullptr;
+    }
+    for (XFANode *c : group->elementChildren()) {
+        if (c->getClassName() == name) {
+            return c;
+        }
+        if (XFANode *found = findDataNamed(c, name, depth + 1)) {
+            return found;
+        }
+    }
+    return nullptr;
+}
+
+// Keeps the data node of a field or exclGroup up to date with its value.
+void XFAForm::writeData(XFANode *node, const std::optional<std::string> &value)
+{
+    if (!bindsData(node)) {
+        return;
+    }
+    XFANode *d = dataNodeOf(node, true);
+    const std::string v = value.value_or("");
+    if (d && d->elementChildren().empty() && d->textContent() != v) {
+        d->setTextContent(v);
+    }
+}
+
+XFANode *XFAForm::dataNodeOf(XFANode *node, bool create, int depth)
+{
+    XFANode *dataRoot = datasets ? getDataRoot() : nullptr;
+    if (!node || !dataRoot || !formRoot || node->getDom() != &formDom || depth >= XFANodeMaxDepth) {
+        return nullptr;
+    }
+    // The record: the data group named after the root subform.
+    const std::string rootName = formRoot->getName().empty() ? std::string("form1") : formRoot->getName();
+    if (node == formRoot) {
+        return dataChild(&dataDom, dataRoot, rootName, 0, create, true);
+    }
+    const std::string &cls = node->getClassName();
+    if (cls != "field" && cls != "exclGroup" && cls != "subform" && cls != "subformSet" && cls != "area") {
+        return nullptr;
+    }
+    XFANode *parent = node->getParent();
+    // A field of an exclGroup is bound through the group.
+    if (!parent || (cls == "field" && parent->getClassName() == "exclGroup")) {
+        return nullptr;
+    }
+    // Unnamed subforms and areas leave their children in their parent's data.
+    if (isTransparent(node)) {
+        return dataNodeOf(parent, create, depth + 1);
+    }
+    const XFANode *bind = node->firstChild("bind");
+    const std::string match = bind ? bind->getAttr("match", "once") : std::string("once");
+    const std::string &name = node->getName();
+    if (match == "none" || name.empty()) {
+        return nullptr;
+    }
+    const bool isGroup = cls != "field" && cls != "exclGroup";
+    XFANode *record = dataChild(&dataDom, dataRoot, rootName, 0, create, true);
+    if (match == "global" && record) {
+        if (XFANode *found = findDataNamed(record, name)) {
+            return found;
+        }
+    }
+    if (match == "dataRef") {
+        // References such as $.a.b, $record.a or $data.a.b, without
+        // predicates or expressions.
+        std::string ref = bind->getAttr("ref", "");
+        XFANode *base = nullptr;
+        if (ref.starts_with("$record")) {
+            base = record;
+            ref = ref.substr(7);
+        } else if (ref.starts_with("$data")) {
+            base = dataRoot;
+            ref = ref.substr(5);
+        } else if (ref.starts_with("$")) {
+            base = dataNodeOf(parent, create, depth + 1);
+            ref = ref.substr(1);
+        } else {
+            base = record;
+        }
+        for (size_t at = 0; base && at < ref.size();) {
+            if (ref[at] == '.') {
+                ++at;
+                continue;
+            }
+            size_t end = ref.find('.', at);
+            std::string step = ref.substr(at, end == std::string::npos ? std::string::npos : end - at);
+            at = end == std::string::npos ? ref.size() : end;
+            size_t index = 0;
+            if (const size_t open = step.find('['); open != std::string::npos) {
+                index = static_cast<size_t>(std::max(0L, std::atol(step.c_str() + open + 1)));
+                step.resize(open);
+            }
+            if (step.empty() || step == "*") {
+                return nullptr;
+            }
+            base = dataChild(&dataDom, base, step, index, create, at < ref.size() || isGroup);
+        }
+        return base;
+    }
+    XFANode *parentData = dataNodeOf(parent, create, depth + 1);
+    if (!parentData) {
+        return nullptr;
+    }
+    // The occurrence of the node among the containers of its name.
+    size_t index = 0;
+    for (const XFANode *sibling : childrenByName(parent, name)) {
+        if (sibling == node) {
+            break;
+        }
+        if (sibling->getClassName() == cls) {
+            ++index;
+        }
+    }
+    return dataChild(&dataDom, parentData, name, index, create, isGroup);
+}
+
+void XFAForm::syncData(XFANode *container)
+{
+    std::vector<int> serials;
+    preorder(container, serials);
+    for (int serial : serials) {
+        XFANode *n = formDom.lookup(serial);
+        if (n && (n->getClassName() == "field" || n->getClassName() == "exclGroup") && bindsData(n)) {
+            XFANode *d = dataNodeOf(n, true);
+            const std::string v = getRawValue(n).value_or("");
+            if (d && d->textContent() != v && d->elementChildren().empty()) {
+                d->setTextContent(v);
+            }
+        }
+    }
+}
+
