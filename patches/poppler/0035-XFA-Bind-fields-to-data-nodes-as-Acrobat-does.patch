--- a/glib/tests/check_xfa.c
+++ b/glib/tests/check_xfa.c
@@ -1180,6 +1180,49 @@ static void test_default_ui(void)
     g_bytes_unref(bytes);
 }
 
+/* Merging data adds the occurrences of repeatable subforms that the data
+ * has groups for; field values reach their data nodes, which manifests
+ * reference; functions a script calls plainly see its object as this. This
+ * is how Designer's paper-forms barcodes collect their content. */
+static void test_data_binding(void)
+{
+    const char *xml = "<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">"
+                      "<template xmlns=\"http://www.xfa.org/schema/xfa-template/3.3/\">"
+                      "<subform name=\"form1\" layout=\"tb\"><pageSet><pageArea name=\"Page1\">"
+                      "<contentArea x=\"1in\" y=\"1in\" w=\"6.5in\" h=\"9in\"/>"
+                      "<medium stock=\"letter\" short=\"8.5in\" long=\"11in\"/></pageArea></pageSet>"
+                      "<variables><manifest name=\"Coll\"><ref>xfa[0].form[0].form1[0].src[0].dataNode</ref></manifest></variables>"
+                      "<subform name=\"Row\" layout=\"tb\"><occur min=\"0\" max=\"-1\"/>"
+                      "<field name=\"v\" w=\"2in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui></field></subform>"
+                      "<field name=\"src\" w=\"2in\" h=\"0.3in\"><ui><textEdit/></ui><value><text>hello</text></value></field>"
+                      "<field name=\"out\" w=\"6in\" h=\"0.3in\" access=\"nonInteractive\"><ui><textEdit/></ui>"
+                      "<calculate><script contentType=\"application/x-javascript\">"
+                      "function enc() { return \"[\" + this.caption.value.text.value + \"]\" + Coll.evaluate().item(0).value; }"
+                      "src.rawValue = \"world\"; \"enc=\" + enc() + \"|\" + xfa.datasets.data.form1.src.value;"
+                      "</script></calculate></field>"
+                      "</subform></template>"
+                      "<xfa:datasets xmlns:xfa=\"http://www.xfa.org/schema/xfa-data/1.0/\"><xfa:data><form1>"
+                      "<Row><v>row-one</v></Row><Row><v>row-two</v></Row></form1></xfa:data></xfa:datasets></xdp:xdp>";
+    GBytes *bytes = build_pdf_from(xml);
+    GError *err = NULL;
+    PopplerDocument *source = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    PopplerDocument *rendered = poppler_document_render_xfa(source, &err);
+    g_assert_no_error(err);
+    char *text = page_text(rendered);
+    g_assert_nonnull(strstr(text, "row-one"));
+    g_assert_nonnull(strstr(text, "row-two"));
+    if (!strstr(text, "enc=")) {
+        g_test_skip("poppler was built without XFA scripting");
+    } else {
+        g_assert_nonnull(strstr(text, "enc=[]world|world"));
+    }
+    g_free(text);
+    g_object_unref(rendered);
+    g_object_unref(source);
+    g_bytes_unref(bytes);
+}
+
 /* As in Acrobat, event.target is the Doc, whose dynamicXFAForm forms test
  * to choose how to work; other properties are those of the XFA object. */
 static void test_event_target(void)
@@ -1356,5 +1399,6 @@ int main(int argc, char *argv[])
     g_test_add_func("/xfa/locales", test_locales);
     g_test_add_func("/xfa/som-predicates", test_som_predicates);
     g_test_add_func("/xfa/event-target", test_event_target);
+    g_test_add_func("/xfa/data-binding", test_data_binding);
     return g_test_run();
 }
