 {
     if (node->getNamespace() == XFANode::Namespace::Data) {
@@ -1154,6 +1341,7 @@ void XFAForm::setRawValue(XFANode *node, const std::optional<std::string> &value
                 setRawValue(c, off.empty() ? std::nullopt : std::optional<std::string>(off));
