From e21408f43ead24cac9fad70f5cc9b0606f59f7e9 Mon Sep 17 00:00:00 2001
From: mminin <mminin2010@gmail.com>
Date: Tue, 13 Oct 2026 13:53:39 -0700
Subject: [PATCH] glib: Add test for form type and NeedsRendering

Builds minimal PDFs in memory, so no new file is needed in the test data
repository: no form, AcroForm, dynamic XFA (array, NeedsRendering true)
and static XFA (stream, NeedsRendering false).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 glib/tests/CMakeLists.txt    |  7 +++
 glib/tests/check_form_type.c | 89 ++++++++++++++++++++++++++++++++++++
 2 files changed, 96 insertions(+)
 create mode 100644 glib/tests/check_form_type.c

diff --git a/glib/tests/CMakeLists.txt b/glib/tests/CMakeLists.txt
index a09c66d..eb04794 100644
--- a/glib/tests/CMakeLists.txt
+++ b/glib/tests/CMakeLists.txt
@@ -11,7 +11,14 @@ set(poppler_check_bb_SRCS
 )
 poppler_add_test(poppler-check-bb BUILD_GTK_TESTS ${poppler_check_bb_SRCS})
 
+set(poppler_check_form_type_SRCS
+  check_form_type.c
+)
+poppler_add_test(poppler-check-form-type BUILD_GTK_TESTS ${poppler_check_form_type_SRCS})
+add_test(poppler-check-form-type ${EXECUTABLE_OUTPUT_PATH}/poppler-check-form-type)
+
 target_link_libraries(poppler-check-text poppler-glib PkgConfig::GTK3)
+target_link_libraries(poppler-check-form-type poppler-glib PkgConfig::GTK3)
 target_link_libraries(poppler-check-bb poppler-glib PkgConfig::GTK3)
 
 macro(GLIB_ADD_BBTEST arg1)
diff --git a/glib/tests/check_form_type.c b/glib/tests/check_form_type.c
new file mode 100644
index 0000000..54018e6
--- /dev/null
+++ b/glib/tests/check_form_type.c
@@ -0,0 +1,89 @@
+/*
+ * testing program for poppler_document_get_form_type and
+ * poppler_document_get_needs_rendering
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <poppler.h>
+
+typedef struct
+{
+    const char *name;
+    const char *catalog_entries;
+    PopplerFormType form_type;
+    gboolean needs_rendering;
+} FormTypeCase;
+
+static const FormTypeCase cases[] = {
+    { "no form", "", POPPLER_FORM_TYPE_NONE, FALSE },
+    { "acroform", "/AcroForm << /Fields [] >>", POPPLER_FORM_TYPE_ACROFORM, FALSE },
+    { "dynamic xfa", "/AcroForm << /Fields [] /XFA [(template) 4 0 R] >> /NeedsRendering true", POPPLER_FORM_TYPE_XFA, TRUE },
+    { "static xfa", "/AcroForm << /Fields [] /XFA 4 0 R >> /NeedsRendering false", POPPLER_FORM_TYPE_XFA, FALSE },
+};
+
+/* Builds a one page PDF whose catalog holds catalog_entries, with a correct xref table. */
+static GBytes *build_pdf(const char *catalog_entries)
+{
+    const char *xfa = "<template/>";
+    char *objects[4];
+    gsize offsets[4];
+    GString *pdf;
+    gsize xref_offset;
+    int i;
+
+    objects[0] = g_strdup_printf("<< /Type /Catalog /Pages 2 0 R %s >>", catalog_entries);
+    objects[1] = g_strdup("<< /Type /Pages /Kids [3 0 R] /Count 1 >>");
+    objects[2] = g_strdup("<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] >>");
+    objects[3] = g_strdup_printf("<< /Length %u >>\nstream\n%s\nendstream", (guint)strlen(xfa), xfa);
+
+    pdf = g_string_new("%PDF-1.7\n");
+    for (i = 0; i < 4; i++) {
+        offsets[i] = pdf->len;
+        g_string_append_printf(pdf, "%d 0 obj\n%s\nendobj\n", i + 1, objects[i]);
+        g_free(objects[i]);
+    }
+
+    xref_offset = pdf->len;
+    g_string_append(pdf, "xref\n0 5\n0000000000 65535 f \n");
+    for (i = 0; i < 4; i++) {
+        g_string_append_printf(pdf, "%010u 00000 n \n", (guint)offsets[i]);
+    }
+    g_string_append_printf(pdf, "trailer\n<< /Size 5 /Root 1 0 R >>\nstartxref\n%u\n%%%%EOF\n", (guint)xref_offset);
+
+    return g_string_free_to_bytes(pdf);
+}
+
+static void test_form_type(gconstpointer data)
+{
+    const FormTypeCase *c = data;
+    GBytes *bytes = build_pdf(c->catalog_entries);
+    GError *err = NULL;
+    PopplerDocument *doc;
+
+    doc = poppler_document_new_from_bytes(bytes, NULL, &err);
+    g_assert_no_error(err);
+    g_assert_nonnull(doc);
+
+    g_assert_cmpint(poppler_document_get_form_type(doc), ==, c->form_type);
+    g_assert_cmpint(poppler_document_get_needs_rendering(doc), ==, c->needs_rendering);
+
+    g_object_unref(doc);
+    g_bytes_unref(bytes);
+}
+
+int main(int argc, char *argv[])
+{
+    gsize i;
+
+    g_test_init(&argc, &argv, NULL);
+
+    for (i = 0; i < G_N_ELEMENTS(cases); i++) {
+        char *path = g_strdup_printf("/form-type/%s", cases[i].name);
+        g_test_add_data_func(path, &cases[i], test_form_type);
+        g_free(path);
+    }
+
+    return g_test_run();
+}
-- 
